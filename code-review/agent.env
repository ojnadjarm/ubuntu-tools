MODEL=opus
TIMEOUT=14000       # seconds; the swarm runs 1-3 h
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=13500000  # claude -p kills background tasks (the swarm) after 600 s by default
UNIT_TIMEOUT=14400  # agent@code-review.service TimeoutStartSec (install.sh writes the drop-in)
SCHEDULE="Sat *-*-* 03:00"
ENABLED=yes         # T74 (2026-09-24)
AGENT_TOOLS=Bash,Read,Write,Edit,Workflow
AGENT_WRAP="code-review-sandbox --post --"
