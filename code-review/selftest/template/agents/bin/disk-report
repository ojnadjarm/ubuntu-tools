#!/usr/bin/env python3
"""disk-report — total size of a directory tree, human readable."""
import os
import sys


def human_size(n):
    """Bytes as B, KB, MB, GB with one decimal."""
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f'{n:.1f} {unit}' if unit != 'B' else f'{int(n)} B'
        n /= 1024


def main():
    if len(sys.argv) != 2:
        print('usage: disk-report <dir>', file=sys.stderr)
        return 2
    total = 0
    for root, _, files in os.walk(sys.argv[1]):
        for f in files:
            p = os.path.join(root, f)
            if not os.path.islink(p):
                total += os.path.getsize(p)
    print(f'{sys.argv[1]}\t{human_size(total)}')
    return 0


sys.exit(main())
