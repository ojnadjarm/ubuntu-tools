#!/usr/bin/env python3
"""opencode adapter: turn its `run --format json` event stream (stdin) into audit records.

Verified against opencode 1.18.29: a tool call arrives as
  {"type":"tool_use","part":{"type":"tool","tool":"bash","state":{"status":"completed",
   "input":{...}}}}
Tool names are lowercase there, so they are mapped onto the harness's canonical names, and
`filePath` onto `file_path`, which is what `hooks/audit-log.py` and `agents-log` expect.
Schema: KB/audit.md. Stdin is echoed to stdout so this can sit in a pipe."""
import importlib.util, json, os, sys

_p = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', '..', 'hooks', 'audit-log.py')
_s = importlib.util.spec_from_file_location('audit_core', _p)
core = importlib.util.module_from_spec(_s)
_s.loader.exec_module(core)

NAMES = {'bash': 'Bash', 'read': 'Read', 'write': 'Write', 'edit': 'Edit', 'patch': 'Edit',
         'glob': 'Glob', 'grep': 'Grep', 'list': 'Glob', 'webfetch': 'WebFetch',
         'todowrite': 'TodoWrite', 'todoread': 'TodoRead', 'task': 'Task', 'skill': 'Skill'}
SESSION = os.environ.get('AGENT_SESSION_ID', '')
CWD = os.environ.get('PWD', '')

for line in sys.stdin:
    sys.stdout.write(line)
    line = line.strip()
    if not line.startswith('{'):
        continue
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    part = ev.get('part') or {}
    if part.get('type') != 'tool':
        continue
    state = part.get('state') or {}
    if state.get('status') not in ('completed', 'error'):
        continue
    args = dict(state.get('input') or {})
    if 'filePath' in args:
        args.setdefault('file_path', args['filePath'])
    name = part.get('tool') or '?'
    core.record(NAMES.get(name, name), args,
                args.get('workdir') or CWD,
                ev.get('sessionID') or SESSION)
