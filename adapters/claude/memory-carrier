#!/usr/bin/env python3
"""Claude Code memory carrier: how Claude sessions get `memory load`'s text (the @ lines, MEMORY.md), worker detection, the quiz seam (T1599)."""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.path[:0] = [os.path.join(ROOT, "lib"), os.path.join(ROOT, "bin")]
import memory_route  # noqa: E402
import memory_store  # noqa: E402

MARK = "<!-- generated by `memory install` from the memory store: edit the store, not this file -->"
TODO = "Approve the memory imports in project folders (T1599)"
MEMORY_LINES, MEMORY_BYTES = 200, 25000


def home():
    return os.path.expanduser("~")


def tilde(path):
    """path as ~/… when it is under HOME."""
    h = home()
    return "~" + path[len(h):] if path == h or path.startswith(h + "/") else path


def config_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home(), ".claude")


def claude_json():
    """Claude Code's global config: $CLAUDE_CONFIG_DIR/.claude.json, else ~/.claude.json."""
    d = os.environ.get("CLAUDE_CONFIG_DIR")
    return os.path.join(d, ".claude.json") if d else os.path.join(home(), ".claude.json")


def project_dir(root):
    """Claude Code's per-project folder: every character outside [A-Za-z0-9] becomes '-'."""
    return os.path.join(config_dir(), "projects", re.sub(r"[^A-Za-z0-9]", "-", root))


def git(folder, *args):
    r = subprocess.run(["git", "-C", folder, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def git_root(folder):
    return git(folder, "rev-parse", "--show-toplevel") or folder


def is_worker():
    """True for a run that is not the owner's own session: the MEMORY_WORKER marker, or a headless `claude -p` ancestor."""
    if os.environ.get("MEMORY_WORKER"):
        return True
    pid = os.getppid()
    while pid > 1:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
            with open(f"/proc/{pid}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
        at = next((i for i, a in enumerate(argv[:2]) if os.path.basename(a) == "claude"), None)
        if at is not None:
            return any(a in ("-p", "--print") for a in argv[at + 1:])
        pid = ppid
    return False


class Writer:
    """Writes or, with plan, prints what it would write; refuses any path under a protected project."""

    def __init__(self, plan, protected):
        self.plan, self.protected, self.wrote = plan, protected, 0

    def blocked(self, path):
        p = os.path.abspath(path)
        return any(p == q or p.startswith(q.rstrip("/") + "/") for q in self.protected)

    def write(self, path, data, what):
        if self.blocked(path):
            print(f"skipped (protected): {tilde(path)}")
            return
        self.wrote += 1
        if self.plan:
            print(f"would: {tilde(path)} ({what})")
            return
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
        print(f"wrote {tilde(path)} ({what})")


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return None


def with_line(text, line, after=None):
    """text with line added (after the last line matching `after`, else at the end); None when it is already there."""
    rows = (text or "").splitlines()
    if line in rows:
        return None
    at = max((i for i, r in enumerate(rows) if after and re.search(after, r)), default=len(rows) - 1)
    rows.insert(at + 1, line)
    return "\n".join(rows) + "\n"


def protected_paths(store):
    """Folders no write may touch: `protected` rows of domains.map plus the protected matcher's repos and paths."""
    import protectedlib
    rows = [os.path.expanduser(w) for w, _, fl in store.map() if not w.startswith("seat:") and "protected" in fl]
    return sorted({os.path.abspath(p) for p in rows + protectedlib.lexical_paths()})


def folders(store):
    """{folder: [domain, ...]} of the folder rows of domains.map, in map order."""
    out = {}
    for w, d, _ in store.map():
        if not w.startswith("seat:"):
            out.setdefault(os.path.abspath(os.path.expanduser(w)), []).append(d)
    return out


def served(folder):
    """A served build (`sites publish` stamps a build.json into it): it gets no stub and needs no approval."""
    return os.path.isfile(os.path.join(folder, "build.json"))


def generated(store):
    """The orchestrator's MEMORY.md: the owner seat's cards (PRIVATE pages left out: subagents read it) and INDEX.md."""
    seats = [w[5:] for w, _, fl in store.map() if w.startswith("seat:") and "owner" in fl]
    parts = []
    for d in dict.fromkeys(d for s in seats for d in memory_route.domains_for(home(), s, {}, store)):
        page = store.card(d)
        if os.path.isfile(store.path(page)) and store.private_seats(page) is None:
            parts.append(f"# memory: {d}\n" + memory_store.strip_ids(store.text(page)).rstrip("\n"))
    if os.path.isfile(store.path("INDEX.md")):
        parts.append("# memory: index\n" + memory_store.strip_ids(store.text("INDEX.md")).rstrip("\n"))
    return MARK + "\n" + "\n\n".join(parts) + "\n" if parts else None


def archive_copy(store, w, text):
    """Copy a hand-written MEMORY.md word for word into the archive once, before it is replaced."""
    arch = store.path("archive/2026-11-auto-memory")
    data = text.encode("utf-8")
    for r, _, fs in os.walk(arch):
        for f in fs:
            with open(os.path.join(r, f), "rb") as fh:
                if fh.read() == data:
                    return
    w.write(os.path.join(arch, "MEMORY.md." + hashlib.sha256(data).hexdigest()[:12]), text, "copy of the old MEMORY.md")


def rostered(harness):
    """Agent folders whose agent.env has a non-empty SCHEDULE= (the roster install.sh turns into timers)."""
    out = []
    for name in sorted(os.listdir(harness)) if os.path.isdir(harness) else []:
        env = os.path.join(harness, name, "agent.env")
        text = read(env) if os.path.isfile(env) else None
        if text and re.search(r"^SCHEDULE=[\"']?[^\"'\s]", text, re.M):
            out.append((os.path.join(harness, name), env, text))
    return out


def verify(store):
    """[(folder, approved)] per existing, unprotected stub folder: is its git root's external-import approval on (read only)."""
    try:
        with open(claude_json(), encoding="utf-8") as f:
            projects = json.load(f).get("projects", {})
    except (OSError, ValueError):
        projects = {}
    prot = protected_paths(store)
    out = []
    for f in folders(store):
        if os.path.isdir(f) and not served(f) and not Writer(True, prot).blocked(f):
            out.append((f, bool(projects.get(git_root(f), {}).get("hasClaudeMdExternalIncludesApproved"))))
    return out


def install(store, plan=False):
    """Write the carriers (idempotent): the ~/CLAUDE.md line, CLAUDE.local.md stubs, MEMORY.md, agent.env domains. Exit code."""
    try:
        prot = protected_paths(store)
    except Exception as e:  # the matcher failed: fail closed, write nothing
        print(f"memory install: protected matcher failed ({e}); nothing written", file=sys.stderr)
        return 1
    w, s = Writer(plan, prot), tilde(store.root)

    inc = os.path.join(home(), "CLAUDE.md")
    text = read(inc)
    if text is None:
        print(f"skipped (missing): {tilde(inc)}")
    else:
        new = with_line(text, f"@{s}/core/CORE.md", after=r"^@.*AGENTS\.md\s*$")
        if new:
            w.write(inc, new, "core line")

    for folder, domains in folders(store).items():
        if w.blocked(folder):
            print(f"skipped (protected): {tilde(folder)}")
            continue
        if not os.path.isdir(folder):
            print(f"skipped (missing): {tilde(folder)}")
            continue
        if served(folder):
            print(f"skipped (served build): {tilde(folder)}")
            continue
        stub = os.path.join(folder, "CLAUDE.local.md")
        text = read(stub)
        for d in domains:
            text = with_line(text, f"@{s}/domains/{d}/DOMAIN.md") or text
        if text != read(stub):
            w.write(stub, text, "domain stub")
        exc = git(folder, "rev-parse", "--git-path", "info/exclude")
        if exc:
            exc = os.path.normpath(os.path.join(folder, exc))
            new = with_line(read(exc), "CLAUDE.local.md")
            if new:
                w.write(exc, new, "git exclude")

    page = generated(store)
    if page:
        n_lines, n_bytes = page.count("\n"), len(page.encode("utf-8"))
        if n_lines > MEMORY_LINES or n_bytes > MEMORY_BYTES:
            print(f"memory install: MEMORY.md would be {n_lines} lines / {n_bytes} B, over {MEMORY_LINES} / {MEMORY_BYTES}:"
                  " make the orchestrator card denser; not written", file=sys.stderr)
            return 1
        mem = os.path.join(project_dir(git_root(home())), "memory", "MEMORY.md")
        old = read(mem)
        if old != page:
            if old and not old.startswith(MARK):
                archive_copy(store, w, old)
            w.write(mem, page, "orchestrator MEMORY.md")
    else:
        print("skipped (no card): orchestrator MEMORY.md")

    harness = os.environ.get("HARNESS_HOME") or os.path.join(home(), "agents")
    for folder, env, text in rostered(harness):
        if re.search(r"^(export )?MEMORY_DOMAINS=", text, re.M):
            continue
        ds = memory_route.domains_for(folder, "", {}, store)
        if ds:
            w.write(env, text.rstrip("\n") + f"\nexport MEMORY_DOMAINS={','.join(ds)}\n", "agent domains")

    todo = [tilde(f) for f, ok in verify(store) if not ok]
    if todo:
        print("unapproved: " + ", ".join(todo))
        how = ("Open one Claude session in each folder and answer Yes to 'Allow external CLAUDE.md file imports?': "
               + ", ".join(todo))
        import owner_todo
        if not any(i["text"] == TODO for i in owner_todo.items()):
            if plan:
                print(f"would: owner-todo '{TODO}'")
            else:
                owner_todo.add(TODO, how, "T1599-M08", "memory install")
                print(f"owner-todo: {TODO}")
    if not w.wrote:
        print("memory install: no changes")
    return 0


def ask(prompt, domains):
    """The model seam: MEMORY_QUIZ_CMD (prompt on stdin, answer on stdout), else one headless haiku run through the Claude adapter."""
    return ask_usage(prompt, domains)[0]


def ask_usage(prompt, domains):
    """(answer, tokens) of one ask; tokens = the run's meta.json usage (agent-exec, or the MEMORY_QUIZ_CMD), {} when absent."""
    env = dict(os.environ, MEMORY_DOMAINS=",".join(domains), MEMORY_WORKER="1")
    with tempfile.TemporaryDirectory(prefix="memory-live.") as t:
        cmd = os.environ.get("MEMORY_QUIZ_CMD")
        if cmd:
            out = subprocess.run(cmd, shell=True, input=prompt, env=env, cwd=t, capture_output=True, text=True,
                                 timeout=600).stdout
            return out, _tokens(t)
        for k in [k for k in env if k == "CLAUDECODE" or k.startswith("CLAUDE_CODE_")]:
            del env[k]
        env.update(HARNESS_AGENT="claude", AGENT_TOOLS="")
        pf = os.path.join(t, "prompt.md")
        with open(pf, "w", encoding="utf-8") as f:
            f.write(prompt)
        try:
            out = subprocess.run([os.path.join(ROOT, "bin", "agent-exec"), "--prompt-file", pf, "--model", "haiku",
                                  "--cwd", t, "--name", "memory-live", "--timeout", "300"],
                                 env=env, cwd=t, capture_output=True, text=True, timeout=400).stdout
            return out, _tokens(t)
        finally:
            shutil.rmtree(project_dir(os.path.realpath(t)), ignore_errors=True)


def _tokens(folder):
    try:
        with open(os.path.join(folder, "meta.json"), encoding="utf-8") as f:
            tok = json.load(f).get("tokens") or {}
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in tok.items() if k.endswith("_tokens") and isinstance(v, int)}


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else ""
    store = memory_store.Store(memory_store.home())
    if verb == "install":
        sys.exit(install(store, "--plan" in sys.argv[2:]))
    if verb == "verify":
        for f, ok in verify(store):
            print(f"approval · {tilde(f)} · {'yes' if ok else 'no'}")
        sys.exit(0)
    if verb == "is-worker":
        sys.exit(0 if is_worker() else 1)
    print("usage: memory-carrier install [--plan] | verify | is-worker", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
