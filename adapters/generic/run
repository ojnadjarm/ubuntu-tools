#!/usr/bin/env bash
# Generic adapter for agent-exec: run $HARNESS_AGENT_CMD with the prompt in $PROMPT.
# stdout = whatever the command prints · $RAW_OUT keeps the same text · no cost reporting.
set -uo pipefail

[ -n "${HARNESS_AGENT_CMD:-}" ] || { echo "generic adapter: HARNESS_AGENT_CMD is empty" >&2; exit 2; }
PROMPT="$(cat "$PROMPT_FILE")"
SYSTEM=""
[ -n "${SYSTEM_FILE:-}" ] && [ -r "$SYSTEM_FILE" ] && SYSTEM="$(cat "$SYSTEM_FILE")"
export PROMPT SYSTEM

cmd=(bash -c "$HARNESS_AGENT_CMD")
[ -n "${AGENT_TIMEOUT:-}" ] && cmd=(timeout "$AGENT_TIMEOUT" "${cmd[@]}")

# Background + wait so a SIGTERM from agents-stop reaches the command instead of waiting for it.
# setsid gives the command its own process group, so the trap also reaches its grandchildren.
setsid bash -c '"$@" </dev/null | tee "$RAW_OUT"; exit "${PIPESTATUS[0]}"' _ "${cmd[@]}" &
child=$!
trap 'pkill -TERM -P "$child"; kill -TERM -- -"$child" 2>/dev/null' TERM INT
until wait "$child"; rc=$?; ! kill -0 "$child" 2>/dev/null; do :; done
jq -n '{}' >"$META_OUT"
exit "$rc"
