[Unit]
Description=fleet-backup run with its restic password from the vault (unit mode, T1634-V9); started by the user timer's fleet-backup nightly
After=fleet-vault.service

[Service]
Type=oneshot
User=@USER@
Environment=HOME=@HOME@ XDG_RUNTIME_DIR=/run/user/@UID@ PATH=@HOME@/agents/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
LoadCredentialEncrypted=fleet.fleet-backup-pass
ExecStart=@HOME@/agents/bin/fleet-backup run
TimeoutStartSec=14400
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
