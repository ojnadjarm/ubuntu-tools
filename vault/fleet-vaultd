#!/usr/bin/env python3
"""fleet-vaultd: the secrets broker (T1634); wires registry, sealer, audit, leases, the leak scan, the admin socket, the loopback listener and the owner page."""
import argparse
import os
import pwd
import socketserver
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from vault import wire  # noqa: E402
from vault.admin import Admin  # noqa: E402
from vault.approvals import Approvals, Approving  # noqa: E402
from vault.caller import Callers  # noqa: E402
from vault.audit import Audit  # noqa: E402
from vault.gate import Gate  # noqa: E402
from vault.grants import Grants  # noqa: E402
from vault.leases import Leases  # noqa: E402
from vault import page  # noqa: E402
from vault.exchange import Exchange  # noqa: E402
from vault.listener import serve  # noqa: E402
from vault.op import Ntfy  # noqa: E402
from vault.push import Push  # noqa: E402
from vault.oauth import OAuthProxy  # noqa: E402
from vault.scan import Scanner  # noqa: E402
from vault.seal import SealError, SystemdCreds  # noqa: E402
from vault.standing import Standing  # noqa: E402


def main():
    p = argparse.ArgumentParser(description="fleet-vaultd: the fleet's secrets broker (admin Unix socket, loopback HTTP)")
    p.add_argument("--registry", default="/etc/fleet-vault/registry.toml")
    p.add_argument("--state", default=os.environ.get("STATE_DIRECTORY", "/var/lib/fleet-vault"))
    p.add_argument("--socket", default="/run/fleet-vault/admin.sock")
    p.add_argument("--seal-socket", default="/run/fleet-vault-seal.sock")
    p.add_argument("--cred-dir", default=os.environ.get("CREDENTIALS_DIRECTORY", ""))
    p.add_argument("--clients", default=os.environ.get("FLEET_VAULT_CLIENTS", ""),
                   help="comma list of user names allowed on the admin socket (root always)")
    p.add_argument("--port", type=int, default=0,
                   help="loopback HTTP port for leased calls (default 0: any free port); written to <state>/port")
    p.add_argument("--page-socket", default="",
                   help="Unix socket of the owner's Vault page (default: page.sock beside --socket); tailscale serve "
                        "mounts it at /vault on the dashboard front")
    p.add_argument("--owner-login", default=os.environ.get("FLEET_VAULT_OWNER_LOGIN", ""),
                   help="the owner's tailnet login; the only one the page lets in (empty: the page refuses everything)")
    p.add_argument("--cgroup-root", default="/sys/fs/cgroup",
                   help="cgroupfs root; a grant from a pid in the caller's agents.slice is refused and raised")
    p.add_argument("--upstream", default="", help="tests only: send every proxied call and ntfy op to this plain-HTTP base")
    a = p.parse_args()
    a.page_socket = a.page_socket or os.path.join(os.path.dirname(a.socket), "page.sock")

    allowed = {0} | {pwd.getpwnam(u).pw_uid for u in a.clients.split(",") if u}
    sealer = SystemdCreds(a.cred_dir, a.seal_socket)
    audit = Audit(os.path.join(a.state, "uses.jsonl"))
    leases = Leases(path=os.path.join(a.state, "leases.json"))
    ntfy = Ntfy(a.upstream)
    push = Push(lambda: admin.entries, sealer, ntfy)
    callers = Callers(a.cgroup_root)
    grants = Approving(leases, audit, callers, Approvals(push, audit), push)
    admin = Admin(a.registry, os.path.join(a.state, "added.json"), sealer, audit, grants,
                  Standing(lambda: admin.entries, sealer, audit, {"ntfy": ntfy}))
    gate = Gate(lambda: admin.entries, sealer, leases, audit, {"proxy": OAuthProxy(sealer, audit, a.upstream),
                                                           "exchange": Exchange(a.upstream)})
    scanner = Scanner(lambda: admin.entries, sealer, audit, callers)
    web = serve(gate, "127.0.0.1", a.port)
    page.serve(admin, a.page_socket, a.owner_login)
    with open(os.path.join(a.state, "port"), "w") as f:
        f.write(str(web.server_address[1]))

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            pid, uid, _gid = wire.peer(self.request)
            try:
                req = wire.read_msg(self.rfile)
            except ValueError:
                return wire.write_msg(self.wfile, {"ok": False, "error": "bad request"})
            if uid not in allowed:
                audit.log({"event": str(req.get("op", "?"))[:20], "secret": req.get("name"), "result": "refused",
                           "uid": uid, "target": "admin socket: uid not allowed"})
                return wire.write_msg(self.wfile, {"ok": False, "error": "refused: this user may not use the vault"})
            if req.get("op") == "scan":
                return scanner.serve(self.request, self.wfile, req, uid, pid)
            try:
                reply = admin.handle(req, uid, pid)
            except SealError as e:
                reply = {"ok": False, "error": str(e)}
            wire.write_msg(self.wfile, reply)

    if os.path.exists(a.socket):
        os.unlink(a.socket)
    old = os.umask(0o111)
    server = socketserver.ThreadingUnixStreamServer(a.socket, Handler)
    server.daemon_threads = True
    os.umask(old)
    print(f"fleet-vaultd: {len(admin.entries)} names known, listening on {a.socket}, {a.page_socket} "
          f"and 127.0.0.1:{web.server_address[1]}",
          flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
