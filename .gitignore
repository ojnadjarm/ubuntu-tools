# pc-harness — what never leaves this machine.
# Everything here is either a credential, a run artefact, or a generated machine fact.

# Credentials and machine-local config.
/secrets/
/config.env

# Run artefacts and owner data.
/log/
/backups/
/browser/
/state/

# Generated machine facts: `pc status --facts > KB/machine.md`.
/KB/machine.md

# Per-agent runtime (BRIEF.md and agent.env are tracked, the rest is not).
*/logs/
*/state/
*/REPORT.md
*/.lock

# Benchmark data: 12 MB of run output and the two frozen arm copies.
/bench/runs/
/bench/arms/old/
/bench/arms/new/

# Python bytecode.
__pycache__/
*.pyc

# npm dependencies: installed by `npm install`, never tracked.
node_modules/

# Planning artefacts: plans, tickets and spikes are pre-development, never part of the product.
/PLAN-*.md
/ubuntu-ai-first/
/bench/PLAN-*.md
/bench/tickets/
/bench/spike/
/bench/tasks/*/.state/

# portfolio raw material: LinkedIn PDF, USB dump, .env files
portfolio/incoming/

# Owner voice data: his recorded clips, his drill and long-form prompt set.
/asr-corpus/
/dashboard/voice_prompts.json

# Agent working papers: briefs, research, reviews, mockups, surveys, the claims board, the trash.
/briefs/
/research/
/eye-review/
/dashboard/plans/
/dashboard/review/
/dashboard/mockups/
/CLEANUP-*.md
/FILE-CLAIMS.md
/.trash/

# Personal site material and this install's orchestrator reference (roster, envs, demo).
/portfolio/
/KB/orchestrator.md

# Machine-local links to the Dark Eye bridge install (~/.config/dark-eye, ~/.local/state/dark-eye).
/eye-relay/mcp-*.json
/eye-relay/state

# Agent run output: toolsmith proposals, backlog and dated reports; pcbench results.
/toolsmith/proposals/*
!/toolsmith/proposals/.gitkeep
!/toolsmith/proposals/TSP-000-example.md
/toolsmith/BACKLOG.md
/toolsmith/PLAN-*.md
/toolsmith/*-20*.md
/improve/queue/*
/improve/saved/
/bench/LAST.json
/bench/BASELINE-*.md
/bench/BASELINE-*.tsv
/bench/QA-REPORT.md
/improve/metrics.tsv

# Build and screenshot output of the kits and ticket pages: rebuilt by `vite build` / tools/shot.mjs.
/kits/**/dist/
/kits/**/out/

# Orchestrator working papers: the claims-board lock (ticket history lives in $AGENT_WORK/history.md).
/FILE-CLAIMS.md.lock

# Machine-local links into ~/.claude/skills (absolute paths; the skills own these scripts).
/bin/finance-month
/bin/invoice
/bin/lesson-board
/bin/new-lesson

# Discord forum bot runtime (T348): venv, sandbox socket, runner ledger, approved-job dirs.
/discord-bot/.venv/
/discord-bot/run/
/discord-bot/runner-state/
/discord-bot/work/

# Product-owner agents (T1412): requests and replies are runtime, BRIEF.md and agent.env are tracked.
/po-*/inbox/
/po-*/current/
/po-*/done/
/po-*/outbox/
/po-*/.inbox-tmp/
/po-*/.po-run.lock
