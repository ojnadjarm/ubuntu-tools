# pc-harness configuration — copy to ~/.config/pc-harness/config.env and edit.
# Shell syntax, sourced by bin/env.sh. Every value has a working default; set only what differs.
# Machine values (hosts, IPs, MACs, paths, users, passwords) live only here and in private-values, never in tracked files (T278).
# ~/.config/pc-harness/private-values: one literal per line that bin/tests/no-machine-values.test.sh must never find in the repo.

# HARNESS_HOME=$HOME/agents            # where this checkout lives
# HARNESS_AGENT=                       # claude|codex|gemini|opencode|generic — empty = legacy path
# HARNESS_AGENT_CMD=                   # command used by adapters/generic/run

# HARNESS_OWNER_NAME=                  # default: git config user.name
# HARNESS_OWNER_EMAIL=                 # default: git config user.email

# HARNESS_HOST=$(hostname)             # short name used in pushes, titles and the dashboard
# HARNESS_BRAND=                      # display name in the dashboard header and page titles — empty falls back to HARNESS_HOST
# HARNESS_TAILNET_FQDN=                # e.g. host.tailXXXX.ts.net — empty falls back to HARNESS_HOST
# HARNESS_LAN_IP=                      # e.g. 192.168.0.10
# HARNESS_BUDS_MAC=                    # Bluetooth earbuds for `pc bt … buds`, `pc audio earbuds`, buds-*
# HARNESS_UID=$UID                     # only for a non-default runtime dir
# HARNESS_GITHUB_USER=                 # GitHub user whose <user>.github.io `sites` mirrors — empty shows "GitHub Pages"

# NTFY_ENV_FILE=$HARNESS_HOME/secrets/ntfy.env
# ORCHESTRATOR_TMUX_SESSION=claude
# ORCHESTRATOR_UNIT=claude-orchestrator.service
# User units pc status checks are active and local sites that must answer 200 (<compose project>=<url>);
# the sentinel restarts them, at most SENTINEL_TRIES times in a row, then pushes once (T269).
# KEEPALIVE_UNITS="vass-middleware.service vass-frontend.service vass-frontend-proxy.service moodle45-cron.timer"
# KEEPALIVE_HTTP="moodle45=http://127.0.0.1:8045/login/index.php"
# SENTINEL_TRIES=3
# AGENT_SCRATCH_GLOBS="/tmp/claude-$HARNESS_UID/*/*/scratchpad"
# MOODLE_ENVS_DIR=$HOME/moodle-envs
# MOODLE_ADMIN_PASSWORD=               # dev Moodle admin password shown by `pc status` and the dashboard — empty shows a placeholder
# HARNESS_CONTEXT_DIR=$HOME/.claude   # where `harness context` reads the instruction files
# MAINT_AUTO_REBOOT=1                  # 0 = maintenance-run never reboots; it pushes "reboot required" and exits 3

# Adapter-specific (see adapters/<name>/README.md); each has a working default.
# OPENCODE_BIN=$HOME/.opencode/bin/opencode   # only if the binary is not on PATH
# OPENCODE_MODEL=                      # provider/model, e.g. opencode/<a free model>
