MODEL=opus
TIMEOUT=300         # triage run only (T1414): real work runs as jobs
SCHEDULE="2099-01-01 00:00:00"
ENABLED=no          # runs from discord-liaison-check.timer only when #foro has new messages
RUNNER_KIND=bash-timer
RUNNER_UNIT=discord-liaison-check.timer
LIAISON_RUNS_PER_DAY=100000 # no run limit (owner: no caps); refusals logged in logs/caps.log
LIAISON_PRS_PER_DAY=100000 # no PR limit (owner 2026-10-28); value only guards a runaway loop
LIAISON_IMAGES_PER_DAY=5   # `discord-liaison art` images per UTC day (concept-img, OpenRouter)
LIAISON_JOBS_MAX=3         # background jobs at once (T1414); extra jobs queue
LIAISON_JOB_TIMEOUT=10800  # one job worker (agent-exec timeout; unit RuntimeMaxSec = 2 × this + 300: both attempts)
LIAISON_JOB_MODEL=claude-fable-5-2  # content jobs: Fable 5.2 (owner 2026-11-09); triage stays MODEL
LIAISON_JOB_EFFORT=high      # content jobs at high reasoning (owner 2026-11-09 21:44 in #foro: "Fable High"; was medium)
export MEMORY_DOMAINS=discord
