MODEL=opus
TIMEOUT=1800
SCHEDULE="2099-01-01 00:00:00"
ENABLED=no          # runs from discord-liaison-check.timer only when #foro has new messages
RUNNER_KIND=bash-timer
RUNNER_UNIT=discord-liaison-check.timer
LIAISON_RUNS_PER_DAY=30    # LLM runs per UTC day; refusals logged in logs/caps.log
LIAISON_PRS_PER_DAY=3      # PRs per UTC day, all projects
