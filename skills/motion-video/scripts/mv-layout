#!/usr/bin/env python3
"""mv-layout: plan-level layout check of a film build's out/ before any render - 2D titles over the subject, unseen 3D titles, squashed subject.

Reads out/cam<n>.json (shot.py --dump-camera), cuts.json, spans.json, build.json, an optional out/layout.json plan and the
project's ../brand.json and ../build.sh (MV_MODEL* settings: the hero .glb and its clip per shot). Exit 0 clean, 1 on any FAIL,
2 on a usage or input error.
"""
import argparse
import bisect
import glob
import json
import math
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "lib"))
import glb  # noqa: E402

SENSOR_MM = 36.0
TITLE_OVERLAP = 0.10
SCALE_MAX = 1.6
SQUASH_DRIFT = 0.15
TITLE3D_SEEN = 0.5
TITLE3D_BOX = {"min": [-1.2, -0.7, 3.0], "max": [1.2, 1.7, 3.6]}

ap = argparse.ArgumentParser(prog="mv-layout", description=__doc__.splitlines()[0].split(": ", 1)[1], epilog="""
layout.json (all optional): {"subject": {"min": [x,y,z], "max": [x,y,z], "scale": [[t, sx, sy, sz], ...]},
  "model_height": 2.0, "title": "HOUSE", "subtitle": "...",
  "titles": [{"id": "title", "t0": 0, "t1": 7.1, "rect": [x0, y0, x1, y1], "rect_9x16": [...]}],
  "title3d": {"shots": [1], "min": [x,y,z], "max": [x,y,z]}}
Rects are frame fractions from the top left. Without a plan: subject = MV_MODEL_HEIGHT (default 2.0) tall on the origin,
footprint +/- a quarter of its height; titles = spans.json with the film template's Title.tsx rects; 3D-title shots =
the MV_TITLE shot in ../build.sh, letters box as shot.py places them without a logo.
Without subject.scale: the MV_MODEL .glb in ../build.sh (MV_MODEL_ANIM clip per shot, _SPEED, _CUE as shot.py loops it)
gives the scale track; FAIL squash when sx/sy or sz/sy drifts > 15 % from the node's rest, or when translation keys move a
leaf skin joint (an IK target such as a foot or pole target) > 15 % of the rest rig height off its rest offset, or when
rotation keys on the root chain (scene root down to the top skin joint and its child joints) shear a node's world frame
> 15 % (sigma max / sigma min of world x rest-world^-1). A .glb with none of these prints the camera's lens and aspect
numbers over the frames where the subject is on screen (or --window) and names a cause when either reaches the FAIL ratio
1.6, a note when > 15 % off.""", formatter_class=argparse.RawDescriptionHelpFormatter)
ap.add_argument("outdir", help="the film build's out/ directory")
ap.add_argument("--aspect", choices=["16x9", "9x16"], default="16x9", help="delivery frame to check (9x16 = the template's centre crop)")
ap.add_argument("--window", metavar="T0-T1", help="film seconds the camera line covers when the .glb has no judged keys (default: the frames where the subject is on screen)")
a = ap.parse_args()
try:
    win = [float(x) for x in a.window.split("-")] if a.window else None
    assert win is None or (len(win) == 2 and win[0] <= win[1])
except (ValueError, AssertionError):
    ap.error(f"--window {a.window}: want T0-T1 seconds")
out = os.path.abspath(a.outdir)
proj = os.path.dirname(out)


def load(path, default=None):
    """Parsed JSON at path, or default when the file is missing."""
    return json.load(open(path)) if os.path.isfile(path) else default


cams = sorted(glob.glob(os.path.join(out, "cam[0-9]*.json")), key=lambda p: int(re.findall(r"\d+", os.path.basename(p))[0]))
if not cams:
    print(f"mv-layout: no cam<n>.json in {out} (shot.py -- --dump-camera)", file=sys.stderr)
    sys.exit(2)
shots = [load(p) for p in cams]
plan = load(os.path.join(out, "layout.json"), {})
build = load(os.path.join(out, "build.json"), {})
cuts = load(os.path.join(out, "cuts.json"), {})
W, H = (int(v) for v in build.get("size", "1920x1080").split("x"))
fps = float(build.get("fps") or (load(os.path.join(out, "cues0.json"), {}).get("fps")) or 0)
fails, notes = [], []
if not fps:
    print("mv-layout: n/a: fps (build.json fps or cues0.json fps)", file=sys.stderr)
    sys.exit(2)
starts = cuts.get("starts")
if not starts:
    notes.append("n/a: cuts.json starts (shots timed back to back)")
    starts, t = [], 0.0
    for s in shots:
        starts.append(t)
        t += len(s["frames"]) / fps
crop = (H * 9 / 16) / W if a.aspect == "9x16" else 1.0


def sub(p, q):
    return [p[i] - q[i] for i in range(3)]


def dot(p, q):
    return sum(p[i] * q[i] for i in range(3))


def cross(p, q):
    return [p[1] * q[2] - p[2] * q[1], p[2] * q[0] - p[0] * q[2], p[0] * q[1] - p[1] * q[0]]


def unit(p):
    n = math.sqrt(dot(p, p))
    return [v / n for v in p]


def camera(pos, target, lens):
    """Projector of world points to delivery-frame fractions (x right, y down) for a TRACK_TO camera, sensor fit auto."""
    f = unit(sub(target, pos))
    r = unit(cross(f, [0, 0, 1]))
    u = cross(r, f)
    big = SENSOR_MM / 2 / lens
    tx, ty = (big, big * H / W) if W >= H else (big * W / H, big)

    def project(p):
        d = sub(p, pos)
        z = dot(d, f)
        if z <= 1e-6:
            return None
        fx = 0.5 + dot(d, r) / (z * tx) / 2
        return ((fx - (1 - crop) / 2) / crop, 0.5 - dot(d, u) / (z * ty) / 2)
    return project, r


def box_rect(project, lo, hi):
    """Screen rect [x0, y0, x1, y1] of the world box lo..hi, None when a corner is behind the camera."""
    pts = [project([x, y, z]) for x in (lo[0], hi[0]) for y in (lo[1], hi[1]) for z in (lo[2], hi[2])]
    if None in pts:
        return None
    return [min(p[0] for p in pts), min(p[1] for p in pts), max(p[0] for p in pts), max(p[1] for p in pts)]


def inter(p, q):
    return max(0.0, min(p[2], q[2]) - max(p[0], q[0])) * max(0.0, min(p[3], q[3]) - max(p[1], q[1]))


def area(p):
    return (p[2] - p[0]) * (p[3] - p[1])


def frames():
    """Every (shot, shot frame, global t, projector, camera right) of the cut."""
    for n, s in enumerate(shots):
        for k, pos in enumerate(s["frames"]):
            project, right = camera(pos, s["target"], s["lens"])
            yield n, k, starts[n] + k / fps, project, right


def runs(hits):
    """Contiguous (t0, t1, worst) runs of (t, value) hits, split where frames are more than 1.5 frames apart."""
    out_runs = []
    for t, v in hits:
        if out_runs and t - out_runs[-1][1] <= 1.5 / fps:
            r = out_runs[-1]
            out_runs[-1] = (r[0], t, max(r[2], v, key=lambda x: x[0]))
        else:
            out_runs.append((t, t, v))
    return out_runs


build_sh = open(os.path.join(proj, "build.sh")).read() if os.path.isfile(os.path.join(proj, "build.sh")) else ""


def shell_value(word, i):
    """A ../build.sh word for shot i: a literal, $VAR, ${VAR} or ${VAR[$i]} (VAR from the environment, else its first assignment); None when unresolvable."""
    word = word.strip("\"'")
    m = re.fullmatch(r"\$\{?(\w+)(\[\$i\])?\}?", word)
    if m:
        raw = os.environ.get(m.group(1))
        if raw is None:
            v = re.escape(m.group(1))
            hit = re.search(rf"(?<![\w$]){v}=(?:\(\$\{{{v}:-([^}}]*)\}}\)|\(([^)]*)\)|\$\{{{v}:-([^}}]*)\}}|(\S+))", build_sh)
            if not hit:
                return None
            raw = next(g for g in hit.groups() if g is not None)
        words = raw.split()
        if m.group(2) and i >= len(words):
            return None
        word = words[i] if m.group(2) else raw
    word = word.replace("${PWD}", proj).replace("$PWD", proj).replace("${HOME}", os.path.expanduser("~")).replace("$HOME", os.path.expanduser("~"))
    return None if "$" in word else os.path.expanduser(word)


def build_setting(name, i=0):
    """NAME=<word> from ../build.sh resolved for shot i, None when unset or unresolvable."""
    m = re.search(rf"(?<![\w$]){name}=(\S+)", build_sh)
    return shell_value(m.group(1), i) if m else None


def mat3(nd, rot=None):
    """Row-major 3x3 linear part of node nd, with rotation rot when given."""
    return [row[:3] for row in glb.node_matrix({**nd, "rotation": rot} if rot else nd)[:3]]


def mul3(p, q):
    return [[sum(p[r][j] * q[j][c] for j in range(3)) for c in range(3)] for r in range(3)]


def inv3(m):
    """Inverse of a 3x3 matrix, None when singular."""
    c = [[m[(r + 1) % 3][(k + 1) % 3] * m[(r + 2) % 3][(k + 2) % 3] - m[(r + 1) % 3][(k + 2) % 3] * m[(r + 2) % 3][(k + 1) % 3]
          for r in range(3)] for k in range(3)]
    det = sum(m[0][k] * c[k][0] for k in range(3))
    return None if abs(det) < 1e-12 else [[c[r][k] / det for k in range(3)] for r in range(3)]


def shear_ratio(m):
    """sigma max / sigma min of a 3x3 matrix (1 for a rotation times a uniform scale)."""
    g = [[sum(m[k][r] * m[k][c] for k in range(3)) for c in range(3)] for r in range(3)]
    q = (g[0][0] + g[1][1] + g[2][2]) / 3
    off = g[0][1] ** 2 + g[0][2] ** 2 + g[1][2] ** 2
    p = math.sqrt((sum((g[i][i] - q) ** 2 for i in range(3)) + 2 * off) / 6)
    if p < 1e-12:
        return 1.0
    b = [[(g[r][c] - (q if r == c else 0)) / p for c in range(3)] for r in range(3)]
    det = b[0][0] * (b[1][1] * b[2][2] - b[1][2] * b[2][1]) - b[0][1] * (b[1][0] * b[2][2] - b[1][2] * b[2][0]) + b[0][2] * (b[1][0] * b[2][1] - b[1][1] * b[2][0])
    phi = math.acos(max(-1.0, min(1.0, det / 2))) / 3
    hi, lo = q + 2 * p * math.cos(phi), q + 2 * p * math.cos(phi + 2 * math.pi / 3)
    return math.sqrt(hi / lo) if lo > 1e-12 else math.inf


def root_chains(nodes, parent, joints):
    """[(terminal, [node indices scene root..terminal])]: the top skin joints' child joints (or the top joints), else the scene roots' children."""
    tops = [j for j in sorted(joints) if parent.get(j) not in joints] or [i for i in range(len(nodes)) if i not in parent]
    out = []
    for top in tops:
        for end in [c for c in nodes[top].get("children", []) if c in joints or not joints] or [top]:
            chain, i = [], end
            while i is not None:
                chain.insert(0, i)
                i = parent.get(i)
            out.append((end, chain))
    return out


def glb_clips(path):
    """(channel count, {clip: (start s, length s, [(rest scale, key times, key values, interpolation)], [(joint, parent world 3x3, rest translation, key times, key values, interpolation)], [(node name, chain nodes, rest world^-1, {node: (key times, key values, interpolation)})])}, rest rig height, nodes) of a .glb via lib/glb.py; the second list holds translation keys of leaf skin joints (no child joint: IK targets), the third rotation keys on root chains."""
    gltf, bin_ = glb.load(path)
    nodes = gltf.get("nodes", [])
    parent = {c: i for i, nd in enumerate(nodes) for c in nd.get("children", [])}
    world = glb.node_matrices(gltf)
    joints = {j for sk in glb.skins(gltf) for j in sk["joints"]}
    leaves = {j for j in joints if not joints.intersection(nodes[j].get("children", []))}
    ys = [world[j][1][3] for j in joints]
    rig = max(ys) - min(ys) if ys else 0.0
    chains = []
    for end, chain in root_chains(nodes, parent, joints):
        rest = mat3(nodes[chain[0]])
        for i in chain[1:]:
            rest = mul3(rest, mat3(nodes[i]))
        inv = inv3(rest)
        if inv:
            chains.append((nodes[end].get("name", f"node{end}"), chain, inv))
    total, clips = 0, {}
    for clip in glb.clips(gltf, bin_):
        chans, moves = [], []
        rots = {ch["node"]: (ch["times"], ch["values"], ch["interpolation"]) for ch in clip["channels"] if ch["path"] == "rotation"}
        shears = [(name, chain, inv, {i: rots[i] for i in chain if i in rots}) for name, chain, inv in chains if rots.keys() & set(chain)]
        for ch in clip["channels"]:
            node = ch["node"]
            if ch["path"] == "translation" and node in leaves and node in parent and rig > 0:
                lin = [row[:3] for row in world[parent[node]][:3]]
                moves.append((nodes[node].get("name", f"node{node}"), lin, nodes[node].get("translation", [0, 0, 0]),
                              ch["times"], ch["values"], ch["interpolation"]))
            if ch["path"] == "scale" and node is not None:
                chans.append((nodes[node].get("scale", [1.0, 1.0, 1.0]), ch["times"], ch["values"], ch["interpolation"]))
        total += len(chans) + len(moves) + len({i for sh in shears for i in sh[3]})
        clips[clip["name"]] = (clip["start"], clip["length"], chans, moves, shears)
    return total, clips, rig, nodes


def scale_at(times, values, interp, t):
    """Value of one VEC3 channel at clip time t; CUBICSPLINE keys are read as linear."""
    if interp == "CUBICSPLINE":
        values = values[1::3]
    j = bisect.bisect_right(times, t)
    if j == 0 or j == len(times) or interp == "STEP":
        return values[max(j - 1, 0)]
    u = (t - times[j - 1]) / (times[j] - times[j - 1])
    return [values[j - 1][i] + (values[j][i] - values[j - 1][i]) * u for i in range(3)]


def quat_at(times, values, interp, t):
    """Unit quaternion of one rotation channel at clip time t (slerp; CUBICSPLINE keys are read as linear)."""
    if interp == "CUBICSPLINE":
        values = values[1::3]
    j = bisect.bisect_right(times, t)
    if j == 0 or j == len(times) or interp == "STEP":
        return list(values[max(j - 1, 0)])
    p, q = values[j - 1], values[j]
    u = (t - times[j - 1]) / (times[j] - times[j - 1])
    d = sum(x * y for x, y in zip(p, q))
    if d < 0:
        q, d = [-x for x in q], -d
    th = math.acos(min(1.0, d))
    w = (1 - u, u) if th < 1e-6 else (math.sin((1 - u) * th) / math.sin(th), math.sin(u * th) / math.sin(th))
    v = [w[0] * x + w[1] * y for x, y in zip(p, q)]
    n = math.sqrt(sum(x * x for x in v))
    return [x / n for x in v]


def cue_seconds(name, i):
    """Seconds of mark `name` in ../build.sh's MV_CUES (clips.*.marks), None when unresolvable."""
    path = build_setting("MV_CUES", i)
    cues = load(path, {}) if path else {}
    return next((float(t) for c in cues.get("clips", {}).values() for k, t in (c.get("marks") or {}).items() if k == name), None)


def model_track():
    """Squash lookup (shot, shot frame) -> (log drift, axis, ratio) or None from the ../build.sh hero .glb as shot.py loops its clips; (lookup, glb has no scale channel)."""
    model = build_setting("MV_MODEL")
    if not model:
        return None, False
    if not os.path.isfile(model):
        notes.append(f"n/a: MV_MODEL {model} (no such file)")
        return None, False
    try:
        total, clips, rig, gnodes = glb_clips(model)
    except (OSError, ValueError, KeyError, IndexError) as e:
        print(f"mv-layout: unreadable MV_MODEL {model}: {e}", file=sys.stderr)
        sys.exit(2)
    if not total:
        notes.append(f"scale: glb has no scale channel, leaf-joint translation or root-chain rotation keys ({model})")
        return None, True
    play, keys = [], {}
    for n, s in enumerate(shots):
        name = build_setting("MV_MODEL_ANIM", n)
        name = next(iter(clips), None) if name == "first" else name
        if name and name not in clips:
            notes.append(f"n/a: MV_MODEL_ANIM {name} not in {model} (shot {n} rest pose)")
        if not name or name not in clips:
            play.append(None)
            continue
        t0, length, chans, moves, shears = clips[name]
        keys[name] = sum(len(c[1]) for c in chans) + sum(len(m[3]) for m in moves) + sum(len(r[0]) for r in {i: r for sh in shears for i, r in sh[3].items()}.values())
        speed = float(build_setting("MV_MODEL_ANIM_SPEED", n) or 1.0)
        cue = build_setting("MV_MODEL_ANIM_CUE", n) or build_setting("MV_TITLE_CUE", n)
        span = len(s["frames"]) - 1
        if cue:
            at = cue_seconds(cue, n)
            if at is None:
                notes.append(f"n/a: MV_MODEL_ANIM_CUE {cue} (MV_CUES marks; shot {n} loops to its end)")
            else:
                span = at * fps
        loop = length * fps
        stretch = span / (max(1, round(span * speed / loop)) * loop) if loop > 0 and span > 0 else 1.0
        play.append((t0, loop, stretch, chans, moves, shears))
    notes.append(f"scale: from {model} ({sum(keys.values())} keys)")

    def at(n, k):
        if play[n] is None:
            return None
        t0, loop, stretch, chans, moves, shears = play[n]
        tc = t0 + ((k / stretch) % loop) / fps if loop > 0 else t0
        worst = None
        for rest, times, values, interp in chans:
            v = scale_at(times, values, interp, tc)
            for axis, label in ((0, "sx/sy"), (2, "sz/sy")):
                drift = (v[axis] / v[1]) / (rest[axis] / rest[1])
                if abs(drift - 1) > SQUASH_DRIFT and (worst is None or abs(math.log(drift)) > worst[0]):
                    worst = (abs(math.log(drift)), label, v[axis] / v[1])
        for joint, lin, rest, times, values, interp in moves:
            d = [p - q for p, q in zip(scale_at(times, values, interp, tc), rest)]
            off = math.sqrt(sum(sum(lin[r][c] * d[c] for c in range(3)) ** 2 for r in range(3))) / rig
            if off > SQUASH_DRIFT and (worst is None or math.log1p(off) > worst[0]):
                worst = (math.log1p(off), f"{joint} keyed off rest by", off)
        for name, chain, inv, rots in shears:
            m = mat3(gnodes[chain[0]], quat_at(*rots[chain[0]], tc) if chain[0] in rots else None)
            for i in chain[1:]:
                m = mul3(m, mat3(gnodes[i], quat_at(*rots[i], tc) if i in rots else None))
            r = shear_ratio(mul3(m, inv))
            if r - 1 > SQUASH_DRIFT and (worst is None or math.log(r) > worst[0]):
                worst = (math.log(r), f"{name} shear", r)
        return worst
    return at, False


subj = plan.get("subject") or {}
mh = float(plan.get("model_height") or os.environ.get("MV_MODEL_HEIGHT") or build_setting("MV_MODEL_HEIGHT") or "2.0")
lo, hi = subj.get("min", [-mh / 4, -mh / 4, 0.0]), subj.get("max", [mh / 4, mh / 4, mh])
centre = [(lo[i] + hi[i]) / 2 for i in range(3)]


def template_titles():
    """The film template's Title.tsx boxes (centre title over spans[0], lower third over spans[1]) as frame fractions."""
    spans = load(os.path.join(out, "spans.json"))
    brand = load(os.path.join(proj, "brand.json"), {})
    text = plan.get("title") or brand.get("name", "").upper()
    if not spans:
        notes.append("n/a: spans.json (2D title spans)")
        return []
    if not text:
        notes.append("n/a: brand.json name (2D title text)")
        return []
    subtitle = plan.get("subtitle", "A film in three moves")
    fw, fh = (round(H * 9 / 16) // 2 * 2, W) if a.aspect == "9x16" else (W, H)
    s = min(fw / 1920, fh / 1080)
    tw, th, cy = len(text) * (0.70 * 150 + 8 + 6) * s, 1.21 * 150 * s, fh / 2 - 0.28 * fh
    lw = (10 + 22) * s + max(0.66 * 52 * len(text), 0.50 * 30 * len(subtitle)) * s
    lh = max(84, 1.21 * (52 + 30)) * s
    rects = [[fw / 2 - tw / 2, cy - th / 2, fw / 2 + tw / 2, cy + th / 2], [96 * s, fh - 110 * s - lh, 96 * s + lw, fh - 110 * s]]
    return [{"id": i, "t0": sp[0] / fps, "t1": sp[1] / fps, "rect": [r[0] / fw, r[1] / fh, r[2] / fw, r[3] / fh]}
            for i, sp, r in zip(("title", "lower-third"), spans, rects)]


titles = plan.get("titles") or template_titles()
t3 = plan.get("title3d") or {}
t3_shots = t3.get("shots")
if t3_shots is None:
    m = re.search(r"MV_TITLE=\$\(\[\[ \$i == (\d+) \]\]", open(os.path.join(proj, "build.sh")).read()) if os.path.isfile(os.path.join(proj, "build.sh")) else None
    t3_shots = [int(m.group(1))] if m else []
    if not m:
        notes.append("n/a: title3d.shots (layout.json, or MV_TITLE in ../build.sh)")
t3_lo, t3_hi = t3.get("min", TITLE3D_BOX["min"]), t3.get("max", TITLE3D_BOX["max"])
track = subj.get("scale")
glb_at, no_channel = (None, False) if track else model_track()
if not track and not glb_at and not no_channel:
    notes.append("n/a: subject.scale (camera foreshortening only)")


def track_ratio(t):
    """sx/sz of the subject.scale track at t (last key at or before t), 1 without a track."""
    keys = [k for k in track or [] if k[0] <= t]
    return keys[-1][1] / keys[-1][3] if keys else 1.0


over = {ti["id"]: [] for ti in titles}
seen = {n: 0.0 for n in t3_shots}
squash, glb_squash, cam_xy = [], [], []
for n, k, t, project, right in frames():
    rect = box_rect(project, lo, hi)
    if rect:
        for ti in titles:
            r = ti.get(f"rect_{a.aspect}") or ti["rect"]
            pct = inter(r, rect) / area(r)
            if ti["t0"] - 1e-6 <= t <= ti["t1"] + 1e-6 and pct > TITLE_OVERLAP:
                over[ti["id"]].append((t, (pct, t)))
    if n in seen:
        r3 = box_rect(project, t3_lo, t3_hi)
        if r3:
            seen[n] = max(seen[n], inter(r3, [0, 0, 1, 1]) / area(r3))
    h = [project([centre[0] + right[0] * 0.5 * s, centre[1] + right[1] * 0.5 * s, centre[2]]) for s in (-1, 1)]
    v = [project([centre[0], centre[1], centre[2] + 0.5 * s]) for s in (-1, 1)]
    if None not in h + v:
        hx = math.hypot((h[1][0] - h[0][0]) * W * crop, (h[1][1] - h[0][1]) * H)
        vy = math.hypot((v[1][0] - v[0][0]) * W * crop, (v[1][1] - v[0][1]) * H)
        if (win[0] - 1e-6 <= t <= win[1] + 1e-6) if win else (rect is not None and inter(rect, [0, 0, 1, 1]) > 0):
            cam_xy.append((t, hx / vy))
        ratio = hx / vy * track_ratio(t)
        if ratio > SCALE_MAX or ratio < 1 / SCALE_MAX:
            squash.append((t, (abs(math.log(ratio)), t, ratio)))
    hit = glb_at(n, k) if glb_at else None
    if hit:
        glb_squash.append((t, hit))

if no_channel:
    lens = sorted({float(s["lens"]) for s in shots})
    vw, vw9 = int(H * 9 / 16) // 2 * 2, int(W * 9 / 16) // 2 * 2
    aspect_xy = (vw9 / vw) / (W / H) if a.aspect == "9x16" else 1.0
    found = [(r, f"lens/perspective x/y {r:.2f} at {t:.2f} s") for t, r in sorted(cam_xy, key=lambda x: -abs(math.log(x[1])))[:1]]
    found.append((aspect_xy, f"{a.aspect} scale x/y {aspect_xy:.3f}"))
    causes = [s for r, s in found if r > SCALE_MAX or r < 1 / SCALE_MAX]
    drift = [s for r, s in found if abs(r - 1) > SQUASH_DRIFT and s not in causes]
    xy = f"{min(r for _, r in cam_xy):.2f}-{max(r for _, r in cam_xy):.2f}" if cam_xy else "n/a"
    span = f"{win[0]:.2f}-{win[1]:.2f}" if win else (f"{min(t for t, _ in cam_xy):.2f}-{max(t for t, _ in cam_xy):.2f}" if cam_xy else "n/a")
    notes.append(f"camera {span} s: lens {'-'.join(f'{x:g}' for x in lens)} mm, x/y {xy}, {a.aspect} scale x/y {aspect_xy:.3f}: "
                 + ("; ".join(x for x in ("cause " + ", ".join(causes) if causes else "", "note " + ", ".join(drift) if drift else "") if x)
                    or "no lens/aspect cause"))
for tid, hits in over.items():
    for t0, t1, (pct, _) in runs(hits):
        fails.append(f"FAIL title {tid} over subject {t0:.2f}–{t1:.2f} s ({pct * 100:.0f}% overlap)")
for n, frac in seen.items():
    if frac < TITLE3D_SEEN:
        fails.append(f"FAIL shot {n} has no 3D title ({frac * 100:.0f}% of its box in frame at best)")
for t0, _t1, (_, _t, ratio) in runs(squash):
    fails.append(f"FAIL subject scale x/y {ratio:.2f} at {t0:.2f} s")
for t0, t1, (_, label, ratio) in runs(glb_squash):
    fails.append(f"FAIL squash {t0:.2f}-{t1:.2f} s: {label} {ratio:.2f}" + (" rig heights (IK-target keys collapse the chain)" if " by" in label else ""))
for line in notes + fails:
    print(line)
if not fails:
    print(f"PASS layout {a.aspect}: {len(shots)} shots, {len(titles)} 2D titles, {len(t3_shots)} 3D titles, subject {lo}..{hi}")
sys.exit(1 if fails else 0)
