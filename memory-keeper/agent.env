MODEL=opus
SCHEDULE="*-*-* 04:10"
ENABLED=yes
AGENT_TOOLS=Bash,Read,Edit,Write
# Run only when the inbox holds a note, a project source changed, or it is Sunday (the weekly pass); else agent-run skips.
PRECHECK='[ "$(date +%u)" = 7 ] || compgen -G "$MEMORY_HOME/inbox/*.md" >/dev/null || [ -n "$(memory sources --changed 2>&1 || echo failed)" ]'
export MEMORY_DOMAINS=machine
