{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notes-file apply plan",
  "type": "object",
  "required": ["actions"],
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["op", "file", "text"],
        "additionalProperties": false,
        "properties": {
          "op": {"enum": ["append", "create"]},
          "file": {"type": "string", "minLength": 4},
          "heading": {"type": "string", "minLength": 1, "maxLength": 120},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "sure": {"type": "boolean"},
          "tags": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
        }
      }
    },
    "refined": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["file", "gist"],
        "additionalProperties": false,
        "properties": {
          "at": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
          "file": {"type": "string", "minLength": 4},
          "heading": {"type": "string", "minLength": 1, "maxLength": 120},
          "gist": {"type": "string", "minLength": 1, "maxLength": 400},
          "sure": {"type": "boolean"}
        }
      }
    }
  }
}
