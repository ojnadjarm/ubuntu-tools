[Unit]
Description=Persistent agent %i

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/agents/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
WorkingDirectory=%h/agents/%i
ExecStart=%h/agents/bin/agent-run %i
TimeoutStartSec=3600
MemoryMax=8G
Nice=5
