[Unit]
Description=Agents status dashboard (tailnet + LAN, port 19998)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binds 0.0.0.0 + ::; the Tailscale wait is best-effort so a LAN-only boot still starts the page.
ExecStartPre=-/usr/bin/tailscale wait --timeout 60s
ExecStart=/bin/bash -c '. %h/agents/bin/env.sh; exec /usr/bin/python3 %h/agents/dashboard/server.py'
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=default.target
