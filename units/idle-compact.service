[Unit]
Description=Compact idle Claude sessions in tmux before the prompt cache expires (T1657)

[Service]
Type=oneshot
TimeoutStartSec=420
Environment=PATH=%h/agents/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c '. %h/agents/bin/env.sh; exec %h/agents/bin/idle-compact --apply'
