[Unit]
Description=Discord liaison relay (post the managers' outbox replies now, T1515 P40)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/agents/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Nice=5
TimeoutStartSec=300
ExecStart=%h/agents/bin/discord-liaison relay
