[Unit]
Description=Nightly encrypted restic backup of laptop-only data to the USB stick (fleet-backup nightly: the system unit fleet-backup-run.service gets the password from the vault, T1634-V9; absent stick = logged skip; T1580)

[Service]
Type=oneshot
TimeoutStartSec=14400
Slice=fleet-heavy.slice
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
Environment=PATH=%h/agents/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/agents/bin/fleet-backup nightly
