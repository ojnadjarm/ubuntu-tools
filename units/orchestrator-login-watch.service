[Unit]
Description=Orchestrator login watch: push the owner when the orchestrator loses its Claude login (T1436)

[Service]
Type=oneshot
TimeoutStartSec=60
Environment=PATH=%h/agents/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c '. %h/agents/bin/env.sh; exec %h/agents/bin/orchestrator-login-watch'
