[Unit]
Description=Discord forum bot "agents" (sandboxed bot + job runner, T348)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/agents/discord-bot/bin/serve
Restart=on-failure
RestartSec=60
SuccessExitStatus=143
MemoryMax=400M

[Install]
WantedBy=default.target
