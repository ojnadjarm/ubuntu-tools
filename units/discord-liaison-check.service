[Unit]
Description=Discord liaison check (REST poll; starts the LLM run only on new forum messages, T1409)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/agents/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Nice=5
TimeoutStartSec=2100
ExecStart=%h/agents/bin/discord-liaison tick
