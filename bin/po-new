#!/usr/bin/env bash
# usage: po-new <p> "<Project name>" [--parent <seat>] — make the product-owner agent ~/agents/po-<p> from ~/agents/po-template:
# BRIEF.md (fill its "## Project" block next), agent.env, inbox/ current/ outbox/discord/, $PO_PAPERS/<p>/done/,, state/PROJECT|BACKLOG|RUNS|HISTORY.md.
# --parent: a manager under that PO seat (MANAGER.tmpl.md, PARENT=<seat> in agent.env; `{{PROJECT}}` left to fill, T1515 P31).
# Refuses (exit 3) when po-<p> exists. Prints the unit command that wakes it on a request.
help() { awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; }
case "${1:-}" in -h|--help) help; exit 0 ;; '') help >&2; exit 2 ;; esac
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/polib.sh"
p="$1"; name="${2:-$1}"; parent=''
[ "${3:-}" != --parent ] || parent="${4:-}"
case "$parent" in *[!a-z0-9-]*) echo "po-new: --parent takes a seat id [a-z0-9-]" >&2; exit 2 ;; esac
case "$p" in -*|*[!a-z0-9-]*|template) echo "po-new: name must be [a-z0-9-] and not 'template'" >&2; exit 2 ;; esac
case "$name" in *[\|\&\\]*) echo "po-new: project name may not contain | & or \\" >&2; exit 2 ;; esac
tpl="$HARNESS_HOME/po-template"; dir="$HARNESS_HOME/po-$p"
brief="$tpl/BRIEF.tmpl.md"; [ -z "$parent" ] || brief="$tpl/MANAGER.tmpl.md"
[ -r "$brief" ] || { echo "po-new: no template at $tpl" >&2; exit 1; }
[ ! -e "$dir" ] || { echo "po-new: $dir exists" >&2; exit 3; }
fill() { sed -e "s|{{P}}|$p|g" -e "s|{{NAME}}|$name|g" -e "s|{{PARENT}}|po-$parent|g" "$1"; }
mkdir -p "$dir/inbox" "$dir/current" "$(po_done "$p")" "$dir/outbox/discord" "$dir/state/picks" "$dir/logs"
fill "$brief" >"$dir/BRIEF.md"
cp "$tpl/agent.env" "$dir/agent.env"
[ -z "$parent" ] || printf 'PARENT=%s        # manager: ESCALATE lines go to po-%s (po-run), no chat seat\n' "$parent" "$parent" >>"$dir/agent.env"
for f in PROJECT BACKLOG RUNS HISTORY; do fill "$tpl/$f.md" >"$dir/state/$f.md"; done
echo "made $dir; fill the '## Project' block of BRIEF.md, then: pc units enable po@$p.path --user --now --apply"
[ -n "$parent" ] || echo "then give its org.json seat an \"about\": 1-2 plain sentences on what $name is (the Org pop-up shows it)"
