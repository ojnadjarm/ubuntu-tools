#!/usr/bin/env python3
"""memory — load the core card plus domain cards, drop a note in the inbox, check the store, install the carriers, run the keeper's verbs (sources, stage, apply), or recall and show what a prompt stirs; the store is $MEMORY_HOME (T1599)."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import memory_check  # noqa: E402
import memory_quiz  # noqa: E402
import memory_route  # noqa: E402
import memory_store  # noqa: E402


ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LIVE_N = 5


def carrier():
    """The agent CLI's memory carrier module: adapters/$HARNESS_AGENT/memory-carrier (default claude)."""
    path = os.path.join(ROOT, "adapters", os.environ.get("HARNESS_AGENT") or "claude", "memory-carrier")
    if not os.path.isfile(path):
        die(f"no memory carrier at {path}")
    loader = importlib.machinery.SourceFileLoader("memory_carrier", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def seat(store):
    """CHAT_SEAT, except that an owner seat inherited by a worker (sub-agent, headless run) counts as no seat."""
    s = os.environ.get("CHAT_SEAT", "")
    if s and memory_route.source_for(s, True, store) == "owner" and carrier().is_worker():
        return ""
    return s


def die(msg):
    print(f"memory: {msg}", file=sys.stderr)
    sys.exit(2)


def unknown(store, domains):
    bad = [d for d in domains if d not in store.domains()]
    if bad:
        die(f"unknown domain {', '.join(bad)} (not in domains.map)")


def load(store, seat, args):
    """Print the core card, then each domain's card, ids stripped; a PRIVATE page only for its seats."""
    domains = args.domains or memory_route.domains_for(os.getcwd(), seat, os.environ, store)
    if args.domains:
        unknown(store, domains)
    out = []
    for name in ["core"] + domains:
        page = store.card(name)
        if not os.path.isfile(store.path(page)):
            continue
        seats = store.private_seats(page)
        if seats is not None and seat not in seats:
            print(f"memory: skipped {page} (private to {', '.join(sorted(seats))})", file=sys.stderr)
            continue
        out.append(f"# memory: {name}\n" + memory_store.strip_ids(store.text(page)).rstrip("\n"))
    if out:
        print("\n\n".join(out))


def note(store, seat, args):
    """Write one inbox note; the source is stamped here from the seat, never by the writer."""
    if args.domain:
        unknown(store, [args.domain])
    fields = [("source", memory_route.source_for(seat, args.quote is not None, store)), ("seat", seat or "-"),
              ("domain", args.domain or "-"), ("date", time.strftime("%Y-%m-%dT%H:%M:%S%z")),
              ("session", os.environ.get("CLAUDE_CODE_SESSION_ID") or "-"), ("text", " ".join(args.text.split()))]
    if args.quote is not None:
        fields.append(("quote", json.dumps(args.quote, ensure_ascii=False)))
    try:
        print(os.path.relpath(store.add_note(fields), store.root))
    except ValueError as e:
        die(str(e))


def check(store, seat, args):
    """Run every checker; exit 0 clean, 1 with one line per finding (checker · file:line · what). `--recall`: the recall table alone."""
    if args.recall:
        import memory_recall_check
        out, ok = memory_recall_check.run(store)
        print("\n".join(out))
        sys.exit(0 if ok else 1)
    folders = []
    for f in args.folders:
        rel = os.path.relpath(store.path(f) if os.path.isdir(store.path(f)) else os.path.abspath(f), store.root)
        if rel.startswith("..") or not os.path.isdir(store.path(rel)):
            die(f"{f} is not a folder of the store {store.root}")
        folders.append(rel)
    before = memory_check.before_dir(args.before) if args.before else memory_check.before_git(store)
    found = memory_check.run(store, before, folders, ["quiz-changed" if args.changed else "quiz"] if args.quiz else [])
    for f in found:
        print(memory_check.fmt(f))
    score = live(store, args.domains) if args.live else LIVE_N
    sys.exit(1 if found or score < LIVE_N else 0)


def questions(store, domains):
    """[(where, question, [must words])]: checks/questions.tsv, else checks/questions.d/*.tsv (private-* left out), for core + domains."""
    tsv = store.path("checks/questions.tsv")
    qd = store.path("checks/questions.d")
    files = [tsv] if os.path.isfile(tsv) else sorted(
        os.path.join(qd, f) for f in (os.listdir(qd) if os.path.isdir(qd) else [])
        if f.endswith(".tsv") and not f.startswith("private-"))
    out = []
    for path in files:
        stem = os.path.basename(path)[:-4] if path != tsv else None
        with open(path, encoding="utf-8") as f:
            rows = [l.rstrip("\n").split("\t") for l in f]
        head = [c.strip().lower() for c in rows[0]] if rows else []
        named = "question" in head and "must" in head
        for n, r in enumerate(rows[1:] if named else rows, 2 if named else 1):
            if named:
                cell = dict(zip(head, r))
                q, must, dom = cell.get("question", ""), cell.get("must", ""), cell.get("domain") or stem
            else:
                i = next((i for i, c in enumerate(r) if c.strip().endswith("?")), None)
                if i is None or i + 1 >= len(r):
                    continue
                q, must, dom = r[i], r[i + 1], stem
            words = [w.strip() for w in re.split(r"[|;,]", must) if w.strip()]
            if q.strip() and words and dom in (None, "core", *domains):
                out.append((f"{os.path.relpath(path, store.root)}:{n}", q.strip(), words))
    return out


def loaded(domains):
    """The text `memory load` gives a worker the carrier starts with these domains (same env, a fresh cwd); "" when it fails."""
    env = dict(os.environ, MEMORY_DOMAINS=",".join(domains), MEMORY_WORKER="1")
    with tempfile.TemporaryDirectory(prefix="memory-live.") as t:
        r = subprocess.run([os.path.realpath(__file__), "load"], env=env, cwd=t, capture_output=True, text=True, timeout=60)
    return r.stdout if r.returncode == 0 else ""


def norm(text):
    return " ".join(text.lower().split())


def live(store, domains):
    """5 quiz questions the loaded cards answer, through one real headless agent fed by the carrier; majority-of-3 on reds."""
    car = carrier()
    for f, ok in car.verify(store):
        print(f"approval · {car.tilde(f)} · {'yes' if ok else 'no'}")
    text = norm(loaded(domains))
    qs = [memory_quiz.Q(where, "", "", "", q, words) for where, q, words in questions(store, domains)
          if all(norm(w) in text for w in words)]
    if len(qs) < LIVE_N:
        print(f"live · only {len(qs)} questions for core{''.join(' ' + d for d in domains)}, need {LIVE_N}")
        return 0
    pick = [qs[i * len(qs) // LIVE_N] for i in range(LIVE_N)]

    def ask(store_, part, used):
        prompt = ("Closed-book quiz. Answer only from what your system prompt already tells you; use no tool.\n"
                  f"Reply with exactly {len(part)} lines, each `<number>: <short answer>`.\n\n"
                  + "\n".join(f"{i}: {q.question}" for i, q in enumerate(part, 1)))
        out, tokens = car.ask_usage(prompt, domains)
        used.update(tokens, calls=1)
        got = memory_quiz.answers(out)
        return {q.key: [w for w in q.must if norm(w) not in got.get(i, "")] for i, q in enumerate(part, 1)}

    miss = memory_quiz.vote(store, pick, ask)
    for q in pick:
        if miss[q.key]:
            print(f"live · {q.key} · missing: {', '.join(miss[q.key])}")
    score = sum(not miss[q.key] for q in pick)
    print(f"live · {score}/{LIVE_N}")
    return score


def install(store, seat_, args):
    """Write every carrier for this agent CLI (idempotent; --plan writes nothing)."""
    sys.exit(carrier().install(store, args.plan))


def sources(store, seat_, args):
    """Print the project files the keeper may read: domain<TAB>path<TAB>protected|-."""
    import memory_sources
    for d, p, prot in memory_sources.sources(store, args.changed, args.mark):
        print(f"{d}\t{memory_sources.tilde(p)}\t{'protected' if prot else '-'}")
    if args.mark:
        print(f"memory sources: marked every source file as read ({memory_sources.tilde(memory_sources.state_file())})", file=sys.stderr)


def stage(store, seat_, args):
    """Print the path of a new staging copy of the store."""
    import memory_txn
    print(memory_txn.stage(store))


def apply(store, seat_, args):
    """Gate a staging copy and move it in (exit 0 green, 1 red, 2 not a staging folder)."""
    import memory_txn
    sys.exit(memory_txn.apply(store, args.staging, carrier()))


def net(store, seat_, args):
    """`net build [folder]` compiles the graph into a store folder (`memory apply` runs it); `net stats` prints its size."""
    import memory_net
    if args.net == "build":
        target = memory_store.Store(args.folder) if args.folder else store
        pub, priv = memory_net.build(target)
        print(f"net · built · {len(pub.mem)} public and {len(priv.mem)} private memories under {target.path(memory_net.NET)}")
        return
    g = memory_net.load(store)
    src = memory_net.PUBLIC if g else "the store, in memory (not built yet)"
    g = g or memory_net.born(store, private=False)[0]
    print(f"net · {src} · " + " · ".join(f"{k} {v}" for k, v in memory_net.stats(g).items()))


def recall(store, seat_, args):
    """Print the hints a prompt stirs (`--hook`: Claude Code's stdin JSON, any failure is silence and exit 0)."""
    import memory_recall
    if args.hook:
        try:
            if os.environ.get("MEMORY_RECALL_DONE"):
                return
            d = json.load(sys.stdin)
            worker = bool(d.get("agent_id")) or carrier().is_worker()
            s = "" if worker and memory_route.owner_seat(seat_, store) else seat_
            ctx = memory_recall.Context(d.get("cwd") or os.getcwd(), s, worker, d.get("session_id"))
            block = memory_recall.recall(store, d.get("prompt") or "", ctx).block
        except (Exception, SystemExit):
            return
        sys.stdout.write(block)
        return
    if args.file:
        with open(args.file, encoding="utf-8") as f:
            text = f.read()
    else:
        text = " ".join(args.words)
    ctx = memory_recall.Context(os.getcwd(), seat_, carrier().is_worker(),
                                os.environ.get("CLAUDE_CODE_SESSION_ID") if args.file else None)
    r = memory_recall.recall(store, text, ctx, write=bool(args.file) and not (args.explain or args.json))
    if args.json:
        print(json.dumps({"block": r.block, "cues": [c for c, _ in r.cues], "hints": [
            {"id": f.id, "place": f.place, "activation": f.activation, "why": None if f.id in r.private else list(f.path)}
            for f in r.firings]}))
        return
    sys.stdout.write(r.block)
    if args.explain:
        print("cues · " + (" ".join(c for c, _ in r.cues) or "-"))
        for f in r.firings:
            print(f"^{f.id} · {f.place} · {f.activation}" + ("" if f.id in r.private else " · " + " | ".join(f.path)))


def show(store, seat_, args):
    """Print a memory's line and page; a PRIVATE page only to its seats, as `memory load` does."""
    mid = args.id.lstrip("^")
    for page in store.pages():
        seats = memory_route.seats_of(store, page)
        if seats is not None and seat_ not in seats:
            continue
        for n, l in enumerate(store.lines(page), 1):
            if l.id == mid:
                print(f"^{mid} · {page}:{n}\n{memory_store.strip_ids(l.raw).strip()}")
                if l.topic:
                    print(f"→ {os.path.dirname(page)}/{l.topic}.md")
                return
    die(f"no memory ^{mid} you may read")


def main():
    ap = argparse.ArgumentParser(prog="memory", description=__doc__.split("— ", 1)[1])
    sub = ap.add_subparsers(dest="verb", required=True)
    p = sub.add_parser("load", help="print core + domain cards (no domain: routed by folder, seat, MEMORY_DOMAINS)")
    p.add_argument("domains", nargs="*")
    p = sub.add_parser("note", help="drop one lesson (at most 1,024 B) in the inbox")
    p.add_argument("--domain")
    p.add_argument("text")
    p.add_argument("--quote", help="the exact words it rests on")
    p = sub.add_parser("check", help="the gate: budgets, ids, format, secrets, machine values, untrusted, provenance, experience")
    p.add_argument("--before", help="the store folder to compare ids against (default: the store's git HEAD)")
    p.add_argument("folders", nargs="*", help="check only these folders of the store")
    p.add_argument("--live", action="store_true", help=f"then ask {LIVE_N} quiz questions through one real headless agent (haiku)")
    p.add_argument("--quiz", action="store_true", help="also the closed-book quiz (haiku): a question green in checks/quiz-baseline.tsv that turns red")
    p.add_argument("--changed", action="store_true", help="--quiz: only the questions of pages changed since --before (default: git HEAD)")
    p.add_argument("--domains", type=lambda v: [d for d in re.split(r"[\s,]+", v) if d], default=[],
                   help="--live: the domains the agent gets besides core (comma-separated)")
    p.add_argument("--recall", action="store_true", help="instead: the recall network against plain word match on the quiz and "
                   "checks/cues.d cues; exit 1 when the ship gate is not met")
    p = sub.add_parser("install", help="write the carriers: the core line, project stubs, MEMORY.md, agent.env domains")
    p.add_argument("--plan", action="store_true", help="print what would be written, write nothing")
    p = sub.add_parser("sources", help="the project files the keeper may read (read-only): domain, path, protected")
    p.add_argument("--changed", action="store_true", help="only files new or changed since the last --mark")
    p.add_argument("--mark", action="store_true", help="remember every file's sha256 now (outside the store)")
    sub.add_parser("stage", help="copy the store to a new staging folder and print its path")
    p = sub.add_parser("apply", help="the keeper's commit: owner edits first, gate, move in, notes filed, views, commit, guarded push")
    p.add_argument("staging")
    p = sub.add_parser("net", help="the recall network: build the graph, print its size")
    nv = p.add_subparsers(dest="net", required=True)
    nv.add_parser("build", help="compile net/graph.json + graph.private.json (git-ignored)").add_argument("folder", nargs="?")
    nv.add_parser("stats", help="nodes and links of the public graph (built, else compiled in memory)")
    p = sub.add_parser("recall", help="the hints a prompt stirs in the network (at most 3 lines, or nothing)")
    src = p.add_mutually_exclusive_group()
    src.add_argument("--hook", action="store_true", help="read Claude Code's UserPromptSubmit JSON on stdin; never fails")
    src.add_argument("--file", help="the prompt is this file (headless runs)")
    p.add_argument("--explain", action="store_true", help="also print the cues and each firing's activation and paths")
    p.add_argument("--json", action="store_true", help="the block, cues and firings as JSON")
    p.add_argument("words", nargs="*", help="the prompt (a dry run: no session state, no event row)")
    sub.add_parser("show", help="a memory's line and page").add_argument("id")
    args = ap.parse_args()
    store = memory_store.Store(memory_store.home())
    if args.verb == "check" and args.domains:
        unknown(store, args.domains)
    {"load": load, "note": note, "check": check, "install": install, "sources": sources, "stage": stage,
     "apply": apply, "net": net, "recall": recall, "show": show}[args.verb](store, seat(store), args)


if __name__ == "__main__":
    main()
