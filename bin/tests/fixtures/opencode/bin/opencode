#!/usr/bin/env bash
# Fixture opencode: replays a recorded `run --format json` stream (opencode 1.18.29).
# It also echoes the argv it was given to $OC_ARGV_OUT so the test can assert the flags.
[ -n "${OC_ARGV_OUT:-}" ] && printf '%s\n' "$@" >"$OC_ARGV_OUT"
cat "$(dirname "$(readlink -f "$0")")/../events.jsonl"
exit "${OC_EXIT:-0}"
