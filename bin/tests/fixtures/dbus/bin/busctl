#!/usr/bin/env bash
# Recorded busctl for the pc-dbus tests: replays ../resp/<sha1 of the argv> (see record.sh).
d="$(cd "$(dirname "$(readlink -f "$0")")/../resp" && pwd)"
k=$(printf '%s\0' "$@" | sha1sum | cut -c1-16)
[ -r "$d/$k" ] || { printf 'fixture busctl: nothing recorded for: %s\n' "$*" >&2; exit 70; }
cat "$d/$k"
