#!/usr/bin/env python3
"""Stub model for the quiz test: answers every question with its whole context (memory load + the memory pages), no model.
QUIZ_DROP=<word> QUIZ_DROP_N=<n>: the first n calls that hold the word answer without it (a noisy model); meta.json = 100/10 tokens."""
import json
import os
import re
import subprocess
import sys

prompt = sys.stdin.read()
pages = re.search(r"<memory-pages>(.*?)</memory-pages>", prompt, re.S).group(1)
load = subprocess.run(["memory", "load"], capture_output=True, text=True).stdout
ctx = " ".join((load + " " + pages).split())
qs = re.findall(r"^(\d+): (.*)$", re.search(r"<questions>(.*?)</questions>", prompt, re.S).group(1), re.M)
with open(os.environ["QUIZ_LOG"], "a", encoding="utf-8") as log:
    log.write("".join(f"{os.environ.get('MEMORY_DOMAINS') or 'core'}\t{q}\n" for _, q in qs))
drop = os.environ.get("QUIZ_DROP", "")
if drop and drop in ctx:
    seen = os.environ["QUIZ_LOG"] + ".drop"
    n = len(open(seen).read()) if os.path.exists(seen) else 0
    with open(seen, "a") as f:
        f.write("x")
    if n < int(os.environ.get("QUIZ_DROP_N", "1")):
        ctx = ctx.replace(drop, "")
with open("meta.json", "w") as f:
    json.dump({"tokens": {"input_tokens": 100, "output_tokens": 10}}, f)
print("\n".join(f"{n}: {ctx}" for n, _ in qs))
