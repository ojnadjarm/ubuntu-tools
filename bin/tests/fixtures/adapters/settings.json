{
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/owner-pre.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/moodle-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "effortLevel": "medium"
}
