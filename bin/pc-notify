#!/bin/bash
# pc notify "msg" [title] — desktop notification on this screen.
. "$(dirname "$(readlink -f "$0")")/env.sh"
[ "${1:-}" = -h ] || [ "${1:-}" = --help ] && { echo 'usage: pc notify "msg" [title]'; exit 0; }
case "${1:-}" in ''|--*) echo 'usage: pc notify "msg" [title]' >&2; exit 2;; esac
exec notify-send "${2:-Claude}" "$1"
