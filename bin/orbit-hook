#!/usr/bin/env python3
"""Subagent hooks → orbiters: SubagentStart lights one and hands the subagent its top `guide` matches and its project's owner decisions, SubagentStop puts it out, sweep puts out the dead.

usage: orbit-hook start|stop   (the hook JSON arrives on stdin)
       orbit-hook sweep        (sentinel-check, every 15 min)
       orbit-hook relabel      (spawned by start when no Agent call names the agent)
       orbit-hook taskstop     (spawned by the PostToolUse audit hook on TaskStop)
Never blocks and never fails: a dead Eye is a silent no-op.
"""
import fcntl
import glob
import json
import os
import subprocess
import sys
import time
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import agent_ends  # noqa: E402
import decisions  # noqa: E402

TIMEOUT = 1.5
LABEL_MAX = 24
SPAWN_WAIT_S = 0.5
RELABEL_WAIT_S = 30
GUIDE_HITS = 3
GUIDE_TIMEOUT = 2
STALE_S = int(os.environ.get("ORBIT_STALE_S") or 1800)
LOST_S = 43200
CLAIMS = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "dark-eye", "orbit-claims.json")
SCANS = os.path.join(os.path.dirname(CLAIMS), "orbit-scans.json")
SPAWNS = os.path.join(os.path.dirname(CLAIMS), "orbit-spawns.json")
SPAWN_TAIL = 2 << 20


def post(state, oid, label=""):
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    cfg = json.load(open(os.path.join(base, "dark-eye", "config.json")))
    body = json.dumps({"id": oid, "state": state, "label": label}).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{cfg.get('port', 8642)}/bridge/status", data=body,
        headers={"Content-Type": "application/json", "x-dark-eye-key": cfg["secret"]})
    urllib.request.urlopen(req, timeout=TIMEOUT).read()


def load():
    try:
        claims = json.load(open(CLAIMS))
        return {k: v for k, v in claims.items() if isinstance(v, dict) and "tx" in v}
    except Exception:
        return {}


def save(claims, path=CLAIMS):
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(claims, f)
        os.replace(tmp, path)
    except Exception:
        pass


def scans(claims, stop=None):
    """{parent transcript: agent_ends scan state} for every claim's parent, read incrementally (offsets kept in SCANS); stop = (transcript, task id) seen now."""
    try:
        memo = json.load(open(SCANS))
    except Exception:
        memo = {}
    now = time.time()
    tps = {c.get("tp") for c in claims.values() if c.get("tp")} | ({stop[0]} if stop else set())
    memo = {tp: agent_ends.scan(tp, memo.get(tp) or agent_ends.memo()) for tp in tps | set(memo)
            if tp in tps or os.path.exists(tp) and now - os.path.getmtime(tp) < LOST_S}
    if stop:
        memo[stop[0]][1].setdefault(stop[1], (now, "stale"))
    save(memo, SCANS)
    return memo


def stopped(c, last, memo):
    """An end signal the agent has not written past: its own or its run's task notification or TaskStop, its journal row, or a resumed run's later same-label start."""
    m = memo.get(c.get("tp")) or agent_ends.memo()
    wf, aid = os.path.dirname(c["tx"]), c.get("aid")
    rid = os.path.basename(wf)
    start = agent_ends.began(c["tx"])
    for tid in [aid] + [t for t, r in m[3].items() if r == rid]:
        t = m[1].get(tid, (0,))[0]
        if t and start <= t and last - t <= agent_ends.SLACK_S:
            return True
    if not rid.startswith("wf_"):
        return False
    done, starts = agent_ends.journal(wf)
    return aid in done or agent_ends.resumed(aid, starts, lambda a: agent_ends.began(os.path.join(wf, f"agent-{a}.jsonl")), last)


def subs_dir(hook):
    """The session's `subagents/` folder."""
    tp = hook.get("transcript_path") or ""
    return os.path.join(tp[:-len(".jsonl")] if tp.endswith(".jsonl") else tp, "subagents")


def subagent_file(hook, agent_id, ext, wide=True):
    """`agent-<id>.<ext>` anywhere under `<session>/subagents/` (workflow agents included), else (`wide`) anywhere in the projects."""
    subs = subs_dir(hook)
    near = os.path.join(subs, f"agent-{agent_id}.{ext}")
    if os.path.exists(near):
        return near
    found = glob.glob(os.path.join(glob.escape(subs), "**", f"agent-{agent_id}.{ext}"), recursive=True) or \
        wide and glob.glob(os.path.expanduser(f"~/.claude/projects/*/*/subagents/**/agent-{agent_id}.{ext}"), recursive=True)
    return found[0] if found else near


def label_for(hook, agent_id, wait):
    """The agent's description from its meta file, which Claude Code writes only after this hook returns; None if still missing after `wait` s."""
    end = time.monotonic() + wait
    while True:
        try:
            desc = json.load(open(subagent_file(hook, agent_id, "meta.json", wide=False))).get("description")
            if desc:
                return str(desc)[:LABEL_MAX]
        except Exception:
            pass
        if time.monotonic() > end:
            return None
        time.sleep(0.05)


def spawn_desc(hook, wait):
    """The description of this agent's Agent call: the oldest pending one in the parent transcript's tail not yet taken (same subagent_type first), polled `wait` s since the row lands just after the hook fires; None if none."""
    end = time.monotonic() + wait
    while True:
        desc = take_spawn(hook)
        if desc or time.monotonic() > end:
            return desc
        time.sleep(0.05)


def take_spawn(hook):
    """One read of spawn_desc()."""
    try:
        with open(hook["transcript_path"], "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - SPAWN_TAIL))
            rows = f.read().decode("utf-8", "replace").splitlines()
        taken = json.load(open(SPAWNS)) if os.path.exists(SPAWNS) else []
    except Exception:
        return None
    calls, done = [], set()
    for row in rows:
        if '"Agent"' not in row and '"tool_result"' not in row:
            continue
        try:
            for c in json.loads(row)["message"]["content"]:
                if c.get("type") == "tool_use" and c.get("name") == "Agent":
                    calls.append(c)
                elif c.get("type") == "tool_result":
                    done.add(c.get("tool_use_id"))
        except Exception:
            continue
    free = [c for c in calls if c.get("id") not in done and c.get("id") not in taken]
    kind = str(hook.get("agent_type") or "")
    pick = next((c for c in free if (c.get("input") or {}).get("subagent_type", "general-purpose") == kind), free[0] if free else None)
    if not pick:
        return None
    save((taken + [pick["id"]])[-200:], SPAWNS)
    return str((pick.get("input") or {}).get("description") or "") or None


def guide_text(desc):
    """Top GUIDE_HITS `guide` matches for the task description; "" when none."""
    try:
        out = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "guide"), desc],
                             capture_output=True, text=True, timeout=GUIDE_TIMEOUT).stdout.splitlines()[:2 * GUIDE_HITS]
    except Exception:
        return ""
    if not out:
        return ""
    return (f"guide (auto, matched on your task description \"{desc}\"; word matches, may be noise):\n" + "\n".join(out) +
            "\nLoad a fitting `→ invoke /name` skill with the Skill tool; run `guide <words>` for more.")


def start_context(desc):
    """The guide matches plus the owner decisions of every project the description names, as SubagentStart additionalContext JSON; "" when none."""
    if not desc:
        return ""
    parts = [t for t in [guide_text(desc)] + [decisions.digest(n) for n in decisions.named(desc)] if t]
    if not parts:
        return ""
    return json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart", "additionalContext": "\n\n".join(parts)}})


def relabel(hook, agent_id, oid):
    """Wait for a late meta file (workflow agents write it only after this hook returns), then re-post the orbiter with its label if still lit."""
    label = label_for(hook, agent_id, RELABEL_WAIT_S)
    if not label:
        return
    with open(CLAIMS + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if oid in load():
            post("working", oid, label)


def sweep(claims, stop=None):
    """An agent is gone when stopped() or when its transcript has not moved for STALE_S; one not found yet is re-resolved and only dropped after LOST_S (the Eye's own 12 h expiry)."""
    now = time.time()
    memo = scans(claims, stop)
    for oid, c in list(claims.items()):
        if not os.path.exists(c["tx"]) and c.get("aid"):
            c["tx"] = subagent_file({"transcript_path": c.get("tp", "")}, c["aid"], "jsonl")
        try:
            last = os.path.getmtime(c["tx"])
            gone = now - last > STALE_S or stopped(c, last, memo)
        except OSError:
            gone = now - c.get("at", 0) > LOST_S
        if gone:
            try:
                post("done", oid)
            except Exception:
                continue
            del claims[oid]


def main():
    verb = (sys.argv[1:2] or ["start"])[0]
    hook = json.load(sys.stdin) if verb != "sweep" else {}
    tid = str((hook.get("tool_input") or {}).get("task_id") or "") if verb == "taskstop" else ""
    agent_id = str(hook.get("agent_id") or "")
    oid = agent_id[:6]
    if agent_id and verb == "relabel":
        return relabel(hook, agent_id, oid)
    if agent_id and verb == "start":
        wait = 0 if os.path.isdir(os.path.join(subs_dir(hook), "workflows")) else SPAWN_WAIT_S
        os.makedirs(os.path.dirname(CLAIMS), mode=0o700, exist_ok=True)
        with open(CLAIMS + ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            desc = spawn_desc(hook, wait)
        ctx = start_context(desc)
        if ctx:
            print(ctx, flush=True)
        label = desc and desc[:LABEL_MAX]
        post("working", oid, label or str(hook.get("agent_type") or "agent")[:LABEL_MAX])
    os.makedirs(os.path.dirname(CLAIMS), mode=0o700, exist_ok=True)
    with open(CLAIMS + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        claims = load()
        if agent_id and verb == "start":
            claims[oid] = {"tx": subagent_file(hook, agent_id, "jsonl", wide=False), "at": time.time(),
                           "aid": agent_id, "tp": hook.get("transcript_path") or ""}
        elif agent_id:
            claims.pop(oid, None)
            save(claims)
            post("done", oid)
        sweep(claims, (hook["transcript_path"], tid) if tid and hook.get("transcript_path") else None)
        save(claims)
    if agent_id and verb == "start" and not label:
        child = subprocess.Popen([os.path.abspath(__file__), "relabel"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        child.stdin.write(json.dumps(hook).encode())
        child.stdin.close()


try:
    main()
except Exception:
    pass  # the Eye being down must never touch the session
