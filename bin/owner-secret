#!/usr/bin/env bash
# owner-secret — store a credential typed with no echo in ~/agents/secrets/<name> (mode 600, atomic), never printing it (T422).
set -uo pipefail
DIR="$HOME/agents/secrets"

usage() {
  cat <<EOF
usage: owner-secret [--replace] <name>   read a secret with no echo (or the first line of piped stdin)
                                         and write $DIR/<name>, mode 600, atomically
       --replace                         overwrite an existing <name>; without it an existing file is refused
       <name>                            letters, digits, . _ - ; no slash, no leading dot
EOF
}

replace=0; name=""
for a in "$@"; do
  case "$a" in
    -h|--help) usage; exit 0;;
    --replace) replace=1;;
    -*) usage >&2; exit 2;;
    *) [ -z "$name" ] || { usage >&2; exit 2; }; name="$a";;
  esac
done
[ -n "$name" ] || { usage >&2; exit 2; }
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "owner-secret: bad name '$name'" >&2; exit 2; }
target="$DIR/$name"
if [ -e "$target" ] && [ "$replace" -eq 0 ]; then
  echo "owner-secret: $target exists; pass --replace to overwrite" >&2; exit 1
fi

if [ -t 0 ]; then
  IFS= read -rs -p "secret for $name (no echo): " value; echo >&2
else
  IFS= read -r value
fi
[ -n "${value:-}" ] || { echo "owner-secret: empty value; nothing written" >&2; exit 1; }

umask 077
mkdir -p "$DIR" && chmod 700 "$DIR" || exit 1
tmp=$(mktemp "$DIR/.$name.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$value" >"$tmp" && chmod 600 "$tmp" || exit 1
unset value
if [ "$replace" -eq 1 ]; then
  mv -f "$tmp" "$target" || exit 1
else
  # ln fails when the target appeared meanwhile: a no-clobber atomic publish.
  ln "$tmp" "$target" 2>/dev/null || { echo "owner-secret: $target exists; pass --replace to overwrite" >&2; exit 1; }
fi
echo "owner-secret: wrote $target (mode 600)"
