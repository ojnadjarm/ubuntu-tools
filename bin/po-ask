#!/usr/bin/env bash
# usage: po-ask <p> [--from owner|orchestrator|liaison|pick] [--channel <ch>] [--thread <id>] [--intent|--copy] "<text>"|-
# Queue one request for the product-owner agent po-<p>: writes po-<p>/inbox/<utc>-<from>-<rand>.md (front matter + the
# verbatim text; `-` reads stdin) and prints its path. The po@<p>.path unit wakes the PO. Exit 2: unknown PO or bad usage.
help() { awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; }
case "${1:-}" in -h|--help) help; exit 0 ;; '') help >&2; exit 2 ;; esac
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/polib.sh"
p="$1"; shift
dir=$(po_dir po-ask "$p") || exit 2
from=orchestrator channel=none thread='' quote=copy
while [ $# -gt 1 ]; do
  case "$1" in
    --from) from="$2"; shift 2 ;;
    --channel) channel="$2"; shift 2 ;;
    --thread) thread="$2"; shift 2 ;;
    --intent) quote=intent; shift ;;
    --copy) quote=copy; shift ;;
    *) break ;;
  esac
done
case "$from" in owner|orchestrator|liaison|pick) ;; *) echo "po-ask: --from must be owner|orchestrator|liaison|pick" >&2; exit 2 ;; esac
case "$channel$thread" in *[!A-Za-z0-9_.-]*) echo "po-ask: --channel/--thread take [A-Za-z0-9_.-] only" >&2; exit 2 ;; esac
[ $# -eq 1 ] || { echo "po-ask: expected one text argument (or -)" >&2; exit 2; }
if [ "$1" = - ]; then text=$(cat); else text="$1"; fi
[ -n "$text" ] || { echo "po-ask: empty request" >&2; exit 2; }

# Written beside the inbox, then renamed in: the path unit never sees a half-written file.
mkdir -p "$dir/.inbox-tmp"
name="$(date -u +%Y%m%dT%H%M%SZ)-$from-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n').md"
tmp="$dir/.inbox-tmp/$name"
printf -- '---\nfrom: %s\nchannel: %s\nthread: %s\nquote: %s\nreceived: %s\n---\n%s\n' \
  "$from" "$channel" "$thread" "$quote" "$(date -Is)" "$text" >"$tmp"
mv -n "$tmp" "$dir/inbox/$name"
[ -e "$dir/inbox/$name" ] && [ ! -e "$tmp" ] || { echo "po-ask: could not file $name" >&2; exit 1; }
echo "$dir/inbox/$name"
