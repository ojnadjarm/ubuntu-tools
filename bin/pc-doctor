#!/usr/bin/env bash
# pc doctor [--quick] [--json] [--brief] — PASS/FAIL for the whole pc family without opening a window, making a sound or touching the TV.
set -uo pipefail
export LC_ALL=C
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"
. "$BIN/env.sh"

pc_usage 'usage: pc doctor [--quick] [--json] [--brief]

Night-safe complement to `pc selftest` (which opens a calculator): doctor never opens a window,
never makes a sound, never touches the TV, restarts nothing and runs no verb that needs --apply.
One row per check — `OK|WARN|FAIL|SKIP <name> <detail> <ms>` — then `PASS n/m in X s` (exit 0) or
`FAIL n/m …` (exit 1).

  --quick   the <= 2 s subset: no subcommand sweep, no trace, no stats
  --json    the rows as an array of {status,name,detail,ms}
  --brief   only the rows that are not OK, then the PASS/FAIL line

Timing rows scale their budget by clamp(load1/nproc × 4, 1, 8), as tests/lib/budget.sh does: over
the base but inside the scaled budget is `WARN slow under load (×k)`, over the scaled one is FAIL.

Budget: <= 10 s full, <= 2 s --quick. `pc status --check` is read **warm** — that is what the
sentinel sees — and the cache age is reported with it.' "$@"

QUICK=0; BRIEF=0
PC_EXTRA_FLAGS=(--quick --brief)
pc_opt "$@"
for f in ${PC_EXTRA[@]+"${PC_EXTRA[@]}"}; do [ "$f" = --quick ] && QUICK=1; [ "$f" = --brief ] && BRIEF=1; done

WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
DOCTOR_PID=$$
T0=$EPOCHREALTIME
# Load factor ×100 for timing budgets: clamp(load1/nproc × 4, 1, 8), the tests/lib/budget.sh formula (T465).
read -r LOAD1 _ <"${PC_LOADAVG:-/proc/loadavg}"; NPROC=${PC_NPROC:-$(nproc)}
LOAD_K=$(( 10#${LOAD1/./} * 4 / NPROC )); [ "$LOAD_K" -lt 100 ] && LOAD_K=100; [ "$LOAD_K" -gt 800 ] && LOAD_K=800
LOAD_X=$((LOAD_K / 100)).$((LOAD_K % 100 / 10))
# timing <ms> <base-ms> — sets TS to OK inside the base, WARN inside the load-scaled budget, else FAIL;
# TD is the detail suffix for a WARN or FAIL.
timing() {
  local sb=$(( $2 * LOAD_K / 100 ))
  if [ "$1" -le "$2" ]; then TS=OK TD=
  elif [ "$1" -le "$sb" ]; then TS=WARN TD="slow under load (×$LOAD_X), base ${2}ms"
  else TS=FAIL TD="over budget ${sb}ms$([ "$LOAD_K" -gt 100 ] && echo ", base ${2}ms ×$LOAD_X")"; fi
}

# row <status> <name> <detail> <ms> — one line of the report, into the running check's own file.
ROWS=$WORK/rows
row() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$ROWS"; }
# ms_since <EPOCHREALTIME sample> — integer milliseconds, no fork.
ms_since() { local a=${1/./} b=${EPOCHREALTIME/./}; printf '%d' $(( (10#$b - 10#$a) / 1000 )); }
# check <name> <budget-ms> <cmd…> — OK when the command exits 0 inside its budget; its last
# line of stdout becomes the detail. A run over budget is retried up to twice and the fastest
# kept, so one cold or loaded sample is not a FAIL (TSP-023).
# Checks whose exit 2 is a WARN — a pattern worth reporting, never a broken machine.
WARN_CHECKS=' browsers usage agent-work claims fleet-ci residue '
check_run() {
  local name=$1 budget=$2 t out rc ms first n=1 o r m load note=; shift 2
  t=$EPOCHREALTIME
  # No blanket timeout wrapper: every probe that could genuinely hang carries its own
  # pc_timeout/$PC_TIMEOUT_BIN inside its command; the rest are bounded by their budget.
  out=$("$@" 2>&1); rc=$?
  ms=$(ms_since "$t"); first=$ms
  while [ "$rc" = 0 ] && [ "$ms" -gt "$budget" ] && [ "$n" -lt 3 ]; do
    n=$((n + 1)); t=$EPOCHREALTIME
    o=$("$@" 2>&1); r=$?; m=$(ms_since "$t")
    [ "$m" -lt "$ms" ] && { out=$o; rc=$r; ms=$m; }
  done
  if [ "$n" -gt 1 ]; then read -r load _ </proc/loadavg; note=" (best of $n, first ${first}ms, load $load)"; fi
  out=${out##*$'\n'}; out=${out//$'\t'/ }
  local wd=120; [ "$name" = agent-work ] && wd=220   # room for the 6 h writers (T1102)
  if [ "$rc" = 2 ] && [[ $WARN_CHECKS == *" $name "* ]]; then row WARN "$name" "${out:0:$wd}$note" "$ms"
  elif [ "$rc" != 0 ]; then local w=120; [ "$name" = ledger ] && w=400   # room for the ledger's fix commands
    row FAIL "$name" "exit $rc: ${out:0:$w}$note" "$ms"
  else
    timing "$ms" "$budget"
    if [ "$TS" = OK ]; then row OK "$name" "${out:0:$wd}$note" "$ms"
    else row "$TS" "$name" "${out:0:100} ($TD)$note" "$ms"; fi
  fi
}
# start <name> <budget-ms> <cmd…> — check_run as a background job (at most PC_DOCTOR_JOBS, default 6;
# 1 runs inline) into row.<name>; check also places the row, flush_rows appends placed rows in order.
JOBS=${PC_DOCTOR_JOBS:-6} RUNNING=0 ORDER=()
start() {
  if [ "$JOBS" -le 1 ]; then ROWS=$WORK/row.$1 check_run "$@"; return; fi
  [ "$RUNNING" -ge "$JOBS" ] && { wait -n; RUNNING=$((RUNNING - 1)); }
  ( ROWS=$WORK/row.$1; check_run "$@" ) &
  RUNNING=$((RUNNING + 1))
}
check() { ORDER+=("$1"); start "$@"; }
flush_rows() {
  local n
  wait
  for n in ${ORDER[@]+"${ORDER[@]}"}; do [ -e "$WORK/row.$n" ] && cat "$WORK/row.$n" >>"$WORK/rows"; done
  ORDER=() RUNNING=0
}

# The longest row (a 1 s trace) starts first and is printed in its place in section 6.
[ "$QUICK" = 0 ] && start trace-run 3000 bash -c '"'"$BIN"'/pc" trace wakeups --seconds 1 --json | jq -e "length>0" >/dev/null && echo "pc trace wakeups --seconds 1 returned rows"' && { [ "$JOBS" -le 1 ] || TRACE_PID=$!; }

## --- 1. the scripts themselves ----------------------------------------------
# A script over 100 ms is timed twice more and judged on its fastest run: FAIL only when even
# that is over, WARN when a sweep sample and the serial settle run were (TSP-023, T724).
# usage_probe <script> — `<name> ok <min> <max>` or `<name> -h=<rc>`; one xargs worker of the sweep.
USAGE_PROBE='f=$1 t=$EPOCHREALTIME
  ms() { local b=$EPOCHREALTIME; echo $(( (10#${b/./} - 10#${t/./}) / 1000 )); }
  "$f" -h >/dev/null 2>&1 || { echo "${f##*/} -h=$?"; exit 0; }
  min=$(ms); max=$min
  for _ in 2 3; do
    [ "$min" -gt 100 ] || break
    t=$EPOCHREALTIME; "$f" -h >/dev/null 2>&1; m=$(ms)
    [ "$m" -lt "$min" ] && min=$m; [ "$m" -gt "$max" ] && max=$m
  done
  echo "${f##*/} ok $min $max"'
usage_sweep() {
  local f n=0 slow= worst=0 wmax=0 min max load np over="" busy="" bad="" warn="" k st a b t m
  local -a run=()
  local -A res=()
  for f in "$BIN"/pc-*; do
    [ -x "$f" ] && [ "${f##*/}" != pc-bt ] && run+=("$f")   # pc-bt: PT12 still being written by another agent
  done
  while read -r k st a b; do res[$k]="$st $a $b"; done < <(printf '%s\0' ${run[@]+"${run[@]}"} | xargs -0 -r -n 1 -P 8 bash -c "$USAGE_PROBE" _)
  for f in "$BIN"/pc-*; do
    [ -x "$f" ] || { bad="$bad ${f##*/}:not-exec"; continue; }
    case ${f##*/} in pc-bt) continue;; esac
    n=$((n + 1))
    read -r st min max <<<"${res[${f##*/}]:--h=? 0 0}"
    [ "$st" = ok ] || { bad="$bad ${f##*/}:$st"; continue; }
    # The 8 parallel probes inflate each other's -h; one serial run after the sweep settles it (T583);
    # SLOW ONCE only when that run is slow too (T724).
    m=0
    if [ "$max" -gt 100 ]; then
      t=$EPOCHREALTIME; "$f" -h >/dev/null 2>&1; m=$(ms_since "$t")
      [ "$m" -lt "$min" ] && min=$m; [ "$m" -gt "$max" ] && max=$m
    fi
    [ "$min" -gt "$worst" ] && { worst=$min; wmax=$max; slow=${f##*/}; }
    if [ "$min" -gt 100 ]; then over="$over ${f##*/}:${min}ms"
    elif [ "$m" -gt 100 ]; then warn="$warn ${f##*/}:${max}/${min}ms"; fi
  done
  read -r load _ <"${PC_LOADAVG:-/proc/loadavg}"; np=${PC_NPROC:-$(nproc)}
  # Over 0.25 load per CPU an over-budget -h is a busy machine, not a broken script (T432).
  if [ -n "$over" ] && [ $((10#${load/./} * 4)) -gt $((np * 100)) ]; then busy=$over
  else bad="$bad$over"; fi
  printf '%d scripts, slowest -h %s min %d/max %dms, load %s/%d cpu%s%s%s\n' "$n" "$slow" "$worst" "$wmax" "$load" "$np" \
    "${bad:+ — BAD:$bad}" "${busy:+ — SLOW UNDER LOAD:$busy}" "${warn:+ — SLOW ONCE:$warn}"
  [ -n "$bad" ] && return 1
  [ -z "$busy$warn" ] || return 2
}
check usage 3000 usage_sweep
check pclib 300 bash -c '. "'"$BIN"'/pclib.sh" && echo "sources; guard+ledger+cache loaded"'

## --- 2. the session the desktop verbs need ----------------------------------
env_sweep() {
  local miss=
  for p in "${XDG_RUNTIME_DIR:-/run/user/$UID}/bus" "${XDG_RUNTIME_DIR:-/run/user/$UID}/${WAYLAND_DISPLAY:-wayland-0}" "${YDOTOOL_SOCKET:-/tmp/.ydotool_socket}"; do
    [ -e "$p" ] || miss="$miss $p"
  done
  printf 'bus + %s + ydotool socket%s\n' "${WAYLAND_DISPLAY:-wayland-0}" "${miss:+ — MISSING:$miss}"
  [ -z "$miss" ]
}
check env 300 env_sweep
sudo_probe() { local out; out=$(cached sudo-ok 600 bash -c '"$PC_TIMEOUT_BIN" 2 sudo -n true && echo "sudo -n answers"'); [ -n "$out" ] && echo "$out"; }
check sudo 500 sudo_probe
check ydotoold 500 bash -c 's=$(systemctl is-active ydotoold); echo "ydotoold $s"; [ "$s" = active ]'
# The EF09 stand-in for a screenshot: the portal answers Ping without capturing a pixel.
check portal 1500 bash -c '"$PC_TIMEOUT_BIN" 3 busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop org.freedesktop.DBus.Peer Ping >/dev/null && echo "xdg-desktop-portal answers Ping"'
check a11y 1500 bash -c 'a=$("$PC_TIMEOUT_BIN" 3 busctl --user call org.a11y.Bus /org/a11y/bus org.a11y.Bus GetAddress 2>/dev/null); [ -n "$a" ] && a=${a#s \"}; echo "a11y bus at ${a%\"}"'
check window-calls 1500 bash -c '
  j=$("'"$BIN"'/pc" mutter extensions --json 2>/dev/null) || exit 1
  s=$(jq -r ".[]|select(.uuid|test(\"window-calls\"))|.state" <<<"$j")
  echo "window-calls state=${s:-absent} ($(jq length <<<"$j") extensions)"
  [ "${s^^}" = ACTIVE ] || [ "$s" = 1 ]'
check mode 500 bash -c 'm=$("'"$BIN"'/pc" mode status 2>/dev/null); echo "pc mode = ${m:-unknown}"; [ "$m" != mixed ] && [ -n "$m" ]'

## --- 3. what the sentinel sees (warm, never --fresh) ------------------------
status_check() {
  local age=n/a newest
  newest=$(ls -t "$CACHE" 2>/dev/null | head -1)
  [ -n "$newest" ] && age=$(( $(printf '%(%s)T' -1) - $(stat -c %Y "$CACHE/$newest") ))s
  local out rc
  out=$("$BIN/pc" status --check 2>&1); rc=$?
  printf '%s (cache age %s)\n' "${out%%$'\n'*}" "$age"
  return $rc
}
check status-check 2000 status_check

## --- 4. the change ledger ---------------------------------------------------
# Two faults an agent leaves behind: a change that never verified, and one recorded without a
# rollback (nothing to hand `pc undo`). A row whose stored read equals `after` now is verified late;
# one whose rollback ran later in the ledger as a verified undo back to its `before` is reverted.
LEDGER_JQ='(map(select(.cmd))) as $ap | (map(select(.verified != null)) | INDEX(.id)) as $vf |
  (map(select(.ack == true)) | map(.id)) as $ackd |
  ($ap | to_entries | map(.key as $n | .value | select(($vf[.id].verified // false) == true)
    | {k: ([.target, .redo, .before, .after] | tojson), id, $n}) | group_by(.k) | map({key: .[0].k, value: .}) | from_entries) as $undo |
  ($ap | to_entries | map(.key as $n | .value | select((.rollback // "") != "" and ($vf[.id].verified // false) != true and (.id as $i | $ackd | index($i)) == null)
    | {id, by: ([$undo[[.target, .rollback, .after, .before] | tojson][]? | select(.n > $n)] | first | .id)}
    | select(.by != null)) | INDEX(.id)) as $rev |'
ledger_audit() {
  local f=$PC_LEDGER id after rd
  [ -e "$f" ] || { echo "no ledger yet at $f"; return 0; }
  [ -w "$f" ] || { echo "$f is not writable"; return 1; }
  while IFS= read -r -d '' id && IFS= read -r -d '' after && IFS= read -r -d '' rd; do
    [ "$(pc_timeout 2 bash -c '. "$1"; eval "$2"' _ "$BIN/pclib.sh" "$rd" 2>/dev/null)" = "$after" ] &&
      pc_json '{id:$id,verified:true,observed:$o,late:true}' -c --arg id "$id" --arg o "$after" >>"$f"
  done < <(jq -s -j "$LEDGER_JQ"'
    $ap[] | select((.read // "") != "" and ($vf[.id].verified // false) != true and $rev[.id] == null and (.id as $i | $ackd | index($i)) == null)
    | .id, "\u0000", .after, "\u0000", .read, "\u0000"' "$f")
  jq -s -r "$LEDGER_JQ"'
    ($ap | map(select(($vf[.id].verified // false) != true and $rev[.id] == null))) as $unver |
    ($unver | map(select(.id as $i | ($ackd | index($i)) == null))) as $unack |
    ($unver | map(select(.id as $i | ($ackd | index($i)) != null))) as $acked |
    ($ap | map(select($vf[.id].late == true)))          as $late |
    ($ap | map(select((.rollback // "") == "")))        as $noroll |
    "\($ap|length) changes · \($unver|length) unverified\(if ($acked|length)>0 then ", acked" else "" end)\(if ($unack|length)>0 then " (" + ($unack|map(.id)|join(",")) + ")" else "" end)\(if ($late|length)>0 then " (\($late|length) verified late: " + ($late|map(.id)|join(",")) + ")" else "" end)\(if ($rev|length)>0 then " (\($rev|length) reverted: " + ($rev|map(.id + " by " + .by)|join(", ")) + ")" else "" end) · \($noroll|length) without rollback\(if ($noroll|length)>0 then " (" + ($noroll|map(.id)|join(",")) + ")" else "" end)\(if ($unack|length)>0 then " · fix: " + ($unack[0:3]|map("pc undo ack \(.id) --why \"<cause>\"")|join("; ")) + (if ($unack|length)>3 then "; +\($unack|length - 3) more" else "" end) else "" end)"
  ' "$f"
  jq -s -e "$LEDGER_JQ"'
    ($ap | all(.id as $i | (($vf[$i].verified // false) == true or $rev[$i] != null or ($ackd | index($i)) != null) and (.rollback // "") != ""))
  ' "$f" >/dev/null
}
check ledger 1500 ledger_audit
check caches 300 bash -c '[ -d "'"$CACHE"'" ] && [ -w "'"$CACHE"'" ] && echo "'"$CACHE"' writable ($(ls "'"$CACHE"'" 2>/dev/null | wc -l) entries)"'

## --- 5. residue an agent must not leave behind ------------------------------
# Nothing here opens a window or makes a sound: it only counts what should be absent.
# test_owner <pid> — the live test run that owns pid (itself or an ancestor is run.sh, pc-doctor or a
# `*.test.*` script, or it sits in a `run-*.scope`); exit 1 when no test owns it.
test_owner() {
  local pid=$1 a s n=0
  while [ "${pid:-0}" -gt 1 ] && [ "$n" -lt 64 ]; do
    mapfile -d '' -n 3 a 2>/dev/null <"$PC_PROC/$pid/cmdline" || break
    for s in ${a[@]+"${a[@]}"}; do
      case ${s##*/} in *.test.*|run.sh|pc-doctor) echo "${s##*/}"; return 0;; esac
    done
    read -r s 2>/dev/null <"$PC_PROC/$pid/stat" || break
    s=${s##*) }; read -r _ pid _ <<<"$s"; n=$((n + 1))
  done
  s=$(<"$PC_PROC/$1/cgroup") 2>/dev/null
  [[ $s =~ /(run-[^/]*\.scope) ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
  return 1
}
# doctor_child <pid> — exit 0 when this doctor run is an ancestor (its own trace-run row's probe).
doctor_child() {
  local pid=$1 s n=0
  while [ "${pid:-0}" -gt 1 ] && [ "$n" -lt 64 ]; do
    [ "$pid" = "$DOCTOR_PID" ] && return 0
    read -r s 2>/dev/null <"$PC_PROC/$pid/stat" || return 1
    s=${s##*) }; read -r _ pid _ <<<"$s"; n=$((n + 1))
  done
  return 1
}
residue() {
  local bad= used= n d c o f held
  n=$(pactl list modules short 2>/dev/null | grep -c module-null-sink)
  [ "$n" != 0 ] && bad="$bad ${n}×module-null-sink"
  for d in "$PC_PROC"/[0-9]*; do
    read -r c 2>/dev/null <"$d/comm" || continue
    case $c in bpftrace|perf|evtest|bpftool) ;; *) continue;; esac
    doctor_child "${d##*/}" && continue
    if o=$(test_owner "${d##*/}"); then used="$used $c($o)"
    elif [[ " $bad " != *" $c "* ]]; then bad="$bad $c"; fi
  done
  if grep -q 'pc-input-virtual' "$PC_PROC/bus/input/devices" 2>/dev/null; then
    held=
    for f in "$PC_PROC"/[0-9]*/fd/*; do
      [[ $f -ef /dev/uinput ]] || continue
      f=${f%/fd/*}; o=$(test_owner "${f##*/}") && { held=$o; break; }
    done
    if [ -n "$held" ]; then used="$used pc-input-virtual($held)"; else bad="$bad pc-input-virtual"; fi
  fi
  # eye-render belongs to dark-eye.service; a hand-run one is EF03 residue.
  local pid stray=0
  for pid in $(pgrep -x eye-render 2>/dev/null); do
    grep -q 'dark-eye' "/proc/$pid/cgroup" 2>/dev/null || stray=$((stray + 1))
  done
  [ "$stray" != 0 ] && bad="$bad ${stray}×eye-render-outside-unit"
  n=$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -ci '^pt1[0-9]' || true)
  [ "${n:-0}" != 0 ] && bad="$bad ${n}×pt1x-container"
  n=$( { systemctl --user list-units --all --no-legend 2>/dev/null; systemctl list-units --all --no-legend 2>/dev/null; } | grep -c '^ *pt1[0-9]' || true)
  [ "${n:-0}" != 0 ] && bad="$bad ${n}×pt1x-unit"
  [ -z "$bad" ] && [ -n "$used" ] && { echo "in use by$used"; return 2; }
  printf 'no null sinks, no probes, no pt1x leftovers%s\n' "${bad:+ — RESIDUE:$bad}"
  [ -z "$bad" ]
}
check residue 2000 residue

# A browser tree left behind by a finished task: a headless Chrome whose playwright-mcp ancestor
# is gone, or older than 24 h (TSP-020, TSP-032); the server's age is information only.
# Read-only — it never signals a pid.
browsers() {
  local d cmd name line start rss age warn=0 detail= k btime clk now args pid p n orphan=0
  declare -A sum age_s fam ppid
  clk=$(getconf CLK_TCK 2>/dev/null) || clk=100
  printf -v now '%(%s)T' -1
  while read -r k v _; do [ "$k" = btime ] && { btime=$v; break; }; done <"$PC_PROC/stat"
  for d in "$PC_PROC"/[0-9]*; do
    mapfile -d '' args <"$d/cmdline" 2>/dev/null || continue
    cmd="${args[*]}"
    case $cmd in
      *playwright-mcp*) name=playwright-mcp;;
      *headless_shell*) name=chrome-headless;;
      *--headless*) case $cmd in *chrom*) name=chrome-headless;; *) continue;; esac;;
      *) continue;;
    esac
    read -r line <"$d/stat" 2>/dev/null || continue
    read -r _ rss _ <"$d/statm" 2>/dev/null || continue
    # after "pid (comm) " the remaining fields start at 3, so starttime (22) is $20.
    line=${line#*') '}; set -- $line; start=${20:-0}
    age=$(( now - (btime + start / clk) ))
    pid=${d##*/}; fam[$pid]=$name; ppid[$pid]=$2
    sum[$name]=$(( ${sum[$name]:-0} + rss * 4096 / 1048576 ))
    [ "$age" -gt "${age_s[$name]:-0}" ] && age_s[$name]=$age
  done
  # A Chrome root (parent not Chrome) is orphaned when no playwright-mcp ancestor is left.
  for pid in "${!fam[@]}"; do
    [ "${fam[$pid]}" = chrome-headless ] && [ "${fam[${ppid[$pid]}]:-}" != chrome-headless ] || continue
    p=${ppid[$pid]} n=0
    while [ "${p:-0}" -gt 1 ] && [ "${fam[$p]:-}" != playwright-mcp ] && [ $((n += 1)) -lt 64 ]; do
      read -r line <"$PC_PROC/$p/stat" 2>/dev/null || { p=0; break; }
      line=${line#*') '}; set -- $line; p=$2
    done
    [ "${fam[$p]:-}" = playwright-mcp ] || orphan=$((orphan + 1))
  done
  for k in "${!sum[@]}"; do
    age=${age_s[$k]}
    detail="$detail${detail:+ · }$k $((age * 10 / 86400 / 10)).$((age * 10 / 86400 % 10)) d ${sum[$k]} MB"
    { { [ "$k" = chrome-headless ] && [ "$age" -gt 86400 ]; } || [ "${sum[$k]}" -gt 1024 ]; } && warn=1
  done
  [ -n "${sum[chrome-headless]:-}" ] && detail="$detail · orphan $orphan"
  [ "$orphan" = 0 ] || warn=1
  printf '%s\n' "${detail:-no playwright-mcp or headless chrome tree}"
  [ "$warn" = 0 ] || return 2
}
check browsers 600 browsers

# Timer-driven units in a failure loop (TSP-038); the probe is pclib's pc_unit_loops, shared with pc status.
# A loop of a unit that is not ours (PC_NOT_OURS) is named on an OK row (T734).
unit_loops() {
  local out f; out=$(pc_unit_loops) || { grep -v '^foreign: ' <<<"$out"; return 1; }
  f=$(sed -n 's/^foreign: //p' <<<"$out")
  echo "no timer-driven unit${f:+ of ours} failing >= 10/h${f:+; not ours: $f}"
}
check unit-loops 500 unit_loops

# A netdata alarm left in the retry spool never reached the phone (T347-01).
alert_spool() {
  local d=${PC_ALERT_SPOOL:-/var/spool/netdata-alerts-retry} log=${PC_ALERT_LOG:-/var/log/netdata-alert.log} n last
  n=$( { ls -A "$d" 2>/dev/null || cached alert-spool 300 pc_timeout 2 sudo -n ls -A "$d"; } | grep -c .)
  last=$(awk -F'\t' '$2=="ok"{t=$1} END{print t}' "$log" 2>/dev/null)
  printf '%s queued in %s, last ok push %s\n' "$n" "${d##*/}" "${last:-never}"
  [ "$n" = 0 ]
}
check alert-spool 500 alert_spool

# $AGENT_WORK over its size cap: lossless intermediates and node_modules left behind (T360).
# aw_growth — `<bytes 24h> <bytes 6h>` written, then the top 3 ticket-level dirs written in 6 h as `<bytes> <dir>` (T1086, T1102).
aw_growth() {
  pc_timeout 3 find "$AGENT_WORK" -type f -newermt "@$((NOW - 86400))" -printf '%T@ %s %P\n' 2>/dev/null |
    awk -v six=$((NOW - 21600)) '{ p = $0; sub(/^[^ ]+ [^ ]+ /, "", p); t += $2; if ($1 < six) next
           n = split(p, a, "/"); k = a[1]; if (n > 2) k = k "/" a[2]
           if (n > 3 && a[2] ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) k = k "/" a[3]
           s[k] += $2; w += $2 }
         END { print t + 0, w + 0; for (k in s) print s[k], k }' | { read -r t; echo "$t"; sort -rn | head -3; }
}
# aw_net <mb> — samples `<epoch>\t<mb>` into the size history (<= 1 row/h, 30 d kept); prints the net MB/24h
# against the sample >= 6 h old nearest to 24 h ago, or `n/a`.
aw_net() {
  local f=${PC_AW_HISTORY:-$HOME/agents/state/agent-work-size.tsv} last
  last=$(tail -n 1 "$f" 2>/dev/null | cut -f1)
  if [ $((NOW - ${last:-0})) -ge 3600 ] 2>/dev/null; then
    mkdir -p "${f%/*}" && { awk -v old=$((NOW - 2592000)) '$1 >= old' "$f" 2>/dev/null; printf '%s\t%s\n' "$NOW" "$1"; } >"$f.tmp" && mv "$f.tmp" "$f"
  fi
  awk -v now="$NOW" -v mb="$1" '{ a = now - $1; d = a - 86400; if (d < 0) d = -d
      if (a >= 21600 && (!b || d < bd)) { b = a; bd = d; m = $2 } }
    END { if (b) printf "%.1f\n", (mb - m) * 86400 / b; else print "n/a" }' "$f" 2>/dev/null || echo n/a
}
agent_work_size() {
  local max=${PC_AGENT_WORK_MAX_MB:-25600} mb g net=n/a
  mb=$(pc_timeout 3 du -sm "$AGENT_WORK" 2>/dev/null | cut -f1)
  g=$(cached "aw-growth6h${AGENT_WORK//\//_}" 600 aw_growth)
  [[ $mb =~ ^[0-9]+$ ]] && net=$(aw_net "$mb")
  awk -v mb="${mb:-?}" -v max="$max" -v net="$net" 'NR == 1 { r = $1 / 1048576; w6 = $2 / 1048576; next }
    { top = top (top ? ", " : "") $2 " " ($1 < 1048576 ? sprintf("%.0f KB", $1 / 1024) : $1 < 1073741824 ? sprintf("%.0f MB", $1 / 1048576) : sprintf("%.1f GB", $1 / 1073741824)) }
    END { printf "%s MB (warn > %s MB) · written +%.1f GB/24h, +%.1f GB/6h · net %s", mb, max, r / 1024, w6 / 1024,
            net == "n/a" ? net : sprintf("%+.1f GB/24h", net / 1024)
          rate = (net == "n/a") ? w6 * 4 : net
          if (rate >= 1 && mb != "?") { days = (max - mb) / rate; if (days < 0) days = 0
            if (days > 30) printf " · cap in > 30 d"; else printf " · cap in %.1f d", days; if (days < 2) warn = 1 }
          print " · writers 6h: " (top ? top : "none"); exit (mb != "?" && (mb > max || warn)) ? 2 : 0 }' <<<"$g"
}
check agent-work 1500 agent_work_size

# A file claim older than 48 h without a pin blocks parallel agents on a dead row (T378).
check claims 500 "$BIN/claims" check

# fleet_cpu <dir> — `cpu <s> s (7-night median <m>)` from the last 7 nights' `cpu:` lines (last night included), a night's
# first pass when <date>.first.txt exists (T862); exit 2 naming the top grower when the last night is > 1.25× with >= 3 nights.
fleet_cpu() {
  local hist=${PC_TIMINGS_HISTORY:-$HOME/agents/state/test-timings-history.tsv} s night newest
  s=$(ls "$1"/*.txt 2>/dev/null | awk '{ n = $0; sub(/.*\//, "", n); sub(/\..*/, "", n)
      if (!(n in f)) o[++k] = n; if (!(n in f) || $0 ~ /\.first\.txt$/) f[n] = $0 }
    END { for (i = (k > 7 ? k - 6 : 1); i <= k; i++) print f[o[i]] }' | xargs -r -d '\n' awk '
    FNR == 1 { o[++q] = FILENAME }
    /^cpu: [0-9.]+ s total/ { c[FILENAME] = $2 }
    END { for (i = 1; i <= q; i++) if (o[i] in c) { x = v[++k] = c[o[i]] + 0; n = o[i] }
      if (!k) exit; for (i = 2; i <= k; i++) { y = v[i]; for (j = i; j > 1 && v[j-1] > y; j--) v[j] = v[j-1]; v[j] = y }
      m = k % 2 ? v[(k+1)/2] : (v[k/2] + v[k/2+1]) / 2; sub(/.*\//, "", n)
      printf "%s %d %.1f %.1f %d\n", substr(n, 1, 10), (x > 1.25 * m && k >= 3), x, m, m ? 100 * (x - m) / m : 0 }')
  [ -n "$s" ] || return 0
  newest=$(ls "$1"/*.txt | tail -1); newest=${newest##*/}
  set -- $s; night=$1
  [ "${newest:0:10}" = "$night" ] && newest= || newest=" on ${night:5}"
  printf 'cpu %s s%s (7-night median %s)' "$3" "$newest" "$4"
  [ "$2" = 1 ] || { echo; return 0; }
  printf ' +%s%%' "$5"
  awk -F'\t' -v n="$night" '$6 == "" { next }
    substr($1, 1, 10) < n { h[$2, ++c[$2]] = $6 + 0; next }
    substr($1, 1, 10) == n && !($2 in cur) { cur[$2] = $6 + 0 }
    END { for (f in cur) if (c[f]) { k = 0
        for (i = 1; i <= c[f]; i++) { x = h[f, i]; for (j = ++k; j > 1 && v[j-1] > x; j--) v[j] = v[j-1]; v[j] = x }
        m = k % 2 ? v[(k+1)/2] : (v[k/2] + v[k/2+1]) / 2
        if (bf == "" || cur[f] - m > best) { best = cur[f] - m; bf = f; bm = m } }
      if (bf != "") { x = cur[bf]; sub(/.*\//, "", bf); sub(/\.test\.[a-z]+$/, "", bf); printf ", top %s %.1f vs %.1f", bf, x, bm } }' "$hist" 2>/dev/null
  echo; return 2
}
# The last nightly fleet suite (T459): its verdict (last PASS/FAIL or `recheck T: N/M green` line, green at N = M) and CPU s; red, cut short, older than 48 h or a CPU jump is a WARN.
fleet_ci() {
  local d=${PC_FLEET_CI_DIR:-$HOME/agents/log/fleet-ci} f last now cpu crc
  f=$(ls "$d"/*.txt 2>/dev/null | tail -1)
  [ -n "$f" ] || { echo "no fleet ci run yet in ${d/#$HOME/\~}"; return 2; }
  last=$(awk '/^(PASS|FAIL) [0-9]+\/[0-9]+ files/ { s = v = $0 }
    /^recheck [0-9:]+: [0-9]+\/[0-9]+ green/ { split($3, n, "/"); v = n[1] == n[2] ? "healed by recheck " substr($2, 1, length($2) - 1) " (" $3 ")" : s }
    END { print v }' "$f")
  printf -v now '%(%s)T' -1
  cpu=$(fleet_cpu "$d"); crc=$?
  [ "$crc" = 2 ] && [ "${last%% *}" != healed ] && last=$(cut -d' ' -f1-2 <<<"$last")
  echo "${f##*/}: ${last:-no summary line (running or cut short)}${cpu:+; $cpu}"
  case ${last%% *} in PASS|healed) ;; *) return 2;; esac
  [ $(( now - $(stat -c %Y "$f") )) -le 172800 ] && [ "$crc" != 2 ] || return 2
}
check fleet-ci 300 fleet_ci

## --- 6. the layers each pc-* sits on ----------------------------------------
if [ "$QUICK" = 0 ]; then
  check pipewire 1000 bash -c 'n=$("$PC_TIMEOUT_BIN" 3 pw-dump 2>/dev/null | jq length) && echo "pw-dump parses, $n objects" && [ "$n" -gt 0 ]'
  check bluez 1500 bash -c 'p=$("$PC_TIMEOUT_BIN" 3 busctl --system get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2>/dev/null); echo "adapter hci0 Powered=${p#b }"; [ "$p" = "b true" ]'
  check docker 1500 bash -c 'n=$("$PC_TIMEOUT_BIN" 3 docker ps -q 2>/dev/null | wc -l) && echo "docker socket answers, $n running" && "$PC_TIMEOUT_BIN" 3 docker info --format "{{.ServerVersion}}" >/dev/null'
  check tailscale 2000 bash -c 's=$("$PC_TIMEOUT_BIN" 3 tailscale status --json 2>/dev/null | jq -r .BackendState); echo "tailscale $s"; [ "$s" = Running ]'
  check trace-deps 500 bash -c '
    m=; for b in bpftrace perf; do command -v $b >/dev/null || m="$m $b"; done
    python3 -c "import bcc" 2>/dev/null || m="$m python3-bcc"
    echo "bpftrace + perf + bcc present${m:+ — MISSING:$m}"; [ -z "$m" ]'
  ORDER+=(trace-run)
  check agents-log 2000 bash -c 'l=$("'"$BIN"'/agents-log" --pc --since 24h 2>/dev/null | tail -1); echo "${l:-no rows}"; [ -n "$l" ]'

  ## --- 7. every read-only subcommand's default verb parses as JSON ----------
  # Started in parallel: the sweep is one round trip, not the sum of ~18 snapshots.
  sub_probe() {
    local name=$1 budget=$2; shift 2
    local t=$EPOCHREALTIME out rc ms
    out=$(pc_timeout 8 "$BIN/pc" "$@" --json 2>&1); rc=$?
    ms=$(ms_since "$t")
    if [ "$rc" != 0 ]; then printf 'FAIL\tsub:%s\texit %s: %s\t%s\n' "$name" "$rc" "${out##*$'\n'}" "$ms"
    elif ! jq -e . >/dev/null 2>&1 <<<"$out"; then printf 'FAIL\tsub:%s\t--json does not parse\t%s\n' "$name" "$ms"
    else
      timing "$ms" "$budget"
      if [ "$TS" = OK ]; then printf 'OK\tsub:%s\t%s bytes of JSON\t%s\n' "$name" "${#out}" "$ms"
      else printf '%s\tsub:%s\t%s\t%s\n' "$TS" "$name" "$TD" "$ms"; fi
    fi
  }
  # name budget verb…  (pc bt is PT12, still being written — deliberately not swept)
  SUBS=(
    'status 1500 status'      'top 1500 top'          'io 1500 io'
    'power 1800 power'        'thermal 1500 thermal'  'kernel 1500 kernel'
    'net 1800 net'            'hw 1500 hw all'            'dbus 1000 dbus list'
    'mutter 1500 mutter'      'units 1800 units list' 'journal 1000 journal digest --since 1h'
    'docker 1500 docker stacks' 'audio 1500 audio'    'input 1800 input devices'
    'undo 1000 undo list'     'win 1500 win list'
  )
  # The sweep's budgets are for its probes alone: it starts once the row jobs drain, all but the
  # mostly-sleeping trace-run row (T583).
  for p in $(jobs -rp); do [ "$p" = "${TRACE_PID:-}" ] || wait "$p"; done
  for spec in "${SUBS[@]}"; do
    # shellcheck disable=SC2086
    sub_probe $spec >"$WORK/sub.${spec%% *}" &
  done
  flush_rows
  for spec in "${SUBS[@]}"; do cat "$WORK/sub.${spec%% *}" >>"$WORK/rows"; done
fi

flush_rows
## --- report -----------------------------------------------------------------
TOTAL_MS=$(ms_since "$T0")
n_ok=$(grep -c '^OK' "$WORK/rows"); n_all=$(wc -l <"$WORK/rows"); n_bad=$(grep -c '^FAIL' "$WORK/rows")
n_warn=$(grep -c '^WARN' "$WORK/rows")
WARNS=$([ "$n_warn" != 0 ] && printf ' — %s WARN: %s' "$n_warn" "$(awk -F'\t' '$1=="WARN"{printf "%s ",$2}' "$WORK/rows")")

if [ "$JSON" = 1 ]; then
  jq -R -s -c 'split("\n")|map(select(length>0)|split("\t")|{status:.[0],name:.[1],detail:.[2],ms:(.[3]|tonumber)})' "$WORK/rows"
else
  while IFS=$'\t' read -r st name detail ms; do
    [ "$BRIEF" = 1 ] && [ "$st" = OK ] && continue
    printf '%-4s %-14s %-72s %5s ms\n' "$st" "$name" "$detail" "$ms"
  done <"$WORK/rows"
  [ "$BRIEF" = 1 ] || printf -- '---\n'
  if [ "$n_bad" = 0 ]; then printf 'PASS %s/%s in %s.%03d s%s%s\n' "$n_ok" "$n_all" "$((TOTAL_MS / 1000))" "$((TOTAL_MS % 1000))" "$([ "$QUICK" = 1 ] && echo ' (--quick)')" "$WARNS"
  else printf 'FAIL %s/%s in %s.%03d s — %s%s\n' "$n_ok" "$n_all" "$((TOTAL_MS / 1000))" "$((TOTAL_MS % 1000))" "$(awk -F'\t' '$1=="FAIL"{printf "%s ",$2}' "$WORK/rows")" "$WARNS"; fi
fi
[ "$n_bad" = 0 ]
