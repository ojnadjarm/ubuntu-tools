#!/usr/bin/env bash
# pc snap [window <HH:MM-HH:MM>|prune] [--apply] — snapd's refresh window and its disabled revisions, ledgered.
set -uo pipefail
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc snap                              timer, minutes it shares with the fenced windows, disabled revisions
       pc snap window <HH:MM-HH:MM> [--apply]   set refresh.timer; undo restores the old value
       pc snap prune [--apply]                  remove every disabled revision (NAME REV MB listed first)
       pc snap timer                            the stored refresh.timer ("unset" when snapd uses its default)

window refuses (exit 3) a window touching the CI window ($CI_WINDOW, default 00:50-01:50) or the
reboot hour 04:00-05:00 (T23 reboot, moodle-keeper 04:30). prune runs `snap remove <name> --revision=<rev>`
under sudo -n per row and ledgers one entry; no undo: removed revisions re-download on demand.' "$@"

PC_SUB='pc snap'
pc_opt "$@"
sub=${PC_ARGS[0]:-}
PC_ROOT_TIMEOUT=120
SNAP_DIR=${PC_SNAP_DIR:-/var/lib/snapd/snaps}
FENCES="${CI_WINDOW:-00:50-01:50} 04:00-05:00"

# timer — the stored refresh.timer, "unset" when none is stored; exit 1 when snapd cannot be read.
timer() {
  local out
  out=$(pc_root snap get system refresh.timer 2>&1) && { printf '%s\n' "$out"; return 0; }
  grep -q 'has no' <<<"$out" && { echo unset; return 0; }
  echo "pc snap: cannot read refresh.timer: $out" >&2; return 1
}

# mins <HH:MM> — minutes since midnight.
mins() { echo $(( 10#${1%:*} * 60 + 10#${1#*:} )); }

# spans <HH:MM-HH:MM> — "start end" minute pairs, a midnight-wrapping window split in two.
spans() {
  local s e; s=$(mins "${1%-*}"); e=$(mins "${1#*-}")
  if [ "$e" -gt "$s" ]; then echo "$s $e"; else echo "$s 1440"; echo "0 $e"; fi
}

# shared <win> <fence> — overlap minutes; prints -1 when the two only touch at an edge.
shared() {
  local a b c d n=0 touch=0
  while read -r a b; do while read -r c d; do
    [ "$a" -le "$d" ] && [ "$b" -ge "$c" ] && touch=1
    local lo=$(( a > c ? a : c )) hi=$(( b < d ? b : d ))
    [ "$hi" -gt "$lo" ] && n=$(( n + hi - lo ))
  done < <(spans "$2"); done < <(spans "$1")
  [ "$n" -eq 0 ] && [ "$touch" = 1 ] && n=-1
  echo "$n"
}

# disabled — "name rev" per disabled revision.
disabled() { pc_cmd snap list --all 2>/dev/null | awk 'NR > 1 && $NF ~ /(^|,)disabled(,|$)/ {print $1, $3}'; }

# rev_mb <name> <rev> — the revision's .snap size in MB.
rev_mb() { local b; b=$(stat -c %s "$SNAP_DIR/$1_$2.snap" 2>/dev/null) || b=0; echo $(( (b + 524288) / 1048576 )); }

valid() { [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && [ "${1%-*}" != "${1#*-}" ]; }

case $sub in
  timer) timer; exit $?;;
  restore)
    v=${PC_ARGS[1]:-}
    if [ "$v" = unset ]; then pc_root snap unset system refresh.timer; exit $?; fi
    valid "$v" || { echo "pc snap restore: not a HH:MM-HH:MM window: $v" >&2; exit 2; }
    pc_root snap set system refresh.timer="$v"; exit $?;;
  window)
    new=${PC_ARGS[1]:-}
    valid "$new" || { echo "pc snap window: need one HH:MM-HH:MM window, got '${new}'" >&2; exit 2; }
    for f in $FENCES; do
      n=$(shared "$new" "$f")
      [ "$n" = 0 ] || { echo "pc snap: refused, $new touches the fenced window $f (CI or reboot hour)" >&2; exit 3; }
    done
    old=$(timer) || exit 1
    [ "$old" = "$new" ] && { echo "nothing: refresh.timer is already $new"; exit 0; }
    printf -v rb '%q restore %q' "$BIN/pc-snap" "$old"
    printf -v PC_READ_CMD '%q timer' "$BIN/pc-snap"
    pc_apply "snap refresh.timer" "$old" "$new" "$rb" pc_root snap set system refresh.timer="$new"
    exit $?;;
  prune)
    mapfile -t rows < <(disabled)
    [ ${#rows[@]} -gt 0 ] || { echo 'nothing: no disabled revisions'; exit 0; }
    total=0
    { printf 'NAME\tREV\tMB\n'
      for r in "${rows[@]}"; do mb=$(rev_mb $r); printf '%s\t%s\t%s\n' "${r% *}" "${r#* }" "$mb"; done; } | column -t -s $'\t'
    for r in "${rows[@]}"; do total=$(( total + $(rev_mb $r) )); done
    summary="${#rows[@]} disabled revisions, $total MB"
    [ "$APPLY" = 1 ] || { echo "would: remove $summary (--apply)"; exit 0; }
    FAILED=()
    for r in "${rows[@]}"; do
      pc_root snap remove "${r% *}" --revision="${r#* }" >/dev/null 2>&1 || FAILED+=("${r% *}/${r#* }")
    done
    left=$(disabled | wc -l)
    after="$left disabled left"; [ ${#FAILED[@]} -gt 0 ] && after+=", failed: ${FAILED[*]}"
    id=$(pc_id); printf -v ts '%(%Y-%m-%dT%H:%M:%S%z)T' -1
    mkdir -p "${PC_LEDGER%/*}"
    pc_json '{ts:$ts,id:$id,agent:$ag,cmd:"pc snap prune --apply",target:"snap disabled revisions",before:$b,after:$a,rollback:"none, revisions re-download on demand",verified:($l == "0")}' -c \
      --arg ts "$ts" --arg id "$id" --arg ag "${AGENT_NAME:-}" --arg b "$summary" --arg a "$after" --arg l "$left" >>"$PC_LEDGER"
    echo "ledger $id: $after (of $summary)"
    for f in ${FAILED[@]+"${FAILED[@]}"}; do echo "pc snap: snap remove failed: $f" >&2; done
    echo "rollback: none, revisions re-download on demand"
    [ "$left" -eq 0 ];;
  '')
    t=$(timer) || exit 1
    shown=$(pc_cmd snap refresh --time 2>/dev/null | sed -n 's/^timer: //p')
    line="timer: $t"
    if valid "$shown"; then for f in $FENCES; do n=$(shared "$shown" "$f"); [ "$n" -lt 0 ] && n=0; line+=" · ∩ $f ${n} min"; done; fi
    mapfile -t rows < <(disabled); total=0
    for r in ${rows[@]+"${rows[@]}"}; do total=$(( total + $(rev_mb $r) )); done
    echo "$line · disabled ${#rows[@]} (${total} MB)";;
  *) printf '%s\n' "$PC_USAGE" >&2; exit 2;;
esac
