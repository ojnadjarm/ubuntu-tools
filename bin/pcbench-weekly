#!/usr/bin/env bash
# pcbench-weekly — the Sunday 02:00 A/B run of the whole task pack (PB09).
# Gated on "nobody home": the run drives the real desktop, so it never starts while the owner
# is at the machine. Skips are counted; the owner is pushed once at three skips in a row.
set -uo pipefail
export LC_ALL=C
. "$HOME/agents/bin/env.sh"

BENCH="$HOME/agents/bench"
STATE="${PCBENCH_WEEKLY_STATE:-$BENCH/state}"
STREAK="$STATE/weekly-skips"
LOG="${PCBENCH_WEEKLY_LOG:-$HOME/agents/log/pcbench-weekly.log}"
TRIALS="${PCBENCH_WEEKLY_N:-3}"
MODEL="${PCBENCH_WEEKLY_MODEL:-opus}"
BUDGET="${PCBENCH_WEEKLY_BUDGET:-60}"

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
usage: pcbench-weekly [--dry-run] [--force]

The weekly pcbench A/B run: every tier (observe, diagnose, change, safety — C02 and C04
included), both arms, -n 3, opus, then `pcbench report --baseline` into
bench/BASELINE-PCBENCH.md and bench/LAST.json.

  --dry-run  print the gate verdict and the command, run nothing
  --force    run even if the gate says the owner is present (never used by the timer)

Env: PCBENCH_WEEKLY_N, PCBENCH_WEEKLY_MODEL, PCBENCH_WEEKLY_BUDGET, PCBENCH_AWAY_IDLE_S,
     PCBENCH_WEEKLY_STATE, PCBENCH_WEEKLY_LOG.
Log: ~/agents/log/pcbench-weekly.log · skip streak: bench/state/weekly-skips
USAGE
    exit 0;;
esac

DRY=0; FORCE=0
for a in "$@"; do case "$a" in
  --dry-run) DRY=1;; --force) FORCE=1;;
  *) echo "pcbench-weekly: unknown option $a" >&2; exit 2;;
esac; done

mkdir -p "$STATE" "$(dirname "$LOG")"
say() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$LOG"; }

# --- the "nobody home" gate ------------------------------------------------
verdict="$(pcbench away --json 2>/dev/null)"
# `.present // true` is wrong here: jq's // treats a literal false as empty.
present=$(printf '%s' "$verdict" | jq -r 'if has("present") then .present else true end' 2>/dev/null)
: "${present:=true}"
why=$(printf '%s' "$verdict" | jq -r '(.reasons // []) | join("; ")' 2>/dev/null)
if [ "$present" != false ] && [ "$FORCE" = 0 ]; then
  n=$(( $(cat "$STREAK" 2>/dev/null || echo 0) + 1 ))
  printf '%s\n' "$n" > "$STREAK"
  say "skipped: owner present (${why:-unknown}) — skip $n in a row"
  [ "$n" = 3 ] && notify-owner -t pcbench "weekly bench skipped 3 weeks running: owner present. Run it by hand: pcbench-weekly --force" || true
  exit 0
fi
say "gate: away${FORCE:+ (force=$FORCE)}"

# --tier is omitted on purpose: every tier runs, so the confirming C02/C04 re-run is included.
cmd=(pcbench run --arm both -n "$TRIALS" --model "$MODEL" --set night
     --require-away --max-budget-usd-total "$BUDGET")
if [ "$DRY" = 1 ]; then say "would run: ${cmd[*]}"; exit 0; fi

say "start: ${cmd[*]}"
out="$(mktemp)"
"${cmd[@]}" >"$out" 2>>"$LOG"; rc=$?
run_dir="$(tail -1 "$out")"; rm -f "$out"
case "$run_dir" in skipped:*) say "$run_dir"; exit 0;; esac
if [ "$rc" != 0 ] || [ ! -s "${run_dir:-/nonexistent}/rows.jsonl" ]; then
  say "FAIL: pcbench run exited $rc (run_dir='${run_dir:-none}')"
  exit 1
fi
say "run: $run_dir"

# Same path cmd_run's baseline writing uses: report --baseline rewrites the pcbench block in
# BASELINE-PCBENCH.md and LAST.json.
if pcbench report "$run_dir" --baseline >>"$LOG" 2>&1; then
  say "baseline updated from $(basename "$run_dir")"
else
  say "FAIL: pcbench report --baseline failed"
  exit 1
fi

printf '0\n' > "$STREAK"
say "done"
