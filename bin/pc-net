#!/usr/bin/env bash
# pc net ifaces|listeners|sockets|who|tailscale|fw|wifi|dns|top — interfaces, listeners, port owners, tailscale, firewall (read-only), wifi, DNS.
set -uo pipefail
export LC_ALL=C
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc net [ifaces|listeners|tailscale] [--json]        default: ifaces + listeners + tailscale one-liners
       pc net ifaces [--json]                          addresses, state, mtu, rx/tx bytes per interface
       pc net listeners [--json]                        listening sockets: proto, addr, port, pid, comm, scope, unit|container
       pc net sockets [--pid P|--comm C] [--json]        established sockets, optionally filtered
       pc net who <port>                                who owns a listening port: pid, comm, unit|container
       pc net tailscale [--json]                         self, peers, serve mappings
       pc net fw [--raw]                                 exposure summary (port -> allowed sources); --raw dumps `nft -j list ruleset`
       pc net wifi [--json]                              SSID, signal, bitrate (no rescan — EF09)
       pc net wifi roams [--since 7d] [--json]           roams, ping-pongs, disconnects, regdom resets (default: this boot)
       pc net wifi pin band a|bg|auto [--apply]          pin the active wifi connection to 5 GHz (a) or 2.4 GHz (bg)
       pc net wifi pin bssid <mac>|auto [--apply]        pin it to one access point; refused unless visible with signal >= 60
       pc net wifi pin --confirm                         keep the pin: pin in use + gateway ping + tailscale Running, then cancel the revert
       pc net dns [--json]                               resolver DNS servers
       pc net dns --stats [--json]                       cache hit %, flushes, degraded-EDNS fallbacks, api lookup ms (this boot)
       pc net top [--seconds 3]                          per-process bandwidth (nethogs, needs root)

Read-only except `wifi pin`: a pin arms a 90 s user timer that sets it back to auto unless confirmed;
the revert and its undo carry `--con <uuid>`, so they run while the wifi is down.
No wifi rescan, no nft/ufw/tailscale mutation exists here. Bind scope is one of
lo, lan, ts, all.' "$@"

FILTER_PID=; FILTER_COMM=; RAW=0; ARGV=()
for a in "$@"; do case $a in
  --pid) NEXTPID=1;; --pid=*) FILTER_PID=${a#*=};;
  --comm) NEXTCOMM=1;; --comm=*) FILTER_COMM=${a#*=};;
  --raw) RAW=1;;
  *) if [ "${NEXTPID:-0}" = 1 ]; then FILTER_PID=$a; NEXTPID=0
     elif [ "${NEXTCOMM:-0}" = 1 ]; then FILTER_COMM=$a; NEXTCOMM=0
     else ARGV+=("$a"); fi;;
esac; done
PC_EXTRA_FLAGS=(--since: --stats --confirm --con:)
pc_opt ${ARGV[@]+"${ARGV[@]}"}
SINCE=${PC_OPT[--since]-}
sub="${PC_ARGS[0]:-}"
arg="${PC_ARGS[1]:-}"
secs=$SECONDS_; [ "$secs" = 0 ] && secs=3

## --- helpers ------------------------------------------------------------
_ts_status() { pc_cmd tailscale status --json 2>/dev/null; }
_ts_serve()  { pc_cmd tailscale serve status 2>/dev/null; }
_ts_ip4()    { pc_cmd tailscale ip -4 2>/dev/null; }
_docker_ps() { pc_cmd docker ps --format json 2>/dev/null; }

TS_IP="$(cached net_tsip 60 _ts_ip4)"

# scope_for <addr> — lo, all, ts (tailscale range) or lan.
scope_for() {
  case "$1" in
    127.0.0.1|::1) echo lo;;
    0.0.0.0|'*'|::) echo all;;
    100.*) echo ts;;
    *) if [ -n "$TS_IP" ] && [ "$1" = "$TS_IP" ]; then echo ts; else echo lan; fi;;
  esac
}

# build_docker_port_map — one docker ps + one jq call, filling DOCKER_PORT_MAP[port]=container (no per-port fork).
declare -A DOCKER_PORT_MAP
build_docker_port_map() {
  local cname ports rest m
  while IFS=$'\t' read -r cname ports; do
    [ -n "$cname" ] || continue
    rest=$ports
    while [[ $rest =~ 0\.0\.0\.0:([0-9]+)-\> ]]; do
      DOCKER_PORT_MAP[${BASH_REMATCH[1]}]=$cname
      m=${BASH_REMATCH[0]}; rest=${rest/$m/}
    done
  done < <(cached net_docker_ports 60 _docker_ps | jq -r '[.Names, (.Ports // "")] | @tsv' 2>/dev/null)
}

# unit_for <pid> <comm> <port> — systemd unit owning pid, or the docker container for docker-proxy (no fork).
unit_for() {
  local pid=$1 comm=$2 port=$3 cg last
  [ "$comm" = docker-proxy ] && { printf '%s' "${DOCKER_PORT_MAP[$port]:--}"; return; }
  [ -n "$pid" ] && [ -r "$PC_PROC/$pid/cgroup" ] || { printf -- '-'; return; }
  cg=$(<"$PC_PROC/$pid/cgroup")
  last=${cg##*$'\n'}
  if [[ $last =~ ([^/]+\.(service|scope))$ ]]; then printf '%s' "${BASH_REMATCH[1]}"; else printf -- '-'; fi
}

## --- ifaces ---------------------------------------------------------------
ifaces_json() {
  pc_cmd ip -j addr 2>/dev/null | jq -c '[.[] | {
    name: .ifname, state: .operstate, mtu: .mtu,
    addrs: [.addr_info[]? | select(.family=="inet" or .family=="inet6") | .local]}]'
}
do_ifaces() {
  local j; j=$(ifaces_json)
  if [ "$JSON" = 1 ]; then printf '%s\n' "$j"; return; fi
  jq -r '.[] | "\(.name)\t\(.state)\tmtu \(.mtu)\t\(.addrs|join(","))"' <<<"$j" | column -t -s $'\t'
}

## --- listeners --------------------------------------------------------------
# ss without root shows no process column (users:(...) needs CAP_SYS_PTRACE on someone else's
# socket); fixtures already carry it, a live run falls back to `sudo -n` once.
# The root read is a 60 s cache shared with the dashboard (sites.py): one sudo per minute (T650).
LISTENERS_CACHE="${XDG_RUNTIME_DIR:-/tmp}/pc-cache"
_root_ss() { pc_root ss -Hltnup; }
listeners_raw() {
  local out
  if [ -n "$PC_FIXTURE" ]; then out=$(pc_cmd ss -Hltnup 2>/dev/null)
  else
    mkdir -p "$LISTENERS_CACHE" 2>/dev/null
    out=$(CACHE=$LISTENERS_CACHE cached listeners 60 _root_ss)
    [ -n "$out" ] || { rm -f "$LISTENERS_CACHE/listeners"; out=$(pc_cmd ss -Hltnup 2>/dev/null); }
  fi
  printf '%s\n' "$out"
}
listeners_json() {
  build_docker_port_map
  local proto state rq sq loc peer rest addr port pid comm scope unit tsv=''
  while read -r proto state rq sq loc peer rest; do
    [ -n "${proto:-}" ] || continue
    addr=${loc%:*}; port=${loc##*:}
    if [[ $rest =~ pid=([0-9]+) ]]; then pid=${BASH_REMATCH[1]}; else pid=''; fi
    if [[ $rest =~ \(\"([^\"]+)\" ]]; then comm=${BASH_REMATCH[1]}; else comm=''; fi
    scope=$(scope_for "$addr")
    unit=$(unit_for "$pid" "$comm" "$port")
    tsv+="$proto"$'\t'"$addr"$'\t'"$port"$'\t'"$pid"$'\t'"$comm"$'\t'"$scope"$'\t'"$unit"$'\n'
  done < <(listeners_raw)
  printf '%s' "$tsv" | jq -R -s -c '
    split("\n") | map(select(length>0) | split("\t")) | map({
      proto: .[0], addr: .[1], port: (.[2] | tonumber),
      pid: (if .[3] == "" then null else (.[3] | tonumber) end),
      comm: .[4], scope: .[5], unit: .[6]})'
}
do_listeners() {
  local j; j=$(listeners_json)
  if [ "$JSON" = 1 ]; then printf '%s\n' "$j"; return; fi
  jq -r '.[] | "\(.proto)\t\(.addr):\(.port)\t\(.scope)\t\(.pid)\t\(.comm)\t\(.unit)"' <<<"$j" \
    | column -t -s $'\t' -N PROTO,LOCAL,SCOPE,PID,COMM,UNIT
}

## --- sockets ----------------------------------------------------------------
sockets_raw() {
  local out
  if [ -n "$PC_FIXTURE" ]; then out=$(pc_cmd ss -Htnp state established 2>/dev/null)
  else out=$(pc_root ss -Htnp state established 2>/dev/null); [ -n "$out" ] || out=$(pc_cmd ss -Htnp state established 2>/dev/null)
  fi
  printf '%s\n' "$out"
}
sockets_json() {
  local state rq sq loc peer rest lp la pp pa pid comm tsv=''
  while read -r state rq sq loc peer rest; do
    [ -n "${state:-}" ] || continue
    la=${loc%:*}; lp=${loc##*:}; pa=${peer%:*}; pp=${peer##*:}
    if [[ $rest =~ pid=([0-9]+) ]]; then pid=${BASH_REMATCH[1]}; else pid=''; fi
    if [[ $rest =~ \(\"([^\"]+)\" ]]; then comm=${BASH_REMATCH[1]}; else comm=''; fi
    [ -n "$FILTER_PID" ] && [ "$pid" != "$FILTER_PID" ] && continue
    [ -n "$FILTER_COMM" ] && [ "$comm" != "$FILTER_COMM" ] && continue
    tsv+="$la"$'\t'"$lp"$'\t'"$pa"$'\t'"$pp"$'\t'"$pid"$'\t'"$comm"$'\n'
  done < <(sockets_raw)
  printf '%s' "$tsv" | jq -R -s -c '
    split("\n") | map(select(length>0) | split("\t")) | map({
      local_addr: .[0], local_port: (.[1] | tonumber),
      peer_addr: .[2], peer_port: (.[3] | tonumber),
      pid: (if .[4] == "" then null else (.[4] | tonumber) end), comm: .[5]})'
}
do_sockets() {
  local j; j=$(sockets_json)
  if [ "$JSON" = 1 ]; then printf '%s\n' "$j"; return; fi
  jq -r '.[] | "\(.local_addr):\(.local_port)\t\(.peer_addr):\(.peer_port)\t\(.pid)\t\(.comm)"' <<<"$j" \
    | column -t -s $'\t' -N LOCAL,PEER,PID,COMM
}

## --- who ----------------------------------------------------------------
do_who() {
  local port=$1 row
  [ -n "$port" ] || { echo 'pc net who: needs a port (see -h)' >&2; exit 2; }
  row=$(listeners_json | jq -c --argjson p "$port" 'map(select(.port==$p)) | .[0] // empty')
  [ -n "$row" ] || { printf 'pc net who: nothing listens on %s\n' "$port" >&2; exit 1; }
  jq -r '"\(.pid)\t\(.comm)\t\(.unit)\t\(.scope)"' <<<"$row" | column -t -s $'\t' -N PID,COMM,UNIT,SCOPE
}

## --- tailscale ----------------------------------------------------------
serve_json() {
  cached net_ts_serve 60 _ts_serve | awk '
    /^https:\/\// { if (match($0, /:[0-9]+/)) cur = substr($0, RSTART+1, RLENGTH-1); next }
    /proxy http/  { t=$0; sub(/^.*proxy /,"",t); if (cur!="") print cur"\t"t }
  ' | jq -R -s -c 'split("\n") | map(select(length>0) | split("\t") | {port:(.[0]|tonumber), target:.[1]})'
}
do_tailscale() {
  local st serve
  st=$(cached net_ts_status 60 _ts_status)
  serve=$(serve_json)
  if [ "$JSON" = 1 ]; then
    jq -c --argjson serve "${serve:-[]}" --arg ip "$TS_IP" '
      {self: {hostname: .Self.HostName, ip: (.Self.TailscaleIPs[0] // $ip), os: .Self.OS, online: .Self.Online},
       backend_state: .BackendState,
       peers: [(.Peer // {})[] | {hostname: .HostName, ip: (.TailscaleIPs[0] // ""), online: .Online, os: .OS}],
       serve: $serve}' <<<"${st:-null}"
  else
    local hn bs sv
    hn=$(jq -r '.Self.HostName // "n/a"' <<<"${st:-null}")
    bs=$(jq -r '.BackendState // "n/a"' <<<"${st:-null}")
    sv=$(jq -r '[.[] | "\(.port)->\(.target)"] | join(", ")' <<<"${serve:-[]}")
    printf 'tailscale %s  self=%s (%s)  serve: %s\n' "$bs" "$hn" "${TS_IP:-n/a}" "${sv:-none}"
  fi
}

## --- fw (read-only: FLEET §5 forbids nft/ufw edits) --------------------------
_nft_json()  { pc_cmd nft -j list ruleset 2>/dev/null; }
_ufw_verbose() { pc_cmd ufw status verbose 2>/dev/null; }
nft_json_cmd() {
  local out; out=$(_nft_json); [ -n "$out" ] || out=$(pc_root nft -j list ruleset 2>/dev/null); printf '%s' "$out"
}
ufw_verbose_cmd() {
  local out; out=$(_ufw_verbose); [ -n "$out" ] || out=$(pc_root ufw status verbose 2>/dev/null); printf '%s' "$out"
}
# ufw_rows — "<port>\t<source>" per allow-in rule. A "To" of "Anywhere on <iface>" is a
# wildcard covering every port on that interface (what ufw shows for tailscale0); it is
# fanned out across every per-port rule instead of printed as its own row.
ufw_rows() {
  local out line wilds=() w port src
  out=$(ufw_verbose_cmd)
  while IFS= read -r line; do
    if [[ $line =~ ^Anywhere[[:space:]]*(\(v6\))?[[:space:]]+on[[:space:]]+([A-Za-z0-9_.-]+)[[:space:]]+ALLOW[[:space:]]+IN ]]; then
      wilds+=("${BASH_REMATCH[2]}")
    fi
  done <<<"$out"
  while IFS= read -r line; do
    [[ $line =~ ^([0-9]+)(/[a-z]+)?[[:space:]]+ALLOW[[:space:]]+IN[[:space:]]+([^[:space:]]+) ]] || continue
    port=${BASH_REMATCH[1]}; src=${BASH_REMATCH[3]}
    printf '%s\t%s\n' "$port" "$src"
    for w in "${wilds[@]:-}"; do [ -n "$w" ] && printf '%s\t%s\n' "$port" "$w"; done
  done <<<"$out"
}
# nft_docker_rows — same shape, for DOCKER-USER chain rules (docker-published ports bypass ufw's INPUT).
nft_docker_rows() {
  nft_json_cmd | jq -r '
    .nftables[]? | .rule? | select(.chain=="DOCKER-USER") | .expr as $e
    | ([$e[]?.match | select(.left.meta.key=="iifname") | .right]) as $iif
    | ([$e[]?.match | select(.left.payload.field=="saddr") | .right]) as $saddr
    | ([$e[]?.match | select(.left.payload.field=="dport") | .right] | map(select(type=="number")))  as $dport
    | select(($dport|length)>0)
    | "\($dport[0])\t\(if ($iif|length)>0 then $iif[0] else ($saddr[0] // "Anywhere") end)"'
}
do_fw() {
  [ "$RAW" = 1 ] && { nft_json_cmd; return; }
  { ufw_rows; nft_docker_rows; } | awk -F'\t' '
    { p=$1; s=$2
      if (!(p in seen)) { order[++n]=p; seen[p]=1 }
      k=p SUBSEP s
      if (!(k in dedupe)) { dedupe[k]=1; if (p in list) list[p] = list[p]", "s; else list[p] = s }
    }
    END { for (i=1;i<=n;i++) printf "%4s|%s\n", order[i], list[order[i]] }' \
    | sort -t'|' -k1,1n | awk -F'|' '{printf "%4s  %s\n", $1, $2}'
}

## --- wifi / dns ---------------------------------------------------------
do_wifi() {
  local dev link ssid sig rate
  dev=$(pc_cmd nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null | awk -F: '$2=="wifi" && $3=="connected"{print $1; exit}')
  if [ -z "$dev" ]; then
    [ "$JSON" = 1 ] && pc_json '{connected:false}' -c || echo 'wifi: no connected wifi device'
    return 0
  fi
  ssid=$(pc_cmd nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null | awk -F: -v d="$dev" '$1==d{print $4}')
  link=$(pc_cmd iw dev "$dev" link 2>/dev/null)
  sig=$(grep -oE 'signal: -?[0-9]+' <<<"$link" | awk '{print $2}')
  rate=$(grep -oE 'tx bitrate: [0-9.]+' <<<"$link" | awk '{print $3}')
  if [ "$JSON" = 1 ]; then
    pc_json '{connected:true,device:$d,ssid:$s,signal_dbm:($g|tonumber?),bitrate_mbps:($r|tonumber?)}' -c \
      --arg d "$dev" --arg s "${ssid:-}" --arg g "${sig:-}" --arg r "${rate:-}"
  else
    printf 'wifi %s  ssid=%s  signal=%s dBm  bitrate=%s Mbps\n' "$dev" "${ssid:-n/a}" "${sig:-n/a}" "${rate:-n/a}"
  fi
}
# wifi roams: wpa_supplicant journal -> one awk pass -> band per BSSID (journal freq, else nmcli CHAN).
PINGPONG_SECS=600
_wpa_journal() {
  local w=(-b); [ -n "$SINCE" ] && { [[ $SINCE =~ ^[0-9]+(s|min|m|h|d|w)$ ]] && w=(--since "-$SINCE") || w=(--since "$SINCE"); }
  pc_cmd journalctl -u wpa_supplicant "${w[@]}" -o short-unix -q --no-pager 2>/dev/null
}
# _wpa_parse — "E\tts\tfrom\tto\tfreq\tpingpong" per CONNECTED, then "S\troams\tpp\tdisc\treasons\tworld\tsteer".
_wpa_parse() {
  awk -v W="$PINGPONG_SECS" '
    /Trying to (authenticate|associate) with / {
      b=$0; sub(/.* with /,"",b); b=substr(b,1,17)
      f=$0; if (sub(/.*freq=/,"",f)) { sub(/[^0-9].*/,"",f); freq[b]=f } }
    /CTRL-EVENT-CONNECTED - Connection to / {
      to=$0; sub(/.*Connection to /,"",to); to=substr(to,1,17); ts=int($1); n++
      pp=(cur!="" && cur!=to && pfrom==to && ts-pts<=W) ? 1 : 0; ping+=pp
      printf "E\t%d\t%s\t%s\t%d\t%d\n", ts, (cur==""?"-":cur), to, freq[to]+0, pp
      pfrom=cur; pts=ts; cur=to }
    /CTRL-EVENT-DISCONNECTED/ {
      d++; r=$0; if (sub(/.*reason=/,"",r)) { sub(/[^0-9].*/,"",r); rs=rs (rs==""?"":",") r } }
    /CTRL-EVENT-REGDOM-CHANGE .*type=WORLD/ { world++ }
    /WNM: Disassociation Imminent/ { steer++ }
    END { printf "S\t%d\t%d\t%d\t%s\t%d\t%d\n", n, ping, d, (rs==""?"-":rs), world, steer }'
}
# _band <freq|0> <bssid> — "5GHz ch52" from the MHz, else from nmcli's cached CHAN for that BSSID.
declare -A NM_CHAN; NM_LOADED=0
_band() {
  local f=$1 b=$2 c k
  if [ "$f" = 0 ]; then
    [ $NM_LOADED = 0 ] && NM_LOADED=1 && while IFS=$'\t' read -r k c; do NM_CHAN[$k]=$c; done < <(
      pc_cmd nmcli -t -f BSSID,CHAN dev wifi list --rescan no 2>/dev/null | sed 's/\\:/-/g' | awk -F: '{gsub(/-/,":",$1); print tolower($1)"\t"$2}')
    c=${NM_CHAN[$b]-}; [ -n "$c" ] || { printf -- '-'; return; }
    [ "$c" -le 14 ] && printf '2.4GHz ch%s' "$c" || printf '5GHz ch%s' "$c"; return
  fi
  if [ "$f" -lt 2500 ]; then [ "$f" = 2484 ] && c=14 || c=$(( (f - 2407) / 5 )); printf '2.4GHz ch%s' "$c"
  elif [ "$f" -lt 5925 ]; then printf '5GHz ch%s' $(( (f - 5000) / 5 ))
  else printf '6GHz ch%s' $(( (f - 5950) / 5 )); fi
}
do_wifi_roams() {
  local out sum n pp d rs w st ts from to f p rows='' tsv=''
  out=$(_wpa_journal | _wpa_parse)
  sum=$(grep '^S' <<<"$out"); IFS=$'\t' read -r _ n pp d rs w st <<<"$sum"; [ "$rs" = - ] && rs=
  while IFS=$'\t' read -r _ ts from to f p; do
    [ -n "${ts:-}" ] || continue
    tsv+="$ts"$'\t'"$from"$'\t'"$to"$'\t'"$(_band "$f" "$to")"$'\t'"$p"$'\n'
  done < <(grep '^E' <<<"$out")
  if [ "$JSON" = 1 ]; then
    printf '%s' "$tsv" | jq -R -s -c --argjson n "$n" --argjson pp "$pp" --argjson d "$d" --arg rs "$rs" \
      --argjson w "$w" --argjson st "$st" '{roams:$n, ping_pong:$pp, disconnects:$d,
        disconnect_reasons:($rs | split(",") | map(select(length>0) | tonumber)), regdom_world_resets:$w,
        ap_steer_requests:$st, events:(split("\n") | map(select(length>0) | split("\t")
          | {ts:(.[0]|tonumber), from:.[1], to:.[2], band:.[3], ping_pong:(.[4]=="1")}))}'
    return
  fi
  if [ "$n" = 0 ] && [ "$d" = 0 ]; then printf 'nothing: no wpa_supplicant connects or disconnects %s\n' "${SINCE:+in $SINCE}"; return; fi
  printf 'roams %s · ping-pong %s (A→B→A within %s min) · disconnects %s%s · regdom WORLD resets %s · AP steer requests %s\n' \
    "$n" "$pp" $((PINGPONG_SECS / 60)) "$d" "${rs:+ (reasons $rs)}" "$w" "$st"
  printf '%s' "$tsv" | awk -F'\t' '{printf "%s  %s → %s  %s%s\n", strftime("%m-%d %H:%M", $1), $2, $3, $4, ($5=="1"?"  ping-pong":"")}'
}
# wifi pin (T1098): nmcli band/bssid pin on the active wifi connection, armed with a dead-man
# user timer that sets the property back to auto unless `pin --confirm` sees gateway + tailscale.
PIN_MIN_SIGNAL=60
PIN_REVERT_SECS=90
PIN_UNIT=pc-net-wifi-pin-revert
_pin_con() { pc_cmd nmcli -t -f TYPE,STATE,CON-UUID dev status 2>/dev/null | awk -F: '$1=="wifi" && $2=="connected"{print $3; exit}'; }
_pin_prop() { case $1 in band) echo 802-11-wireless.band;; bssid) echo 802-11-wireless.bssid;; esac; }
# _pin_best <ssid> <kind> <value> — strongest signal of a visible BSSID matching the pin (cached scan, no rescan).
_pin_best() {
  pc_cmd nmcli -t -f BSSID,SSID,FREQ,SIGNAL dev wifi list --rescan no 2>/dev/null | sed 's/\\:/-/g' |
    awk -F: -v s="$1" -v k="$2" -v v="$3" '{ b=$1; gsub(/-/,":",b); f=$3+0
      if ($2 != s) next
      if (k=="bssid" && toupper(b)!=v) next
      if (k=="band" && v=="a" && (f<4900 || f>=5925)) next
      if (k=="band" && v=="bg" && f>=2500) next
      if ($4+0 > m) m=$4+0 } END { print m+0 }'
}
_pin_set() {
  local uuid=$1 kind=$2 value=$3 nmv=$3
  [ "$value" = auto ] && nmv=
  if [ "$value" != auto ]; then
    pc_cmd systemctl --user stop "$PIN_UNIT-$kind.timer" >/dev/null 2>&1
    pc_cmd systemctl --user reset-failed "$PIN_UNIT-$kind.service" >/dev/null 2>&1
    pc_cmd systemd-run --user --quiet --unit="$PIN_UNIT-$kind" --on-active="${PIN_REVERT_SECS}s" \
      --timer-property=AccuracySec=1s --setenv=AGENT_NAME=wifi-pin-dead-man \
      "$(readlink -f "$0")" wifi pin "$kind" auto --con "$uuid" --apply ||
      { echo "refused: the dead-man timer $PIN_UNIT-$kind did not arm, nothing changed" >&2; return 1; }
  fi
  pc_cmd nmcli con modify "$uuid" "$(_pin_prop "$kind")" "$nmv" || return 1
  pc_cmd nmcli -w 30 con up "$uuid" >/dev/null || {
    [ "$value" = auto ] && echo 'nmcli con up failed: pin cleared, NetworkManager autoconnect retries' >&2 ||
      echo "nmcli con up failed: the dead-man reverts within ${PIN_REVERT_SECS} s" >&2; return 1; }
  [ "$value" = auto ] || echo "dead-man: reverts to auto in ${PIN_REVERT_SECS} s unless \`pc net wifi pin --confirm\`"
}
do_wifi_pin_confirm() {
  local gw ts k uuid band bssid ab af armed=()
  for k in band bssid; do pc_cmd systemctl --user is-active -q "$PIN_UNIT-$k.timer" 2>/dev/null && armed+=("$PIN_UNIT-$k.timer"); done
  [ ${#armed[@]} -gt 0 ] || { echo 'nothing: no wifi pin dead-man timer armed'; return 0; }
  uuid=$(_pin_con); [ -n "$uuid" ] || { echo 'refused: no connected wifi connection, dead-man stays armed'; return 1; }
  { IFS= read -r band; IFS= read -r bssid; } < <(
    pc_cmd nmcli --escape no -g 802-11-wireless.band,802-11-wireless.bssid con show "$uuid" 2>/dev/null)
  IFS=' ' read -r ab af < <(pc_cmd nmcli -t -f ACTIVE,BSSID,FREQ dev wifi list --rescan no 2>/dev/null | sed 's/\\:/-/g' |
    awk -F: '$1=="yes"{b=$2; gsub(/-/,":",b); print toupper(b), $3+0; exit}')
  [ -z "$bssid" ] || [ "$bssid" = "$ab" ] || { echo "refused: in use ${ab:-no AP}, not pinned $bssid, dead-man stays armed"; return 1; }
  case "$band" in
    a) [ "${af:-0}" -ge 4900 ] && [ "$af" -lt 5925 ] || { echo "refused: in use ${af:-no} MHz, not band a, dead-man stays armed"; return 1; };;
    bg) [ "${af:-0}" -gt 0 ] && [ "$af" -lt 2500 ] || { echo "refused: in use ${af:-no} MHz, not band bg, dead-man stays armed"; return 1; };;
  esac
  gw=$(pc_cmd ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
  [ -n "$gw" ] && pc_cmd ping -c 1 -W 2 "$gw" >/dev/null 2>&1 || { echo "refused: gateway ${gw:-none} no reply, dead-man stays armed"; return 1; }
  ts=$(pc_cmd tailscale status --json 2>/dev/null | jq -r '.BackendState // "n/a"' 2>/dev/null)
  [ "$ts" = Running ] || { echo "refused: tailscale ${ts:-n/a}, not Running, dead-man stays armed"; return 1; }
  pc_cmd systemctl --user stop "${armed[@]}" || return 1
  echo "confirmed: in use $ab $af MHz · gateway $gw ok · tailscale Running · cancelled ${armed[*]}"
}
do_wifi_pin() {
  local kind=${PC_ARGS[2]:-} value=${PC_ARGS[3]:-} uuid ssid band bssid before sig
  [ "${PC_OPT[--confirm]-}" = 1 ] && { do_wifi_pin_confirm; return; }
  case "$kind:$value" in
    band:a|band:bg|band:auto|bssid:auto) ;;
    bssid:*) value=${value^^}; [[ $value =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || { echo "pc net wifi pin: bad BSSID $value" >&2; exit 2; };;
    *) echo 'pc net wifi pin: band a|bg|auto, bssid <mac>|auto, or --confirm (see -h)' >&2; exit 2;;
  esac
  uuid=${PC_OPT[--con]:-$(_pin_con)}; [ -n "$uuid" ] || { echo 'refused: no connected wifi connection'; exit 1; }
  { IFS= read -r ssid; IFS= read -r band; IFS= read -r bssid; } < <(
    pc_cmd nmcli --escape no -g 802-11-wireless.ssid,802-11-wireless.band,802-11-wireless.bssid con show "$uuid" 2>/dev/null)
  [ "$kind" = band ] && before=${band:-auto} || before=${bssid:-auto}
  [ "$before" = "$value" ] && { echo "nothing: wifi $kind already $value"; return 0; }
  if [ "$value" != auto ]; then
    sig=$(_pin_best "$ssid" "$kind" "$value")
    [ "$sig" -ge "$PIN_MIN_SIGNAL" ] || { echo "refused: no visible $ssid BSSID for $kind $value with signal >= $PIN_MIN_SIGNAL (best $sig)"; exit 1; }
  fi
  PC_READ_CMD="v=\$(pc_cmd nmcli --escape no -g $(_pin_prop "$kind") con show $uuid 2>/dev/null); echo \"\${v:-auto}\""
  pc_apply "wifi $kind" "$before" "$value" "$(readlink -f "$0") wifi pin $kind $before --con $uuid --apply" _pin_set "$uuid" "$kind" "$value"
}
do_dns() {
  local out; out=$(pc_cmd resolvectl dns 2>/dev/null)
  local servers; servers=$(grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}|[0-9a-fA-F:]+:[0-9a-fA-F:]+' <<<"$out" | sort -u)
  if [ "$JSON" = 1 ]; then
    jq -R -s -c 'split("\n") | map(select(length>0))' <<<"${servers:-}"
  else
    printf 'dns: %s\n' "$(paste -sd', ' - <<<"${servers:-n/a}")"
  fi
}

# dns --stats: `resolvectl statistics` needs root (user call = polkit varlink timeout), so sudo -n.
DNS_PROBE_HOST=api.anthropic.com
_dns_stats_json() {
  if [ -n "$PC_FIXTURE" ]; then pc_cmd resolvectl statistics --json=short 2>/dev/null
  else pc_root resolvectl statistics --json=short 2>/dev/null; fi
}
# _resolved_counts — "flushes degraded grace servers" from systemd-resolved's journal this boot.
_resolved_counts() {
  pc_cmd journalctl -u systemd-resolved -b -o cat -q --no-pager 2>/dev/null | awk '
    /Flushed all caches/ { f++ }
    /Using degraded feature set/ { d++; s=$NF; sub(/\.$/,"",s); if (!(s in seen)) { seen[s]=1; l=l (l==""?"":",") s } }
    /Grace period over/ { g++ }
    END { printf "%d %d %d %s\n", f, d, g, (l==""?"-":l) }'
}
_api_lookup_ms() {
  local t0=$EPOCHREALTIME
  pc_cmd getent ahosts "$DNS_PROBE_HOST" >/dev/null 2>&1 || { printf -- '-1'; return; }
  awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN{printf "%d", (b-a)*1000 + 0.5}'
}
do_dns_stats() {
  local st f d g sv ms
  st=$(_dns_stats_json)
  jq -e '.cache.hits' >/dev/null 2>&1 <<<"$st" || { printf 'pc net dns --stats: sudo -n resolvectl statistics failed\n' >&2; exit 1; }
  read -r f d g sv <<<"$(_resolved_counts)"; [ "$sv" = - ] && sv=
  ms=$(_api_lookup_ms)
  local j; j=$(jq -c --argjson f "$f" --argjson d "$d" --argjson g "$g" --arg sv "$sv" --argjson ms "$ms" --arg h "$DNS_PROBE_HOST" '
    {cache_hit_pct: (if .cache.hits + .cache.misses > 0 then (.cache.hits * 100 / (.cache.hits + .cache.misses) | floor) else 0 end),
     cache_hits: .cache.hits, cache_misses: .cache.misses, cache_size: .cache.size,
     transactions: .transactions.totalTransactions, timeouts: .transactions.totalTimeouts,
     failed_responses: .transactions.totalFailedResponses,
     flushes: $f, degraded: $d, grace_recoveries: $g, degraded_servers: ($sv | split(",") | map(select(length>0))),
     lookup_host: $h, lookup_ms: (if $ms < 0 then null else $ms end)}' <<<"$st")
  if [ "$JSON" = 1 ]; then printf '%s\n' "$j"; return; fi
  jq -r '"dns cache \(.cache_hit_pct) % hit · flushes \(.flushes) · degraded \(.degraded)"
    + (if .degraded_servers|length > 0 then " (\(.degraded_servers|join(", ")))" else "" end)
    + " · grace \(.grace_recoveries) · api lookup \(if .lookup_ms == null then "failed" else "\(.lookup_ms) ms" end)"' <<<"$j"
}

## --- top (nethogs, needs root) ------------------------------------------
do_top() {
  local out; out=$(pc_cmd nethogs -t -c 3 -d 1 2>/dev/null)
  [ -n "$out" ] || out=$(pc_root timeout $((secs + 5)) nethogs -t -c 3 -d 1 2>/dev/null)
  printf '%s\n' "${out:-pc net top: nethogs produced no output (needs root)}"
}

case "$sub" in
  ''|overview) do_ifaces; do_listeners; do_tailscale;;
  ifaces) do_ifaces;;
  listeners) do_listeners;;
  sockets) do_sockets;;
  who) do_who "$arg";;
  tailscale) do_tailscale;;
  fw) do_fw;;
  wifi) case "$arg" in roams) do_wifi_roams;; pin) do_wifi_pin;; '') do_wifi;; *) printf 'pc net wifi: unknown verb %s (try -h)\n' "$arg" >&2; exit 2;; esac;;
  dns) if [ -n "${PC_OPT[--stats]-}" ]; then do_dns_stats; else do_dns; fi;;
  top) do_top;;
  *) printf 'pc net: unknown verb %s (try -h)\n' "$sub" >&2; exit 2;;
esac
