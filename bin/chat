#!/usr/bin/env python3
"""chat — the fleet chat for agents: post, read, ask and answer harness questions; the seat is $CHAT_SEAT."""
import argparse
import os
import re
import shlex
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.realpath(__file__))
LIB = os.path.join(os.path.dirname(BIN), "lib")
sys.path.insert(0, LIB)
import chat_dispatch  # noqa: E402
import chat_files  # noqa: E402
import chat_guard  # noqa: E402
import chat_notify  # noqa: E402
import chat_route  # noqa: E402
import chat_store  # noqa: E402
import chat_wake  # noqa: E402
import org  # noqa: E402
from chat_wake import HEADER  # noqa: E402

HELD = 3
LOOK_FIRST = 4
NO_ANSWER = 5
GUIDE_HITS = 3
REPEAT_DAYS = 7
SEEN = re.compile(r"\n\(guides seen: [^)\n]*\)$")
ALL = 10 ** 6


def seat_of(seats):
    """The posting seat from $CHAT_SEAT: an org seat that is not the owner."""
    seat = os.environ.get("CHAT_SEAT", "")
    if not seat:
        raise ValueError("CHAT_SEAT is not set")
    if seat == "owner":
        raise ValueError("the owner writes from the panel, not as CHAT_SEAT=owner")
    if seat not in {s["id"] for s in seats}:
        raise ValueError(f"CHAT_SEAT {seat!r} is not a seat in {org.path()}")
    return seat


def pull(seat, seats):
    """True for a pull seat: #harness and its direct messages only, no project channel."""
    return any(s["id"] == seat and s["wake"] == "pull" for s in seats)


def room(ch, seat, seats):
    """ch, unless a pull seat names a channel other than #harness or a direct message (ValueError)."""
    if pull(seat, seats) and ch != "harness" and not ch.startswith("dm-"):
        raise ValueError(f"{seat} has #harness and direct messages only")
    return ch


def target(where, seat, seats):
    """(channel, to) for a channel name or @seat; agents post to harness, org, a product owner's channel or a seat."""
    ids = {s["id"] for s in seats}
    if where.startswith("@"):
        other = where[1:]
        if other not in ids or other == seat:
            raise ValueError(f"no other seat {other!r}")
        return chat_store.dm(seat, other), [other]
    room(where, seat, seats)
    named = {"harness", "org"} | {s["id"] for s in seats if s["role"] == "po" and s["wake"] != "pull"}
    if where not in named:
        raise ValueError(f"unknown channel {where!r}: {', '.join(sorted(named))} or @<seat>")
    return where, []


def allow(seat, ch, seats):
    """ValueError when the seat may not post in ch (a manager: only in its direct message with the owner)."""
    why = chat_route.may_post(seat, ch, seats)
    if why:
        raise ValueError(why)


def show(rows, with_ch, seat=None):
    """Print messages one per line, extra text lines indented, then each attachment as a path in the seat's own folder,
    after the data header."""
    if rows:
        print(HEADER)
    for r in rows:
        to = f" -> {','.join(r['to'])}" if r["to"] else ""
        kind = f" ({r['kind']}{' re ' + str(r['re']) if r['re'] else ''})" if r["kind"] != "msg" else ""
        first, *rest = r["text"].split("\n")
        print(f"{r['id']} {r['ts'][11:19]}{' #' + r['ch'] if with_ch else ''} {r['from']}{to}{kind}: {first}")
        for line in rest + chat_files.lines(seat, r.get("files")):
            print("    " + line)


def attachments(paths):
    """[(bytes, name)] of the --file paths; ValueError over MAX_FILES, over the size cap or unreadable."""
    if len(paths) > chat_files.MAX_FILES:
        raise ValueError(f"at most {chat_files.MAX_FILES} files a message")
    out = []
    for p in paths:
        try:
            if os.path.getsize(p) > chat_files.MAX_BYTES:
                raise ValueError(f"{p}: over the {chat_files.MAX_BYTES >> 20} MiB cap a file")
            with open(p, "rb") as f:
                out.append((f.read(), chat_files.clean_name(p)))
        except OSError as e:
            raise ValueError(f"cannot read {p}: {e.strerror}") from None
    return out


def post(a, seat, seats):
    ch, to = target(a.where, seat, seats)
    allow(seat, ch, seats)
    text = sys.stdin.read().rstrip("\n") if a.text == "-" else a.text
    blobs = attachments(a.file)
    ok, rule = chat_guard.check(text, seat, ch, to, [n for _, n in blobs])
    if not ok:
        chat_store.audit({"held": True, "seat": seat, "ch": ch, "rule": rule})
        print(f"chat: held ({rule}): nothing was posted", file=sys.stderr)
        return HELD
    files = [chat_files.save(data, name) for data, name in blobs]
    msg = {"ch": ch, "from": seat, "to": to, "text": text, **({"files": files} if files else {})}
    try:
        mid = chat_store.post(msg)
    except ValueError:
        for f in files:
            chat_files.drop(f["id"])
        raise
    print(mid)
    chat_dispatch.dispatch({**msg, "id": mid, "kind": "msg", "hop": 0}, seats)
    chat_notify.alert({**msg, "id": mid}, seats)
    return 0


def read(a, seat, seats):
    visible = [c for c in chat_store.channels(seat)
               if not pull(seat, seats) or c["ch"] == "harness" or c["ch"].startswith("dm-")]
    if a.ch is None and not a.unread:
        for c in visible:
            print(f"{c['ch']} {c['unread']} unread")
        return 0
    if a.ch is None:
        chs = [c["ch"] for c in visible]
    elif a.ch.startswith("@"):
        chs = [target(a.ch, seat, seats)[0]]
    elif a.ch.startswith("dm-") and seat not in a.ch[3:].split("--"):
        raise ValueError(f"{a.ch} is not your direct message")
    else:
        chs = [room(a.ch, seat, seats)]
    rows = []
    for ch in chs:
        got = chat_store.read(ch, after=chat_store.cursor(seat, ch)) if a.unread else chat_store.read(ch)
        if got:
            chat_store.mark(seat, ch, got[-1]["id"])
        rows += [r for r in got if not (a.unread and r["from"] == seat)]
    show(rows, with_ch=a.ch is None, seat=seat)
    return 0


def send(msg, seats):
    """Guard, store, print the id and wake the addressed seats; None when the guard holds it."""
    ok, rule = chat_guard.check(msg["text"], msg["from"], msg["ch"], msg.get("to"))
    if not ok:
        chat_store.audit({"held": True, "seat": msg["from"], "ch": msg["ch"], "rule": rule})
        print(f"chat: held ({rule}): nothing was posted", file=sys.stderr)
        return None
    mid = chat_store.post(msg)
    print(mid)
    chat_dispatch.dispatch({"to": [], "re": None, "hop": 0, **msg, "id": mid}, seats)
    chat_notify.alert({**msg, "id": mid}, seats)
    return mid


def words(text):
    """A question as lowercase words, its guides-seen line dropped, for the repeat lookup."""
    return " ".join(re.findall(r"[a-z0-9]+", SEEN.sub("", text).lower()))


def guide_hits(question):
    """[(slug, head line, summary line)] of the top `guide` hits for the question."""
    out = subprocess.run([os.path.join(BIN, "guide"), *question.split()], capture_output=True, text=True,
                         timeout=60).stdout.splitlines()
    hits = []
    for head, body in zip(out[0::2], out[1::2]):
        path = head.split()[2]
        hits.append((os.path.basename(path)[:-3] if path.endswith(".md") else os.path.basename(path), head, body))
    return hits[:GUIDE_HITS]


def asked_before(question):
    """(ask, answer or None) of the newest same question in #harness within REPEAT_DAYS, answered ones first."""
    since = int(time.time() * 1000) - REPEAT_DAYS * 86400 * 1000
    rows = chat_store.read("harness", after=since, limit=ALL)
    want = words(question)
    asks = [r for r in rows if r["kind"] == "ask" and words(r["text"]) == want]
    answers = {r["re"]: r for r in rows if r["kind"] == "answer"}
    for q in reversed(asks):
        if q["id"] in answers:
            return q, answers[q["id"]]
    return (asks[-1], None) if asks else (None, None)


def answer_of(mid):
    """The newest answer to question `mid`, or None."""
    got = [r for r in chat_store.read("harness", after=mid, limit=ALL) if r["kind"] == "answer" and r["re"] == mid]
    return got[-1] if got else None


def wait_answer(mid, seconds):
    """Block on `wait-for` until question `mid` has an answer, at most `seconds`; the answer or None."""
    cond = (f"{shlex.quote(sys.executable)} -c " + shlex.quote(
        f"import sys; sys.path.insert(0, {LIB!r}); import chat_store; "
        f"sys.exit(not any(r['kind'] == 'answer' and r['re'] == {mid} "
        f"for r in chat_store.read('harness', after={mid}, limit={ALL})))"))
    subprocess.run(["timeout", str(seconds), os.path.join(BIN, "wait-for"), "--label", f"chat-ask-{mid}",
                    "--every", "2", "--until", cond], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return answer_of(mid)


def ask(a, seat, seats):
    allow(seat, "harness", seats)
    question = sys.stdin.read().rstrip("\n") if a.question == "-" else a.question
    q, ans = asked_before(question)
    if ans:
        print(f"chat: asked before as {q['id']}; the answer:")
        show([ans], with_ch=False)
        return 0
    if q:
        mid = q["id"]
        print(f"chat: asked already as {mid} by {q['from']}, not answered yet; nothing was posted")
    else:
        hits = guide_hits(question)
        if hits and not a.post:
            for _, head, body in hits:
                print(f"{head}\n{body}")
            print("chat: read these first; nothing was posted. None answers it: chat ask --post ...", file=sys.stderr)
            return LOOK_FIRST
        seen = f"\n(guides seen: {', '.join(h[0] for h in hits)})" if hits else ""
        mid = send({"ch": "harness", "from": seat, "to": [], "kind": "ask", "text": question + seen, "hop": 0}, seats)
        if mid is None:
            return HELD
    if not a.wait:
        return 0
    ans = wait_answer(mid, a.wait)
    if not ans:
        print(f"chat: no answer in {a.wait} s; it arrives as a new inbox request", file=sys.stderr)
        return NO_ANSWER
    if chat_wake.withdraw(seat, {ans["id"]}):
        chat_dispatch.uncount(seat)
    show([ans], with_ch=False)
    return 0


def answer(a, seat, seats):
    allow(seat, "harness", seats)
    got = chat_store.read("harness", after=a.id - 1, limit=1)
    if not got or got[0]["id"] != a.id or got[0]["kind"] != "ask":
        raise ValueError(f"no question {a.id} in #harness")
    q = got[0]
    text = sys.stdin.read().rstrip("\n") if a.text == "-" else a.text
    to = [] if q["from"] == seat else [q["from"]]
    mid = send({"ch": "harness", "from": seat, "to": to, "kind": "answer", "text": text, "re": q["id"],
                "hop": chat_route.next_hop(seat, q)}, seats)
    return HELD if mid is None else 0


def switch(a):
    """pause|resume: set or clear the PAUSED file (stored, nobody woken); a dry run without --apply."""
    path = os.path.join(chat_store.root(), "PAUSED")
    want = "paused" if a.cmd == "pause" else "running"
    if not a.apply:
        print(f"would: {'paused' if chat_dispatch.paused() else 'running'} → {want}")
        return 0
    if want == "paused":
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {os.environ.get('CHAT_SEAT') or 'shell'}\n")
    elif os.path.exists(path):
        os.remove(path)
    chat_store.audit({"pause": want == "paused", "by": os.environ.get("CHAT_SEAT") or "shell"})
    now = "paused" if chat_dispatch.paused() else "running"
    print(f"chat: {now} (undo: chat {'resume' if want == 'paused' else 'pause'} --apply)")
    got = chat_dispatch.drain() if now == "running" else []
    if got:
        print(f"chat: {len(got)} held wake{'s' * (len(got) > 1)} re-sent: " + ", ".join(f"{s} {o}" for s, o in got))
    return 0


def prune(a):
    """Drop (with --apply) or list the stored uploads that no message carries, older than --days."""
    ids = chat_files.orphans(a.days)
    n = sum(chat_files.size(f) for f in ids)
    if a.apply:
        for f in ids:
            chat_files.drop(f)
    print(f"chat: {'dropped' if a.apply else 'would drop'} {len(ids)} upload{'s' * (len(ids) != 1)} never posted ({n} bytes)")
    return 0


def main():
    p = argparse.ArgumentParser(prog="chat", description=__doc__.split("—", 1)[1].strip())
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("post", help="post text to a channel or @seat; prints the id, exit 3 when the guard holds it")
    s.add_argument("where", help="harness, org, a product owner's channel, or @<seat> for a direct message")
    s.add_argument("text", help="the message (max 2000 characters), or - to read it from stdin; may be empty with --file")
    s.add_argument("--file", action="append", default=[], metavar="PATH",
                   help="attach a file (repeatable, at most 5, 10 MiB each); readers get their own copy's path")
    s = sub.add_parser("read", help="no channel: your channels with unread counts; else the messages, marked read")
    s.add_argument("ch", nargs="?", help="a channel or @<seat>")
    s.add_argument("--unread", action="store_true", help="only messages since you last read, not your own")
    s = sub.add_parser("ask", help="ask the harness: a 7-day repeat prints its answer; guide hits print first "
                                   "(exit 4, nothing posted); else posts to #harness and prints the id")
    s.add_argument("question", help="the question, or - to read it from stdin")
    s.add_argument("--post", action="store_true", help="post even though guide hits exist (none answered it)")
    s.add_argument("--wait", type=int, metavar="S", help="block up to S seconds on the answer (exit 5: none came)")
    s = sub.add_parser("answer", help="answer question <id> in #harness; wakes the seat that asked")
    s.add_argument("id", type=int, help="the question's id")
    s.add_argument("text", help="the answer (max 2000 characters), or - to read it from stdin")
    for cmd, what in (("pause", "stop every wake: messages are still stored"), ("resume", "wake seats again")):
        s = sub.add_parser(cmd, help=f"{what}; no seat needed, a dry run without --apply")
        s.add_argument("--apply", action="store_true", help="make the change and read it back")
    s = sub.add_parser("prune", help="drop uploads never posted, older than --days; no seat needed, a dry run without --apply")
    s.add_argument("--days", type=float, default=2, help="minimum age in days (default 2)")
    s.add_argument("--apply", action="store_true", help="delete them")
    a = p.parse_args()
    try:
        if a.cmd in ("pause", "resume"):
            return switch(a)
        if a.cmd == "prune":
            return prune(a)
        seats = org.seats()
        return {"post": post, "read": read, "ask": ask, "answer": answer}[a.cmd](a, seat_of(seats), seats)
    except ValueError as e:
        print(f"chat: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
