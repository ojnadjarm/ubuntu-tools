#!/usr/bin/env python3
"""chat — the fleet chat for agents: post to a channel or a seat, read channels; the seat is $CHAT_SEAT."""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import chat_dispatch  # noqa: E402
import chat_guard  # noqa: E402
import chat_store  # noqa: E402
import org  # noqa: E402
from chat_wake import HEADER  # noqa: E402

HELD = 3


def seat_of(seats):
    """The posting seat from $CHAT_SEAT: an org seat that is not the owner."""
    seat = os.environ.get("CHAT_SEAT", "")
    if not seat:
        raise ValueError("CHAT_SEAT is not set")
    if seat == "owner":
        raise ValueError("the owner writes from the panel, not as CHAT_SEAT=owner")
    if seat not in {s["id"] for s in seats}:
        raise ValueError(f"CHAT_SEAT {seat!r} is not a seat in {org.path()}")
    return seat


def target(where, seat, seats):
    """(channel, to) for a channel name or @seat; agents post to harness, org, a product owner's channel or a seat."""
    ids = {s["id"] for s in seats}
    if where.startswith("@"):
        other = where[1:]
        if other not in ids or other == seat:
            raise ValueError(f"no other seat {other!r}")
        return chat_store.dm(seat, other), [other]
    named = {"harness", "org"} | {s["id"] for s in seats if s["role"] == "po"}
    if where not in named:
        raise ValueError(f"unknown channel {where!r}: {', '.join(sorted(named))} or @<seat>")
    return where, []


def show(rows, with_ch):
    """Print messages one per line, extra text lines indented, after the data header."""
    if rows:
        print(HEADER)
    for r in rows:
        to = f" -> {','.join(r['to'])}" if r["to"] else ""
        kind = f" ({r['kind']}{' re ' + str(r['re']) if r['re'] else ''})" if r["kind"] != "msg" else ""
        first, *rest = r["text"].split("\n")
        print(f"{r['id']} {r['ts'][11:19]}{' #' + r['ch'] if with_ch else ''} {r['from']}{to}{kind}: {first}")
        for line in rest:
            print("    " + line)


def post(a, seat, seats):
    ch, to = target(a.where, seat, seats)
    text = sys.stdin.read().rstrip("\n") if a.text == "-" else a.text
    ok, rule = chat_guard.check(text, seat)
    if not ok:
        chat_store.audit({"held": True, "seat": seat, "ch": ch, "rule": rule})
        print(f"chat: held ({rule}): nothing was posted", file=sys.stderr)
        return HELD
    msg = {"ch": ch, "from": seat, "to": to, "text": text}
    mid = chat_store.post(msg)
    print(mid)
    chat_dispatch.dispatch({**msg, "id": mid, "kind": "msg", "hop": 0}, seats)
    return 0


def read(a, seat, seats):
    visible = chat_store.channels(seat)
    if a.ch is None and not a.unread:
        for c in visible:
            print(f"{c['ch']} {c['unread']} unread")
        return 0
    if a.ch is None:
        chs = [c["ch"] for c in visible]
    elif a.ch.startswith("@"):
        chs = [target(a.ch, seat, seats)[0]]
    elif a.ch.startswith("dm-") and seat not in a.ch[3:].split("--"):
        raise ValueError(f"{a.ch} is not your direct message")
    else:
        chs = [a.ch]
    rows = []
    for ch in chs:
        got = chat_store.read(ch, after=chat_store.cursor(seat, ch)) if a.unread else chat_store.read(ch)
        if got:
            chat_store.mark(seat, ch, got[-1]["id"])
        rows += [r for r in got if not (a.unread and r["from"] == seat)]
    show(rows, with_ch=a.ch is None)
    return 0


def main():
    p = argparse.ArgumentParser(prog="chat", description=__doc__.split("—", 1)[1].strip())
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("post", help="post text to a channel or @seat; prints the id, exit 3 when the guard holds it")
    s.add_argument("where", help="harness, org, a product owner's channel, or @<seat> for a direct message")
    s.add_argument("text", help="the message (max 2000 characters), or - to read it from stdin")
    s = sub.add_parser("read", help="no channel: your channels with unread counts; else the messages, marked read")
    s.add_argument("ch", nargs="?", help="a channel or @<seat>")
    s.add_argument("--unread", action="store_true", help="only messages since you last read, not your own")
    a = p.parse_args()
    try:
        seats = org.seats()
        return {"post": post, "read": read}[a.cmd](a, seat_of(seats), seats)
    except ValueError as e:
        print(f"chat: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
