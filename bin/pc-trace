#!/usr/bin/env bash
# pc trace wakeups|disk|syscalls|opens|execs|sleep|offcpu|cpu|sched|raw — eBPF/perf one-liners as verbs: who wakes the CPU, who writes the disk, what a pid waits on.
# shellcheck disable=SC2034
set -uo pipefail
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc trace <verb> [pid|comm] [--seconds N] [-n N] [--by comm|pid|unit] [--json]

verbs:
  wakeups            tasks woken per second (sched:sched_wakeup + sched_switch)
  disk               block IO issued, bytes by comm and rwbs (block:block_rq_issue)
  syscalls <pid>     syscall count and total latency for one pid (raw_syscalls)
  opens [pid]        openat() filenames by comm
  execs              programs exec'"'"'d (sched:sched_process_exec)
  sleep [pid]        nanosleep/poll/epoll_pwait callers and their smallest timeout
  offcpu <pid|comm>  folded off-CPU stacks by microseconds (offcputime-bpfcc)
  cpu <pid|comm>     on-CPU symbols (perf record -F 499 -g / perf report)
  sched              run-queue latency per task (perf sched latency)
  raw "<program>"    a bpftrace program verbatim, same hard timeout

Every run is read-only and wrapped in a hard timeout, so no probe outlives its window.
Default window is 2 s; the bpftrace floor is ~0.4 s on top of it (PLAN-PCTOOLS §1 rule 4).
Root comes from sudo -n. Never attaches to kprobe:* except through `raw`.' "$@"

PC_SUB='pc trace'; PC_EXTRA_FLAGS=(-n: --by:); SECONDS_=2
pc_opt "$@"; ARGS=("${PC_ARGS[@]}")
SEC=$SECONDS_; TOPN=${PC_OPT[-n]-15}; BY=${PC_OPT[--by]-comm}
SECONDS_=$SEC
case "$BY" in comm|pid|unit) ;; *) echo "pc trace: --by takes comm, pid or unit" >&2; exit 2;; esac
case "$SEC" in ''|*[!0-9]*) echo "pc trace: --seconds takes whole seconds" >&2; exit 2;; esac
[ "$SEC" -ge 1 ] || { echo "pc trace: --seconds must be at least 1" >&2; exit 2; }
case "$TOPN" in ''|*[!0-9]*) echo "pc trace: -n takes a number" >&2; exit 2;; esac

VERB="${ARGS[0]:-}"; TARGET="${ARGS[1]:-}"
[ -n "$VERB" ] || { printf '%s\n' "$PC_USAGE" >&2; exit 2; }

PIDARG=0
WORK=$(mktemp -d); PIDS=()
cleanup() {
  local p
  for p in "${PIDS[@]:-}"; do [ -n "$p" ] && kill -TERM "$p" 2>/dev/null; done
  rm -rf "$WORK"
}
trap cleanup EXIT INT TERM

ATTACHED=0; ATTACH_MS=0; NOTE=; SUMMARY=; PROBES='%s probes attached in %s ms'

# run_traced <slack> <tool> [args…] — the tool under a hard root timeout, so nothing outlives
# the window: the inner `timeout` runs as root next to the probe, the outer one bounds sudo itself.
run_traced() {
  local slack=$1 tool=$2; shift 2
  if [ -n "$PC_FIXTURE" ] && [ -x "$PC_FIXTURE/bin/$tool" ]; then
    "$PC_FIXTURE/bin/$tool" "$@"; return
  fi
  command -v "$tool" >/dev/null || { echo "pc trace: $tool is not installed" >&2; exit 1; }
  local hard=$((SEC + slack))
  timeout -k 3 $((hard + 3)) sudo -n timeout -k 2 "$hard" "$tool" "$@" &
  local p=$!; PIDS+=("$p"); wait "$p"
}

# resolve <pid|comm> — a pid stays a pid; a comm goes through pgrep -x (never -f: quirks).
resolve() {
  case "$1" in
    ''|*[!0-9]*)
      local p; p=$(pgrep -x "$1" 2>/dev/null | head -1)
      [ -n "$p" ] || { echo "pc trace: no process named '$1' (pgrep -x)" >&2; exit 1; }
      [ "$(pgrep -xc "$1" 2>/dev/null)" -gt 1 ] && NOTE="${NOTE}several '$1' processes; traced pid $p. "
      printf '%s\n' "$p";;
    *) printf '%s\n' "$1";;
  esac
}

# bt <program.bt> <pid> — the bpftrace program's maps as one JSON object; sets ATTACHED/ATTACH_MS.
bt() {
  local prog=$1 pid=${2:-0} t0 t1
  t0=${EPOCHREALTIME/./}
  run_traced 10 bpftrace -f json "$BIN/trace.d/$prog" "$pid" "$SEC" >"$WORK/out" 2>"$WORK/err"
  t1=${EPOCHREALTIME/./}
  ATTACH_MS=$(( (t1 - t0) / 1000 - SEC * 1000 )); [ "$ATTACH_MS" -lt 0 ] && ATTACH_MS=0
  ATTACHED=$(jq -s -r 'map(select(.type=="attached_probes"))|.[0].data.probes // 0' "$WORK/out" 2>/dev/null)
  grep -q '"helper_error"' "$WORK/out" && NOTE="${NOTE}some events were dropped (map full). "
  jq -s '[.[] | select(.type=="map") | .data] | add // {}' "$WORK/out" 2>/dev/null >"$WORK/maps" \
    || echo '{}' >"$WORK/maps"
}

# jq helpers shared by every verb: split a tuple key, then rank and top-N.
JQL='
def keyparts($n): (.key | split(",")) as $p
  | [ $p[0:$n-1][] ] + [ ($p[$n-1:] | join(",")) ];
def rank($secs; $n): map(. + {per_s: (((.count / $secs) * 100 | floor) / 100)})
  | sort_by(-.count) | .[0:$n];
'

# out <tsv-filter> <header> — the rows as JSON, or as a table with the footer.
ROWS='[]'
out() {
  if [ "$JSON" = 1 ]; then printf '%s\n' "$ROWS" | jq .; return 0; fi
  [ -n "$SUMMARY" ] || SUMMARY="$(printf '%s\n' "$ROWS" | jq '[.[].count // 0] | add // 0') events shown"
  { printf '%s\n' "$2"; printf '%s\n' "$ROWS" | jq -r "$1"; } | column -t -s $'\t'
  # $PROBES is this script's own format string, not user input.
  # shellcheck disable=SC2059
  printf "window %ss · %s · $PROBES%s\n" "$SEC" "$SUMMARY" "$ATTACHED" "$ATTACH_MS" "${NOTE:+ · $NOTE}"
}

# unitmap <rows> — {"<pid>":"<cgroup leaf>"} for the pids in the rows (--by unit only).
unitmap() {
  local pid out='{}'
  for pid in $(printf '%s\n' "$1" | jq -r '[.[].pid] | unique[] | select(. != null)'); do
    local u
    u=$(sed -n 's/.*:.*:\///p' "$PC_PROC/$pid/cgroup" 2>/dev/null | tail -1)
    out=$(jq -c --arg p "$pid" --arg u "${u:-"-"}" '. + {($p): $u}' <<<"$out")
  done
  printf '%s\n' "$out"
}

# group_rows <rows> — collapse by comm or cgroup unit when --by asks for it.
group_rows() {
  case "$BY" in
    pid) printf '%s\n' "$1";;
    comm) jq -c 'group_by(.comm) | map({comm: .[0].comm, pid: null, count: (map(.count) | add)})' <<<"$1";;
    unit) jq -c --argjson m "$(unitmap "$1")" \
            'map(. + {unit: ($m[(.pid|tostring)] // "-")}) | group_by(.unit)
             | map({unit: .[0].unit, comm: .[0].comm, pid: null, count: (map(.count) | add)})' <<<"$1";;
  esac
}

case "$VERB" in
wakeups)
  if [ -n "$TARGET" ]; then PIDARG=$(resolve "$TARGET") && [ -n "$PIDARG" ] || exit 1; fi
  bt wakeups.bt "$PIDARG"; m=$(<"$WORK/maps")
  raw=$(jq -c "$JQL"'(.["@wake"] // {}) | to_entries
        | map(keyparts(2) as $k | {comm: $k[0], pid: ($k[1] | tonumber), count: .value})' <<<"$m")
  ROWS=$(group_rows "$raw" | jq -c "$JQL"'rank('"$SEC"'; '"$TOPN"')')
  out '.[] | [(.unit // .comm), (.pid // "-"), .count, .per_s] | @tsv' \
      $'TASK\tPID\tWAKEUPS\tPER_S';;
disk)
  if [ -n "$TARGET" ]; then PIDARG=$(resolve "$TARGET") && [ -n "$PIDARG" ] || exit 1; fi
  bt disk.bt "$PIDARG"; m=$(<"$WORK/maps")
  ROWS=$(jq -c --argjson secs "$SEC" --argjson n "$TOPN" "$JQL"'
        ((.["@ops"] // {}) | with_entries(.value = .value)) as $ops
        | (.["@bytes"] // {}) | to_entries
        | map(keyparts(2) as $k | {comm: $k[0], rw: $k[1], bytes: .value,
              ops: ($ops[.key] // 0), count: ($ops[.key] // 0)})
        | map(. + {bytes_per_s: ((.bytes / $secs) | floor), per_s: (((.count / $secs) * 100 | floor) / 100)})
        | sort_by(-.bytes) | .[0:$n]' <<<"$m")
  out '.[] | [.comm, .rw, .bytes, .ops, .bytes_per_s] | @tsv' $'COMM\tRW\tBYTES\tOPS\tBYTES_S';;
syscalls)
  [ -n "$TARGET" ] || { echo "pc trace syscalls: need a pid or comm" >&2; exit 2; }
  pid=$(resolve "$TARGET") || exit 1; [ -n "$pid" ] || exit 1
  names=$(cached syscall-names 86400 \
    sed -n 's/^#define __NR_\([a-z0-9_]*\)[[:space:]]\+\([0-9]\+\).*/{"\2":"\1"}/p' \
      /usr/include/x86_64-linux-gnu/asm/unistd_64.h)
  names=$(jq -s -c 'add // {}' <<<"$names")
  bt syscalls.bt "$pid"; m=$(<"$WORK/maps")
  ROWS=$(jq -c --argjson names "$names" --argjson secs "$SEC" --argjson n "$TOPN" "$JQL"'
        (.["@ns"] // {}) as $ns
        | (.["@count"] // {}) | to_entries
        | map({syscall: ($names[.key] // ("#" + .key)), nr: (.key | tonumber), count: .value,
               total_ms: ((($ns[.key] // 0) / 1000) | floor / 1000),
               avg_us: (((($ns[.key] // 0) / .value / 1000) * 10 | floor) / 10)})
        | rank($secs; $n)' <<<"$m")
  out '.[] | [.syscall, .count, .per_s, .total_ms, .avg_us] | @tsv' \
      $'SYSCALL\tCOUNT\tPER_S\tTOTAL_MS\tAVG_US';;
opens)
  if [ -n "$TARGET" ]; then PIDARG=$(resolve "$TARGET") && [ -n "$PIDARG" ] || exit 1; fi
  bt opens.bt "$PIDARG"; m=$(<"$WORK/maps")
  ROWS=$(jq -c --argjson secs "$SEC" --argjson n "$TOPN" "$JQL"'
        (.["@opens"] // {}) | to_entries
        | map(keyparts(3) as $k | {comm: $k[0], pid: ($k[1] | tonumber), file: $k[2], count: .value})
        | rank($secs; $n)' <<<"$m")
  out '.[] | [.comm, .pid, .count, .file] | @tsv' $'COMM\tPID\tCOUNT\tFILE';;
execs)
  if [ -n "$TARGET" ]; then PIDARG=$(resolve "$TARGET") && [ -n "$PIDARG" ] || exit 1; fi
  bt execs.bt "$PIDARG"; m=$(<"$WORK/maps")
  ROWS=$(jq -c --argjson secs "$SEC" --argjson n "$TOPN" "$JQL"'
        (.["@execs"] // {}) | to_entries
        | map(keyparts(2) as $k | {comm: $k[0], file: $k[1], count: .value})
        | rank($secs; $n)' <<<"$m")
  out '.[] | [.comm, .count, .per_s, .file] | @tsv' $'COMM\tCOUNT\tPER_S\tFILE';;
sleep)
  if [ -n "$TARGET" ]; then PIDARG=$(resolve "$TARGET") && [ -n "$PIDARG" ] || exit 1; fi
  bt sleep.bt "$PIDARG"; m=$(<"$WORK/maps")
  ROWS=$(jq -c --argjson secs "$SEC" --argjson n "$TOPN" "$JQL"'
        (.["@min_ms"] // {}) as $t
        | (.["@sleep"] // {}) | to_entries
        | map(keyparts(3) as $k | {comm: $k[0], pid: ($k[1] | tonumber), call: $k[2],
              count: .value, min_ms: ($t[.key] // null)})
        | rank($secs; $n)' <<<"$m")
  out '.[] | [.comm, .pid, .call, .count, .per_s, (.min_ms // "-")] | @tsv' \
      $'COMM\tPID\tCALL\tCOUNT\tPER_S\tMIN_MS';;
offcpu)
  [ -n "$TARGET" ] || { echo "pc trace offcpu: need a pid or comm" >&2; exit 2; }
  pid=$(resolve "$TARGET") || exit 1; [ -n "$pid" ] || exit 1; t0=${EPOCHREALTIME/./}
  run_traced 25 offcputime-bpfcc -p "$pid" -f "$SEC" >"$WORK/out" 2>"$WORK/err"
  ATTACH_MS=$(( (${EPOCHREALTIME/./} - t0) / 1000 - SEC * 1000 )); [ "$ATTACH_MS" -lt 0 ] && ATTACH_MS=0
  ROWS=$(awk 'NF>1 {us=$NF; $NF=""; sub(/ +$/,""); printf "%s\t%s\n", us, $0}' "$WORK/out" \
    | jq -R -s --argjson n "$TOPN" 'split("\n") | map(select(length>0) | split("\t")
        | {us: (.[0] | tonumber), ms: (((.[0] | tonumber) / 100 | floor) / 10), stack: .[1]})
        | sort_by(-.us) | .[0:$n]')
  grep -q '\[unknown\]' "$WORK/out" && NOTE="${NOTE}[unknown] frames: the binary is stripped (Go and other stripped builds). "
  SUMMARY="$(printf '%s\n' "$ROWS" | jq '[.[].us] | add // 0') µs off-CPU in the top $TOPN stacks"
  [ "$(printf '%s\n' "$ROWS" | jq 'length')" = 0 ] && NOTE="${NOTE}no off-CPU interval ended inside the window: a thread that stays asleep the whole time is never counted, so widen --seconds. "
  ATTACHED=$(printf '%s\n' "$ROWS" | jq 'length'); PROBES='%s stacks, sampled in %s ms'
  out '.[] | [.us, .ms, .stack] | @tsv' $'OFFCPU_US\tMS\tSTACK';;
cpu)
  [ -n "$TARGET" ] || { echo "pc trace cpu: need a pid or comm" >&2; exit 2; }
  pid=$(resolve "$TARGET") || exit 1; [ -n "$pid" ] || exit 1; t0=${EPOCHREALTIME/./}
  run_traced 25 perf record -q -F 499 -g -p "$pid" -o "$WORK/perf.data" -- sleep "$SEC" >/dev/null 2>"$WORK/err"
  ATTACH_MS=$(( (${EPOCHREALTIME/./} - t0) / 1000 - SEC * 1000 )); [ "$ATTACH_MS" -lt 0 ] && ATTACH_MS=0
  run_traced 25 perf report --stdio --no-children -i "$WORK/perf.data" >"$WORK/out" 2>>"$WORK/err"
  ROWS=$(sed -n 's/^ *\([0-9.]*\)% *\([^ ]*\) *\([^ ]*\) *\[.\] *\(.*\)$/\1\t\2\t\3\t\4/p' "$WORK/out" \
    | jq -R -s --argjson n "$TOPN" 'split("\n") | map(select(length>0) | split("\t")
        | {percent: (.[0] | tonumber), comm: .[1], dso: .[2], symbol: (.[3] | sub(" +$"; ""))})
        | sort_by(-.percent) | .[0:$n]')
  grep -q '\[unknown\]' "$WORK/out" && NOTE="${NOTE}[unknown] frames: the binary is stripped. "
  SUMMARY="$(printf '%s\n' "$ROWS" | jq 'length') symbols shown"
  [ "$(printf '%s\n' "$ROWS" | jq 'length')" = 0 ] && NOTE="${NOTE}no samples: the pid was idle, exited, or only its children ran. "
  ATTACHED=$(sed -n 's/^# Samples: \([0-9KM]*\).*/\1/p' "$WORK/out" | head -1); ATTACHED=${ATTACHED:-0}
  PROBES='%s samples at 499 Hz, recorded in %s ms'
  out '.[] | [.percent, .comm, .dso, .symbol] | @tsv' $'PERCENT\tCOMM\tDSO\tSYMBOL';;
sched)
  t0=${EPOCHREALTIME/./}
  run_traced 25 perf sched record -q -o "$WORK/perf.data" -- sleep "$SEC" >/dev/null 2>"$WORK/err"
  ATTACH_MS=$(( (${EPOCHREALTIME/./} - t0) / 1000 - SEC * 1000 )); [ "$ATTACH_MS" -lt 0 ] && ATTACH_MS=0
  run_traced 25 perf sched latency -i "$WORK/perf.data" >"$WORK/out" 2>>"$WORK/err"
  ROWS=$(awk -F'|' 'NF>=5 && $1 ~ /:/ && $1 !~ /Task/ {
        gsub(/^ +| +$/,"",$1); gsub(/[^0-9.]/,"",$2); gsub(/[^0-9]/,"",$3);
        gsub(/[^0-9.]/,"",$4); gsub(/[^0-9.]/,"",$5);
        printf "%s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $4, $5 }' "$WORK/out" \
    | jq -R -s --argjson n "$TOPN" 'split("\n") | map(select(length>0) | split("\t")
        | {task: .[0], runtime_ms: (.[1]|tonumber? // 0), count: (.[2]|tonumber? // 0),
           avg_delay_ms: (.[3]|tonumber? // 0), max_delay_ms: (.[4]|tonumber? // 0)})
        | sort_by(-.avg_delay_ms) | .[0:$n]')
  SUMMARY="$(printf '%s\n' "$ROWS" | jq '[.[].count] | add // 0') switches in the top $TOPN tasks"
  ATTACHED=$(printf '%s\n' "$ROWS" | jq 'length'); PROBES='%s tasks, recorded in %s ms'
  out '.[] | [.task, .count, .runtime_ms, .avg_delay_ms, .max_delay_ms] | @tsv' \
      $'TASK\tSWITCHES\tRUNTIME_MS\tAVG_DELAY\tMAX_DELAY';;
raw)
  [ -n "$TARGET" ] || { echo "pc trace raw: need a bpftrace program" >&2; exit 2; }
  echo "pc trace raw: unchecked bpftrace program — kprobe:* is an unstable ABI and can wedge a probe; the ${SEC}s window and its hard timeout still apply." >&2
  if [ "$JSON" = 1 ]; then run_traced 10 bpftrace -f json -e "$TARGET"; else run_traced 10 bpftrace -e "$TARGET"; fi
  exit $?;;
*)
  echo "pc trace: unknown verb '$VERB' (try: pc trace -h)" >&2; exit 2;;
esac
