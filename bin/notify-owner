#!/usr/bin/env bash
# Send a short push to the owner's phone via ntfy.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
: "${HOME:=${here%/*/*}}"
. "$here/fleetlib.sh"

ENV_FILE="${NTFY_ENV_FILE:-$HOME/agents/secrets/ntfy.env}"
LOG_FILE="${NTFY_LOG_FILE:-$HOME/agents/log/notify.log}"
KEYS_FILE="${NTFY_KEYS_FILE:-$HOME/agents/log/notify-keys.tsv}"

usage() {
  local rc=${1:-2} fd=2; [ "$rc" = 0 ] && fd=1
  {
  echo 'usage: notify-owner [-p min|low|default|high|urgent] [-t title] [-g tags] [-k cause-key] [-a "label=body;…"] "message"'
  echo '  -a: up to 3 ntfy buttons; a tap POSTs body to the reply topic (NTFY_REPLY_TOPIC, else <topic>-picks), read by po-picks'
  echo '  -p high: same key (-k, else the text; digits and a trailing " · path" dropped) sent in 24 h → logged dup in notify-keys.tsv, not sent'
  } >&"$fd"
  exit "$rc"
}

prio=default
title="${HARNESS_HOST:-$(hostname)}"
tags=
key=
actions=
case "${1:-}" in -h|--help) usage 0 ;; esac
while getopts ':p:t:g:k:a:h' opt; do
  case "$opt" in
    p) prio=$OPTARG ;;
    t) title=$OPTARG ;;
    g) tags=$OPTARG ;;
    k) key=$OPTARG ;;
    a) actions=$OPTARG ;;
    h) usage 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage
case "$prio" in min|low|default|high|urgent) ;; *) echo "notify-owner: bad priority '$prio'" >&2; usage ;; esac
msg="$*"
[ "${#msg}" -le 200 ] || echo "notify-owner: message is ${#msg} chars (limit 200)" >&2

# A readable env file (root alarm units, fixtures) is used as is; without one the vault broker sends (T1634-V6).
via_vault=1
if [ -r "$ENV_FILE" ]; then
  via_vault=
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  : "${NTFY_URL:?}" "${NTFY_TOPIC:?}"
fi

mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$KEYS_FILE")"
if [ "$prio" = high ]; then
  key=$(printf '%s' "${key:-$msg}" | tr '\n[:upper:]' ' [:lower:]' | sed -E 's/ · [^·]*$//; s/[0-9]+//g; s/[[:space:]]+/ /g; s/^ | $//g')
  now=$(date +%s)
  if [ -r "$KEYS_FILE" ] && k="$key" awk -F'\t' -v c=$((now - 86400)) '$1 >= c && $2 == "sent" && $3 == ENVIRON["k"] {f=1} END {exit !f}' "$KEYS_FILE" \
    && ! python3 - "$KEYS_FILE" "$LOG_FILE" "${NTFY_RESOLVED_FILE:-$HOME/agents/log/notify-resolved.jsonl}" "$key" 2>/dev/null <<'PY'
# Exit 0 when the last push sent for this key was resolved with `pc need` (dashboard push_key), so it may page again.
import hashlib, json, sys
keys, log, res, key = sys.argv[1:]
msg = [l.rstrip('\n').split('\t', 3)[3] for l in open(keys) if l.split('\t')[1:3] == ['sent', key]][-1]
rows = [l.rstrip('\n').split('\t', 3) for l in open(log)]
t = [r[0] for r in rows if len(r) == 4 and r[1] == 'ok' and r[3] == msg][-1]
pk = hashlib.sha1((t + '\t' + msg).encode()).hexdigest()[:10]
state = ''
for l in open(res):
    try:
        r = json.loads(l)
    except ValueError:
        continue
    if r.get('key') == pk:
        state = r.get('state')
sys.exit(0 if state == 'resolved' else 1)
PY
  then
    printf '%s\tdup\t%s\t%s\n' "$now" "$key" "${msg//$'\n'/\\n}" >> "$KEYS_FILE"
    echo "notify-owner: same cause pushed in the last 24 h, logged dup, not sent" >&2
    exit 0
  fi
fi
case "$actions" in *[,\"\']*) echo "notify-owner: -a labels and bodies take no commas or quotes" >&2; exit 2 ;; esac
if [ -n "$via_vault" ]; then
  vargs=(-p "$prio" -t "$title")
  if [ -n "$tags" ]; then vargs+=(-g "$tags"); fi
  if [ -n "$actions" ]; then vargs+=(-a "$actions"); fi
  if printf '%s' "$msg" | "$here/secret" notify "${vargs[@]}" >/dev/null; then status=ok; else status=fail; fi
else
  args=(-fsS -m 15 -X POST -H "Title: $title" -H "Priority: $prio")
  if [ -n "$tags" ]; then args+=(-H "Tags: $tags"); fi
  if [ -n "$actions" ]; then
    IFS=';' read -ra acts <<<"$actions"; hdr=
    for a in "${acts[@]:0:3}"; do
      hdr="${hdr:+$hdr; }http, ${a%%=*}, $NTFY_URL/${NTFY_REPLY_TOPIC:-$NTFY_TOPIC-picks}, method=POST, body=${a#*=}, clear=true"
    done
    args+=(-H "Actions: $hdr")
  fi
  if printf '%s' "$msg" | curl "${args[@]}" --data-binary @- "$NTFY_URL/$NTFY_TOPIC" >/dev/null; then
    status=ok
  else
    status=fail
  fi
fi
printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "$status" "$prio" "${msg//$'\n'/\\n}" >> "$LOG_FILE"
if [ "$prio" = high ] && [ "$status" = ok ]; then printf '%s\tsent\t%s\t%s\n' "$now" "$key" "${msg//$'\n'/\\n}" >> "$KEYS_FILE"; fi
[ "$status" = ok ]
