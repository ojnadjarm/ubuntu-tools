#!/usr/bin/env bash
# tier-nightly — the change-tier safety net (T1399): what tiered tickets skipped runs once a night on a quiet machine.
set -uo pipefail
BIN="$(dirname "$(readlink -f "$0")")"
REPO="${TIER_MOOBLOX:-$HOME/projects/personal/mooblox}"
LOGS="${XDG_STATE_HOME:-$HOME/.local/state}/moodle-harness/logs"
MCI="${TIER_MCI:-$HOME/.claude/skills/moodle-ci/scripts/mci}"
STATE="${TIER_STATE:-$HOME/agents/state/tier-nightly}"
OUTDIR="${TIER_LOGDIR:-$HOME/agents/log/tier-nightly}"
LOCK="${TIER_PERF_LOCK:-/tmp/mooblox-perf.lock}"
NEVER="${TIER_NEVER:-$HOME/moodle-envs/vass $HOME/moodle-envs/4.5}"

case "${1:-}" in
  -h|--help) cat <<EOF
usage: tier-nightly    one pass, after ci-window --quiet (load < 4, no fleet CI unit active):
  1. Mooblox HEAD ($REPO, a git archive in a temp dir, npm ci): npm test, then the perf gate under
     flock $LOCK timeout 1500 (npm run test:perf; T1407 measured 1000 s with one core busy)
  2. mci full on every Moodle plugin with an mci log (<log>.plugin) newer than the last pass (first pass: 24 h);
     never under: $NEVER
The fleet suite is fleet-ci-daily's (02:10). Output: $OUTDIR/<date>.txt; exit 1 when any row is red, so the
failed unit reaches pc failures and the 08:00 digest (no push of its own).
EOF
     exit 0;;
  "") ;;
  *) echo "tier-nightly: unknown argument $1 (see --help)" >&2; exit 2;;
esac

mkdir -p "$STATE" "$OUTDIR"
exec > >(tee -a "$OUTDIR/$(date +%F).txt") 2>&1
echo "tier-nightly $(date '+%F %T')"
"$BIN/ci-window" --quiet
rows=() red=0
row() { rows+=("$(printf '%-44s %-4s %5s s' "$1" "$2" "$3")"); [ "$2" = 0 ] || red=$((red + 1)); }
timed() { local t0=$SECONDS; "${@:2}"; local rc=$?; row "$1" "$rc" $((SECONDS - t0)); return "$rc"; }

if git -C "$REPO" rev-parse --verify -q HEAD >/dev/null 2>&1; then
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  head=$(git -C "$REPO" rev-parse --short HEAD)
  git -C "$REPO" archive HEAD | tar -x -C "$tmp"
  if timed "mooblox $head npm ci" bash -c "cd '$tmp/client' && nice -n 19 npm ci --prefer-offline --no-audit --no-fund >/dev/null"; then
    timed "mooblox $head npm test" bash -c "set -o pipefail; cd '$tmp/client' && nice -n 19 npm test 2>&1 | tail -5"
    timed "mooblox $head perf gate" flock "$LOCK" timeout 1500 bash -c "set -o pipefail; cd '$tmp/client' && npm run test:perf 2>&1 | tail -15"
  fi
  rm -rf "$tmp"
else
  echo "tier-nightly: no git repo at $REPO; Mooblox skipped"
fi

since=(-mmin -1440); [ -f "$STATE/last" ] && since=(-newer "$STATE/last")
mapfile -t plugins < <(find "$LOGS" -mindepth 2 -maxdepth 2 -name 'mci-*.log.plugin' "${since[@]}" -exec cat {} + 2>/dev/null | sort -u)
for p in "${plugins[@]}"; do
  [ -d "$p" ] || continue
  skip=0; for n in $NEVER; do case "$p/" in "$n"/*) skip=1;; esac; done
  [ "$skip" = 1 ] && { echo "tier-nightly: never $p"; continue; }
  timed "mci full $p" bash -c "set -o pipefail; '$MCI' full '$p' | tail -3"
done
[ "${#plugins[@]}" -gt 0 ] || echo "tier-nightly: no mci run since the last pass"
touch "$STATE/last"

printf '%s\n' "${rows[@]}"
echo "tier-nightly: $([ "$red" = 0 ] && echo PASS || echo FAIL) $(( ${#rows[@]} - red ))/${#rows[@]} rows"
[ "$red" = 0 ]
