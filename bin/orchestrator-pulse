#!/usr/bin/env bash
# Hourly pulse: types one prompt into the orchestrator's tmux session, only when it sits idle at an empty prompt
# and the standing queue changed since the last fire (a new need id, a new failed unit, a new HEALTH.md) or the last fire
# is PULSE_FLOOR_H old; the queue at each fire is kept in PULSE_QUEUE (default pulse-queue.json beside the log).
# Fires only into the exact session's pane when it runs the orchestrator claude (--append-system-prompt-file …ORCHESTRATOR.md) and
# ~/.claude/sessions/<pid>.json confirms that pane and an idle status; anything unverifiable is a logged skip.
case "${1:-}" in -h|--help) awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; exit 0 ;; esac
set -uo pipefail
SESSION=${PULSE_SESSION:-${ORCHESTRATOR_TMUX_SESSION:-claude}}
LOG=${PULSE_LOG:-$HOME/agents/log/pulse.log}
SNAP=${PULSE_QUEUE:-$(dirname "$LOG")/pulse-queue.json}
SETTLE=${PULSE_SETTLE:-3}
FLOOR_H=${PULSE_FLOOR_H:-6}
CLAUDE_DIR=${PULSE_CLAUDE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}
MARK=${PULSE_ORCH_MARK:-ORCHESTRATOR.md}
TURN=${PULSE_TURN:-'Pulse: run plan-usage, then continue the standing queue (see ~/agents/KB/orchestrator.md "Pulse") or report nothing.'}
tm() { if [ -n "${PULSE_TMUX_SOCKET:-}" ]; then tmux -L "$PULSE_TMUX_SOCKET" "$@"; else tmux "$@"; fi; }
log() { mkdir -p "$(dirname "$LOG")"; printf '%s %s session=%s %s\n' "$(date -Is)" "$1" "$SESSION" "$2" >>"$LOG"; echo "orchestrator-pulse: $1 $2"; }
PANE=
pane() { tm capture-pane -pJt "$PANE" 2>/dev/null; }
# Prints the pid of the orchestrator claude (argv names claude and --append-system-prompt-file …$MARK) below pid $1.
orch_pid() { ps -eo pid=,ppid=,args= | awk -v root="$1" -v mark="$MARK" '
  { pp[$1] = $2; a = $0; sub(/^ *[0-9]+ +[0-9]+ +/, "", a); args[$1] = a }
  END { for (p in pp) { q = p; while (q in pp && q != root && q > 1) q = pp[q]; if (q != root || p == root) continue
          n = split(args[p], v, " "); c = 0
          for (i = 1; i <= n; i++) { if (v[i] ~ /(^|\/)claude$/) c = 1
            if (c && v[i] == "--append-system-prompt-file" && index(v[i+1], mark)) { print p; exit } } } }'; }
# Field $2 of the Claude session registry entry for pid $1 (empty when absent).
reg() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$CLAUDE_DIR/sessions/$1.json" "$2" 2>/dev/null; }
# Drops dim ghost text (prompt suggestions) and the inverse cursor cell right before it; other escapes removed.
unghost() { perl -ne '
  chomp; my ($o, $h) = ("", "");
  for my $t (split /(\e\[[0-9;:]*m)/) {
    if ($t =~ /^\e\[([0-9;:]*)m$/) {
      my @p = split /[;:]/, $1; @p = (0) unless @p;
      while (@p) {
        my $c = shift(@p) || 0;
        if ($c == 0) { $d = $i = 0 } elsif ($c == 2) { $d = 1 } elsif ($c == 22) { $d = 0 }
        elsif ($c == 7) { $i = 1 } elsif ($c == 27) { $i = 0 }
        elsif ($c =~ /^[345]8$/) { my $m = shift(@p) || 0; splice @p, 0, ($m == 5 ? 1 : $m == 2 ? 3 : 0) }
      }
      next;
    }
    next if $t eq "";
    if ($d) { $h = ""; next }
    $o .= $h; $h = "";
    if ($i) { $h = $t } else { $o .= $t }
  }
  $o .= $h; $o =~ s/\e(\[[0-9;?]*[A-Za-z]|\][^\a\e]*(\a|\e\\))//g; print "$o\n"'; }
prompt_line() { tm capture-pane -peJt "$PANE" 2>/dev/null | unghost | grep -E '^(❯|>)' | tail -n1; }
squash() { tr -s ' \n' '  '; }
# The input box text from the last prompt glyph to the box border, joined, so a wrapped prompt still matches.
box_text() { pane | awk '/^(❯|>)/{buf=""; on=1} on&&/^─/{on=0} on{buf=buf" "$0} END{print buf}' | squash; }

tm has-session -t "=$SESSION" 2>/dev/null || { log skip "no tmux session"; exit 0; }
read -r PANE ppid < <(tm display -pt "=$SESSION:" '#{pane_id} #{pane_pid}' 2>/dev/null)
[ -n "${PANE:-}" ] || { log skip "no pane"; exit 0; }
opid=$(orch_pid "$ppid")
[ -n "$opid" ] || { log skip "pane $PANE runs no orchestrator claude"; exit 0; }
case "$(reg "$opid" tmux)" in *".$PANE") ;; *) log skip "pid $opid: session registry does not confirm pane $PANE"; exit 0 ;; esac
st=$(reg "$opid" status)
[ "$st" = idle ] || { log skip "orchestrator session ${st:-unknown}, not idle"; exit 0; }
[ "$(tm display -pt "$PANE" '#{pane_in_mode}' 2>/dev/null)" = 0 ] || { log skip "pane in copy mode"; exit 0; }
a=$(pane)
case "$a" in
  *"esc to interrupt"*) log skip "turn in progress"; exit 0 ;;
  *"Waiting for"*"background"*) log skip "background agents running"; exit 0 ;;
esac
line=$(prompt_line)
[ -n "$line" ] || { log skip "no prompt box (dialog or startup)"; exit 0; }
rest=$(printf '%s' "$line" | sed -e 's/^❯//' -e 's/^>//' | tr -d ' \302\240')
[ -z "$rest" ] || { log skip "input line not empty"; exit 0; }

plan-usage --check 80 >/dev/null 2>&1; [ $? -ne 1 ] || { log skip "plan >= 80%"; exit 0; }
need_ids=$(pc need list --json 2>/dev/null | jq -r '.[].id' 2>/dev/null | sort -u)
failed_units=$(systemctl --user list-units --state=failed --plain --no-legend 2>/dev/null | awk 'NF{print $1}' | sort -u)
needs=$(printf '%s' "$need_ids" | grep -c .); failed=$(printf '%s' "$failed_units" | grep -c .)
# Ids in $1 (newline list) absent from snapshot key $2.
fresh() { comm -23 <(printf '%s\n' "$1" | grep .) <(jq -r ".$2[]?" "$SNAP" 2>/dev/null | sort -u) | paste -sd' ' -; }
new_needs=$(fresh "$need_ids" needs); new_failed=$(fresh "$failed_units" failed)
last=$(grep ' fired ' "$LOG" 2>/dev/null | tail -n1 | cut -d' ' -f1)
health=new; age=$((FLOOR_H * 3600))
if [ -n "$last" ]; then
  age=$(( $(date +%s) - $(date -d "$last" +%s) ))
  find "${AGENT_WORK:-$HOME/agent-work}"/research/*/*/HEALTH.md -newermt "$last" 2>/dev/null | grep -q . || health=unchanged
fi
queue="needs $needs, failed $failed, health $health"
new=$(printf '%s' "${new_needs:+need $new_needs; }${new_failed:+failed $new_failed; }" | sed 's/; $//'); new=${new:-none}
if [ "$new" = none ] && [ "$health" = unchanged ] && [ "$age" -lt $((FLOOR_H * 3600)) ]; then
  if [ "$needs" = 0 ] && [ "$failed" = 0 ]; then log skip "queue empty ($queue)"; else log skip "queue unchanged ($queue)"; fi
  exit 0
fi
TURN="$TURN (queue: $queue; new: $new)"
sleep "$SETTLE"
[ "$(pane)" = "$a" ] || { log skip "pane changing"; exit 0; }

tm send-keys -t "$PANE" -l "$TURN" || { log skip "send-keys failed"; exit 0; }
for _ in 1 2 3 4 5; do
  sleep 1
  if box_text | grep -qF "$(printf '%s' "$TURN" | squash)"; then tm send-keys -t "$PANE" Enter
    jq -n --arg n "$need_ids" --arg f "$failed_units" '{needs: ($n | split("\n") | map(select(. != ""))), failed: ($f | split("\n") | map(select(. != "")))}' >"$SNAP"
    log fired "prompt submitted (queue: $queue; new: $new)"; exit 0; fi
done
tm send-keys -t "$PANE" C-u
log skip "prompt never echoed whole; line cleared"
