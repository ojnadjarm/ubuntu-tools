#!/usr/bin/env bash
# Weekly maintenance: /tmp sweep (pc tmp), apt full-upgrade, autoremove, needrestart, docker image + build-cache prune, uv cache prune, reboot gate.
# Exit 0 ok · 3 reboot required but refused (deferred) · 4 reboot scheduled · 1 error.
set -uo pipefail
export LC_ALL=C DEBIAN_FRONTEND=noninteractive
export PATH="$HOME/.local/bin:$HOME/agents/bin:$PATH"
. "$(dirname "$(readlink -f "$0")")/fleetlib.sh"

WINDOW_START=4                                 # inclusive hour, Europe/Madrid — not overridable
WINDOW_END=5                                   # exclusive hour — not overridable
REBOOT_DELAY=${MAINT_REBOOT_DELAY:-5}          # minutes announced and passed to shutdown
AUTO_REBOOT=${MAINT_AUTO_REBOOT:-0}            # 1 = gated reboots; 0 or unset = never, push and exit 3 (owner 2026-09-13, T116)
DOCKER_PKGS="docker.io docker-buildx docker-compose-v2 containerd"
SETTLE_MAX=${MAINT_GATE_SETTLE:-120}           # seconds a mid-restart service may take to settle before the gate refuses (T1144)
VERDICT_UNITS=${MAINT_GATE_VERDICT_UNITS-fleet-ci-daily.service ailearning-ci-daily.service}  # CI verdicts, not machine faults (T1039)

dry=0; with_docker=0; assume_reboot=0; ignore_window=0
for a in "$@"; do case "$a" in
  --dry-run) dry=1 ;;
  --with-docker) with_docker=1 ;;
  --assume-reboot) assume_reboot=1; dry=1 ;;   # test only: pretend a reboot is required; implies --dry-run
  --dry-run-ignore-window) ignore_window=1 ;;  # test only: skip the hour gate, refused outside a dry run
  -h|--help) echo "usage: maintenance-run [--dry-run] [--with-docker] [--assume-reboot] [--dry-run-ignore-window]"; exit 0 ;;
  *) echo "maintenance-run: unknown option $a" >&2; exit 2 ;;
esac; done
if [ "$ignore_window" = 1 ] && [ "$dry" = 0 ]; then
  echo "maintenance-run: --dry-run-ignore-window requires --dry-run" >&2; exit 2
fi

STATE="$HOME/agents/maintenance/state"
SUMMARY="$STATE/last-summary.txt"
if [ "$dry" = 1 ]; then SUMMARY=/dev/null
else
  mkdir -p "$STATE"
  fleet_lock "$STATE/.lock" 9 || { echo "maintenance-run: already running"; exit 1; }
  : >"$SUMMARY"; : >"$STATE/last-apt.log"
fi

out() { printf '%s\n' "$*" | tee -a "$SUMMARY"; }
run() { if [ "$dry" = 1 ]; then out "would run: $*"; else "$@" >>"$STATE/last-apt.log" 2>&1; fi; }

out "maintenance-run $(date -Is)$([ "$dry" = 1 ] && echo " (dry-run)")"

# --- /tmp leftovers (tmpfs, held in RAM) --------------------------------------
if [ "$dry" = 1 ]; then out "would run: pc tmp --apply"
else
  tmp=$(pc tmp --apply 2>&1); trc=$?; ledger=$(grep '^ledger ' <<<"$tmp")
  if [ "$trc" = 0 ] && [ -n "$ledger" ]; then out "tmp: $ledger"; else out "maintenance-run: pc tmp failed rc $trc"; fi
fi

# --- packages ---------------------------------------------------------------
held=""
if [ "$with_docker" = 0 ]; then
  held=$(for p in $DOCKER_PKGS; do dpkg -s "$p" >/dev/null 2>&1 && printf '%s ' "$p"; done)
  if [ -n "$held" ]; then
    trap 'sudo apt-mark unhold $held >/dev/null 2>&1' EXIT INT TERM
    run sudo apt-mark hold $held
  fi
  out "docker packages held back: ${held:-none}"
fi
apt_rc=0
run sudo apt-get update -qq || apt_rc=$?
if [ "$dry" = 1 ]; then
  pend=$(apt-get -s full-upgrade 2>/dev/null | grep '^Inst ' \
         | awk -v h=" $held " '{if (index(h, " " $2 " ") == 0) n++} END{print n+0}')
  out "pending upgrades: $pend"
else
  run sudo apt-get -y full-upgrade || apt_rc=$?
  run sudo apt-get -y autoremove --purge || apt_rc=$?
  n=$(grep -c '^Setting up ' "$STATE/last-apt.log" 2>/dev/null)
  out "upgraded: ${n:-0} package operations"
fi
[ -n "$held" ] && { run sudo apt-mark unhold $held; trap - EXIT INT TERM; }
if [ "$apt_rc" != 0 ]; then
  out "apt FAILED (rc $apt_rc): see $STATE/last-apt.log"
  notify-owner -t maintenance "apt FAILED (rc $apt_rc) on ${HARNESS_HOST:-this machine}: see last-apt.log" || out "maintenance-run: notify-owner failed rc $?"
  exit 1
fi

# --- services and docker ----------------------------------------------------
svc=$(sudo needrestart -b 2>/dev/null | sed -n 's/^NEEDRESTART-SVC: //p' | tr '\n' ' ')
out "services needing restart: ${svc:-none}"
run docker image prune -af --filter until=168h
bc() { docker system df --format '{{.Type}}\t{{.Size}}' 2>/dev/null | awk -F'\t' '$1 == "Build Cache" {print $2}'; }
bc_before=$(bc)
run docker builder prune -f --filter until=168h
[ "$dry" = 1 ] || out "build cache ${bc_before:-?} → $(bc | grep . || echo ?)"
if pgrep -x uv >/dev/null 2>&1; then out "uv cache: skip: uv busy"
elif command -v uv >/dev/null; then
  uvdir=$(uv cache dir 2>/dev/null); uvmb() { du -sm "$uvdir" 2>/dev/null | cut -f1; }
  uv_before=$(uvmb)
  urc=0; run nice -n 19 uv cache prune || urc=$?
  [ "$urc" = 0 ] || out "uv cache prune FAILED rc $urc: see $STATE/last-apt.log"
  [ "$dry" = 1 ] || out "uv cache ${uv_before:-?} → $(uvmb | grep . || echo ?) MB"
else out "uv cache: skip: uv not on PATH"
fi

# --- reboot decision --------------------------------------------------------
reboot_required=0
[ -e /var/run/reboot-required ] && reboot_required=1
[ "$assume_reboot" = 1 ] && reboot_required=1
out "reboot required: $([ "$reboot_required" = 1 ] && echo yes || echo no)"
[ "$reboot_required" = 0 ] && exit 0
out "reason: $(cat /var/run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ' || echo 'simulated')"

# Owner switch first: with MAINT_AUTO_REBOOT=0 no other gate is consulted.
if [ "$AUTO_REBOOT" != 1 ]; then
  out "REBOOT REFUSED: auto-reboot-disabled-by-owner"
  msg="reboot required on ${HARNESS_HOST:-this machine} (auto-reboot off): do it yourself when convenient"
  if [ "$dry" = 1 ]; then out "would run: notify-owner -t maintenance \"$msg\""
  else notify-owner -t maintenance "$msg" || out "maintenance-run: notify-owner failed rc $?"; fi
  exit 3
fi

# Gates: all must pass or the reboot waits for the next window.
refuse=""
hour=$(TZ=Europe/Madrid date +%-H)
[ "$ignore_window" = 1 ] || { [ "$hour" -ge "$WINDOW_START" ] && [ "$hour" -lt "$WINDOW_END" ]; } \
  || refuse="$refuse time-window(now ${hour}h, allowed ${WINDOW_START}-${WINDOW_END}h Europe/Madrid);"
# The pending reboot is the fault this run clears, so it never blocks itself (T347-10); CI verdict units are dropped (T1039).
health() { # [--fresh] -> the FAIL rows that block a reboot; empty when the check passes
  local o; o=$(pc status --check "$@" 2>/dev/null) && return 0
  awk -v skip=" $VERDICT_UNITS " '
    /^FAIL host\.reboot_required:/ {next}
    /^FAIL host\.failed_units: [0-9]+: / {
      sub(/^FAIL host\.failed_units: [0-9]+: /, ""); n = split($0, u, ", "); keep = ""; k = 0
      for (i = 1; i <= n; i++) { b = u[i]; sub(/^[a-z]+:/, "", b); if (!index(skip, " " b " ")) keep = keep (k++ ? ", " : "") u[i] }
      if (k) print "FAIL host.failed_units: " k ": " keep
      next }
    {print}' <<<"${o:-no output}"
}
# settling <rows>: every row is a unit mid-restart or tailscale Starting (apt postinst restarts, T1144).
settling() { [ -n "$1" ] && ! grep -qvE '^FAIL (services\.[^:]+: (activating|deactivating|reloading)|network\.tailscale: Starting)( |$)' <<<"$1"; }
st_out=$(health); waited=0
while settling "$st_out" && [ "$waited" -lt "$SETTLE_MAX" ]; do
  sleep 10; waited=$((waited + 10)); st_out=$(health --fresh)
done
[ "$waited" = 0 ] || out "gate settle $waited s"
if [ -n "$st_out" ]; then
  fails=$(awk '/^FAIL / && n < 3 {sub(/^FAIL /, ""); printf "%s%s", (n++ ? ", " : ""), $0}' <<<"$st_out")
  refuse="$refuse pc-status-check${fails:+($fails)};"
fi
if ! bc_out=$("$HOME/agents/bin/boot-check.sh" 2>/dev/null); then
  fails=$(awk '/^FAIL / && n < 3 {sub(/^FAIL /, ""); printf "%s%s", (n++ ? ", " : ""), $0}' <<<"$bc_out")
  refuse="$refuse boot-check${fails:+($fails)};"
fi
busy=$(systemctl --user list-units --state=active --no-legend 'agent@*.service' 2>/dev/null \
       | awk '{print $1}' | grep -v "^agent@maintenance\.service$" | tr '\n' ' ')
[ -z "$busy" ] || refuse="$refuse agents-active($busy);"

if [ -n "$refuse" ]; then
  refuse="${refuse# }"; refuse="${refuse%;}"
  out "REBOOT REFUSED: $refuse"
  msg="reboot pending, window missed: $refuse"
  [ "${#msg}" -le 200 ] || msg="${msg:0:197}..."
  if [ "$dry" = 1 ]; then out "would run: notify-owner -t maintenance \"$msg\""
  else notify-owner -t maintenance "$msg" || out "maintenance-run: notify-owner failed rc $?"; fi
  exit 3
fi

out "REBOOT ALLOWED: all gates passed"
if [ "$dry" = 1 ]; then
  out "would run: notify-owner -p high -t reboot \"rebooting ${HARNESS_HOST:-this machine} in ${REBOOT_DELAY} min (kernel update)\""
  out "would run: sudo shutdown -r +${REBOOT_DELAY}"
  exit 4
fi
notify-owner -p high -t reboot "rebooting ${HARNESS_HOST:-this machine} in ${REBOOT_DELAY} min (kernel update)" || out "maintenance-run: notify-owner failed rc $?"
sudo shutdown -r "+${REBOOT_DELAY}"
out "reboot scheduled: $(date -Is)"
exit 4
