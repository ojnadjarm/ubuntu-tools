#!/usr/bin/env bash
# Resume after the kill switch: start what agents-stop listed in state/agents-stopped.list (not its killed oneshot runs),
# enable+start the units the roster in KB/orchestrator.md lists (else ~/CLAUDE.md), then resume the chat.
case "${1:-}" in -h|--help) awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; exit 0 ;; esac
set -uo pipefail
. "$HOME/agents/bin/fleetlib.sh"
fleet_path
roster="$HARNESS_HOME/KB/orchestrator.md"
[ -r "$roster" ] || roster="$HOME/CLAUDE.md"
[ -r "$roster" ] || { echo "agents-start: no roster in $HARNESS_HOME/KB/orchestrator.md or $HOME/CLAUDE.md" >&2; exit 2; }

started=""
list="$HARNESS_HOME/state/agents-stopped.list"
if [ -r "$list" ]; then
  while IFS= read -r unit; do
    [ -n "$unit" ] || continue
    case "$unit" in *.service) [ "$(systemctl --user show -p Type --value "$unit" 2>/dev/null)" = oneshot ] && continue ;; esac
    systemctl --user start "$unit" >/dev/null 2>&1 && started="$started ${unit%.timer}"
  done <"$list"
  rm -f "$list"
fi

while IFS= read -r line; do
  case "$line" in \|*) ;; *) continue ;; esac
  case "$line" in *"(disabled)"*) continue ;; esac
  unit="$(printf '%s\n' "$line" | awk -F'|' '{print $3}' | grep -o '`[^`]*`' | head -1 | tr -d '`')"
  [ -n "$unit" ] || continue
  case "$unit" in *.timer|*.service|*.path) ;; *) unit="$unit.timer" ;; esac
  systemctl --user enable --now "$unit" >/dev/null 2>&1 && started="$started ${unit%.timer}"
done <"$roster"

systemctl --user list-timers --no-pager 'agent@*' sentinel-check.timer moodle-keep-weekly.timer pcbench-weekly.timer ailearning-ci-daily.timer orchestrator-pulse.timer
chat=; chat resume --apply >/dev/null 2>&1 && chat="; chat resumed"
echo "agents-start:${started:- nothing}$chat"
