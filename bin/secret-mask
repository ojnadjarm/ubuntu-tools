#!/usr/bin/env bash
# usage: secret-mask <file>... -- <command> [args…]
# Runs the command with each listed file read as empty in its whole process tree (T1633): bwrap keeps the host as is
# (`--dev-bind / /`, same env, cwd and exit code) and binds an empty read-only file over each path that exists; with
# none existing it runs the command as is. Fails closed: without bwrap the command does not run. Exit 2 on bad usage.
help() { awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; }
case "${1:-}" in -h|--help) help; exit 0 ;; esac
set -uo pipefail
args=(--dev-bind / /)
while [ $# -gt 0 ] && [ "$1" != -- ]; do
  [ -e "$1" ] && args+=(--ro-bind-data 3 "$(readlink -f "$1")")
  shift
done
[ $# -ge 2 ] || { help >&2; exit 2; }
shift
[ ${#args[@]} -gt 3 ] || exec "$@"
# each --ro-bind-data reads its own copy of fd 3, which is /dev/null: an empty file
exec bwrap "${args[@]}" -- "$@" 3</dev/null
