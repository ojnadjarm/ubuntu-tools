#!/usr/bin/env python3
"""toolsmith-inputs [--since 4d] [--json|--md] [--qa] [--check] — read-only evidence collector for toolsmith.

One JSON object with the sections bench_last, bench_failures, audit, failures, guards, changes, doctor,
qa, idle, tokens and hold; --check exits 1 when a `hold` row changed since state/last-seen.json.
Reads only; runs no mutating verb. Root: TOOLSMITH_ROOT, else HARNESS_HOME,
else ~/agents. A live probe is replaced by $ROOT/mock/<name>.json (doctor, power, top) or
$ROOT/mock/qa.tsv when that file exists; TOOLSMITH_NO_LIVE=1 skips the rest, so tests never call pc.
"""
import argparse, json, os, re, subprocess, sys, time
from collections import Counter

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from auditlib import error_class, error_cluster, outcome_rows, parse_age, raw_call, read_jsonl, rotated_rows, row_kind

ROOT = os.environ.get('TOOLSMITH_ROOT') or os.environ.get('HARNESS_HOME') \
    or os.path.expanduser('~/agents')
MOCK = os.path.join(ROOT, 'mock')

PC_RE = re.compile(r'\bpc ([a-z][a-z0-9-]*)')


def die(msg):
    sys.exit(f'toolsmith-inputs: {msg}')


def ts_epoch(s):
    try:
        return time.mktime(time.strptime(s[:19], '%Y-%m-%dT%H:%M:%S'))
    except (ValueError, TypeError):
        return 0.0


def read_json(path, default=None):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def strip_money(obj):
    """Drop every cost key: this collector reports tokens, never amounts."""
    if isinstance(obj, dict):
        return {k: strip_money(v) for k, v in obj.items()
                if not re.search(r'cost|usd|price|spend', k, re.I)}
    if isinstance(obj, list):
        return [strip_money(v) for v in obj]
    return obj


def probe(name, argv):
    """A live pc probe, or $ROOT/mock/<name>.json when that file exists."""
    mock = os.path.join(MOCK, name + '.json')
    if os.path.exists(mock):
        return read_json(mock)
    if os.environ.get('TOOLSMITH_NO_LIVE') == '1':
        return None
    pc =os.path.join(ROOT, 'bin', 'pc')
    argv = [pc if os.path.exists(pc) else 'pc'] + argv
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


# --- sections --------------------------------------------------------------

def sec_bench_last():
    j = read_json(os.path.join(ROOT, 'bench', 'LAST.json'))
    return strip_money(j) if j else {'present': False}


def newest_rows():
    runs = os.path.join(ROOT, 'bench', 'runs')
    try:
        names = sorted(d for d in os.listdir(runs)
                       if os.path.exists(os.path.join(runs, d, 'rows.jsonl')))
    except OSError:
        return None, []
    if not names:
        return None, []
    return names[-1], read_jsonl(os.path.join(runs, names[-1], 'rows.jsonl'))


def sec_bench_failures():
    run, rows = newest_rows()
    if run is None:
        return {'present': False}
    skipped = sum(1 for r in rows if r.get('skipped'))
    rows = [r for r in rows if not r.get('skipped')]
    fails = sorted((r for r in rows if not r.get('pass')),
                   key=lambda r: (r.get('arm') != 'new', r.get('task') or '', r.get('i') or 0))
    expected = sum(1 for r in fails if r.get('arm') == 'old'
                   and (r.get('task') or '').startswith('C') and 'no --apply' in (r.get('reason') or ''))
    return {
        'present': True, 'run': run, 'trials': len(rows), 'fails': len(fails),
        'skipped': skipped, 'expected': expected,
        'by_task': dict(Counter(r.get('task') for r in fails).most_common()),
        'rows': [{
            'task': r.get('task'), 'arm': r.get('arm'), 'i': r.get('i'),
            'reason': r.get('reason'),
            'raw_recipes_detail': r.get('raw_recipes_detail') or {},
            'tool_histogram': r.get('tool_histogram') or {},
        } for r in fails],
    }


def sec_audit(since, cut):
    path = os.path.join(ROOT, 'log', 'actions.jsonl')
    rows = [r for r in rotated_rows(path, cut) if ts_epoch(r.get('ts', '')) >= cut]
    per_session, raw_by_tool, pc_verbs = {}, Counter(), Counter()
    raw_by_session, pc_by_session, raw_sessions, raw_kind = Counter(), Counter(), {}, {}
    for r in rows:
        sess = r.get('session', '')
        per_session.setdefault(sess, Counter())[(r.get('op') or '').split(' ')[0]] += 1
        if r.get('tool') != 'Bash':
            continue
        blob = r.get('summary') or ''
        hit = raw_call(r) if row_kind(r) == 'agent' else None
        if hit:
            raw_by_tool[hit[0]] += 1
            raw_by_session[sess] += 1
            raw_sessions.setdefault(hit[0], set()).add(sess)
            raw_kind[hit[0]] = hit[1:]
        for verb in PC_RE.findall(blob):
            pc_verbs[verb] += 1
            pc_by_session[sess] += 1
    offenders = [{'session': s, 'raw': n, 'pc': pc_by_session.get(s, 0)}
                 for s, n in raw_by_session.most_common(5)]
    raw_map = [{'raw': t, 'class': raw_kind[t][0], 'pc': raw_kind[t][1], 'count': n,
                'sessions': len(raw_sessions.get(t, ()))}
               for t, n in raw_by_tool.most_common()]
    by = Counter()
    for r in raw_map:
        by[r['class']] += r['count']
    base = by['covered'] + by['gap']
    return {
        'raw_kind': 'agent', 'raw_map': raw_map, 'raw_coverable': by['covered'],
        'raw_by_design': by['by-design'],
        'raw_gap': by['gap'], 'raw_coverable_pct': round(100 * by['covered'] / base) if base else 0,
        'raw_gaps': [r['raw'] for r in raw_map if r['class'] == 'gap'],
        'present': os.path.exists(path), 'since': since, 'lines': len(rows),
        'sessions': {s: dict(c.most_common(10)) for s, c in per_session.items()},
        'raw_total': sum(raw_by_tool.values()), 'raw_by_tool': dict(raw_by_tool.most_common()),
        'pc_total': sum(pc_verbs.values()), 'pc_verbs': dict(pc_verbs.most_common(10)),
        'top_raw_offenders': offenders,
    }


def sec_failures(cut):
    """Failed agent and interactive calls in the window: classes, rate on real, by op, top 5 real clusters, newest errors."""
    window = outcome_rows([r for r in rotated_rows(os.path.join(ROOT, 'log', 'actions.jsonl'), cut)
                           if ts_epoch(r.get('ts', '')) >= cut])
    rows = [r for r in window if row_kind(r) != 'bench']
    bad = [r for r in rows if r.get('ok') is False]
    by_class = Counter({c: 0 for c in ('guarded', 'probe', 'red-first', 'real')})
    by_class.update(error_class(r) for r in bad)
    real = [r for r in bad if error_class(r) == 'real']
    keys = Counter(error_cluster(r) for r in real)
    return {'rows': len(bad), 'of': len(rows),
            'rate_pct': round(100 * len(real) / len(rows), 2) if rows else 0,
            'by_class': dict(by_class),
            'bench_rows': sum(1 for r in window if r.get('ok') is False and row_kind(r) == 'bench'),
            'clusters': [{'key': k, 'n': n, 'sessions': len({r.get('session') for r in real if error_cluster(r) == k})}
                         for k, n in keys.most_common(5)],
            'by_op': dict(Counter(r.get('op') or r.get('tool') for r in bad).most_common(10)),
            'recent': [{'ts': r.get('ts'), 'session': r.get('session'), 'agent_id': r.get('agent_id'),
                        'op': r.get('op'), 'error': r.get('error')} for r in bad[-5:]]}


def sec_guards(cut):
    path = os.path.join(ROOT, 'log', 'guards.jsonl')
    if not os.path.exists(path):
        return {'present': False, 'rows': 0}
    rows = [r for r in read_jsonl(path) if ts_epoch(r.get('ts', '')) >= cut]
    return {'present': True, 'rows': len(rows),
            'by_reason': dict(Counter(r.get('rule') or r.get('reason') or r.get('guard') for r in rows).most_common())}


def sec_changes(cut):
    path = os.path.join(ROOT, 'log', 'changes.jsonl')
    rows = rotated_rows(path, cut)
    verdict = {r['id']: r for r in rows if 'verified' in r and 'id' in r}
    applies = [r for r in rows if 'target' in r]
    window = [r for r in applies if ts_epoch(r.get('ts', '')) >= cut]
    verified = unverified = undone = 0
    for n, r in enumerate(applies):
        if ts_epoch(r.get('ts', '')) < cut:
            continue
        if verdict.get(r.get('id'), {}).get('verified') is True:
            verified += 1
        else:
            unverified += 1
        # An undo is a later ledgered change that puts the same target back.
        if any(later.get('target') == r.get('target') and later.get('before') == r.get('after')
               and later.get('after') == r.get('before') for later in applies[n + 1:]):
            undone += 1
    return {'present': os.path.exists(path), 'total': len(applies), 'window': len(window),
            'verified': verified, 'unverified': unverified, 'undone': undone,
            'unverified_ids': [r.get('id') for r in window
                               if verdict.get(r.get('id'), {}).get('verified') is not True][:10]}


def sec_doctor():
    rows = probe('doctor', ['doctor', '--quick', '--json'])
    if not isinstance(rows, list):
        return {'present': False, 'fail': 0, 'rows': []}
    fails = [{'name': r.get('name'), 'detail': r.get('detail')}
             for r in rows if r.get('status') == 'FAIL']
    return {'present': True, 'checks': len(rows), 'fail': len(fails), 'rows': fails}


def qa_table(text):
    out = {}
    for line in text.splitlines():
        f = line.split('\t')
        if len(f) >= 5 and f[0] != 'module':
            try:
                out[f[0]] = [int(x) for x in f[1:5]]
            except ValueError:
                continue
    return out


def sec_qa(run_qa):
    if not run_qa:
        return {'ran': False, 'hint': 'pass --qa (runs the linters, several seconds)'}
    mock = os.path.join(MOCK, 'qa.tsv')
    script = os.path.join(ROOT, 'bin', 'tests', 'qa-metrics.sh')
    if os.path.exists(mock):
        with open(mock) as fh:
            cur = qa_table(fh.read())
    elif os.path.exists(script):
        try:
            cur = qa_table(subprocess.run(['bash', script], capture_output=True,
                                          text=True, timeout=600).stdout)
        except (OSError, subprocess.SubprocessError):
            return {'ran': False, 'error': 'qa-metrics.sh did not finish'}
    else:
        return {'ran': False, 'error': 'no qa-metrics.sh'}
    base = {}
    bpath = os.path.join(ROOT, 'bin', 'tests', 'BASELINE-QA.tsv')
    if os.path.exists(bpath):
        with open(bpath) as fh:
            base = qa_table(fh.read())
    cols = ['lines', 'dupes', 'shellcheck', 'ccn_gt15']
    mods = []
    for m, vals in cur.items():
        row = {'module': m}
        row.update(dict(zip(cols, vals)))
        if m in base:
            row['delta'] = dict(zip(cols, [v - b for v, b in zip(vals, base[m])]))
        mods.append(row)
    return {'ran': True, 'baseline': bool(base), 'modules': mods,
            'worse': [m['module'] for m in mods
                      if any(v > 0 for k, v in m.get('delta', {}).items() if k != 'lines')]}


OWN_UNIT = 'agent@toolsmith.service'
IDLE_COLS = ['t', 'seconds', 'samples', 'package_w', 'psys_w', 'psys_sd', 'top_waker', 'wake_s',
             'fleet_rss_mb', 'other_rss_mb', 'top_waker_unit', 'other_top']


def own_pids():
    """This process and its ancestors: the run calling the collector."""
    pids, pid = set(), os.getpid()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        try:
            with open(f'/proc/{pid}/stat') as f:
                pid = int(f.read().rsplit(')', 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return pids


def idle_baseline():
    """The newest row of bench/BASELINE-IDLE.tsv (pc idle, Sunday, away and quiet), or None."""
    try:
        with open(os.path.join(ROOT, 'bench', 'BASELINE-IDLE.tsv')) as f:
            rows = [ln.rstrip('\n').split('\t') for ln in f if ln.strip() and not ln.startswith('#')]
    except OSError:
        return None
    if not rows:
        return None
    row = dict(zip(IDLE_COLS, rows[-1]))
    for k in ('package_w', 'psys_w', 'wake_s', 'fleet_rss_mb', 'other_rss_mb'):
        try:
            row[k] = float(row[k])
        except (KeyError, ValueError):
            row[k] = None
    return {k: row.get(k) for k in ('t', 'package_w', 'psys_w', 'top_waker', 'top_waker_unit',
                                    'wake_s', 'fleet_rss_mb', 'other_rss_mb', 'other_top')}


def sec_idle():
    power = probe('power', ['power', '--json']) or {}
    rapl = power.get('rapl') or {}
    top = probe('top', ['top', '--json', '--sort', 'wake', '-n', '8'])
    mine = own_pids()
    rows = [r for r in top if r.get('unit') != OWN_UNIT and r.get('pid') not in mine] \
        if isinstance(top, list) else []
    wakers = [{'comm': r.get('comm'), 'wake': r.get('wake'), 'unit': r.get('unit'),
               'rss_kb': r.get('rss')} for r in rows[:5]]
    return {'baseline': idle_baseline(),
            'live': {'present': bool(rapl) or bool(wakers),
                     'package_w': rapl.get('package_w'), 'core_w': rapl.get('core_w'),
                     'psys_w': rapl.get('psys_w'),
                     'gpu_rc6_pct': (power.get('gpu') or {}).get('rc6_pct'),
                     'wakers': wakers}}


def cell_int(fields, i):
    """One TSV cell as an int; missing or non-numeric is 0."""
    if i is None or len(fields) <= i or not fields[i].isdigit():
        return 0
    return int(fields[i])


def sec_hold():
    """Owner-held BACKLOG rows (cells after rank) and those that changed since last-seen.json."""
    ts = os.path.join(ROOT, 'toolsmith')
    rows = {}
    try:
        for line in open(os.path.join(ts, 'BACKLOG.md')):
            c = [x.strip() for x in line.strip().strip('|').split('|')]
            if len(c) > 4 and c[4] == 'hold':
                rows[c[1]] = ' | '.join(c[1:])
    except OSError:
        pass
    seen = (read_json(os.path.join(ts, 'state', 'last-seen.json'), {}) or {}).get('hold') or {}
    return {'rows': rows, 'changed': sorted(k for k, v in seen.items() if rows.get(k) != v)}


def sec_tokens(cut):
    agents, seen_cols = {}, False
    try:
        names = sorted(os.listdir(ROOT))
    except OSError:
        names = []
    for name in names:
        path = os.path.join(ROOT, name, 'logs', 'index.tsv')
        if not os.path.exists(path):
            continue
        with open(path) as fh:
            head = fh.readline().rstrip('\n').split('\t')
            idx = {c: i for i, c in enumerate(head)}
            ci = next((idx[c] for c in ('tokens_in', 'input_tokens', 'in_tokens') if c in idx), None)
            co = next((idx[c] for c in ('tokens_out', 'output_tokens', 'out_tokens') if c in idx), None)
            if ci is None and co is None:
                continue
            seen_cols = True
            cr = idx.get('cache_r')
            ct = idx.get('tool_calls')
            ch = idx.get('histogram')
            runs = partial = tin = tout = tcache = tcalls = 0
            hist = {}
            for line in fh:
                f = line.rstrip('\n').split('\t')
                if len(f) <= max(x for x in (ci, co) if x is not None):
                    continue
                if 'start' in idx and ts_epoch(f[idx['start']]) < cut:
                    continue
                runs += 1
                tcalls += cell_int(f, ct)
                row = {}
                if ch is not None and len(f) > ch:
                    for pair in f[ch].split(','):
                        k, _, v = pair.partition('=')
                        if k and v.isdigit():
                            row[k] = int(v)
                            hist[k] = hist.get(k, 0) + int(v)
                # A Workflow run's index row holds only the outer turn; its subagents' tokens are missing.
                if row.get('Workflow'):
                    partial += 1
                    continue
                tin += cell_int(f, ci)
                tout += cell_int(f, co)
                tcache += cell_int(f, cr)
            if runs:
                full = runs - partial
                avg = (lambda n: round(n / full)) if full else (lambda n: None)
                agents[name] = {'runs': runs, 'partial_runs': partial,
                                'tokens_partial': bool(partial),
                                'in': tin, 'out': tout, 'cache_r': tcache,
                                'in_per_run': avg(tin), 'out_per_run': avg(tout),
                                'cache_r_per_run': avg(tcache),
                                'tool_calls': tcalls,
                                'tool_calls_per_run': round(tcalls / runs),
                                'tool_histogram': dict(sorted(hist.items(),
                                                             key=lambda kv: -kv[1]))}
    return {'columns_present': seen_cols, 'agents': agents,
            'note': None if seen_cols else 'no token columns in */logs/index.tsv yet'}


# --- rendering -------------------------------------------------------------

def md(d):
    L = [f"# toolsmith inputs — {d['generated']} (since {d['since']})", '']
    b = d['bench_last']
    if b.get('runs'):
        arms = ' · '.join(f"{k} pass={v.get('pass')} passN={v.get('passN')} residue={v.get('residue')}"
                          for k, v in (b.get('arms') or {}).items())
        L += ['## bench_last', f"- {b.get('ts', '?')} · {b.get('trials', '?')} trials · {arms}",
              f"- regressions: {', '.join(b.get('regressions') or []) or 'none'}", '']
    f = d['bench_failures']
    if f.get('present'):
        by = ', '.join(f'{k}={v}' for k, v in f['by_task'].items()) or 'none'
        L += ['## bench_failures', f"- run {f['run']}: {f['fails']}/{f['trials']} failed "
              f"(expected old C-tier no --apply {f['expected']}, skipped {f['skipped']})",
              f"- by task: {by}"]
        L += [f"  - {r['task']}/{r['arm']}#{r['i']}: {(r['reason'] or '')[:90]}" for r in f['rows'][:10]]
        L.append('')
    a = d['audit']
    L += ['## audit',
          f"- {a['lines']} rows, {len(a['sessions'])} sessions · raw={a['raw_total']} pc={a['pc_total']}",
          f"- raw by class ({a['raw_kind']} runs only): covered {a['raw_coverable']} · "
          f"by-design {a['raw_by_design']} · "
          f"gap {a['raw_gap']} ({a['raw_coverable_pct']}% coverable)",
          '- raw: ' + (', '.join(f'{k}={v}' for k, v in a['raw_by_tool'].items()) or 'none'),
          '- top raw sessions: ' + (', '.join(f"{o['session']}(raw {o['raw']}/pc {o['pc']})"
                                              for o in a['top_raw_offenders']) or 'none'), '']
    fl = d['failures']
    bc = fl['by_class']
    L += [f"- failures: {bc['real']} real of {fl['of']} calls ({fl['rate_pct']:.1f}%) · guarded {bc['guarded']} · "
          f"probe {bc['probe']} · red-first {bc['red-first']} · bench {fl['bench_rows']} · "
          + (', '.join(f'{k}={v}' for k, v in fl['by_op'].items()) or 'none')]
    L += [f"  - {c['n']}× {c['sessions']} sess: {c['key']}" for c in fl['clusters']] + ['']
    c, g, doc = d['changes'], d['guards'], d['doctor']
    fails = '; '.join(f"{r['name']} {r['detail']}" for r in doc['rows'])
    L += ['## guards · changes · doctor',
          f"- guards: {g['rows']} rows" + ('' if g['present'] else ' (no guards.jsonl)'),
          f"- changes: {c['window']} in window · verified {c['verified']} · "
          f"unverified {c['unverified']} · undone {c['undone']}",
          f"- doctor FAIL: {doc['fail']}" + (f': {fails}' if fails else ''), '']
    q = d['qa']
    if q.get('ran'):
        L += ['## qa', '- worse than baseline: ' + (', '.join(q['worse']) or 'none'), '']
    b, i = d['idle']['baseline'], d['idle']['live']
    L += ['## idle']
    if b:
        L.append(f"- baseline {b['t']}: package {b['package_w']} W · psys {b['psys_w']} W · "
                 f"top waker {b['top_waker']}({b['wake_s']}/s, {b['top_waker_unit'] or '?'}) · "
                 f"fleet {b['fleet_rss_mb']} MB · other {b['other_rss_mb']} MB ({b['other_top'] or '?'})")
    else:
        L.append('- baseline: none (no bench/BASELINE-IDLE.tsv row)')
    L += [f"- live (biased by this run): package {i['package_w']} W · core {i['core_w']} W · "
          f"gpu rc6 {i['gpu_rc6_pct']}%",
          '- live wakers: ' + (', '.join(f"{w['comm']}({w['wake']}/s)" for w in i['wakers']) or 'none'), '']
    t = d['tokens']
    q = lambda x: '?' if x is None else x
    L += ['## tokens',
          '- ' + (', '.join(f"{k}: {q(v['in_per_run'])} in / {q(v['out_per_run'])} out / "
                            f"{q(v['cache_r_per_run'])} cache_r per run, "
                            f"{v['tool_calls_per_run']} tool calls"
                            + (f" ({v['partial_runs']} Workflow run(s) partial, not averaged)"
                               if v['partial_runs'] else '')
                            for k, v in t['agents'].items()) or (t['note'] or 'none')), '']
    tops = {k: ', '.join(f"{n}={c}" for n, c in list(v['tool_histogram'].items())[:5])
            for k, v in t['agents'].items() if v['tool_histogram']}
    if tops:
        L += ['- tools: ' + '; '.join(f"{k}: {v}" for k, v in tops.items()), '']
    return '\n'.join(L)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('--since', default='4d', help='age window, e.g. 12h, 4d (default 4d)')
    ap.add_argument('--json', action='store_true', help='one JSON object (default)')
    ap.add_argument('--md', action='store_true', help='markdown digest instead of JSON')
    ap.add_argument('--qa', action='store_true', help='also run qa-metrics.sh (several seconds)')
    ap.add_argument('--check', action='store_true',
                    help='exit 1 if a hold row changed since state/last-seen.json')
    a = ap.parse_args()
    if a.check:
        h = sec_hold()
        for k in h['changed']:
            print(f"hold changed: {k} now {h['rows'].get(k, 'gone')}")
        print(f"hold: {len(h['rows'])} rows, {len(h['changed'])} changed")
        sys.exit(1 if h['changed'] else 0)
    try:
        cut = time.time() - parse_age(a.since)
    except ValueError as e:
        die(e)
    d = {
        'generated': time.strftime('%Y-%m-%dT%H:%M:%S'), 'since': a.since,
        'bench_last': sec_bench_last(), 'bench_failures': sec_bench_failures(),
        'audit': sec_audit(a.since, cut), 'failures': sec_failures(cut), 'guards': sec_guards(cut), 'changes': sec_changes(cut),
        'doctor': sec_doctor(), 'qa': sec_qa(a.qa), 'idle': sec_idle(), 'tokens': sec_tokens(cut),
        'hold': sec_hold(),
    }
    print(md(d) if a.md else json.dumps(strip_money(d), indent=1))


if __name__ == '__main__':
    main()
