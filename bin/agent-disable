#!/usr/bin/env bash
# Disable and stop one agent's timer.
set -euo pipefail
usage() { echo "usage: agent-disable <name>"; }
case "${1:-}" in -h|--help) usage; exit 0 ;; -*) usage >&2; exit 2 ;; esac
[ $# -eq 1 ] || { usage >&2; exit 2; }
. "$HOME/agents/bin/fleetlib.sh"
agent_name_check agent-disable "$1" || exit 2
systemctl --user disable --now "agent@$1.timer" 2>/dev/null || true
echo "agent $1 disabled"
