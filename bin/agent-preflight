#!/usr/bin/env bash
# agent-preflight — the first command of every Dark-Eye agent: the six things every
# one of them re-derived by hand, the three rules and the three commands. < 0.5 s.
# Exit 1 when code is newer than the running body, the tree cannot be read, or a hand-run body is live ("do not restart").
set -uo pipefail

EYE=${DARK_EYE_DIR:-$HOME/the-dark-eye}
BRIEF=""
usage() { echo 'usage: agent-preflight [--brief]   Dark-Eye state, rules, commands; --brief: state only'; }
for a in "$@"; do
  case "$a" in
    --brief) BRIEF=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agent-preflight: unknown argument: $a" >&2; usage >&2; exit 2 ;;
  esac
done

# --- the probes, all at once ------------------------------------------------
T=$(mktemp -d) || exit 1; trap 'rm -rf "$T"' EXIT
{
  systemctl --user show dark-eye --timestamp=unix -p ActiveState,SubState,NRestarts,MainPID,ActiveEnterTimestamp > $T/unit 2>/dev/null
} &
{ journalctl --user -u dark-eye -n 400 --no-pager -o cat 2>/dev/null |
    grep -E 'eye up at|\[eye-render\] backend ' | tail -3 > $T/journal; } &
{ eye health 2>/dev/null > $T/health; eye status 2>/dev/null > $T/orbit; } &
{ git -C "$EYE" status --porcelain > $T/git 2>$T/giterr && : > $T/giterr; } &
{ pactl get-default-sink 2>/dev/null > $T/sink
  pactl list sinks short 2>/dev/null | grep -c bluez > $T/buds
  pw-metadata -n settings 2>/dev/null | sed -n "s/.*'log.level' value:'\\([0-9]*\\)'.*/log.level \\1/p" | head -1 > $T/pwlog; } &
wait

. $T/unit 2>/dev/null || true
BACKEND=$(grep -o 'backend [a-z]*' $T/journal | tail -1)
LASTUP=$(grep 'eye up at' $T/journal | tail -1)
DIRTY=$(wc -l < $T/git)
# shipped code (body/src, eye-render, bridge; tests excluded) changed or deleted since the unit started
STARTED=${ActiveEnterTimestamp:-} STARTED=${STARTED#@} NEWER="" TREEERR=""
[ -z "${ActiveState:-}" ] && TREEERR="systemctl show dark-eye printed nothing"
if [ "${ActiveState:-}" = active ] && [ -n "$STARTED" ] && [ "$STARTED" != 0 ]; then
  SHIPPED=(body/src bridge body/render/target/release/eye-render)
  if ! TREEERR=$(cd "$EYE" 2>&1); then
    TREEERR="cd: ${TREEERR#*cd: }"
  elif [ -s $T/giterr ]; then
    TREEERR="git: $(head -1 $T/giterr)"
  else
    HAVE=(); for f in "${SHIPPED[@]}"; do [ -e "$EYE/$f" ] && HAVE+=("$f"); done
    [ ${#HAVE[@]} -gt 0 ] && NEWER=$(cd "$EYE" && find "${HAVE[@]}" -type f -newermt "@$STARTED" 2>$T/find)
    [ -s $T/find ] && TREEERR=$(head -1 $T/find)
    # a deletion, a rename's old path or a copy's new path counts when its nearest existing directory changed after the start
    while read -r f; do
      d=$(dirname "$f"); while [ "$d" != . ] && [ ! -d "$EYE/$d" ]; do d=$(dirname "$d"); done
      [ "$(stat -c %Y "$EYE/$d")" -ge "$STARTED" ] && NEWER+=$'\n'"$f"
    done < <(sed -nE -e 's/^(R.|.R) (.*) -> .*/\2/p;t' -e 's/^(C.|.C) .* -> //p;t' -e 's/^(D.|.D) //p' "$T/git" | grep -E '^(body/src|bridge)/')
    NEWER=$(grep -vE '(^|/)tests?/|\.test\.' <<<"$NEWER" | grep . | sort)
  fi
fi
NNEWER=$(grep -c . <<<"$NEWER")
SINK=$(cat $T/sink)
BUDS=$(cat $T/buds)
PWLOG=$(cat $T/pwlog)
HOUR=$(date +%H)

# a hand-run body / eye-render is any such pid outside the unit's cgroup; a sandbox
# one carries DARK_EYE_SANDBOX and is not a hijack (EF03 rule 3 reaps it after 2 h)
HAND="" SAND=""
# `pgrep -f` would match this script's own command line (quirks), so: -x, then /proc
for p in $(pgrep -x eye-render 2>/dev/null; pgrep -x node 2>/dev/null); do
  grep -q 'dark-eye.service' "/proc/$p/cgroup" 2>/dev/null && continue
  tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'the-dark-eye/body' || continue
  if tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -q '^DARK_EYE_SANDBOX='; then
    SAND="$SAND $p"
  else
    HAND="$HAND $p"
  fi
done

# --- the screen -------------------------------------------------------------
echo "UNIT      ${ActiveState:-?}/${SubState:-?} pid ${MainPID:-?} NRestarts=${NRestarts:-?} ${BACKEND:-backend ?}"
echo "          ${LASTUP:-no 'eye up at' in the last 400 lines}"
echo "BRIDGE    $(cat $T/health 2>/dev/null || echo 'no answer')"
if [ -n "$TREEERR" ]; then
  echo "TREE      unknown ($TREEERR) — do not restart"
elif [ "${ActiveState:-}" != active ] || [ -z "$STARTED" ] || [ "$STARTED" = 0 ]; then
  echo "TREE      body not running ($DIRTY dirty in $EYE)"
elif [ "$NNEWER" -eq 0 ]; then
  echo "TREE      $DIRTY dirty, 0 newer than the running body (started $(date -d "@$STARTED" '+%m-%d %H:%M')) — a restart ships the running code"
else
  echo "TREE      $DIRTY dirty, $NNEWER newer than the running body (started $(date -d "@$STARTED" '+%m-%d %H:%M')) — DO NOT RESTART: $(head -5 <<<"$NEWER" | paste -sd' ')"
fi
echo "HAND-RUN  ${HAND:-none}${HAND:+ — outside the unit cgroup, DO NOT RESTART}${SAND:+   sandbox:$SAND}"
echo "ORBITERS  $(cat $T/orbit 2>/dev/null || echo '-')"
echo "CHANNEL   ${HOUR}h · sink $SINK · bluez sinks $BUDS · pipewire ${PWLOG:-log.level ?}"

if [ -z "$BRIEF" ]; then
  cat <<'EOF'

RULES     kill by PID (never killall / pkill -f) · never restart dark-eye without the
          orchestrator · the live render.sock, orbiters.json and remote sessions are off limits
COMMANDS  eval "$(body-sandbox up --name t1 --eye offscreen --stats --audio null)"   # isolated body
          body-sandbox eye --dump /tmp/f.png --scene idle                  # offscreen frame
          MEASURE_PIDS=$MEASURE_PIDS bash ~/the-dark-eye/body/scripts/measure.sh --state idle
          body-sandbox down --name t1                                      # no residue
EOF
fi

{ [ "$NNEWER" -gt 0 ] || [ -n "$TREEERR" ] || [ -n "$HAND" ]; } && exit 1
exit 0
