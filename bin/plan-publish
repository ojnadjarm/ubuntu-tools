#!/usr/bin/env python3
"""Publish a markdown or html file as a page on the local dashboard and record it in plans/index.json."""
import argparse, json, os, re, subprocess, sys, time
from datetime import date

HOME = os.path.expanduser("~")
PLANS = os.path.join(HOME, "agents", "dashboard", "plans")
INDEX = os.path.join(PLANS, "index.json")
def public_host():
    """The tailnet name, so the URL works from his phone."""
    h = os.environ.get("HARNESS_TAILNET_FQDN")
    if not h:
        cfg = os.path.join(HOME, ".config/pc-harness/config.env")
        if os.path.exists(cfg):
            m = re.search(r"^HARNESS_TAILNET_FQDN=(.+)$", open(cfg).read(), re.M)
            h = m.group(1).strip() if m else ""
    return h or "127.0.0.1"


PUBLIC_HOST = public_host()
PORT = 19998

SHELL = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>%(title)s</title>
<link rel="icon" href="data:image/svg+xml,%%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%%3E%%3Crect width='32' height='32' fill='%%23000'/%%3E%%3Cpath d='M4 4h8v2H6v6H4zM20 4h8v8h-2V6h-6zM4 20h2v6h6v2H4zM26 20h2v8h-8v-2h6z' fill='%%234dffa0'/%%3E%%3Ccircle cx='16' cy='16' r='4' fill='%%234dffa0'/%%3E%%3C/svg%%3E">
<link rel="stylesheet" href="/static/eye.css">
</head><body><main class="page">
<nav><a href="/#plans">&larr; panel · plans</a><span>%(kind)s</span></nav>
<p class="meta">%(date)s</p>
<article class="prose">
%(body)s
</article>
<script>(function(){var h=document.querySelectorAll(".prose h2");if(!h.length)return;var o=document.createElement("ol");o.className="toc";h.forEach(function(x,i){x.id=x.id||"s"+(i+1);var a=document.createElement("a");a.href="#"+x.id;a.textContent=x.textContent;var li=document.createElement("li");li.appendChild(a);o.appendChild(li);});document.querySelector(".page .meta").appendChild(o);})();</script>
</main></body></html>
"""

def slugify(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:48] or "plan"


def render_markdown(text):
    import markdown
    return markdown.markdown(
        text, extensions=["extra", "sane_lists"],
        output_format="html5")


def load_index():
    if os.path.exists(INDEX):
        try:
            return json.load(open(INDEX))
        except ValueError:
            pass
    return []


def main():
    ap = argparse.ArgumentParser(prog="plan-publish", description=__doc__)
    ap.add_argument("file")
    ap.add_argument("--title", default="")
    ap.add_argument("--kind", default="plan", choices=["plan", "report", "preview"])
    ap.add_argument("--slug", default="")
    ap.add_argument("--link", action="store_true", help="also put the link on his Eye page")
    a = ap.parse_args()

    src = os.path.abspath(os.path.expanduser(a.file))
    if not os.path.isfile(src):
        sys.exit("plan-publish: no such file: %s" % src)
    raw = open(src, encoding="utf-8").read()
    title = a.title or next(
        (l.lstrip("# ").strip() for l in raw.splitlines() if l.startswith("# ")),
        os.path.splitext(os.path.basename(src))[0])
    today = date.today().isoformat()
    slug = slugify(a.slug or title)
    name = "%s-%s" % (slug, today)

    if src.lower().endswith((".html", ".htm")):
        page = raw
    else:
        body = render_markdown(raw)
        if "<h1>" not in body:
            body = "<h1>%s</h1>\n%s" % (title, body)
        page = SHELL % {"title": title, "kind": a.kind, "date": today, "body": body}

    out = os.path.join(PLANS, name)
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, "index.html"), "w", encoding="utf-8") as f:
        f.write(page)

    url = "http://%s:%d/plans/%s/" % (PUBLIC_HOST, PORT, name)
    entry = {"slug": name, "title": title, "kind": a.kind, "date": today,
             "source": src, "url": "/plans/%s/" % name,
             "updated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
             "bytes": len(page.encode())}
    idx = [e for e in load_index() if e.get("slug") != name]
    idx.append(entry)
    idx.sort(key=lambda e: e.get("updated", ""), reverse=True)
    os.makedirs(PLANS, exist_ok=True)
    with open(INDEX, "w", encoding="utf-8") as f:
        json.dump(idx, f, indent=1)

    if a.link:
        subprocess.run(["eye", "link", url, title, "--to", "remote"], check=False)
    print(url)


if __name__ == "__main__":
    main()
