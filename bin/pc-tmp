#!/usr/bin/env bash
# pc tmp [--apply] — /tmp (tmpfs, RAM) leftovers: leaked test dirs, finished tickets' scratch, old build caches; dry run lists them.
set -uo pipefail
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc tmp [--apply]

Lists KIND PATH MB AGE REASON for what is safe to delete from $PC_TMP_ROOT (default /tmp):
  test-dir  tmp.* directories idle > 24 h
  scratch   <scratchpad>/T<n>*/ idle > 6 h whose T<n> has a done line in $PC_TMP_HISTORY
            (default ~/agent-work/history.md, "- <date> T<n>") and no row on $PC_TMP_CLAIMS
            (default ~/agents/FILE-CLAIMS.md); Vass sessions are never read
  build     remotion-webpack-bundle-* and cc*.ltrans* idle > 24 h
Idle = newest mtime anywhere in the tree. A path a process holds open (fd or cwd) is skipped.
--apply deletes the listed paths and appends one ledger entry (after: "deleted N, failed M");
a path still present after rm -rf is named on stderr and exits 1; nothing to roll back (scratch only).' "$@"

PC_SUB='pc tmp'
pc_opt "$@"
: "${PC_TMP_ROOT:=/tmp}" "${PC_TMP_HISTORY:=$HOME/agent-work/history.md}" "${PC_TMP_CLAIMS:=$HOME/agents/FILE-CLAIMS.md}"
ROOT=$(readlink -f -- "$PC_TMP_ROOT")
case $ROOT in /tmp|/tmp/*) ;; *) echo "pc tmp: refused, PC_TMP_ROOT must be under /tmp ($ROOT)" >&2; exit 2;; esac
printf -v NOW '%(%s)T' -1

# idle_h <path> — hours since the newest mtime in the tree.
idle_h() {
  local t; t=$(find "$1" -printf '%T@\n' 2>/dev/null | sort -rn | head -1)
  echo $(( (NOW - ${t%.*}) / 3600 ))
}

# Every path under ROOT that a process holds open, as fd target or cwd.
OPEN=$(find "$PC_PROC"/[0-9]*/fd -maxdepth 1 -type l -printf '%l\n' 2>/dev/null
       find "$PC_PROC"/[0-9]*/cwd -maxdepth 0 -printf '%l\n' 2>/dev/null)
OPEN=$(grep -F -- "$ROOT/" <<<"$OPEN" | sed 's/ (deleted)$//' | sort -u)
held() { [ -n "$OPEN" ] && awk -v p="$1" 'index($0, p) == 1 && (length($0) == length(p) || substr($0, length(p) + 1, 1) == "/") {f=1; exit} END {exit !f}' <<<"$OPEN"; }

ROWS=(); SKIPPED=0
add() {  # add <kind> <path> <idle_h> <reason>
  if held "$2"; then SKIPPED=$((SKIPPED + 1)); return; fi
  ROWS+=("$1"$'\t'"$2"$'\t'"$(du -sm -- "$2" 2>/dev/null | cut -f1)"$'\t'"$3h"$'\t'"$4")
}

me=$(id -u)
for p in "$ROOT"/tmp.*; do
  [ -d "$p" ] && [ -O "$p" ] || continue
  h=$(idle_h "$p"); [ "$h" -ge 24 ] && add test-dir "$p" "$h" "idle ${h}h > 24h"
done
for p in "$ROOT"/remotion-webpack-bundle-* "$ROOT"/cc*.ltrans*; do
  [ -e "$p" ] && [ -O "$p" ] || continue
  h=$(idle_h "$p"); [ "$h" -ge 24 ] && add build "$p" "$h" "idle ${h}h > 24h"
done
for p in "$ROOT"/claude-"$me"/*/*/scratchpad/T[0-9]*/; do
  p=${p%/}; [ -d "$p" ] || continue
  case $p in *vass*) continue;; esac
  t=$(grep -oE '^T[0-9]+' <<<"${p##*/}")
  grep -qE "^- [0-9]{4}-[0-9]{2}-[0-9]{2} $t([^0-9]|$)" "$PC_TMP_HISTORY" 2>/dev/null || continue
  grep -qE "^- $t([^0-9]|$)" "$PC_TMP_CLAIMS" 2>/dev/null && continue
  h=$(idle_h "$p"); [ "$h" -ge 6 ] && add scratch "$p" "$h" "$t done, no claim, idle ${h}h > 6h"
done

total=0
{ printf 'KIND\tPATH\tMB\tAGE\tREASON\n'
  for r in ${ROWS[@]+"${ROWS[@]}"}; do printf '%s\n' "$r"; done; } | column -t -s $'\t'
for r in ${ROWS[@]+"${ROWS[@]}"}; do IFS=$'\t' read -r _ _ mb _ <<<"$r"; total=$((total + ${mb:-0})); done
summary="${#ROWS[@]} paths, $total MB"
[ "$SKIPPED" -gt 0 ] && echo "kept (open fd/cwd): $SKIPPED"

if [ "$APPLY" != 1 ]; then echo "would: delete $summary (--apply)"; exit 0; fi
deleted=0; FAILED=()
for r in ${ROWS[@]+"${ROWS[@]}"}; do
  IFS=$'\t' read -r _ p _ <<<"$r"
  case $p in "$ROOT"/?*) rm -rf -- "$p" 2>/dev/null;; esac
  if [ -e "$p" ] || [ -L "$p" ]; then FAILED+=("$p"); else deleted=$((deleted + 1)); fi
done
after="deleted $deleted, failed ${#FAILED[@]}"
[ "${#FAILED[@]}" -gt 0 ] && after+=": ${FAILED[*]}"
id=$(pc_id); printf -v ts '%(%Y-%m-%dT%H:%M:%S%z)T' -1
mkdir -p "${PC_LEDGER%/*}"
pc_json '{ts:$ts,id:$id,agent:$ag,cmd:"pc tmp --apply",target:"tmp leftovers",before:$b,after:$a,rollback:"none, scratch only",verified:($f == "0")}' -c \
  --arg ts "$ts" --arg id "$id" --arg ag "${AGENT_NAME:-}" --arg b "$summary" --arg a "$after" --arg f "${#FAILED[@]}" >>"$PC_LEDGER"
echo "ledger $id: $after (of $summary)"
for p in ${FAILED[@]+"${FAILED[@]}"}; do echo "pc tmp: still present after rm -rf: $p" >&2; done
echo "rollback: none, scratch only"
[ "${#FAILED[@]}" -eq 0 ]
