#!/usr/bin/env bash
# quiet-gate — one quiet-machine rule: rc 0 when the 1-min load (and with --gpu the shared GPU) is below the limit, rc 3 busy; sourceable for qg_load1/qg_nproc/qg_gpu_pct (T595, T617).

qg_load1() { local l _; read -r l _ <"${1:-${QUIET_LOADAVG:-/proc/loadavg}}"; echo "$l"; }
qg_nproc() { echo "${QUIET_NPROC:-$(nproc)}"; }

# One snapshot of a /proc tree ROOT: "client-id render-ns" per DRM client of this user, minus the compositor and the process tree of PID.
qg_gpu_clients() {
  { grep -s -H -E '^(Name|PPid|Uid):' "$1"/[0-9]*/status; grep -s -H -E '^drm-(client-id|engine-render):' "$1"/[0-9]*/fdinfo/* || true; } |
    awk -v root="$1" -v skip="${2:-}" -v uid="$(id -u)" '
      {
        i = index($0, ":"); p = substr($0, length(root) + 2, i - length(root) - 2); r = substr($0, i + 1)
        j = index(r, ":"); k = substr(r, 1, j - 1); v = substr(r, j + 1); sub(/^[ \t]+/, "", v); split(p, a, "/")
        if (k == "Name") name[a[1]] = v
        else if (k == "PPid") pp[a[1]] = v
        else if (k == "Uid") { split(v, u, /[ \t]+/); own[a[1]] = u[1] }
        else if (k == "drm-client-id") cid[p] = v
        else { ns[p] = v + 0; pid[p] = a[1] }
      }
      END {
        if (skip != "") out[skip] = 1
        do { ch = 0; for (q in pp) if (!(q in out) && (pp[q] in out)) { out[q] = 1; ch = 1 } } while (ch)
        for (f in ns) { q = pid[f]; if (!(q in out) && own[q] == uid && name[q] !~ /^(gnome-shell|Xwayland)$/) c[cid[f]] = ns[f] }
        for (k in c) printf "%s %.0f\n", k, c[k]
      }'
}

# Render-engine busy % over ~1 s summed across those clients (PID's tree excluded); fixture: QUIET_FDINFO/a and /b, 1 s apart.
qg_gpu_pct() {
  local a b t0=0 t1=1000000000
  if [ -n "${QUIET_FDINFO:-}" ]; then
    a=$(qg_gpu_clients "$QUIET_FDINFO/a" "${1:-}"); b=$(qg_gpu_clients "$QUIET_FDINFO/b" "${1:-}")
  else
    t0=$(date +%s%N); a=$(qg_gpu_clients /proc "${1:-}"); sleep "${QUIET_GPU_SECS:-1}"
    t1=$(date +%s%N); b=$(qg_gpu_clients /proc "${1:-}")
  fi
  awk -v dt=$((t1 - t0)) 'NR == FNR {a[$1] = $2; next} {d = $2 - a[$1]; if (d > 0) s += d} END {printf "%.0f\n", 100 * s / dt}' \
    <(echo "$a") <(echo "$b")
}

qg_usage() {
  cat <<'EOF2'
usage: quiet-gate [--max-load1 N | --max-per-cpu F] [--gpu [PCT]] [--wait S] [--json]
  quiet when load1 < N, else load1 < F × nproc (default F 0.25; an empty N falls back to F, so callers pass both); --wait polls (wait-for, every $QUIET_EVERY s, default 15) up to S s
  --gpu: also busy when the user's other GPU clients (gnome-shell/Xwayland excluded) keep the render engine > PCT % busy over 1 s (default 15)
  exit 0 quiet · 3 busy · 2 usage; fixtures: QUIET_LOADAVG (a loadavg file), QUIET_NPROC, QUIET_FDINFO (dir with /proc-shaped snapshots a/ and b/)
EOF2
}

qg_main() {
  local abs="" per=0.25 wait=0 json=0 gpu="" pct="" max load1 np rc t0 waited why
  while [ $# -gt 0 ]; do
    case $1 in
      --max-load1) abs=${2?}; shift 2 ;;
      --max-per-cpu) per=${2:?}; shift 2 ;;
      --gpu) if [[ ${2:-} =~ ^[0-9.]+$ ]]; then gpu=$2; shift; else gpu=15; fi; shift ;;
      --wait) wait=${2:?}; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) qg_usage; return 0 ;;
      *) qg_usage >&2; return 2 ;;
    esac
  done
  np=$(qg_nproc)
  max=${abs:-$(awk -v f="$per" -v n="$np" 'BEGIN {print f * n}')}
  quiet() { awk -v m="$max" '{exit !($1 < m)}' "${QUIET_LOADAVG:-/proc/loadavg}"; }
  gpu_quiet() { [ -z "$gpu" ] || { pct=$(qg_gpu_pct); awk -v p="$pct" -v m="$gpu" 'BEGIN {exit !(p <= m)}'; }; }
  t0=$(date +%s)
  quiet; rc=$?
  gpu_quiet || rc=3
  if [ "$rc" != 0 ] && [ "$wait" -gt 0 ]; then
    timeout "$wait" "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/wait-for" --label "quiet-gate: load1 < $max${gpu:+, gpu <= $gpu%}" \
      --every "${QUIET_EVERY:-15}" --until "'$(readlink -f "${BASH_SOURCE[0]}")' --max-load1 $max${gpu:+ --gpu $gpu}" >/dev/null
    rc=$?
    [ -z "$gpu" ] || pct=$(qg_gpu_pct)
  fi
  [ "$rc" = 0 ] || rc=3
  load1=$(qg_load1); waited=$(( $(date +%s) - t0 ))
  if [ "$json" = 1 ]; then
    printf '{"quiet":%s,"load1":%s,"max":%s,"nproc":%s,"waited_s":%s%s}\n' "$([ "$rc" = 0 ] && echo true || echo false)" "$load1" "$max" "$np" "$waited" \
      "${gpu:+,\"gpu_busy_pct\":$pct}"
  elif [ "$rc" = 0 ]; then echo "quiet-gate: quiet, load1 $load1 < $max${gpu:+, gpu $pct% <= $gpu%}"
  else
    why=$(awk -v l="$load1" -v m="$max" 'BEGIN {if (l >= m) print "load1 " l " >= " m}')
    [ -n "$gpu" ] && awk -v p="$pct" -v m="$gpu" 'BEGIN {exit !(p > m)}' && why="${why:+$why, }gpu $pct% > $gpu%"
    echo "quiet-gate: busy, ${why:-load1 $load1 >= $max}$([ "$wait" -gt 0 ] && echo " after $waited s")"
  fi
  return "$rc"
}

[[ ${BASH_SOURCE[0]} == "$0" ]] && { set -uo pipefail; qg_main "$@"; exit $?; }
true
