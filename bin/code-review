#!/usr/bin/env python3
"""code-review — the deterministic half of the weekly code-review swarm (T74): roots, policy, evidence, backups, retire, report."""
import argparse
import json
import os
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(BIN, '..', 'lib'), BIN]
from code_review import backups, claims, common, evidence, fixes, lanes, policy, report, retire, snapshot  # noqa: E402

COMMANDS = {
    'prep': lanes.cmd_prep, 'claim': claims.cmd_claim, 'unclaim': claims.cmd_unclaim, 'backup': backups.cmd_backup,
    'restore': backups.cmd_restore, 'tests': fixes.cmd_tests, 'lint': fixes.cmd_lint, 'cleanup': fixes.cmd_cleanup,
    'deliver': report.cmd_deliver, 'retire': retire.cmd_retire, 'queue-new': retire.cmd_queue_new,
    'finish': report.cmd_finish, 'snapshot': snapshot.cmd_snapshot, 'snapdiff': snapshot.cmd_snapdiff,
}


def main():
    ap = argparse.ArgumentParser(prog='code-review', description=__doc__)
    sub = ap.add_subparsers(dest='cmd', required=True)
    sub.add_parser('prep', help='pick the run id; write state/runs/<run>/args.json for swarm.js; print its path')
    p = sub.add_parser('policy', help='print edit|retire-only|review-only|forbidden per path')
    p.add_argument('paths', nargs='+')
    p = sub.add_parser('usage', help='audit-log uses per name in the last N days, and log coverage')
    p.add_argument('names', nargs='+')
    p.add_argument('--days', type=int, default=common.UNUSED_DAYS)
    p = sub.add_parser('refs', help='files that reference an item (outside the item)')
    p.add_argument('path')
    p = sub.add_parser('claim', help='claim paths in FILE-CLAIMS.md for a finding; rc 3 if another ticket holds one')
    p.add_argument('id')
    p.add_argument('paths', nargs='+')
    p = sub.add_parser('unclaim', help='drop the claim rows of a finding')
    p.add_argument('id')
    p = sub.add_parser('backup', help='back up the paths a fix will touch (absent ones too)')
    p.add_argument('id')
    p.add_argument('paths', nargs='+')
    p = sub.add_parser('restore', help='restore a backup without deleting anything: code-review restore <run> <id>')
    p.add_argument('run')
    p.add_argument('id')
    p = sub.add_parser('tests', help='run the area tests of a backed-up finding (serialized); after = verify; rc 5 = not verified')
    p.add_argument('id')
    p.add_argument('phase', choices=['before', 'after'])
    p = sub.add_parser('lint', help='checks for areas without tests: skills frontmatter, guide INDEX slugs')
    p.add_argument('what', choices=['skills', 'guides'])
    sub.add_parser('cleanup', help='after a session: drop stale code-review claims, restore unverified backups')
    sub.add_parser('deliver', help='publish the findings doc and send the one weekly push (outside the sandbox)')
    p = sub.add_parser('retire', help='move a NOT USEFUL item to backups/retired/<date>/ after the gates; rc 4 = kept')
    p.add_argument('path')
    p.add_argument('--id', default='')
    p.add_argument('--why', default='', help='broken | duplicate | superseded | obsolete (low use is never a reason)')
    p.add_argument('--by', default='', help='duplicate/superseded: the item that does the job at least as well')
    p.add_argument('--proof', default='', help='duplicate/superseded: file with the side-by-side run')
    p.add_argument('--check', action='store_true', help='only evaluate the gates')
    p = sub.add_parser('queue-new', help='reserve improve/queue/CR-NNN.md; print its path')
    p.add_argument('title')
    p.add_argument('--cls', default='owner-go', choices=['auto', 'owner-go', 'owner-reboot'])
    p = sub.add_parser('finish', help='seen.jsonl, findings.md, REPORT.md, outbox for deliver')
    p.add_argument('--run', default='')
    sub.add_parser('containment', help='absolute paths the sandbox mounts read-only because the swarm must not change itself')
    p = sub.add_parser('snapshot', help='sha256 of every file under roots → JSON')
    p.add_argument('out')
    p.add_argument('roots', nargs='+')
    p = sub.add_parser('snapdiff', help='compare two snapshots; rc 1 on any difference')
    p.add_argument('a')
    p.add_argument('b')
    a = ap.parse_args()
    if a.cmd == 'policy':
        for x in a.paths:
            print(f'{policy.policy(x)}\t{x}')
    elif a.cmd == 'usage':
        print(json.dumps(evidence.usage(a.names, a.days), indent=1))
    elif a.cmd == 'containment':
        print('\n'.join(policy.containment(common.REAL_HOME)))
    elif a.cmd == 'refs':
        r = evidence.refs(a.path)
        print('\n'.join(r) if r else 'no references')
    else:
        COMMANDS[a.cmd](a)


main()
