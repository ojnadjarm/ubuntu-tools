#!/usr/bin/env python3
"""secret: the vault's client CLI (T1634); names, classes, ages and the log, never a value."""
import base64
import datetime
import getpass
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from vault import briefline, registry, wire  # noqa: E402

SOCK = os.environ.get("FLEET_VAULT_SOCKET", "/run/fleet-vault/admin.sock")
REG = os.environ.get("FLEET_VAULT_REGISTRY", "/etc/fleet-vault/registry.toml")
SECRETS = os.path.join(os.environ.get("HARNESS_HOME", os.path.expanduser("~/agents")), "secrets")
USAGE = f"""usage: secret list [--json]             names, class, state, age, last use; never a value
       secret add <name> [--class free|ruled|critical --used-in TEXT] [--ticket T<n>]
                                        read a value with no echo (or the first line of piped stdin) and seal it;
                                        a name outside the registry needs --class and --used-in
       secret replace <name> [--ticket T<n>]   a new value for a known name; the old one is never shown
       secret remove <name> [--ticket T<n>]    drop a sealed value (and a hand-added name)
       secret grant <name> --ticket T<n> [--ttl S] [--cap USD] [--asked "<requester's words>"] [--wait S]
                                        a lease (printed alone on stdout) for one secret, one ticket, S seconds
                                        (default 3600); class ruled needs its rule met (openrouter: --asked),
                                        critical waits (--wait S) for approval. Calls then go to
                                        http://127.0.0.1:<FLEET_VAULT_PORT>/<lease>/<name>/<path>
       secret leases --from <brief> --ticket T<n> [--ttl S] [--wait S]
                                        one lease per name on the brief's `Secrets: <name>[, <name>]` line (and
                                        openrouter on `AI image grant: "<quote>"`, the quote as --asked); prints
                                        FLEET_LEASE_<NAME>=<lease> lines; exit 3 when any name was refused.
                                        Launchers call it (agent-exec --secrets-from, po-work, liaison jobs);
                                        asked from inside an agent (agents.slice) the broker refuses and it is raised
       secret revoke <lease>|-           end a lease early (- : lease ids from stdin, one per line)
       secret used <name> --target <unit> [--ticket T<n>]
                                        log one use of a unit-mode secret (its consumer's unit calls it)
       secret notify [-p PRIO] [-t TITLE] [-g TAGS] [-a "label=body;…"] [words]
                                        push the words (else stdin) to the owner; the broker holds the ntfy topic
       secret picks [--since ID|TIME|10m] the owner's button taps on the reply topic, one JSON line each
       secret approve|deny <ref>         answer a pending critical lease (never from inside an agent)
       secret pending                    critical lease requests and their state
       secret log [-n N] [name]          the vault's events: time, event, secret, ticket, agent, result
       secret known <name>               exit 0 when <name> is a row of the installed registry
socket {SOCK} (FLEET_VAULT_SOCKET); registry {REG} (FLEET_VAULT_REGISTRY);
a refused self-grant the broker could not push runs SECRET_RAISE_CMD (default: notify-owner -p high), never a value"""


def die(msg, rc=1):
    print(f"secret: {msg}", file=sys.stderr)
    sys.exit(rc)


def usage_error():
    print(USAGE, file=sys.stderr)
    sys.exit(2)


def call(req):
    try:
        r = wire.call(SOCK, req)
    except (OSError, ValueError) as e:
        die(f"broker unreachable at {SOCK} ({type(e).__name__}); is fleet-vault.service running?")
    if not r.get("ok"):
        die(r.get("error", "refused"))
    return r


def ago(ts):
    if ts is None:
        return "-"
    s = max(0, time.time() - ts)
    return f"{int(s // 86400)}d" if s >= 86400 else f"{int(s // 3600)}h" if s >= 3600 else f"{int(s // 60)}m"


def state(row):
    """sealed, file (today's legacy file, not moved yet) or empty; with the matching sealed-at time."""
    if row["sealed"]:
        return "sealed", row["sealed_at"]
    if row["legacy"]:
        try:
            return "file", os.stat(os.path.join(SECRETS, row["legacy"])).st_mtime
        except OSError:
            pass
    return "empty", None


def cmd_list(args):
    if args not in ([], ["--json"]):
        usage_error()
    rows = call({"op": "list"})["secrets"]
    for r in rows:
        r["state"], r["since"] = state(r)
    if args:
        print(json.dumps(rows, indent=1))
        return
    print(f"{'NAME':<20} {'CLASS':<9} {'STATE':<7} {'AGE':>5} {'LAST USE':>8} {'7D':>4}  USED IN")
    for r in rows:
        print(f"{r['name']:<20} {r['class']:<9} {r['state']:<7} {ago(r['since']):>5} {ago(r['last_used']):>8} "
              f"{r['uses_7d']:>4}  {r['used_in']}")


def read_value(name):
    if sys.stdin.isatty():
        v = getpass.getpass(f"secret for {name} (no echo): ")
    else:
        v = sys.stdin.readline()
    v = v.rstrip("\r\n")
    if not v:
        die("empty value; nothing sealed")
    return v.encode()


def opts(args, allowed):
    """Split [name] and --flag value pairs; exit 2 on anything else."""
    name, out, i = None, {}, 0
    while i < len(args):
        a = args[i]
        if a in allowed and i + 1 < len(args):
            out[allowed[a]] = args[i + 1]
            i += 2
        elif (a == "-" or not a.startswith("-")) and name is None:
            name, i = a, i + 1
        else:
            usage_error()
    if name is None:
        usage_error()
    return name, out


def cmd_put(args, replace):
    allowed = {"--ticket": "ticket"} if replace else {"--ticket": "ticket", "--class": "class", "--used-in": "used_in"}
    name, o = opts(args, allowed)
    if not registry.NAME.match(name):
        die(f"bad name '{name}': lowercase letters, digits, '-'", 2)
    value = read_value(name)
    req = {"op": "put", "name": name, "replace": replace, "agent": os.environ.get("AGENT_NAME", ""),
           "value_b64": base64.b64encode(value).decode(), **o}
    del value
    r = call(req)
    print(f"secret: {r['event']} {name}: sealed (value not shown)")


def cmd_remove(args):
    name, o = opts(args, {"--ticket": "ticket"})
    call({"op": "remove", "name": name, "agent": os.environ.get("AGENT_NAME", ""), **o})
    print(f"secret: removed {name}")


def raise_owner(name, o):
    """Push the owner a refused self-grant (the broker logged it already)."""
    who = os.environ.get("AGENT_NAME") or "an agent"
    try:
        subprocess.run(os.environ.get("SECRET_RAISE_CMD", "notify-owner -p high").split() + [f"vault: {who} asked a lease on {name} ({o.get('ticket', '-')}) "
                        "from inside an agent; refused. Grants come from a brief's Secrets: line."[:200]],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        pass


def grant(name, o, wait=0):
    """(reply) for one grant request; a pending critical one is asked again every 5 s for up to wait seconds;
    a refusal of a caller inside an agent the broker could not push is raised here."""
    end = time.time() + wait
    while True:
        try:
            r = wire.call(SOCK, {"op": "grant", "name": name, "agent": os.environ.get("AGENT_NAME", ""), **o})
        except (OSError, ValueError) as e:
            return {"ok": False, "error": f"broker unreachable at {SOCK} ({type(e).__name__})"}
        if r.get("raise"):
            raise_owner(name, o)
        if not r.get("pending") or time.time() >= end:
            return r
        print(f"secret: {name} waits for approval (ref {r['pending']})", file=sys.stderr)
        time.sleep(5)


def until(r):
    cap = f", cap {r['cap']:.2f} USD" if r.get("cap") else ""
    return f"until {datetime.datetime.fromtimestamp(r['expires']).isoformat(timespec='seconds')}{cap}"


def cmd_grant(args):
    name, o = opts(args, {"--ticket": "ticket", "--ttl": "ttl", "--cap": "cap", "--asked": "asked", "--wait": "wait"})
    if "ticket" not in o:
        die("a lease needs --ticket", 2)
    r = grant(name, o, seconds(o.pop("wait", "0")))
    if not r.get("ok"):
        die(r.get("error", "refused"))
    print(r["lease"])
    print(f"secret: lease on {name} {until(r)}", file=sys.stderr)


def cmd_leases(args):
    o, i = {}, 0
    flags = {"--from": "from", "--ticket": "ticket", "--ttl": "ttl", "--wait": "wait"}
    while i < len(args):
        if args[i] in flags and i + 1 < len(args):
            o[flags[args[i]]], i = args[i + 1], i + 2
        else:
            usage_error()
    if "from" not in o or "ticket" not in o:
        usage_error()
    try:
        with open(o["from"], encoding="utf-8", errors="replace") as f:
            names, asked, bad = briefline.parse(f.read())
    except OSError as e:
        die(f"cannot read {o['from']} ({e.strerror})", 2)
    for b in bad:
        print(f"secret: '{b}' on the Secrets: line is not a name; skipped", file=sys.stderr)
    req = {"ticket": o["ticket"], **({"ttl": o["ttl"]} if "ttl" in o else {}), **({"asked": asked} if asked else {})}
    refused = bool(bad)
    for name in names:
        r = grant(name, req, seconds(o.get("wait", "0")))
        if r.get("ok"):
            print(f"{briefline.env_name(name)}={r['lease']}")
            print(f"secret: lease on {name} for {o['ticket']} {until(r)}", file=sys.stderr)
        else:
            refused = True
            print(f"secret: no lease on {name}: {r.get('error', 'refused')}", file=sys.stderr)
    sys.exit(3 if refused else 0)


def cmd_revoke(args):
    lease, o = opts(args, {"--ticket": "ticket"})
    for lid in ([x.strip() for x in sys.stdin if x.strip()] if lease == "-" else [lease]):
        call({"op": "revoke", "lease": lid, "agent": os.environ.get("AGENT_NAME", ""), **o})
        print("secret: lease revoked")


def cmd_used(args):
    name, o = opts(args, {"--target": "target", "--ticket": "ticket"})
    if "target" not in o:
        die("used needs --target <unit>", 2)
    call({"op": "used", "name": name, "agent": os.environ.get("AGENT_NAME", ""), **o})


def seconds(v):
    if not str(v).isdigit():
        die("--wait takes whole seconds", 2)
    return int(v)


def cmd_notify(args):
    o, words, i = {}, [], 0
    flags = {"-p": "priority", "-t": "title", "-g": "tags", "-a": "actions"}
    while i < len(args):
        if args[i] in flags and i + 1 < len(args):
            o[flags[args[i]]], i = args[i + 1], i + 2
        else:
            words, i = words + [args[i]], i + 1
    msg = " ".join(words) if words else sys.stdin.read()
    buttons = [a.split("=", 1) for a in o.pop("actions", "").split(";") if "=" in a][:3]
    call({"op": "use", "name": "ntfy", "path": "/notify", "agent": os.environ.get("AGENT_NAME", ""),
          "args": {"message": msg, "buttons": buttons, **o}})


def cmd_picks(args):
    if args and (len(args) != 2 or args[0] != "--since"):
        usage_error()
    r = call({"op": "use", "name": "ntfy", "path": "/picks", "agent": os.environ.get("AGENT_NAME", ""),
              "args": {"since": args[1] if args else "10m"}})
    sys.stdout.write(r["body"])


def cmd_decide(args, yes):
    if len(args) != 1:
        usage_error()
    r = call({"op": "approve" if yes else "deny", "ref": args[0], "agent": os.environ.get("AGENT_NAME", "")})
    print(f"secret: {r['state']} {r['name']} for {r['ticket']} (ref {r['ref']})")


def cmd_pending(args):
    if args:
        usage_error()
    for p in call({"op": "pending"})["pending"]:
        t = datetime.datetime.fromtimestamp(p["created"]).isoformat(timespec="seconds")
        print(f"{p['ref']} {t} {p['state']:<8} {p['name']:<20} {p['ticket']} {p['agent'] or '-'} {p['by']}".rstrip())


def cmd_log(args):
    n, name = 20, None
    while args:
        a = args.pop(0)
        if a == "-n" and args and args[0].isdigit():
            n = int(args.pop(0))
        elif not a.startswith("-") and name is None:
            name = a
        else:
            usage_error()
    for e in call({"op": "log", "n": n, "name": name})["events"]:
        t = datetime.datetime.fromtimestamp(e.get("ts", 0)).isoformat(timespec="seconds")
        rest = " ".join(f"{k}={e[k]}" for k in ("ticket", "agent", "target", "status", "cost", "why", "uid") if k in e)
        print(f"{t} {e.get('event', '?'):<8} {e.get('secret', '-'):<20} {e.get('result', '-'):<8} {rest}".rstrip())


def cmd_known(args):
    if len(args) != 1:
        usage_error()
    try:
        names = registry.load(REG)
    except (OSError, ValueError):
        sys.exit(1)
    sys.exit(0 if args[0] in names else 1)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        sys.exit(0 if argv else 2)
    verb, args = argv[0], argv[1:]
    if "-h" in args or "--help" in args:
        print(USAGE)
        sys.exit(0)
    if verb == "list":
        cmd_list(args)
    elif verb in ("add", "replace"):
        cmd_put(args, verb == "replace")
    elif verb == "remove":
        cmd_remove(args)
    elif verb == "grant":
        cmd_grant(args)
    elif verb == "leases":
        cmd_leases(args)
    elif verb == "revoke":
        cmd_revoke(args)
    elif verb == "used":
        cmd_used(args)
    elif verb == "notify":
        cmd_notify(args)
    elif verb == "picks":
        cmd_picks(args)
    elif verb in ("approve", "deny"):
        cmd_decide(args, verb == "approve")
    elif verb == "pending":
        cmd_pending(args)
    elif verb == "log":
        cmd_log(args)
    elif verb == "known":
        cmd_known(args)
    else:
        usage_error()


if __name__ == "__main__":
    main(sys.argv[1:])
