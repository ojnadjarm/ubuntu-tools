#!/usr/bin/env bash
# drop-link — publish a file or folder into ~/drop/<sub>/ and print its checked https link (tailscale serve :8470 → caddy :8070).
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/env.sh"

DROP=${DROP_DIR:-$HOME/drop}
BASE=${DROP_URL:-https://${HARNESS_TAILNET_FQDN:-$HARNESS_HOST}:8470}

usage() {
  cat <<'EOF'
usage: drop-link [--allow-intermediates] <file|dir> <sub>    hard-link (copy across filesystems) into ~/drop/<sub>/, print the https URL, check it answers 200
       drop-link [--allow-intermediates] <path-in-drop>      print and check the URL of something already in ~/drop
A folder with no index.html gets the dashboard Files link (:8498/#files?p=…, previews images); a folder with one and index.html get a trailing-slash URL; other .html files open as pages; any other file downloads.
Refused: a path holding node_modules or lossless intermediates (.mkv FFV1 composites, .y4m, .exr; T360); --allow-intermediates for a deliberate case.
exit 0 link answers 200 · 1 link does not answer · 2 usage · 3 refused
EOF
}

[ "${1:-}" = -h ] || [ "${1:-}" = --help ] && { usage; exit 0; }
allow=0; [ "${1:-}" = --allow-intermediates ] && { allow=1; shift; }
[ -e "${1:-}" ] || { usage >&2; exit 2; }
src=$(readlink -f "$1"); drop=$(readlink -f "$DROP")
heavy=$(find "$src" \( -name node_modules -o -iname '*.mkv' -o -iname '*.y4m' -o -iname '*.exr' \) -print -quit 2>/dev/null)
[ -z "$heavy" ] || [ "$allow" = 1 ] || { echo "drop-link: refused, $heavy is node_modules or a lossless intermediate: delete it, or pass --allow-intermediates for a deliberate case" >&2; exit 3; }

if [[ "$src" == "$drop"/* ]]; then
  dest=$src
else
  [[ "${2:-}" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] && [[ "/$2/" != */./* && "/$2/" != */../* ]] || { usage >&2; exit 2; }
  mkdir -p "$drop/$2"
  dest="$drop/$2/$(basename "$src")"
  rm -rf -- "$dest"
  if [ -d "$src" ]; then cp -al "$src" "$dest" 2>/dev/null || { rm -rf -- "$dest"; cp -a "$src" "$dest"; }
  else ln "$src" "$dest" 2>/dev/null || cp -a "$src" "$dest"; fi
fi

rel=${dest#"$drop"/}
case "$rel" in
  */index.html|index.html) rel=${rel%index.html} ;;
esac
[ -d "$dest" ] && rel="$rel/"
if [ -d "$dest" ] && [ ! -e "$dest/index.html" ]; then
  url="${DROP_FILES_URL:-https://${HARNESS_TAILNET_FQDN:-$HARNESS_HOST}:8498}/#files?p=$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1].rstrip("/"),safe=""))' "$rel")"
else
  url="$BASE/$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$rel")"
fi
code=$(curl -s -o /dev/null -w '%{http_code}' -I --max-time 10 "$url")
echo "$url"
[ "$code" = 200 ] || { echo "drop-link: $url answered $code" >&2; exit 1; }
