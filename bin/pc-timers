#!/usr/bin/env bash
# pc timers [--since 7d] [--overlap] [--free 45m] [--json] — every system+user timer: next run, last start/end and CPU s from the journal; overlapping runs; the first free slot.
# shellcheck disable=SC2034
set -uo pipefail
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc timers [--since 7d] [--overlap] [--free 45m] [--json]

Lists every system and user timer with its next run and its last run (start, end, CPU s) read
from the journal'"'"'s Starting/Started, Finished/Failed and Consumed lines of the unit it activates,
plus snapd'"'"'s refresh.timer as a pseudo-timer (`snap refresh --time`). Rows sort by the time of
day of the last start, so the list reads as the day'"'"'s map.
--overlap  pairs of jobs whose runs in the window intersected: both windows, both CPU s, minutes
           shared (latest intersection per pair); snapd'"'"'s refresh window counts as a job.
--free D   the first window of length D (45m, 1h) in the day clear of every job'"'"'s run in the
           window (mapped onto time of day), the CI window ($CI_WINDOW, 00:50-01:50) and snapd'"'"'s
           refresh window; exit 1 when none.
A job is a run of 10 CPU s or more, or a run of a timer that fires at most twice a day unless it
idled (10 min or more of wall at under 1 % CPU or with no Consumed line yet: a notifier daemon,
a run still going); the every-few-minutes light runs are left out of --overlap and --free, and
--overlap drops pairs sharing under 30 s. Read-only.' "$@"

PC_SUB='pc timers'; PC_EXTRA_FLAGS=(--overlap --since: --free:)
pc_opt "$@"
SINCE=${PC_OPT[--since]-7d}; FREE=${PC_OPT[--free]-}; MODE=list
[ -n "${PC_OPT[--overlap]-}" ] && MODE=overlap
[ -n "$FREE" ] && MODE=free
CI=${CI_WINDOW:-00:50-01:50}

# secs <span> — seconds in Nd/Nh/Nmin/Nm/Ns.
secs() {
  case "$1" in
    *[0-9]d) echo $(( ${1%d} * 86400 ));; *[0-9]h) echo $(( ${1%h} * 3600 ));;
    *[0-9]min) echo $(( ${1%min} * 60 ));; *[0-9]m) echo $(( ${1%m} * 60 ));; *[0-9]s) echo "${1%s}";;
    *) return 2;;
  esac
}
W=$(secs "$SINCE" 2>/dev/null) && [ "$W" -gt 0 ] || { echo "pc timers: bad --since '$SINCE'" >&2; exit 2; }
FM=0
if [ "$MODE" = free ]; then FM=$(secs "$FREE" 2>/dev/null) && [ "$FM" -ge 60 ] || { echo "pc timers: bad --free '$FREE'" >&2; exit 2; }; FM=$(( FM / 60 )); fi
NOW=${PC_NOW:-$(date +%s)}

out=$({
  printf 'N\t%s\t%s\n' "$NOW" "$CI"
  for s in system user; do
    f=; [ $s = user ] && f=--user
    tj=$(pc_cmd systemctl $f list-timers --all --output=json 2>/dev/null)
    jq -r --arg s $s '.[] | ["T", $s, .unit, (.activates // ""), ((.next // 0) / 1e6 | floor), ((.last // 0) / 1e6 | floor)] | @tsv' <<<"$tj" 2>/dev/null
    mapfile -t su < <(jq -r '.[].activates // empty' <<<"$tj" 2>/dev/null)
    [ ${#su[@]} -gt 0 ] && pc_cmd systemctl $f show --timestamp=unix -p Id,ActiveState,ExecMainStartTimestamp,ExecMainExitTimestamp,InactiveEnterTimestamp -- "${su[@]}" 2>/dev/null \
      | awk -v s=$s 'BEGIN { RS = ""; FS = "\n" }
        { delete v; for (i = 1; i <= NF; i++) { p = index($i, "="); x = substr($i, p + 1); sub(/^@/, "", x); v[substr($i, 1, p - 1)] = x }
          printf "S\t%s\t%s\t%s\t%d\t%d\n", s, v["Id"], v["ActiveState"], v["ExecMainStartTimestamp"], (v["ExecMainExitTimestamp"] != "" ? v["ExecMainExitTimestamp"] : v["InactiveEnterTimestamp"]) }'
  done
  pc_cmd snap refresh --time 2>/dev/null | awk '/^(timer|next|last):/ { k=$1; sub(/:$/, "", k); v=$0; sub(/^[a-z]+: */, "", v); o[k]=v }
    END { if (o["timer"] != "") printf "P\t%s\t%s\t%s\n", o["timer"], o["next"], o["last"] }'
  pc_cmd journalctl --since "-$SINCE" _COMM=systemd -o short-unix --no-hostname --no-pager \
    --grep '^(Starting|Started|Finished|Failed to start) [^ ]+\.service|\.service: (Consumed|Deactivated|Failed with)|Reached target shutdown\.target' 2>/dev/null \
    | sed 's/^/J /'
} | awk -F'\t' -v mode="$MODE" -v W="$W" -v FM="$FM" '
  function hm(s,  a) { split(s, a, ":"); return a[1] * 60 + a[2] }
  function tod(t) { return strftime("%H", t) * 60 + strftime("%M", t) }
  function ts(t) { return t > 0 ? strftime("%m-%d %H:%M", t) : "-" }
  function iso(t) { return t > 0 ? strftime("%Y-%m-%dT%H:%M", t) : "" }
  function hhmm(m) { return sprintf("%02d:%02d", int(m / 60) % 24, m % 60) }
  function span(v, t,  x) { x = v + 0; sub(/^[0-9.]+/, "", t)
    return x * (t == "d" ? 86400 : t == "h" ? 3600 : t == "min" ? 60 : t == "s" ? 1 : t == "ms" ? 1e-3 : t ~ /^(us|μs)$/ ? 1e-6 : 0) }
  function emit(k, s, e, c) { n++; rk[n] = k; rs[n] = s; re[n] = e; rc[n] = c; cnt[k]++
    if (s >= ls[k]) { ls[k] = s; le[k] = e; lc[k] = c } }
  function close_(k, t) { emit(k, (k in op) ? op[k] : en[k], (k in en) ? en[k] : t, ""); delete op[k]; delete en[k] }
  $1 == "N" { now = $2; ci = $3; next }
  $1 == "T" { k = $2 SUBSEP $4; if ($4 == "") k = $2 SUBSEP $3; nm[k] = $3; sc[k] = $2; nx[k] = $5; lt[k] = $6; nt++; ord[nt] = k; next }
  $1 == "P" { snap = $2; snx = $3; slt = $4; next }
  $1 == "S" { k = $2 SUBSEP $3; ua[k] = $4 ~ /^(active|activating|reloading)$/; ust[k] = $5; uex[k] = $6; next }
  {
    nf = split($0, f, " "); t = f[2] + 0; s = (f[3] == "systemd[1]:") ? "system" : "user"
    if (f[4] == "Reached" && f[6] == "shutdown.target") { for (k in op) if (sc[k] == s) close_(k, t); for (k in en) if (sc[k] == s) close_(k, t); next }
    if (f[4] == "Failed" && f[5] == "to") u = f[7]; else if (f[4] ~ /:$/) { u = f[4]; sub(/:$/, "", u) } else u = f[5]
    k = s SUBSEP u; if (!(k in nm)) next
    if (f[4] == "Starting" || f[4] == "Started") { if (k in en) close_(k, en[k])
      if (k in op && ob[k] == "Started") { emit(k, op[k], op[k], ""); delete op[k] }
      if (!(k in op)) { op[k] = t; ob[k] = f[4] }; next }
    if (f[5] == "Consumed") { c = 0; w = 0; ov = 0
      for (i = 6; i <= nf && f[i] != "wall"; i++) { if (f[i] == "over") { ov = 1; continue }; if (f[i] == "CPU" || f[i] == "time") continue
        if (ov) w += span(f[i], f[i]); else c += span(f[i], f[i]) }
      emit(k, (k in op) ? op[k] : t - w, t, c); delete op[k]; delete en[k]; next }
    en[k] = t
  }
  END {
    for (k in en) close_(k, en[k])
    for (k in op) if ((k in ua) && !ua[k]) { emit(k, op[k], uex[k] > op[k] ? uex[k] : op[k], ""); delete op[k] }
    for (k in ua) if ((k in nm) && ust[k] > ((k in ls) ? ls[k] : 0) + 2) { ls[k] = ust[k]; le[k] = ua[k] ? -1 : (uex[k] > ust[k] ? uex[k] : ust[k]); lc[k] = "" }
    for (k in op) { n++; rk[n] = k; rs[n] = op[k]; re[n] = now; rc[n] = ""; cnt[k]++; if (op[k] >= ls[k]) { ls[k] = op[k]; le[k] = -1; lc[k] = "" } }
    days = W / 86400; if (days < 1) days = 1
    for (i = 1; i <= n; i++) { w = re[i] - rs[i]
      job[i] = (rc[i] != "" && rc[i] >= 10) || (cnt[rk[i]] <= 2 * days && !(w >= 600 && (rc[i] == "" || rc[i] < 0.01 * w))) }
    nsn = 0; if (snap ~ /^[0-9][0-9]:[0-9][0-9]-[0-9][0-9]:[0-9][0-9](,[0-9][0-9]:[0-9][0-9]-[0-9][0-9]:[0-9][0-9])*$/) {
      m = split(snap, sw, ","); for (j = 1; j <= m; j++) { split(sw[j], p, "-"); nsn++; sa[nsn] = hm(p[1]); sb[nsn] = hm(p[2]) } }
    if (mode == "list") {
      for (j = 1; j <= nt; j++) { k = ord[j]; s0 = (k in ls) ? ls[k] : lt[k]
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s\t\n", (s0 > 0 ? sprintf("%04d", tod(s0)) : "9999"), nm[k], sc[k], ts(nx[k]), ts(s0),
          (k in ls) ? (le[k] < 0 ? "running" : ts(le[k])) : "-", (k in ls && lc[k] != "") ? sprintf("%.1f", lc[k]) : "-", cnt[k] + 0,
          iso(nx[k]), iso(s0), (k in ls && le[k] > 0) ? iso(le[k]) : "" }
      if (snap != "") printf "9998\tsnapd refresh.timer (pseudo)\tsystem\t%s\t%s\twindow %s\t-\t0\t%s\t%s\t\t%s\n", snx, slt, snap, snx, slt, snap
      exit }
    if (mode == "overlap") {
      for (d = int((now - W) / 86400) - 1; d <= int(now / 86400) + 1 && nsn; d++) for (j = 1; j <= nsn; j++) {
        base = d * 86400; base -= tod(base) * 60; a = base + sa[j] * 60; b = base + sb[j] * 60; if (b <= a) b += 86400
        if (b < now - W || a > now) continue; n++; rk[n] = "snap"; rs[n] = a; re[n] = b; rc[n] = ""; job[n] = 1; nm["snap"] = "snapd-refresh(" snap ")" }
      for (i = 1; i <= n; i++) if (job[i]) for (j = i + 1; j <= n; j++) if (job[j] && rk[i] != rk[j]) {
        a = rs[i] > rs[j] ? rs[i] : rs[j]; b = re[i] < re[j] ? re[i] : re[j]; if (b <= a) continue
        if (b - a < 30) continue; x = i; y = j; if (nm[rk[x]] > nm[rk[y]]) { x = j; y = i }; pk = rk[x] SUBSEP rk[y]
        if (!(pk in pa) || a > pa[pk]) { pa[pk] = a; pm[pk] = (b - a) / 60; px[pk] = x; py[pk] = y } }
      for (pk in pa) { x = px[pk]; y = py[pk]
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%.1f\t%s\t%s\t%s\t%s\n", pa[pk], nm[rk[x]], ts(rs[x]) "-" strftime("%H:%M", re[x]), (rc[x] == "" ? "-" : sprintf("%.1f", rc[x])),
          nm[rk[y]], ts(rs[y]) "-" strftime("%H:%M", re[y]), (rc[y] == "" ? "-" : sprintf("%.1f", rc[y])), iso(rs[x]), iso(re[x]), pm[pk], iso(rs[y]), iso(re[y]), (rc[x] == "" ? "" : sprintf("%.3f", rc[x])), (rc[y] == "" ? "" : sprintf("%.3f", rc[y])) }
      exit }
    split(ci, p, "-"); busy_(hm(p[1]), hm(p[2]))
    for (j = 1; j <= nsn; j++) busy_(sa[j], sb[j])
    for (i = 1; i <= n; i++) if (job[i]) { a = tod(rs[i]); b = a + int((re[i] - rs[i] + 59) / 60); if (b == a) b++; if (re[i] - rs[i] >= 86400) b = a + 1440; busy_(a, b) }
    for (s = 0; s + FM <= 1440; s++) { ok = 1; for (m = s; m < s + FM; m++) if (m in bz) { ok = 0; s = m; break }; if (ok) { printf "%s\t%s\t%d\n", hhmm(s), hhmm(s + FM), FM; exit } }
    exit 1
  }
  function busy_(a, b,  m) { if (b < a) b += 1440; for (m = a; m < b; m++) bz[m % 1440] = 1 }
'); rc=$?

case $MODE in
  list)
    sorted=$(sort -t $'\t' -k1,1 -k2,2 <<<"$out")
    if [ "$JSON" = 1 ]; then
      jq -Rn '[inputs | split("\t") | {unit:.[1], scope:.[2], next:(.[8] // ""), last_start:(.[9] // ""), last_end:(.[10] // ""),
        cpu_s:(if .[6] == "-" then null else (.[6]|tonumber) end), runs:(.[7]|tonumber)}
        + (if (.[11] // "") != "" then {window:.[11]} else {} end)]' <<<"$sorted"
    else
      { printf 'UNIT\tSCOPE\tNEXT\tLAST_START\tLAST_END\tCPU_S\tRUNS\n'; cut -f2-8 <<<"$sorted"; } | column -t -s $'\t'
    fi;;
  overlap)
    [ -n "$out" ] || { [ "$JSON" = 1 ] && echo '[]' || echo "nothing: no two jobs overlapped in the last $SINCE"; exit 0; }
    sorted=$(sort -t $'\t' -k1,1nr <<<"$out")
    if [ "$JSON" = 1 ]; then
      jq -Rn '[inputs | split("\t") | {a:.[1], a_start:.[7], a_end:.[8], a_cpu_s:(if .[12] == "" then null else (.[12]|tonumber) end),
        b:.[4], b_start:.[10], b_end:.[11], b_cpu_s:(if .[13] == "" then null else (.[13]|tonumber) end), shared_min:(.[9]|tonumber)}]' <<<"$sorted"
    else
      { printf 'JOB_A\tWINDOW_A\tCPU_S_A\tJOB_B\tWINDOW_B\tCPU_S_B\tSHARED_MIN\n'; awk -F'\t' -v OFS='\t' '{print $2, $3, $4, $5, $6, $7, $10}' <<<"$sorted"; } | column -t -s $'\t'
      echo "$(wc -l <<<"$sorted") overlapping pairs in the last $SINCE"
    fi;;
  free)
    if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
      [ "$JSON" = 1 ] && echo 'null' || echo "none: no ${FM}m window clear of every job, the CI window and snapd's refresh"; exit 1
    fi
    IFS=$'\t' read -r a b m <<<"$out"
    if [ "$JSON" = 1 ]; then jq -n --arg a "$a" --arg b "$b" --argjson m "$m" '{start:$a, end:$b, minutes:$m}'
    else echo "free: $a-$b (${m}m clear of every job in the last $SINCE, the CI window $CI and snapd's refresh)"; fi;;
esac
