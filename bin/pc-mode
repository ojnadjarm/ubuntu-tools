#!/bin/bash
# pc mode [agent|human|status] — switch the desktop profile between agent-first and stock GNOME.
. "$(dirname "$(readlink -f "$0")")/env.sh"

STATE="$HOME/agents/state/pc-mode"
EXT=tiling-assistant@ubuntu.com
MODES="${PC_SHELL_MODES:-/usr/share/gnome-shell/modes}"

# schema key agent-value human-value
KEYS='org.gnome.desktop.interface enable-animations false true
com.ubuntu.update-notifier no-show-notifications true false
com.ubuntu.update-notifier regular-auto-launch-interval 0 7
org.gnome.mutter dynamic-workspaces false true
org.gnome.desktop.wm.preferences num-workspaces 1 4'

usage() { echo 'usage: pc mode [agent|human|status]'; }

# overview BOOL — set the shell overview state.
overview() {
  gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method org.freedesktop.DBus.Properties.Set org.gnome.Shell OverviewActive "<$1>" >/dev/null 2>&1
}

# live_get SCHEMA KEY — one key's value from a cached list-recursively read, quotes stripped.
declare -A SCHEMA
live_get() {
  local s k v
  [ -n "${SCHEMA[$1]+x}" ] || SCHEMA[$1]=$'\n'"$(gsettings list-recursively "$1" 2>/dev/null)"
  while read -r s k v; do [ "$s" = "$1" ] && [ "$k" = "$2" ] && { echo "${v//\'/}"; return; }; done <<<"${SCHEMA[$1]}"
}

# ext_on — GNOME Shell's enable rule from dconf: (session-mode or user-enabled) and not disabled.
ext_on() {
  [[ $(live_get org.gnome.shell disabled-extensions) == *"$EXT"* ]] && return 1
  grep -qF "\"$EXT\"" "$MODES/${GNOME_SHELL_SESSION_MODE:-ubuntu}.json" 2>/dev/null && return 0
  [ "$(live_get org.gnome.shell disable-user-extensions)" = true ] && return 1
  [[ $(live_get org.gnome.shell enabled-extensions) == *"$EXT"* ]]
}

# live_mode — agent, human or mixed, read from the live keys and the extension.
live_mode() {
  local schema key a h got n_a=0 n_h=0
  while read -r schema key a h; do
    got=$(live_get "$schema" "$key")
    [ "$got" = "$a" ] && n_a=$((n_a + 1))
    [ "$got" = "$h" ] && n_h=$((n_h + 1))
  done <<<"$KEYS"
  if ext_on; then
    n_h=$((n_h + 1))
  else
    n_a=$((n_a + 1))
  fi
  if [ "$n_a" = 6 ]; then echo agent
  elif [ "$n_h" = 6 ]; then echo human
  else echo mixed; fi
}

# apply agent|human — write every key and read it back.
apply() {
  local want="$1" schema key a h target got rc=0
  while read -r schema key a h; do
    [ "$want" = agent ] && target="$a" || target="$h"
    if [ "$want" = agent ]; then gsettings reset "$schema" "$key"; else gsettings set "$schema" "$key" "$target"; fi
    got=$(gsettings get "$schema" "$key" 2>/dev/null | tr -d "'")
    [ "$got" = "$target" ] || { echo "pc mode: $schema $key = $got (expected $target)" >&2; rc=1; }
  done <<<"$KEYS"
  if [ "$want" = agent ]; then
    gnome-extensions disable "$EXT" 2>/dev/null
    overview false
  else
    gnome-extensions enable "$EXT" 2>/dev/null
  fi
  echo "$want" > "$STATE"
  return $rc
}

case "${1:-status}" in
  -h|--help) usage; exit 0;;
  agent|human) apply "$1" || exit 1;;
  status) ;;
  *) usage >&2; exit 2;;
esac

m=$(live_mode)
echo "$m"
[ "$m" = mixed ] && exit 1
exit 0
