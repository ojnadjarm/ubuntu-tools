#!/usr/bin/env bash
# pc power status|rapl|gpu|battery|profiles|cstates|pl|runtime-pm|profile|platform|epp|governor|turbo|charge-limit — watts, GPU, battery, power limits and the power profiles; mutations ledgered.
set -uo pipefail
export LC_ALL=C
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"
SELF="$(readlink -f "$0")"

pc_usage 'usage: pc power [status] [--seconds 0.3] [--deep] [--json]
       pc power rapl|gpu|battery|profiles [--seconds N] [--json]
       pc power cstates [--window 10]
       pc power pl [<long W> [<short W>]] [--apply]
       pc power runtime-pm [<usb|pci id> auto|on] [--owner-ok] [--apply]
       pc power profile power-saver|balanced|performance [--apply]
       pc power platform quiet|balanced|performance [--apply]
       pc power epp <default|performance|balance_performance|balance_power|power> [--apply]
       pc power governor <performance|powersave> [--apply]
       pc power turbo on|off [--apply]
       pc power charge-limit <40..100> [--apply]

Watts come from the powercap RAPL counters sampled over --seconds (default 0.3, root read);
--deep adds one turbostat run. cstates prints package pc2..pc10 residency (pmc_core, root read),
core idle-state residency (cpuidle) over --window seconds, and the PCI/USB devices with runtime PM `on`.
pl reads the RAPL PL1/PL2 of the mmio and MSR zones; with watts it writes the mmio zone (long <= 35,
short <= 45, no raise at package >= 85 C). runtime-pm lists the `on` devices or sets one; a network
controller (the remote-access path) needs --owner-ok. Mutations print `would: …` and change nothing without --apply;
with it they are recorded in the change ledger and undoable with `pc undo`. Fan control is
refused (FLEET §5) — `pc thermal fan` reads it.' "$@"

DEEP=0; ARGV=()
for a in "$@"; do case $a in --deep) DEEP=1;; *) ARGV+=("$a");; esac; done
PC_EXTRA_FLAGS=(--window: --owner-ok)
pc_opt ${ARGV[@]+"${ARGV[@]}"}
secs=$SECONDS_; [ "$secs" = 0 ] && secs=0.3
# to_ms 0.3 -> 300; integer milliseconds keep the watt arithmetic in bash (no awk/bc fork).
to_ms() { local s=$1 i=${1%%.*} f; f=${s#*.}; [ "$f" = "$s" ] && f=0; f="${f}00"; printf '%d' $((10#${i:-0} * 1000 + 10#${f:0:3})); }
win_ms=$(to_ms "$secs"); [ "$win_ms" -gt 0 ] || win_ms=300
# mW -> "12.34"
w() { printf '%d.%02d' $(( ${1:-0} / 1000 )) $(( (${1:-0} % 1000) / 10 )); }

## --- RAPL -------------------------------------------------------------------
# PC_SYS2 (tests only) makes the second sample come from a second captured tree.
: "${PC_SYS2:=$PC_SYS}"
RN=() RP=() RM=()
for d in "$PC_SYS"/class/powercap/intel-rapl:*; do
  [ -f "$d/energy_uj" ] && [ -f "$d/name" ] || continue
  RN+=("$(<"$d/name")"); RP+=("$d/energy_uj"); RM+=("$(<"$d/max_energy_range_uj")")
done
# One pass over every counter: builtin reads when they are ours, a single sudo cat when not.
sample() {
  local root=$1 p out=()
  for p in "${RP[@]}"; do out+=("${root}${p#$PC_SYS}"); done
  if [ "${#out[@]}" = 0 ]; then return 0; fi
  if [ -r "${out[0]}" ]; then for p in "${out[@]}"; do printf '%s\n' "$(<"$p")"; done
  else pc_root cat "${out[@]}"; fi
}
rapl_mw=()   # milliwatts, parallel to RN
gpu_rc6=0
rapl_read() {
  local -a e1 e2; local t1 t2 r1 r2 i d el
  r1=$(pc_rd "$PC_SYS/class/drm/card1/gt/gt0/rc6_residency_ms" 0); t1=${EPOCHREALTIME/./}
  mapfile -t e1 < <(sample "$PC_SYS")
  sleep "$secs"
  mapfile -t e2 < <(sample "$PC_SYS2")
  r2=$(pc_rd "$PC_SYS2/class/drm/card1/gt/gt0/rc6_residency_ms" 0); t2=${EPOCHREALTIME/./}
  el=$(( (t2 - t1) / 1000 )); [ -n "${PC_FIXTURE:-}" ] && [ -n "${PC_POWER_ELAPSED_US:-}" ] && el=$(( PC_POWER_ELAPSED_US / 1000 ))
  [ "$el" -gt 0 ] || el=$win_ms
  for i in "${!RN[@]}"; do
    d=$(( ${e2[i]:-0} - ${e1[i]:-0} ))
    [ "$d" -lt 0 ] && d=$(( d + ${RM[i]:-0} ))       # energy_uj wraps at max_energy_range_uj
    rapl_mw+=( $(( d / el )) )                        # uJ/ms == mW
  done
  gpu_rc6=$(( (r2 - r1) * 100 / el )); [ "$gpu_rc6" -gt 100 ] && gpu_rc6=100
  [ "$gpu_rc6" -lt 0 ] && gpu_rc6=0
}
mw_of() { local i; for i in "${!RN[@]}"; do [ "${RN[i]}" = "$1" ] && { printf '%s' "${rapl_mw[i]:-0}"; return; }; done; printf 0; }
pl1_w() { local u; u=$(pc_rd "$PC_SYS/class/powercap/intel-rapl:0/constraint_0_power_limit_uw" 0); printf '%d' $(( u / 1000000 )); }

## --- GPU --------------------------------------------------------------------
GT="$PC_SYS/class/drm/card1/gt/gt0"
gpu_reasons() {
  local f n out=
  for f in "$GT"/throttle_reason_*; do
    n=${f##*/throttle_reason_}; [ "$n" = status ] && continue
    [ "$(pc_rd "$f" 0)" = 1 ] && out="$out $n"
  done
  printf '%s' "${out# }"
}

## --- battery ----------------------------------------------------------------
ac_online() { local f; for f in "$PC_SYS"/class/power_supply/A[CD]*/online; do [ -r "$f" ] && { printf '%s' "$(<"$f")"; return; }; done; printf 1; }

## --- profiles ---------------------------------------------------------------
CPU0="$PC_SYS/devices/system/cpu/cpu0/cpufreq"
PSTATE="$PC_SYS/devices/system/cpu/intel_pstate"
ppd_get() { cached ppd 60 pc_cmd powerprofilesctl get; }
# Entries pc_apply drops after a power mutation (pc-status caches the profile for 60 s).
export PC_CACHE_KEYS='ppd power_profile'
turbo_state() { [ "$(pc_rd "$PSTATE/no_turbo" 0)" = 0 ] && printf on || printf off; }

## --- mutations --------------------------------------------------------------
# apply_change <target> <before> <after> <verb> <read-cmd> <cmd…>
apply_change() {
  local target=$1 before=$2 after=$3 verb=$4 read=$5; shift 5
  [ "$before" = "$after" ] && { printf 'already: %s %s\n' "$target" "$after"; return 0; }
  PC_READ_CMD="$read" pc_apply "$target" "$before" "$after" \
    "$(printf '%q %q %q --apply' "$SELF" "$verb" "$before")" "$@"
}
need_arg() { [ -n "${1:-}" ] || { printf 'pc power: %s needs a value (see -h)\n' "$2" >&2; exit 2; }; }
one_of() { local v=$1 l=$2; case " $l " in *" $v "*) return 0;; esac; printf 'pc power: %s is not one of: %s\n' "$v" "$l" >&2; exit 2; }
# write_all <value> <file…> — one root shell, one write per policy.
write_all() { local v=$1; shift; pc_root sh -c 'v=$1; shift; for f do printf %s "$v" >"$f" || exit 1; done' _ "$v" "$@"; }

## --- C-states ---------------------------------------------------------------
PMC=kernel/debug/pmc_core/package_cstate_show
# pkgc_sample <root> — the pmc_core counters (µs) as "C2 N" lines; a root read off the fixture.
pkgc_sample() {
  local f="$1/$PMC"
  if [ -r "$f" ]; then cat "$f"; else pc_root cat "$f" 2>/dev/null; fi | awk -F' *: *' '/^Package C/{sub(/Package /,"",$1); print $1, $2}'
}
# idle_sample <root> — every cpu's cpuidle state times (µs), cpu-major, state-minor.
idle_sample() { cat "$1"/devices/system/cpu/cpu[0-9]*/cpuidle/state[0-9]*/time 2>/dev/null; }
# pct <delta-us> <elapsed-us> -> "12.3%"
pct() { local m=$(( $1 * 1000 / $2 )); [ "$m" -lt 0 ] && m=0; printf '%d.%d%%' $(( m / 10 )) $(( m % 10 )); }
rpm_on() {
  local d names
  names=$(pc_cmd lspci -D 2>/dev/null)
  for d in "$PC_SYS"/bus/pci/devices/*; do
    [ "$(pc_rd "$d/power/control")" = on ] || continue
    printf 'rpm-on  pci %s  %s\n' "${d##*/}" "$(awk -v a="${d##*/}" '$1==a{$1=""; sub(/^ /,""); print; exit}' <<<"$names")"
  done
  for d in "$PC_SYS"/bus/usb/devices/*; do
    [ "$(pc_rd "$d/power/control")" = on ] || continue
    printf 'rpm-on  usb %s  %s\n' "${d##*/}" "$(pc_rd "$d/product" '?')"
  done
}
cstates() {
  local win=${PC_OPT[--window]:-10} t1 t2 el i n line ncpu nst sum
  local -a p1 p2 i1 i2 names
  mapfile -t p1 < <(pkgc_sample "$PC_SYS"); mapfile -t i1 < <(idle_sample "$PC_SYS"); t1=${EPOCHREALTIME/./}
  sleep "$win"
  mapfile -t p2 < <(pkgc_sample "$PC_SYS2"); mapfile -t i2 < <(idle_sample "$PC_SYS2"); t2=${EPOCHREALTIME/./}
  el=$(( t2 - t1 )); [ -n "${PC_FIXTURE:-}" ] && [ -n "${PC_POWER_ELAPSED_US:-}" ] && el=$PC_POWER_ELAPSED_US
  if [ "${#p1[@]}" -gt 0 ] && [ "${#p1[@]}" = "${#p2[@]}" ]; then
    line=pkg
    for i in "${!p1[@]}"; do
      n=${p1[i]%% *}; line+="  pc${n#C} $(pct $(( ${p2[i]##* } - ${p1[i]##* } )) "$el")"
    done
    printf '%s   (%s s window)\n' "$line" "$(w $(( el / 1000 )))"
  else
    printf 'pkg     unavailable (pmc_core debugfs not readable: sudo -n cat /sys/%s)\n' "$PMC"
  fi
  mapfile -t names < <(cat "$PC_SYS"/devices/system/cpu/cpu0/cpuidle/state[0-9]*/name 2>/dev/null)
  nst=${#names[@]}
  if [ "$nst" -gt 0 ] && [ "${#i1[@]}" = "${#i2[@]}" ]; then
    ncpu=$(( ${#i1[@]} / nst )); line=core
    for n in "${!names[@]}"; do
      sum=0; for (( i = n; i < ${#i1[@]}; i += nst )); do sum=$(( sum + i2[i] - i1[i] )); done
      line+="  ${names[n]} $(pct "$sum" $(( el * ncpu )))"
    done
    printf '%s   (%s cpus)\n' "$line" "$ncpu"
  fi
  rpm_on
}

## --- power limits -----------------------------------------------------------
MMIO="$PC_SYS/class/powercap/intel-rapl-mmio:0"
# us_fmt <us> -> "27.98 s" or "2 ms"
us_fmt() { if [ "${1:-0}" -ge 1000000 ]; then printf '%s s' "$(w $(( $1 / 1000 )))"; else printf '%d ms' $(( ${1:-0} / 1000 )); fi; }
pkg_temp() { local z; for z in "$PC_SYS"/class/thermal/thermal_zone*; do
  [ "$(pc_rd "$z/type")" = x86_pkg_temp ] && { printf '%d' $(( $(pc_rd "$z/temp" 0) / 1000 )); return; }; done; }
pl_w() { printf '%d' $(( $(pc_rd "$1/constraint_$2_power_limit_uw" 0) / 1000000 )); }
pl_show() {
  local k d i line l1= l2= v
  for k in mmio msr; do
    d="$PC_SYS/class/powercap/intel-rapl:0"; [ $k = mmio ] && d=$MMIO
    [ -f "$d/constraint_0_power_limit_uw" ] || continue
    line="pl      $k "
    for i in 0 1; do
      line+="  $(pc_rd "$d/constraint_${i}_name") $(w $(( $(pc_rd "$d/constraint_${i}_power_limit_uw" 0) / 1000 ))) W ($(us_fmt "$(pc_rd "$d/constraint_${i}_time_window_us" 0)"))"
    done
    printf '%s\n' "$line"
    v=$(pl_w "$d" 0); [ -z "$l1" ] || [ "$v" -lt "$l1" ] && l1=$v
    v=$(pl_w "$d" 1); [ -z "$l2" ] || [ "$v" -lt "$l2" ] && l2=$v
  done
  printf 'pl      effective  PL1 %s W  PL2 %s W  pkg %s C\n' "${l1:-?}" "${l2:-?}" "$(pkg_temp)"
}
pl_set() {
  local long=$1 cur_l cur_s short t f0="$MMIO/constraint_0_power_limit_uw" f1="$MMIO/constraint_1_power_limit_uw"
  [ -f "$f0" ] || { echo 'pc power: no intel-rapl-mmio:0 zone' >&2; exit 2; }
  cur_l=$(pl_w "$MMIO" 0); cur_s=$(pl_w "$MMIO" 1); short=${2:-$cur_s}
  case "$long/$short" in *[!0-9/]*|/*|*/) echo 'pc power: pl takes whole watts' >&2; exit 2;; esac
  long=$((10#$long)); short=$((10#$short))
  [ "$long" -ge 5 ] && [ "$short" -ge 5 ] || { echo 'pc power: pl refuses a limit < 5 W' >&2; exit 2; }
  [ "$long" -le 35 ] || { echo 'pc power: pl refuses long > 35 W (heat on a lid-closed laptop)' >&2; exit 2; }
  [ "$short" -le 45 ] || { echo 'pc power: pl refuses short > 45 W' >&2; exit 2; }
  if [ "$long" -gt "$cur_l" ] || [ "$short" -gt "$cur_s" ]; then
    t=$(pkg_temp)
    [ -n "$t" ] && [ "$t" -lt 85 ] || { printf 'pc power: refused: package %s C (a raise needs < 85 C)\n' "${t:-unreadable}" >&2; exit 3; }
  fi
  [ "$cur_l/$cur_s" = "$long/$short" ] && { printf 'already: rapl-mmio PL1/PL2 W %s\n' "$long/$short"; return 0; }
  PC_READ_CMD="$(printf 'echo $(( $(cat %q) / 1000000 ))/$(( $(cat %q) / 1000000 ))' "$f0" "$f1")" \
    pc_apply 'rapl-mmio PL1/PL2 W' "$cur_l/$cur_s" "$long/$short" "$(printf '%q %q %q %q --apply' "$SELF" pl "$cur_l" "$cur_s")" \
    pc_root sh -c 'printf %s "$2" >"$1" && printf %s "$4" >"$3"' _ "$f0" $(( long * 1000000 )) "$f1" $(( short * 1000000 ))
}
# rpm_set <usb|pci id> <auto|on> — one device's power/control; a network controller needs --owner-ok.
rpm_set() {
  local id=$1 mode=$2 bus f before ok=()
  need_arg "$mode" runtime-pm; one_of "$mode" 'auto on'
  if [ -d "$PC_SYS/bus/usb/devices/$id" ]; then bus=usb
  elif [ -d "$PC_SYS/bus/pci/devices/$id" ]; then bus=pci
  elif [ -d "$PC_SYS/bus/pci/devices/0000:$id" ]; then bus=pci; id=0000:$id
  else printf 'pc power: no usb or pci device %s\n' "$id" >&2; exit 2; fi
  f="$PC_SYS/bus/$bus/devices/$id/power/control"
  if [ $bus = pci ]; then case $(pc_rd "$PC_SYS/bus/pci/devices/$id/class") in 0x02*)
    [ "${PC_OPT[--owner-ok]:-0}" = 1 ] || { printf 'pc power: refused: %s is a network controller (the remote-access path); the owner decides, then --owner-ok\n' "$id" >&2; exit 3; }
    ok=(--owner-ok);; esac; fi
  before=$(pc_rd "$f")
  [ "$before" = "$mode" ] && { printf 'already: runtime-pm %s %s %s\n' "$bus" "$id" "$mode"; return 0; }
  PC_READ_CMD="cat $(printf %q "$f")" pc_apply "runtime-pm $bus $id" "$before" "$mode" \
    "$(printf '%q ' "$SELF" runtime-pm "$id" "$before" ${ok[@]+"${ok[@]}"})--apply" write_all "$mode" "$f"
}

sub="${PC_ARGS[0]:-status}"; arg="${PC_ARGS[1]:-}"
case "$sub" in
  fan) pc_guard "pwm1_enable";;   # always refuses: fan control is read-only in v1
  profile)
    need_arg "$arg" profile; one_of "$arg" 'power-saver balanced performance'
    apply_change powerprofiles "$(FRESH=1 ppd_get)" "$arg" profile 'powerprofilesctl get' \
      powerprofilesctl set "$arg"; exit $?;;
  platform)
    f="$PC_SYS/firmware/acpi/platform_profile"
    need_arg "$arg" platform; one_of "$arg" "$(pc_rd "${f}_choices")"
    apply_change platform_profile "$(pc_rd "$f")" "$arg" platform "cat $f" write_all "$arg" "$f"; exit $?;;
  epp)
    need_arg "$arg" epp; one_of "$arg" "$(pc_rd "$CPU0/energy_performance_available_preferences")"
    apply_change epp "$(pc_rd "$CPU0/energy_performance_preference")" "$arg" epp \
      "cat $CPU0/energy_performance_preference" \
      write_all "$arg" "$PC_SYS"/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; exit $?;;
  governor)
    need_arg "$arg" governor; one_of "$arg" "$(pc_rd "$CPU0/scaling_available_governors")"
    apply_change governor "$(pc_rd "$CPU0/scaling_governor")" "$arg" governor \
      "cat $CPU0/scaling_governor" \
      write_all "$arg" "$PC_SYS"/devices/system/cpu/cpu*/cpufreq/scaling_governor; exit $?;;
  turbo)
    need_arg "$arg" turbo; one_of "$arg" 'on off'
    v=1; [ "$arg" = on ] && v=0
    apply_change turbo "$(turbo_state)" "$arg" turbo \
      "[ \"\$(cat $PSTATE/no_turbo)\" = 0 ] && echo on || echo off" \
      write_all "$v" "$PSTATE/no_turbo"; exit $?;;
  charge-limit)
    need_arg "$arg" charge-limit
    case $arg in ''|*[!0-9]*) arg=0;; esac
    [ "$arg" -ge 40 ] && [ "$arg" -le 100 ] || { echo 'pc power: charge-limit takes 40..100' >&2; exit 2; }
    f="$PC_BAT/charge_control_end_threshold"
    apply_change charge-limit "$(pc_rd "$f")" "$arg" charge-limit "cat $f" write_all "$arg" "$f"; exit $?;;
  status|rapl|gpu|battery|profiles) ;;
  cstates) cstates; exit 0;;
  pl) if [ -n "$arg" ]; then pl_set "$arg" "${PC_ARGS[2]:-}"; else pl_show; fi; exit $?;;
  runtime-pm) if [ -n "$arg" ]; then rpm_set "$arg" "${PC_ARGS[2]:-}"; else rpm_on; fi; exit $?;;
  *) printf 'pc power: unknown verb %s (try -h)\n' "$sub" >&2; exit 2;;
esac

## --- read-only verbs --------------------------------------------------------
case "$sub" in status|rapl|gpu) rapl_read;; esac

rapl_json() {
  pc_json '{seconds:$s,package_w:$p,core_w:$c,uncore_w:$u,psys_w:$y,pl1_w:$l}' -c \
    --argjson s "$(w "$win_ms")" --argjson p "$(w "$(mw_of package-0)")" \
    --argjson c "$(w "$(mw_of core)")" --argjson u "$(w "$(mw_of uncore)")" \
    --argjson y "$(w "$(mw_of psys)")" --argjson l "$(pl1_w)"
}
gpu_json() {
  pc_json '{act_mhz:$a,cur_mhz:$c,min_mhz:$mn,max_mhz:$mx,rp0_mhz:$r0,rp1_mhz:$r1,rpn_mhz:$rn,
            punit_req_mhz:$pr,rc6_enable:$re,rc6_pct:$rc,throttle:($t|split(" ")|map(select(.!=""))),
            runtime_status:$rs}' -c \
    --argjson a "$(pc_rd "$GT/rps_act_freq_mhz" 0)" --argjson c "$(pc_rd "$GT/rps_cur_freq_mhz" 0)" \
    --argjson mn "$(pc_rd "$GT/rps_min_freq_mhz" 0)" --argjson mx "$(pc_rd "$GT/rps_max_freq_mhz" 0)" \
    --argjson r0 "$(pc_rd "$GT/rps_RP0_freq_mhz" 0)" --argjson r1 "$(pc_rd "$GT/rps_RP1_freq_mhz" 0)" \
    --argjson rn "$(pc_rd "$GT/rps_RPn_freq_mhz" 0)" --argjson pr "$(pc_rd "$GT/punit_req_freq_mhz" 0)" \
    --argjson re "$(pc_rd "$GT/rc6_enable" 0)" --argjson rc "$gpu_rc6" --arg t "$(gpu_reasons)" \
    --arg rs "$(pc_rd "$PC_SYS/class/drm/card1/device/power/runtime_status" unknown)"
}
bat_json() {
  pc_json '{status:$st,capacity_pct:$cap,health_pct:$h,energy_full_uwh:$ef,design_uwh:$ed,
            cycles:$cy,charge_limit:$cl,power_w:$pw,ac:$ac}' -c \
    --arg st "$(pc_rd "$PC_BAT/status" unknown)" --argjson cap "$(pc_rd "$PC_BAT/capacity" 0)" \
    --argjson h "$(pc_bat_health)" --argjson ef "$(pc_rd "$PC_BAT/energy_full" 0)" \
    --argjson ed "$(pc_rd "$PC_BAT/energy_full_design" 0)" --argjson cy "$(pc_rd "$PC_BAT/cycle_count" 0)" \
    --argjson cl "$(pc_rd "$PC_BAT/charge_control_end_threshold" 0)" \
    --argjson pw "$(w $(( $(pc_rd "$PC_BAT/power_now" 0) / 1000 )))" \
    --argjson ac "$([ "$(ac_online)" = 1 ] && echo true || echo false)"
}
prof_json() {
  pc_json '{ppd:$ppd,platform:$pf,platform_choices:($pfc|split(" ")),asus_throttle_policy:$at,
            pstate:$ps,turbo:$tb,governor:$gv,governors:($gvs|split(" ")),epp:$epp,
            epps:($epps|split(" ")|map(select(.!="")))}' -c \
    --arg ppd "$(ppd_get)" --arg pf "$(pc_rd "$PC_SYS/firmware/acpi/platform_profile" unknown)" \
    --arg pfc "$(pc_rd "$PC_SYS/firmware/acpi/platform_profile_choices")" \
    --argjson at "$(pc_rd "$PC_SYS/devices/platform/asus-nb-wmi/throttle_thermal_policy" 0)" \
    --arg ps "$(pc_rd "$PSTATE/status" unknown)" \
    --argjson tb "$([ "$(turbo_state)" = on ] && echo true || echo false)" \
    --arg gv "$(pc_rd "$CPU0/scaling_governor" unknown)" \
    --arg gvs "$(pc_rd "$CPU0/scaling_available_governors")" \
    --arg epp "$(pc_rd "$CPU0/energy_performance_preference" unknown)" \
    --arg epps "$(pc_rd "$CPU0/energy_performance_available_preferences")"
}
deep_json() {
  local out; out=$(pc_root turbostat --quiet --show PkgWatt,CorWatt,GFXWatt,Busy%,Bzy_MHz \
    --interval 0.5 --num_iterations 1 2>/dev/null | awk 'NR==2{print $1,$2,$3,$4,$5}')
  set -- $out
  pc_json '{busy_pct:$b,bzy_mhz:$m,pkg_w:$p,cor_w:$c,gfx_w:$g}' -c \
    --argjson b "${1:-0}" --argjson m "${2:-0}" --argjson p "${3:-0}" \
    --argjson c "${4:-0}" --argjson g "${5:-0}"
}

if [ "$JSON" = 1 ]; then
  case "$sub" in
    rapl) rapl_json;; gpu) gpu_json;; battery) bat_json;; profiles) prof_json;;
    status)
      if [ "$DEEP" = 1 ]; then
        pc_json '{rapl:$r,gpu:$g,battery:$b,profiles:$p,deep:$d}' \
          --argjson r "$(rapl_json)" --argjson g "$(gpu_json)" --argjson b "$(bat_json)" \
          --argjson p "$(prof_json)" --argjson d "$(deep_json)"
      else
        pc_json '{rapl:$r,gpu:$g,battery:$b,profiles:$p}' \
          --argjson r "$(rapl_json)" --argjson g "$(gpu_json)" --argjson b "$(bat_json)" \
          --argjson p "$(prof_json)"
      fi;;
  esac
  exit 0
fi

t_rapl() {
  printf 'watts   package %s  core %s  uncore %s  psys %s   (PL1 %s W, %s s window)\n' \
    "$(w "$(mw_of package-0)")" "$(w "$(mw_of core)")" "$(w "$(mw_of uncore)")" \
    "$(w "$(mw_of psys)")" "$(pl1_w)" "$(w "$win_ms")"
}
t_gpu() {
  local r; r=$(gpu_reasons); : "${r:=none}"
  printf 'gpu     %s MHz (cur %s, %s-%s)  rc6 %s%%  throttle %s  runtime %s\n' \
    "$(pc_rd "$GT/rps_act_freq_mhz" 0)" "$(pc_rd "$GT/rps_cur_freq_mhz" 0)" \
    "$(pc_rd "$GT/rps_min_freq_mhz" 0)" "$(pc_rd "$GT/rps_max_freq_mhz" 0)" "$gpu_rc6" "$r" \
    "$(pc_rd "$PC_SYS/class/drm/card1/device/power/runtime_status" unknown)"
}
t_bat() {
  printf 'battery %s%%  health %s%%  limit %s  %s  %s W  cycles %s  %s\n' \
    "$(pc_rd "$PC_BAT/capacity" 0)" "$(pc_bat_health)" "$(pc_rd "$PC_BAT/charge_control_end_threshold" '-')" \
    "$(pc_rd "$PC_BAT/status" unknown)" "$(w $(( $(pc_rd "$PC_BAT/power_now" 0) / 1000 )))" \
    "$(pc_rd "$PC_BAT/cycle_count" 0)" "$([ "$(ac_online)" = 1 ] && echo AC || echo battery)"
}
t_prof() {
  printf 'profile ppd %s  platform %s  asus %s  pstate %s  turbo %s  gov %s  epp %s\n' \
    "$(ppd_get)" "$(pc_rd "$PC_SYS/firmware/acpi/platform_profile" unknown)" \
    "$(pc_rd "$PC_SYS/devices/platform/asus-nb-wmi/throttle_thermal_policy" '-')" \
    "$(pc_rd "$PSTATE/status" unknown)" "$(turbo_state)" "$(pc_rd "$CPU0/scaling_governor" unknown)" \
    "$(pc_rd "$CPU0/energy_performance_preference" unknown)"
}
case "$sub" in
  rapl) t_rapl;; gpu) t_gpu;; battery) t_bat;; profiles) t_prof;;
  status)
    t_rapl; t_gpu; t_bat; t_prof
    [ "$DEEP" = 1 ] && deep_json | jq -r '"deep    busy \(.busy_pct)%  \(.bzy_mhz) MHz  pkg \(.pkg_w) W  cor \(.cor_w) W  gfx \(.gfx_w) W"';;
esac
exit 0
