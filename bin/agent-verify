#!/usr/bin/env python3
"""Run a brief's `CHECK: <command>` and record the verdict in $AGENT_WORK/evidence/<ticket>/check.json (T381)."""
import argparse, datetime, json, os, re, signal, subprocess, sys, time

CHECK = re.compile(r'^\s*(?:[-*]\s*)?CHECK:\s*(.+?)\s*$', re.M)
TAIL = 40


def check_cmd(text):
    m = CHECK.search(text)
    if not m:
        return None
    cmd = m.group(1)
    return cmd[1:-1] if len(cmd) > 1 and cmd[0] == cmd[-1] == '`' else cmd


def ticket_of(path):
    stem = os.path.basename(path).rsplit('.', 1)[0]
    m = re.match(r'(?i)(t\d+)', stem)
    return m.group(1).upper() if m else stem


def tail(s):
    return '\n'.join(s.splitlines()[-TAIL:])


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('brief')
    ap.add_argument('--ticket', help='evidence folder name (default: T<nn> from the brief file name)')
    ap.add_argument('--timeout', type=int, default=600, help='seconds (default 600)')
    a = ap.parse_args()
    with open(a.brief, encoding='utf-8', errors='replace') as f:
        cmd = check_cmd(f.read())
    if not cmd:
        print(f'agent-verify: no CHECK: line in {a.brief}', file=sys.stderr)
        sys.exit(2)
    ticket = a.ticket or ticket_of(a.brief)
    out_dir = os.path.join(os.environ.get('AGENT_WORK', os.path.expanduser('~/agent-work')), 'evidence', ticket)
    started = datetime.datetime.now().astimezone()
    t0 = time.monotonic()
    p = subprocess.Popen(['bash', '-c', cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         start_new_session=True)
    try:
        out, err = p.communicate(timeout=a.timeout)
        rc = p.returncode
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        out, _ = p.communicate()
        rc, err = 124, f'timeout after {a.timeout}s'
    rec = {
        'ticket': ticket, 'brief': os.path.abspath(a.brief), 'check': cmd, 'cwd': os.getcwd(),
        'rc': rc, 'ok': rc == 0, 'started': started.isoformat(timespec='seconds'),
        'seconds': round(time.monotonic() - t0, 2), 'stdout_tail': tail(out), 'stderr_tail': tail(err),
    }
    os.makedirs(out_dir, exist_ok=True)
    path = os.path.join(out_dir, 'check.json')
    with open(path + '.tmp', 'w') as f:
        json.dump(rec, f, indent=1)
    os.replace(path + '.tmp', path)
    print(f"{'green' if rc == 0 else 'red'} rc={rc} {rec['seconds']}s → {path}")
    sys.exit(0 if rc == 0 else 1)


if __name__ == '__main__':
    main()
