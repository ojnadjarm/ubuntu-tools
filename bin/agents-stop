#!/usr/bin/env bash
# Kill switch: stop every running agent unit, every fleet timer and every background claude run.
# Timers are stopped, not disabled: `agents-start` (or `agents-stop --resume`) brings the roster back.
set -uo pipefail
. "$HOME/agents/bin/fleetlib.sh"
fleet_path
[ "${1:-}" = --resume ] && exec agents-start

units() { systemctl --user list-units "$1" --all --no-legend --plain 2>/dev/null | awk '{print $1}'; }

stopped=""
stop_if_running() {
  case "$(systemctl --user is-active "$1" 2>/dev/null)" in
    active|activating|reloading|deactivating) ;;
    *) return 0 ;;
  esac
  systemctl --user stop "$1" >/dev/null 2>&1
  stopped="$stopped ${1%.*}"
}

for u in $(units 'agent@*.service') sentinel-check.service moodle-keep-weekly.service pcbench-weekly.service notes-brain.service; do
  stop_if_running "$u"
done
for u in $(units 'agent@*.timer') sentinel-check.timer moodle-keep-weekly.timer pcbench-weekly.timer; do
  stop_if_running "$u"
done

# Every run writes its child pid to <name>/state/pid (agent-exec --pid-file), so the kill
# switch does not depend on the agent CLI's own bookkeeping.
killed=" "
kill_pid() {
  case "$1" in ''|*[!0-9]*) return 0 ;; esac
  case "$killed" in *" $1 "*) return 0 ;; esac
  killed="$killed$1 "
  kill "$1" 2>/dev/null && stopped="$stopped pid:$1"
}

for f in "$HARNESS_HOME"/*/state/pid; do
  [ -r "$f" ] || continue
  kill_pid "$(cat "$f" 2>/dev/null)"
done

# Fallback: background runs the agent CLI knows about and no pid file covers.
pids="$(claude agents --json 2>/dev/null | jq -r '.[] | select(.kind=="background") | .pid' 2>/dev/null)"
for p in $pids; do kill_pid "$p"; done

notify-owner -p high -t agents-stop "kill switch: stopped${stopped:- nothing}" || true
echo "agents-stop:${stopped:- nothing}"
