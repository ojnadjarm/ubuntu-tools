#!/usr/bin/env bash
# Kill switch: stop every running agent unit, every fleet timer and every background claude run; pause the chat.
# Timers are stopped, not disabled; every stopped unit is listed in state/agents-stopped.list, and
# `agents-start` (or `agents-stop --resume`) starts that list and the roster again and resumes the chat.
case "${1:-}" in -h|--help) awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; exit 0 ;; esac
set -uo pipefail
. "$HOME/agents/bin/fleetlib.sh"
fleet_path
[ "${1:-}" = --resume ] && exec agents-start

units() { systemctl --user list-units "$1" --all --no-legend --plain 2>/dev/null | awk '{print $1}'; }

stopped=""
list="$HARNESS_HOME/state/agents-stopped.list"
mkdir -p "${list%/*}"
stop_if_running() {
  case "$(systemctl --user is-active "$1" 2>/dev/null)" in
    active|activating|reloading|deactivating) ;;
    *) return 0 ;;
  esac
  systemctl --user stop "$1" >/dev/null 2>&1
  stopped="$stopped ${1%.*}"
  grep -qxF "$1" "$list" 2>/dev/null || printf '%s\n' "$1" >>"$list"
}

# Timers and paths first, so none can start a job between the two loops.
for u in $(units 'agent@*.timer') $(units 'po@*.path') sentinel-check.timer moodle-keep-weekly.timer pcbench-weekly.timer ailearning-ci-daily.timer ailearning-ci-weekly.timer fleet-ci-daily.timer orchestrator-pulse.timer improve-meter.timer $(units 'discord-liaison-relay@*.path') discord-liaison-check.timer discord-liaison-wake.path tier-nightly.timer gamedev-perf.timer pulse-5h-reset.timer; do
  stop_if_running "$u"
done
for u in $(units 'agent@*.service') $(units 'po@*.service') po-picks.service sentinel-check.service moodle-keep-weekly.service pcbench-weekly.service ailearning-ci-daily.service ailearning-ci-weekly.service fleet-ci-daily.service orchestrator-pulse.service improve-meter.service discord-bot.service $(units 'discord-liaison-job-*.service') discord-liaison-check.service discord-liaison-wake.service discord-liaison-relay.service tier-nightly.service gamedev-perf.service pulse-5h-reset.service; do
  stop_if_running "$u"
done

# Every run writes its child pid to <name>/state/pid (agent-exec --pid-file), so the kill
# switch does not depend on the agent CLI's own bookkeeping.
killed=" "
kill_pid() {
  case "$1" in ''|*[!0-9]*) return 0 ;; esac
  case "$killed" in *" $1 "*) return 0 ;; esac
  killed="$killed$1 "
  kill "$1" 2>/dev/null && stopped="$stopped pid:$1"
}

# A pid file older than its pid's process is stale (run SIGKILLed, then pid reused): skip it.
for f in "$HARNESS_HOME"/*/state/pid; do
  [ -r "$f" ] || continue
  p="$(cat "$f" 2>/dev/null)"
  case "$p" in ''|*[!0-9]*) continue ;; esac
  age="$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')"
  [ -n "$age" ] || continue
  [ $(( $(date +%s) - age )) -le $(( $(stat -c %Y "$f") + 2 )) ] || continue
  kill_pid "$p"
done

# Fallback: background runs the agent CLI knows about and no pid file covers.
pids="$(claude agents --json 2>/dev/null | jq -r '.[] | select(.kind=="background") | .pid' 2>/dev/null)"
for p in $pids; do kill_pid "$p"; done

chat=; chat pause --apply >/dev/null 2>&1 && chat="; chat paused"
notify-owner -p high -t agents-stop "kill switch: stopped${stopped:- nothing}$chat" || true
echo "agents-stop:${stopped:- nothing}$chat"
