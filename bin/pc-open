#!/bin/bash
# pc open <url|file|app.desktop|app> — launch in the desktop session and return immediately.
. "$(dirname "$(readlink -f "$0")")/env.sh"
[ "${1:-}" = -h ] || [ $# -eq 0 ] && { echo "usage: pc open <url|file|app>"; exit 0; }
t="$1"
case "$t" in
  *://*|/*|./*) setsid xdg-open "$t" >/dev/null 2>&1 & ;;
  *) setsid gtk-launch "${t%.desktop}" >/dev/null 2>&1 || setsid "$t" >/dev/null 2>&1 & ;;
esac
exit 0
