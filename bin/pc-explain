#!/usr/bin/env bash
# pc explain <thing…> [-n 3] [--json] [--files] — ranked KB lookup: heading > bold lead > exact quoted token > partial quote/backtick > word > substring.
# shellcheck disable=SC2034
set -uo pipefail
export LC_ALL=C
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"

pc_usage 'usage: pc explain <thing…> [-n 3] [--json] [--files]

Ranked lookup over the KB corpus (toolbox.md, quirks.md, audit.md, machine.md, KB/runbooks/*.md,
KB/guides/*.md, README-pc-control.md, FLEET.md, RUNNER.md,
the-dark-eye/{RUNBOOK,PLAN-*}.md, KB/pc-cli.md) so an agent gets the heading and the paragraph instead of opening the whole
file. A match on a line scores, highest first: an atx heading (`# ...`) > a `- **Bold
lead:**` bullet (this KBs own mini-heading convention) whose bold span holds the query >
an exact quoted/backticked token (`` `x` `` or "x" equal to the query) > a partial
quote/backtick match > a bare word > a plain substring. Ties break by file priority: toolbox,
quirks, README-pc-control, RUNBOOK*, machine, everything else.

  -n N       number of results (default 3)
  --json     array of {file,line,heading,text}
  --files    one "file:line" per result, nothing else

Exit 1 and the closest three headings (stderr) when nothing matches.' "$@"

PC_SUB='pc explain'; PC_EXTRA_FLAGS=(--files -n:)
pc_opt "$@"; ARGS=("${PC_ARGS[@]}")
N=${PC_OPT[-n]-3}; FILES_ONLY=${PC_OPT[--files]-0}
QUERY="${ARGS[*]:-}"
[ -n "$QUERY" ] || { echo "usage: pc explain <thing…> [-n 3] [--json] [--files]" >&2; exit 2; }

CORPUS=(
  "$HOME/agents/KB/toolbox.md"
  "$HOME/agents/KB/quirks.md"
  "$HOME/agents/KB/audit.md"
  "$HOME/agents/README-pc-control.md"
  "$HOME/the-dark-eye/RUNBOOK.md"
  "$HOME/agents/KB/machine.md"
  "$HOME/agents/KB/runbooks"/*.md
  "$HOME/agents/KB/guides"/[a-z]*.md
  "$HOME/agents/FLEET.md"
  "$HOME/agents/RUNNER.md"
  "$HOME/the-dark-eye/PLAN-"*.md
  "$HOME/agents/KB/pc-cli.md"
)

FILES=(); for f in "${CORPUS[@]}"; do [ -f "$f" ] && FILES+=("$f"); done

# One awk pass over the corpus: score (5 heading, 4 bold-lead, 3 exact quoted/backticked token, 2 partial,
# 1 word, 0 substring), file priority (toolbox, quirks, README-pc-control, RUNBOOK*, machine, rest) and the
# paragraph start; prints the best line per paragraph. A multi-word query with no line carrying the exact
# phrase falls back to "every word present on the line, any order", always tier 0.
WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
CAND="$WORK/ranked"; : >"$CAND"
[ "${#FILES[@]}" -gt 0 ] && Q="$QUERY" awk '
function prio(f) {
  if (f ~ /\/toolbox\.md$/) return 1; if (f ~ /\/quirks\.md$/) return 2
  if (f ~ /\/README-pc-control\.md$/) return 3; if (f ~ /\/RUNBOOK[^\/]*\.md$/) return 4
  if (f ~ /\/machine\.md$/) return 5; return 6
}
function wordch(c) { return c ~ /[A-Za-z0-9_]/ }
function score(c,   lc, m, b, rest, t, nw, w, i, p, k) {
  if (c ~ /^#+[[:space:]]/) return 5
  if (match(c, /^[[:space:]]*[-*][[:space:]]+\*\*[^*]+\*\*/)) {
    m = substr(c, 1, RLENGTH); b = index(m, "**")
    if (index(tolower(substr(m, b + 2, RLENGTH - b - 3)), lq)) return 4
  }
  rest = c
  while (match(rest, /`[^`]+`|"[^"]+"/)) {
    t = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
    nw = split(t, w, /[ \t]+/)
    for (i = 1; i <= nw; i++) {
      sub(/^[`"]/, "", w[i]); sub(/[`"]$/, "", w[i])
      if (w[i] != "" && tolower(w[i]) == lq) return 3
    }
  }
  lc = tolower(c)
  if (partial(lc, "`") || partial(lc, "\"")) return 2
  for (p = 1; (k = index(substr(lc, p), lq)) > 0; p += k) {
    i = p + k - 1
    if ((i == 1 || !wordch(substr(lc, i - 1, 1))) && !wordch(substr(lc, i + length(lq), 1))) return 1
  }
  return 0
}
function partial(lc, d,   a, k) {
  if (!(a = index(lc, d))) return 0
  if (!(k = index(substr(lc, a + 1), lq))) return 0
  return index(substr(lc, a + k + length(lq)), d) > 0
}
function keep(f, s, p, sc, ln,   key) {
  key = f SUBSEP s
  if (!(key in best) || sc > best[key]) { best[key] = sc; bline[key] = ln; bfile[key] = f; bs0[key] = s; bpr[key] = p }
}
BEGIN { q = ENVIRON["Q"]; lq = tolower(q); nq = split(lq, qw) }
FNR == 1 { lastblank = -1; pr = prio(FILENAME) }
{
  s0 = lastblank + 1; lc = tolower($0)
  if (index(lc, lq)) { keep(FILENAME, s0, pr, score($0), FNR); exact = 1 }
  else if (!exact && nq > 1 && index(lc, qw[1])) {
    for (i = 2; i <= nq && index(lc, qw[i]); i++);
    if (i > nq) { fb[++nfb] = FILENAME SUBSEP s0 SUBSEP pr SUBSEP FNR }
  }
  if ($0 !~ /[^[:space:]]/) lastblank = FNR - 1
}
END {
  if (!exact) for (i = 1; i <= nfb; i++) {
    split(fb[i], a, SUBSEP); keep(a[1], a[2], a[3], 0, a[4])
  }
  for (key in best) printf "%s\t%s\t%s\t%s\t%s\n", best[key], bpr[key], bfile[key], bs0[key], bline[key]
}' "${FILES[@]}" >"$CAND"

if [ ! -s "$CAND" ]; then
  printf 'pc explain: no match for "%s" — closest headings:\n' "$QUERY" >&2
  n=0
  for f in "${CORPUS[@]}"; do
    [ -f "$f" ] || continue
    while IFS=: read -r hl _; do
      printf '%s:%s\n' "$f" "$hl" >&2
      n=$((n + 1)); [ "$n" -ge 3 ] && break 2
    done < <(grep -nE '^#+ ' "$f" | head -3)
  done
  exit 1
fi

sort -t $'\t' -k1,1nr -k2,2n -k4,4n "$CAND" | head -n "$N" >"$WORK/top"

emit() {
  local f=$1 s0=$2 ln=$3
  mapfile -t L < "$f"
  local n=${#L[@]} e=$s0
  while [ "$e" -lt $((n - 1)) ] && [[ -n "${L[$((e + 1))]//[[:space:]]/}" ]]; do e=$((e + 1)); done
  [ $((e - s0 + 1)) -gt 25 ] && e=$((s0 + 24))
  local h="" i=$s0
  while [ "$i" -ge 0 ]; do
    [[ "${L[$i]}" =~ ^#+[[:space:]] ]] && { h="${L[$i]}"; break; }
    i=$((i - 1))
  done
  if [ "$JSON" = 1 ]; then
    local text="" j
    for ((j = s0; j <= e; j++)); do text+="${L[$j]}"$'\n'; done
    jq -n --arg file "$f" --argjson line "$ln" --arg heading "$h" --arg text "$text" \
      '{file:$file, line:$line, heading:$heading, text:$text}'
  else
    printf '%s:%d\n' "$f" "$ln"
    [ -n "$h" ] && printf '%s\n' "$h"
    local j; for ((j = s0; j <= e; j++)); do printf '%s\n' "${L[$j]}"; done
    printf '\n'
  fi
}

if [ "$FILES_ONLY" = 1 ]; then
  while IFS=$'\t' read -r _ _ f s0 ln; do printf '%s:%s\n' "$f" "$ln"; done <"$WORK/top"
  exit 0
fi

if [ "$JSON" = 1 ]; then
  { while IFS=$'\t' read -r _ _ f s0 ln; do emit "$f" "$s0" "$ln"; done <"$WORK/top"; } | jq -s .
else
  while IFS=$'\t' read -r _ _ f s0 ln; do emit "$f" "$s0" "$ln"; done <"$WORK/top"
fi
