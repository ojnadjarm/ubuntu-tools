#!/usr/bin/env bash
# harness — the agent-agnostic session entry point.
# `harness context` prints everything a session must know before it acts: the machine brief,
# the output rules, and the project guidelines when the cwd is a Moodle project. It is the
# single source the per-agent SessionStart wrappers in adapters/*/hooks/ call.
set -uo pipefail
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Read before env.sh, which sets HARNESS_AGENT from config.env for every caller.
IN_AGENT=0; [ -n "${CLAUDECODE:-}${HARNESS_AGENT:-}" ] && IN_AGENT=1
# shellcheck source=/dev/null
[ -r "$BIN/env.sh" ] && . "$BIN/env.sh"

usage() {
  cat <<'U'
usage: harness context [--brief] [--worker] [--full] [--json] [--moodle]
       --brief   the one-line machine brief only
       --worker  the machine brief, 5 worker report rules and the claims/wait-for verbs (<= 720 B), for subagents
       --full    the full text even inside an agent (CLAUDECODE or HARNESS_AGENT set), where the default is --worker
       --json    SessionStart hook JSON (systemMessage + hookSpecificOutput.additionalContext)
       --moodle  include the project guidelines even when detection finds no Moodle root
Instruction files are read from $HARNESS_CONTEXT_DIR (default ~/.claude).
U
}

[ "${1:-}" = context ] || { usage >&2; exit 2; }
shift
BRIEF=0; WORKER=0; JSON=0; FORCE=0
[ $# = 0 ] && [ "$IN_AGENT" = 1 ] && WORKER=2
while [ $# -gt 0 ]; do
  case $1 in
    --brief) BRIEF=1;; --worker) WORKER=1;; --json) JSON=1;; --moodle) FORCE=1;; --full) ;;
    -h|--help) usage; exit 0;;
    *) echo "harness: unknown option $1" >&2; usage >&2; exit 2;;
  esac
  shift
done

# TSP-011: the uutils `timeout` costs ~100 ms per call; prefer the GNU binary when installed.
TMO="${PC_TIMEOUT_BIN:-$(command -v gnutimeout || echo timeout)}"
brief=$("$TMO" 5 "$BIN/pc" status --brief 2>/dev/null) || brief=""
case "$PWD" in
  "$HOME/the-dark-eye"*)
    pf=$("$TMO" 3 "$BIN/agent-preflight" --brief 2>/dev/null | tr -s "\n " "  ")
    [ -n "$pf" ] && [ -n "$brief" ] && brief="$brief | eye: $pf";;
esac

if [ "$BRIEF" = 1 ]; then
  [ -n "$brief" ] && printf '%s\n' "$brief"
  exit 0
fi

if [ "$WORKER" != 0 ]; then
  rules='Worker rules (the full output rules are in `harness context --full`):
1. Report to your caller in at most 6 lines, numbers over prose.
2. Lead with the result; no preamble, recap or closer.
3. Report only what you verified; red is red.
4. Absolute paths; code only when load-bearing; no emojis.
5. Lists of at most 5; run `guide <words>` and `pc status` before acting.
6. Claims: claims add T<n> <paths> before editing; claims done T<n> after. Waits: wait-for --label X --until '"'"'<cmd>'"'"'.'
  # 720 B cap (T908), 700 B for the in-agent plain form with its tail line (T602, T957).
  cap=720 tail=''; [ "$WORKER" = 2 ] && cap=700 tail=$'\nfull rules: harness context --full'
  # T993: over its share the brief drops middle fields for `…`, keeping orch= and FAIL=; cuts stay UTF-8 whole.
  fit() {
    local s=$1 max=$2 f out='' keep='' LC_ALL=C; local -a a
    [ "${#s}" -le "$max" ] && { printf '%s' "$s"; return; }
    read -ra a <<<"$s"
    for f in "${a[@]}"; do case $f in orch=*|FAIL=*) keep+=" $f";; esac; done
    for f in "${a[@]}"; do
      case $f in orch=*|FAIL=*) continue;; esac
      [ $(( ${#out} + ${#f} + 1 + 4 + ${#keep} )) -le "$max" ] || break
      out+="${out:+ }$f"
    done
    s="${out:+$out }…$keep"
    [ "${#s}" -le "$max" ] || s=$(printf '%s' "$s" | head -c "$max" | iconv -f utf-8 -t utf-8 -c 2>/dev/null)
    printf '%s' "$s"
  }
  printf 'Machine now: %s\n%s%s\n' "$(fit "${brief:-unknown}" $((cap - 15 - ${#rules} - ${#tail})))" "$rules" "$tail"
  exit 0
fi

root=""
if [ "$FORCE" = 1 ]; then root="${CLAUDE_PROJECT_DIR:-$PWD}"
elif [ -x "$HARNESS_CONTEXT_DIR/hooks/moodle-detect.sh" ]; then
  root="$("$HARNESS_CONTEXT_DIR/hooks/moodle-detect.sh" 2>/dev/null)" || root=""
fi

python3 - "$brief" "$root" "$HARNESS_CONTEXT_DIR" "$JSON" <<'PY'
import json, os, re, sys

brief, root, base, as_json = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1"

def read(rel):
    path = os.path.join(base, rel)
    return open(path).read() if os.path.exists(path) else ""

# Headless agent runs (AGENT_NAME set by agent-exec) skip the human-facing output rules.
if os.environ.get("AGENT_NAME"):
    parts, banner = [], "Harness: headless agent context"
else:
    adhd = re.sub(r"\A---\n.*?\n---\n", "", read("skills/i-have-adhd/SKILL.md"), count=1, flags=re.S)
    parts = ["=== ADHD OUTPUT MODE — active for this whole session ===", adhd]
    banner = "Harness: ADHD mode on"
# T347-03: point to the Moodle rule files; inlined they overflow the 10,000-char hook cap.
if root:
    p = lambda f: os.path.join(base, f)
    parts += [
        "=== MOODLE PROJECT DETECTED — these rules are mandatory for this session ===\n"
        f"BEFORE any work here, read with the Read tool:\n"
        f"- {p('moodle-guidelines.md')} (mandatory rules: docs, style, Docker envs, code checker, tests)\n"
        f"- {p('moodle-tips.md')} (known gotchas)\n"
        f"BEFORE writing or reviewing any PHP, read {p('moodle-coding-style.md')}.\n"
        "WHEN code is complete, run the /moodle-ci skill (phpcs + PHPUnit).",
    ]
    banner += f" · Moodle guidelines loaded ({root})"
session_ctx = "\n\n".join(p for p in parts if p)

machine_msg = machine_ctx = ""
if brief:
    machine_msg = f"Machine: {brief}"
    machine_ctx = (
        f"Machine now: {brief}. Run `pc status` (or `pc status --json`) for detail; "
        "never ask the owner about machine state you can read. "
        "Facts and runbooks: ~/agents/KB/. "
        "Before a task, run `guide <words>`: it ranks how the fleet did it before (KB/guides) and the "
        "installed skills; load any `→ invoke /<name>` skill it prints with the Skill tool."
    )

if as_json:
    print(json.dumps({
        "systemMessage": " · ".join(x for x in (banner, machine_msg) if x),
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "\n\n".join(x for x in (session_ctx, machine_ctx) if x),
        },
    }))
else:
    print("\n\n".join(x for x in (machine_ctx, session_ctx) if x))
PY
exit 0
