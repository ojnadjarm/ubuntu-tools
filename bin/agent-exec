#!/usr/bin/env bash
# Run one agent turn through adapters/$HARNESS_AGENT/run.
# Result text on stdout, adapter diagnostics on stderr, {"exit","cost_usd","tokens"} in meta.json.
set -uo pipefail
. "$HOME/agents/bin/fleetlib.sh"
fleet_path

synopsis() {
  echo 'usage: agent-exec --prompt-file F [--system-file F] [--model M] [--cwd D] [--name N]'
  echo '                  [--timeout S] [--raw-out F] [--meta-out F] [--pid-file F]'
  echo '                  [--secrets-from BRIEF] [--ticket T]'
}
usage() { synopsis >&2; exit 2; }
help() {
  synopsis
  echo 'MODEL=<id> EFFORT=<level> are read from the environment (--model wins over MODEL).'
  echo 'example: MODEL=claude-fable-5-2 EFFORT=medium agent-exec --prompt-file F'
  echo 'worker, worker-max, planner are Agent-tool agent types, not commands.'
  echo '--secrets-from BRIEF: one vault lease per name on its `Secrets:` line (secret leases, ticket --ticket, else'
  echo '  --name), exported as FLEET_LEASE_<NAME> to the agent and revoked when it ends; asked here, outside the'
  echo '  agent, because the vault refuses (and raises) a lease asked from inside an agent (agents.slice).'
  exit 0
}

prompt=; system=; model=${MODEL:-}; cwd=.; name=; tmo=; raw=; meta=; pidfile=; secrets_from=; ticket=
while [ $# -gt 0 ]; do
  case "$1" in
    --*-file|--model|--cwd|--name|--timeout|--budget-usd|--*-out|--secrets-from|--ticket) [ $# -ge 2 ] || { echo "agent-exec: $1 needs a value" >&2; usage; } ;;&
    --prompt-file) prompt="${2:-}"; shift 2 ;;
    --system-file) system="${2:-}"; shift 2 ;;
    --model)       model="${2:-}";  shift 2 ;;
    --cwd)         cwd="${2:-}";    shift 2 ;;
    --name)        name="${2:-}";   shift 2 ;;
    --timeout)     tmo="${2:-}";    shift 2 ;;
    --budget-usd)  shift 2 ;;                     # caps removed: ignored
    --raw-out)     raw="${2:-}";    shift 2 ;;
    --meta-out)    meta="${2:-}";   shift 2 ;;
    --pid-file)    pidfile="${2:-}";shift 2 ;;
    --secrets-from) secrets_from="${2:-}"; shift 2 ;;
    --ticket)      ticket="${2:-}"; shift 2 ;;
    -h|--help)     help ;;
    *) echo "agent-exec: unknown option $1" >&2; usage ;;
  esac
done
[ -r "$prompt" ] || { echo "agent-exec: cannot read prompt file '$prompt'" >&2; exit 2; }
[ -d "$cwd" ] || { echo "agent-exec: no such directory '$cwd'" >&2; exit 2; }
[ -z "$secrets_from" ] || [ -r "$secrets_from" ] || { echo "agent-exec: cannot read --secrets-from '$secrets_from'" >&2; exit 2; }

adapter="$HARNESS_HOME/adapters/${HARNESS_AGENT:-generic}/run"
[ -x "$adapter" ] || { echo "agent-exec: no adapter at $adapter" >&2; exit 2; }

: "${raw:=$cwd/raw.json}"
: "${meta:=$cwd/meta.json}"
prompt=$(realpath -m -- "$prompt"); raw=$(realpath -m -- "$raw"); meta=$(realpath -m -- "$meta")
[ -z "$system" ] || system=$(realpath -m -- "$system")
[ -z "$pidfile" ] || pidfile=$(realpath -m -- "$pidfile")
[ -z "$secrets_from" ] || secrets_from=$(realpath -m -- "$secrets_from")
: >"$raw"; : >"$meta"

export PROMPT_FILE="$prompt" SYSTEM_FILE="$system" MODEL="$model" AGENT_NAME="$name" \
       AGENT_TIMEOUT="$tmo" RAW_OUT="$raw" META_OUT="$meta"

cd "$cwd" || exit 1
# Leases for the brief's `Secrets:` line, asked before the agent starts (T1634-V5).
leases=()
if [ -n "$secrets_from" ] && grep -qE '^[[:blank:]]*([-*][[:blank:]]*)?Secrets:|^AI image grant: "' "$secrets_from"; then
  ttl=$(( ${tmo:-85800} + 600 )); [ "$ttl" -le 86400 ] || ttl=86400
  while IFS='=' read -r k v; do
    [[ $k =~ ^FLEET_LEASE_[A-Z0-9_]+$ && -n $v ]] || continue
    export "$k=$v"; leases+=("$v")
  done < <("$HARNESS_HOME/bin/secret" leases --from "$secrets_from" --ticket "${ticket:-${name:-agent-exec}}" \
             --ttl "$ttl" </dev/null)
fi
# scope_ok — a user-bus scope can start; a positive probe is cached per boot in $XDG_RUNTIME_DIR/pc-status/scope-ok (T1138).
scope_ok() {
  local f=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/pc-status/scope-ok} b
  b=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  [ -n "$f" ] && [ -n "$b" ] && [ "$(cat "$f" 2>/dev/null)" = "$b" ] && return 0
  systemd-run --user --scope -q true >/dev/null 2>&1 || return 1
  [ -n "$f" ] && [ -n "$b" ] && mkdir -p "${f%/*}" 2>/dev/null && printf '%s\n' "$b" >"$f" 2>/dev/null
  return 0
}
# The adapter yields CPU in agents.slice (idle weight), bound to the caller's user unit: its stop and MemoryMax still apply.
place=(); cg=$(sed -n 's/^0:://p' /proc/self/cgroup); u=${cg##*/}; m=$(cat "/sys/fs/cgroup$cg/memory.max" 2>/dev/null)
if [[ $cg == */user@"$UID".service/* && $cg != */agents.slice/* && ( $u == *.service || $u == *.scope ) ]] &&
   scope_ok; then
  place=(systemd-run --user --scope --quiet --slice=agents.slice -p "BindsTo=$u"
         -p "MemoryMax=${m/#max/infinity}")
fi
"${place[@]}" "$adapter" </dev/null &
child=$!
[ -n "$pidfile" ] && printf '%s\n' "$child" >"$pidfile"
trap 'kill "$child" 2>/dev/null' TERM INT
wait "$child"; rc=$?
[ -n "$pidfile" ] && rm -f "$pidfile"
[ ${#leases[@]} = 0 ] || printf '%s\n' "${leases[@]}" | "$HARNESS_HOME/bin/secret" revoke - >/dev/null 2>&1

# The adapter owns cost/tokens; agent-exec owns the exit code.
if [ -s "$meta" ] && jq -e . "$meta" >/dev/null 2>&1; then
  jq --argjson e "$rc" '. + {exit:$e}' "$meta" >"$meta.tmp" && mv "$meta.tmp" "$meta"
else
  jq -n --argjson e "$rc" '{exit:$e}' >"$meta"
fi
exit "$rc"
