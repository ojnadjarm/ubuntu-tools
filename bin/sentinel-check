#!/usr/bin/env bash
# 15-min health check: bash fixes for known faults, Claude (agent-run sentinel) only if they fail.
# usage: sentinel-check [--profile]
#   --profile  the tick's read path only (no fix, push, escalation or state write): CPU ms per step.
PROFILE=""
case "${1:-}" in
  -h|--help) awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; exit 0 ;;
  --profile) PROFILE=1 ;;
  "") ;;
  *) echo "usage: sentinel-check [--profile]" >&2; exit 2 ;;
esac
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/agents/bin:$PATH"
# shellcheck source=/dev/null
[ -n "${HARNESS_ENV_LOADED:-}" ] || . "$HOME/agents/bin/env.sh"
st="$HOME/agents/sentinel/state"
if [ -n "$PROFILE" ]; then
  log() { :; }
else
  mkdir -p "$st"
  log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$st/sentinel.log"; }
  exec 9>"$st/.lock"; flock -n 9 || { log "lock busy: the previous tick is still running, skipped"; exit 0; }
  # pc status reads this stamp as agents.sentinel_age: a stale one means the sentinel stopped ticking.
  date -Is >"$st/last-run"
fi
# CPU ms of this shell plus its reaped children (/proc stat) and of the unit cgroup (background children
# too; only as a unit's main process). step <name> <cmd…> runs cmd and, with --profile, prints both deltas.
cg_stat=""
[ -n "$PROFILE" ] && HZ=$(getconf CLK_TCK)
# The cgroup is ours only when systemd started this shell (a unit's main process), not inherited.
if [ -n "$PROFILE" ] && read -r cg_stat </proc/$PPID/comm && [ "$cg_stat" = systemd ]; then
  read -r cg_stat </proc/$$/cgroup; cg_stat="/sys/fs/cgroup${cg_stat#0::}/cpu.stat"
else cg_stat=""; fi
cpu_now() {
  local l a; read -r l </proc/$$/stat; read -ra a <<<"${l##*) }"
  CPU=$(( (a[11] + a[12] + a[13] + a[14]) * 1000 / HZ )); CG=-1
  [ -r "$cg_stat" ] && { read -r _ l <"$cg_stat"; CG=$((l / 1000)); }
}
step() {
  local n=$1 c0 g0 rc; shift
  [ -n "$PROFILE" ] || { "$@"; return; }
  cpu_now; c0=$CPU; g0=$CG
  "$@" >/dev/null 2>&1; rc=$?
  cpu_now
  printf '%-10s %6d ms  cgroup %s  rc %d\n' "$n" $((CPU - c0)) "$([ "$CG" -ge 0 ] && echo "$((CG - g0)) ms" || echo n/a)" "$rc"
  return "$rc"
}
DRY=${PROFILE:+--dry-run}
# snapshot [--fresh] — pc status JSON; --fresh bypasses the 60 s probe cache (used
# after a repair, where a cached docker/tailscale value would hide the fix).
# Output without a .sections key (probe crashed or printed nothing) becomes a status.probe FAIL.
snapshot() {
  local out
  out=$(${SENTINEL_STATUS_CMD:-pc status --json} "$@" 2>/dev/null)
  if jq -e .sections >/dev/null 2>&1 <<<"$out"; then printf '%s\n' "$out"; return; fi
  log "status probe failed"
  echo '{"sections":{"status":{"probe":{"state":"FAIL","value":"no valid JSON"}}}}'
}
failures() {
  jq -r '.sections|to_entries[]|.key as $s|.value|to_entries[]
         |select(.value.state=="FAIL")|"\($s).\(.key)\t\(.value.value)"' <<<"$1" 2>/dev/null
}

# Known faults, as data: one row per fault, "<pc status key glob>  <fix command>". Adding a
# fault is one row; `docker.*` covers every compose stack. A fix reads the key from $key.
FAULTS=(
  'services.docker    sudo systemctl start docker'
  'services.ydotoold  sudo systemctl restart ydotoold'
  'network.tailscale  fix_tailscale'
  'docker.*           bounded fix_stack'
  'keepalive.*        bounded fix_keepalive'
  'agents.orchestrator fix_orch'
)
# Faults only the owner clears (a pending reboot, swap, a dead fleet unit): pc status and the dashboard
# show them; the sentinel never repairs or escalates them. "<key glob> [push once after N s]".
OWNER_ONLY=(
  'host.reboot_required'
  'host.failed_units'
  'host.netdata_alerts'
  'resources.swap'
  'agents.fleet'
  'agents.unit_loops 7200'
)
# owner_only [--push] — the failure lines on stdin minus the owner-only ones; --push sends the
# one push a row with a delay is owed once its fault has lasted that long (episode in tries/).
owner_only() {
  local push=${1:-} key val row g d f t
  while IFS=$'\t' read -r key val; do
    [ -n "$key" ] || continue
    for row in "${OWNER_ONLY[@]}"; do
      read -r g d <<<"$row"
      # shellcheck disable=SC2254  # deliberate: $g is the row's glob
      case "$key" in $g) ;; *) continue;; esac
      if [ -n "$push" ] && [ -n "$d" ]; then
        f="$st/tries/$key"; [ -s "$f" ] || date +%s >"$f"; t=$(cat "$f")
        [ "$t" != pushed ] && [ $(( $(date +%s) - t )) -ge "$d" ] &&
          notify-owner -p high -t sentinel "sentinel: $key for $(( ($(date +%s) - t) / 3600 )) h: ${val:0:120}" && echo pushed >"$f"
      fi
      continue 2
    done
    printf '%s\t%s\n' "$key" "$val"
  done
}
# profile_only — the failure lines on stdin minus docker.<project> rows whose expected services
# (compose-services: profile-aware) all run. Unknown projects keep the row.
profile_only() {
  local key val p exp run
  while IFS=$'\t' read -r key val; do
    [ -n "$key" ] || continue
    if [[ $key == docker.* ]]; then
      p=${key#docker.}
      exp=$(compose-services "$p" 2>/dev/null)
      run=$(docker ps --filter "label=com.docker.compose.project=$p" \
        --format '{{.Label "com.docker.compose.service"}}' 2>/dev/null | sort -u)
      if [ -n "$exp" ] && [ -z "$(comm -23 <(printf '%s\n' "$exp") <(printf '%s\n' "$run"))" ]; then
        log "$key $val: only services behind an inactive profile are down, not a fault"; continue
      fi
    fi
    printf '%s\t%s\n' "$key" "$val"
  done
}

# `tailscale up` refuses unless every non-default pref is restated (hostname, operator, ssh).
fix_tailscale() { sudo tailscale up --timeout=30s --hostname="$HARNESS_HOST" --operator="$USER" --ssh; }
compose_file() { grep -l "^name: $1\$" "$HOME"/moodle-envs/*/docker-compose.yml 2>/dev/null | head -1; }
# Bring the compose stack named by $key (docker.<project>) back up.
fix_stack() {
  local cf; cf=$(compose_file "${key#docker.}")
  [ -n "$cf" ] && docker compose -f "$cf" up -d
}
# keepalive.<unit>: restart the user unit; keepalive.http-<project>: restart that compose stack.
fix_keepalive() {
  local k=${key#keepalive.} cf
  case $k in
    http-*) cf=$(compose_file "${k#http-}"); [ -n "$cf" ] && docker compose -f "$cf" restart;;
    *) systemctl --user restart "$k";;
  esac
}
# bounded <fix…>: at most SENTINEL_TRIES repairs in a row per $key, then one push and no more until it clears.
bounded() {
  local f="$st/tries/$key" n max=${SENTINEL_TRIES:-3}
  n=$(cat "$f" 2>/dev/null || echo 0)
  if [ "$n" -ge "$max" ]; then
    [ "$n" -eq "$max" ] && notify-owner -p high -t sentinel \
      "sentinel: $key still down after $max repairs ($val); bash repair paused until it recovers" && echo $((n + 1)) >"$f"
    return 0
  fi
  echo $((n + 1)) >"$f"
  "$@"
}

# Orchestrator pane not serving ($val = trust-prompt|shell|dead): one repair per episode.
# The trust dialog is answered (Down Enter = "Yes, I trust this folder": the folder is the
# owner's home); a dead pane or a bare shell gets one unit restart. The owner is pushed only
# if the pane is still not serving afterwards (below); the Claude sentinel never handles it.
fix_orch() {
  [ "$val" = off ] && return 0
  [ -e "$st/orch-repaired" ] && return 0
  case "$val" in
    trust-prompt) tmux send-keys -t "${ORCHESTRATOR_TMUX_SESSION:-claude}" Down Enter
                  log "orchestrator trust-prompt: answered (Down Enter)";;
    *) systemctl --user restart "${ORCHESTRATOR_UNIT:-claude-orchestrator.service}"
       log "orchestrator $val: restarted ${ORCHESTRATOR_UNIT:-claude-orchestrator.service}";;
  esac
  : >"$st/orch-repaired"
  sleep "${SENTINEL_ORCH_WAIT:-5}"
}

[ -n "$PROFILE" ] && { cpu_now; p0=$CPU; g0=$CG; }
# shellcheck disable=SC2086  # $DRY is empty or one word
step runaway sentinel-runaway $DRY || log "sentinel-check: sentinel-runaway failed rc $?"
# shellcheck disable=SC2086
step waits sentinel-waits $DRY || log "sentinel-check: sentinel-waits failed rc $?"

# A hand-typed `systemd-run` without --collect leaves a failed run-* scope that nothing else clears
# (pc status lists it apart, no FAIL); one older than SENTINEL_TRANSIENT_AGE s is reset and logged.
reset_transient() {
  local u props since desc now; now=$(date +%s)
  for u in $(systemctl --user list-units --state=failed --plain --no-legend 2>/dev/null | awk '$1 ~ /^run-/{print $1}'); do
    props=$(systemctl --user show "$u" -p Transient -p Description -p StateChangeTimestamp --timestamp=unix 2>/dev/null)
    grep -qx 'Transient=yes' <<<"$props" || continue
    since=$(sed -n 's/^StateChangeTimestamp=@//p' <<<"$props")
    [ -n "$since" ] && [ $((now - since)) -ge "${SENTINEL_TRANSIENT_AGE:-600}" ] || continue
    desc=$(sed -n 's/^Description=//p' <<<"$props")
    [ -z "$PROFILE" ] && pc units reset-failed "$u" --user --apply >/dev/null 2>&1 &&
      log "reset failed transient $u after $(( (now - since) / 60 )) min: ${desc:0:120}"
  done
}
step transient reset_transient

# pipewire log.level creeps up from debug tools left running; keep it at the default (2).
fix_pipewire() {
  local pw_lvl
  pw_lvl=$(pw-metadata -n settings 0 log.level 2>/dev/null | sed -n "s/.*value:'\([0-9]*\)'.*/\1/p")
  if [ -z "$PROFILE" ] && [ -n "$pw_lvl" ] && [ "$pw_lvl" -gt 2 ] 2>/dev/null; then
    pw-metadata -n settings 0 log.level 2 >/dev/null 2>&1
    log "pipewire log.level was $pw_lvl, reset to 2"
  fi
}
step pipewire fix_pipewire

# Orbiters whose subagent died without a SubagentStop go out here (sweep writes its claims: not profiled).
orbit=${ORBIT_HOOK:-$HOME/agents/bin/orbit-hook}
[ -z "$PROFILE" ] && [ -x "$orbit" ] && "$orbit" sweep </dev/null

# pc status --brief judges the same verdict table for ~0.2 CPU s less than --json (T988): a clean
# FAIL=none tick stops there; any FAIL, or no brief line, reads the full JSON.
triage() {
  if [[ "$(${SENTINEL_BRIEF_CMD:-pc status --brief} 2>/dev/null)" == *" FAIL=none" ]]; then json='{"sections":{}}'; all=""; return; fi
  json="$(snapshot "$@")"; all="$(failures "$json")"
}
step status triage
if [ -n "$PROFILE" ]; then
  step owner_only eval 'owner_only <<<"$all" | profile_only'
  cpu_now
  printf '%-10s %6d ms  cgroup %s\n' total $((CPU - p0)) "$([ "$CG" -ge 0 ] && echo "$((CG - g0)) ms" || echo n/a)"
  exit 0
fi
mkdir -p "$st/tries"
for f in "$st"/tries/*; do
  [ -e "$f" ] && ! grep -q "^${f##*/}"$'\t' <<<"$all" && rm -f "$f"
done
fails="$(owner_only --push <<<"$all" | profile_only)"
grep -qE '^(agents.orchestrator|status.probe)' <<<"$fails" || rm -f "$st/orch-repaired" "$st/orch-notified"
if [ -z "$fails" ]; then date -Is >"$st/last-ok"; exit 0; fi
log "FAIL: $(tr '\n' ';' <<<"$fails")"

unmatched=""
while IFS=$'\t' read -r key val; do
  fixed=""
  for row in "${FAULTS[@]}"; do
    set -f
    # shellcheck disable=SC2086  # deliberate: the row splits into pattern + fix words, unglobbed
    set -- $row
    set +f
    # shellcheck disable=SC2254  # deliberate: $1 is the row's glob
    case "$key" in $1) shift; "$@"; fixed=1; break ;; esac
  done
  [ -n "$fixed" ] || unmatched+="$key;"
done <<<"$fails" >>"$st/sentinel.log" 2>&1

# A fault with no bash fix gets time to clear on its own (e.g. wifi reassociating) before Claude.
if [ -n "$unmatched" ]; then
  log "no bash fix for $unmatched re-checking in ${SENTINEL_SETTLE:-30} s"
  sleep "${SENTINEL_SETTLE:-30}"
fi
json="$(snapshot --fresh)"; left="$(failures "$json" | owner_only | profile_only)"
orch=$(awk -F'\t' '$1=="agents.orchestrator"{print $2}' <<<"$left")
if [ -n "$orch" ]; then
  if [ ! -e "$st/orch-notified" ]; then
    notify-owner -p high -t sentinel \
      "orchestrator pane $orch after one repair: Remote Control is down. Runbook: KB/runbooks/orchestrator-down.md" && : >"$st/orch-notified"
    log "orchestrator $orch after repair: owner notified"
  fi
  left=$(grep -v '^agents.orchestrator' <<<"$left")
  [ -z "$left" ] && exit 0
fi
if [ -z "$left" ]; then log "$([ -n "$unmatched" ] && echo cleared on re-check || echo fixed by bash)"; date -Is >"$st/last-ok"; exit 0; fi

# Cool-down: the same failure signature escalates to Claude at most once every COOLDOWN seconds.
COOLDOWN=21600
sig="$(cut -f1 <<<"$left" | sort -u | tr '\n' ',')"
now="$(date +%s)"
prev_sig=""; prev_t=0
[ -r "$st/last-escalation" ] && IFS=$'\t' read -r prev_sig prev_t <"$st/last-escalation"
if [ "$sig" = "$prev_sig" ] && [ $((now - prev_t)) -lt "$COOLDOWN" ]; then
  log "escalation suppressed (same signature $sig escalated $(((now - prev_t) / 60)) min ago)"
  if [ ! -e "$st/suppressing" ]; then
    : >"$st/suppressing"
    notify-owner -p high -t sentinel \
      "sentinel: $sig still failing after a Claude repair; escalation paused 6h, bash fixes keep running" \
      || log "sentinel-check: notify-owner failed rc $?"
  fi
  exit 0
fi
rm -f "$st/suppressing"
printf '%s\t%s\n' "$sig" "$now" >"$st/last-escalation"

log "unresolved, escalating to Claude: $(tr '\n' ';' <<<"$left")"
jq -n --arg t "$(date -Is)" --arg b "$fails" --arg a "$left" --argjson s "$json" \
  '{time:$t, failures_before:($b|split("\n")), failures_after:($a|split("\n")), status:$s}' \
  >"$st/incident.json"
agent-run sentinel 9>&-
