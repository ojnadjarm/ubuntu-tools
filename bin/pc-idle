#!/usr/bin/env bash
# pc idle — idle power baseline: median package/psys watts over a window, the top wakers and the resident fleet RSS.
set -uo pipefail
export LC_ALL=C
BIN="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$BIN/pclib.sh"
PC_SUB='pc idle'

pc_usage 'usage: pc idle [--seconds 60] [--json|--tsv]

Samples `pc power rapl` every PC_IDLE_INTERVAL seconds (default 2) for the window and reports
the median package and psys watts with the psys standard deviation, the five busiest wakers
from `pc top --sort wake` with their unit, the resident RSS of the agent@*, sentinel* and
dark-eye* units and, as other_rss_mb, the RSS of any leftover playwright-mcp / headless-chrome tree.
Read-only: nothing is mutated and no ledger entry is written. `--tsv` prints one row for
bench/BASELINE-IDLE.tsv, which pcbench-weekly appends to on Sunday; column 11,
top_waker_unit, is the cgroup leaf of the top waker with tmux-spawn-<uuid>.scope and
app-<name>-<pid>.scope collapsed to tmux-spawn and app-<name>; column 12, other_top, names the
largest browser tree as <cgroup leaf>:<playwright-mcp|chrome-headless>:<age_s>:<rss_mb>
(- when there is none).' "$@"

PC_EXTRA_FLAGS=(--tsv)
pc_opt "$@"
TSV=0; [ -n "${PC_OPT[--tsv]:-}" ] && TSV=1

SECS=$SECONDS_
case "$SECS" in ""|*[!0-9]*) SECS=60;; 0) SECS=60;; esac
INT=${PC_IDLE_INTERVAL:-2}
N=$(( SECS / INT )); [ "$N" -lt 1 ] && N=1
RAPL_S=$(( INT > 1 ? 1 : INT )); [ "$RAPL_S" -lt 1 ] && RAPL_S=1

samples=$(
  i=0
  while [ "$i" -lt "$N" ]; do
    [ "$i" = 0 ] || { [ $(( INT - RAPL_S )) -gt 0 ] && sleep $(( INT - RAPL_S )); }
    pc_cmd pc power rapl --seconds "$RAPL_S" --json
    i=$(( i + 1 ))
  done
)

power=$(jq -sc '
  def r2: (. * 100 | round) / 100;
  def med: sort | if length == 0 then 0
                  elif length % 2 == 1 then .[(length / 2) | floor]
                  else (.[length / 2 - 1] + .[length / 2]) / 2 end;
  def sd: if length == 0 then 0 else (add / length) as $m
          | (map(($m - .) * ($m - .)) | add / length | sqrt) end;
  { samples: length,
    package_w: ([.[].package_w] | med | r2),
    psys_w:    ([.[].psys_w]    | med | r2),
    psys_sd:   ([.[].psys_w]    | sd  | r2) }' <<<"$samples")

wakers=$(pc_cmd pc top --sort wake -n 5 --json |
  jq -c '[.[] | {comm, wake, rss, unit: ((.unit // "-")
           | sub("^tmux-spawn-.*\\.scope$"; "tmux-spawn")
           | sub("^(?<a>app-.+)-[0-9]+\\.scope$"; "\(.a)"))}]')

fleet=$(pc_cmd pc top --sort rss -n 100 --json |
  jq -c '[.[] | select(.unit | test("^(agent@|sentinel|dark-eye)"))]
         | { rss_mb: ((([.[].rss] | add // 0) / 1024 * 10 | round) / 10),
             units: ([.[].unit] | unique) }')

# Session leftovers the fleet does not own: the Playwright MCP server and headless Chrome
# trees that outlive a browser task (TSP-020), summed in KB apart from fleet_rss_mb. Also the
# largest tree by cgroup leaf as <unit-or-scope>:<family>:<age_s>:<rss_mb> of its oldest process (TSP-039).
# Prints "<kb><TAB><other_top>".
other_rss() {
  local d cmd rss args kb=0 cg comm line age btime= clk now k v top=- max=0
  declare -A grp gcomm gage
  clk=$(getconf CLK_TCK 2>/dev/null) || clk=100
  printf -v now '%(%s)T' -1
  { while read -r k v _; do [ "$k" = btime ] && { btime=$v; break; }; done <"$PC_PROC/stat"; } 2>/dev/null
  for d in "$PC_PROC"/[0-9]*; do
    mapfile -d '' args <"$d/cmdline" 2>/dev/null || continue
    cmd="${args[*]}"
    case $cmd in
      *playwright-mcp*) comm=playwright-mcp;;
      *headless_shell*) comm=chrome-headless;;
      *--headless*) case $cmd in *chrom*) comm=chrome-headless;; *) continue;; esac;;
      *) continue;;
    esac
    read -r _ rss _ <"$d/statm" 2>/dev/null || continue
    kb=$(( kb + rss * 4 ))
    cg=-; read -r cg 2>/dev/null <"$d/cgroup"; cg=${cg##*/}; cg=${cg:--}
    age=0
    if [ -n "$btime" ] && read -r line 2>/dev/null <"$d/stat"; then
      line=${line#*') '}; set -- $line; age=$(( now - (btime + ${20:-0} / clk) ))
    fi
    grp[$cg]=$(( ${grp[$cg]:-0} + rss * 4 ))
    [ "$age" -ge "${gage[$cg]:--1}" ] && { gage[$cg]=$age; gcomm[$cg]=$comm; }
  done
  for k in "${!grp[@]}"; do
    [ "${grp[$k]}" -gt "$max" ] && { max=${grp[$k]}; top="$k:${gcomm[$k]}:${gage[$k]}:$(( (max + 512) / 1024 ))"; }
  done
  printf '%s\t%s' "$kb" "$top"
}

IFS=$'\t' read -r other_kb other_top <<<"$(other_rss)"
OUT=$(pc_json '$p + {seconds:$s, wakers:$w, fleet:$f, other_rss_mb:(($o / 1024 * 10 | round) / 10), other_top:$ot, t:$t}' -c \
  --argjson p "$power" --argjson s "$SECS" --argjson w "$wakers" --argjson f "$fleet" \
  --argjson o "$other_kb" --arg ot "$other_top" --arg t "$(date -Is)")

if [ "$TSV" = 1 ]; then
  jq -r '[.t, .seconds, .samples, .package_w, .psys_w, .psys_sd,
          (.wakers[0].comm // "-"), (.wakers[0].wake // 0), .fleet.rss_mb,
          .other_rss_mb, (.wakers[0].unit // "-"), .other_top] | @tsv' <<<"$OUT"
elif [ "$JSON" = 1 ]; then
  printf '%s\n' "$OUT"
else
  jq -r '"idle    \(.seconds) s, \(.samples) samples",
         "power   package \(.package_w) W median  psys \(.psys_w) W ±\(.psys_sd)",
         "wakers  " + ([.wakers[] | "\(.comm) \(.wake)/s"] | join(" · ")),
         "fleet   \(.fleet.rss_mb) MB resident in \(.fleet.units | length) units · other \(.other_rss_mb) MB in browser trees (largest \(.other_top))"' <<<"$OUT"
fi
exit 0
