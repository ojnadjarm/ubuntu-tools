#!/usr/bin/env bash
# Usage: sentinel-runaway [--dry-run]   --dry-run prints "would ..." lines, kills nothing, writes no state.
# Runaway-process check: kills stateless helpers pegged at >=90% of a core over two sentinel
# runs, restarts fat/hot desktop portal helpers, closes hot Chrome trees no Playwright call drives,
# and cleans up agent residue (orphan shell loops, unread capture pipes, hand-run Dark Eye bodies,
# dead sessions' scratchpads).
# Reads /proc directly (one pass, no per-process forks) so a quiet box costs ~nothing.
case "${1:-}" in -h|--help) awk 'NR>1&&/^#/{sub(/^# ?/,"");print;next}NR>1{exit}' "$0"; exit 0 ;; esac
set -uo pipefail
# shellcheck source=/dev/null
[ -n "${HARNESS_ENV_LOADED:-}" ] || . "$HOME/agents/bin/env.sh"
st="${SENTINEL_STATE_DIR:-$HOME/agents/sentinel/state}"
mkdir -p "$st"
state="$st/runaway.tsv"
restarts="$st/runaway-restarts.tsv"
browsers="$st/runaway-browsers.tsv"
ACTIONS="${SENTINEL_RUNAWAY_ACTIONS:-$HOME/agents/log/actions.jsonl}"
DRY=0
case "${1:-}" in
  "") ;;
  --dry-run) DRY=1 ;;
  *) echo "usage: sentinel-runaway [--dry-run]   (see --help)" >&2; exit 2 ;;
esac
DRYRULES="${SENTINEL_RUNAWAY_DRYRULES:-}"   # e.g. "1,3" forces those rules to log-only

PROC="${SENTINEL_RUNAWAY_PROC:-/proc}"
TMPROOT="${SENTINEL_RUNAWAY_TMPROOT:-/tmp}"
PROJECTS="${SENTINEL_RUNAWAY_PROJECTS:-$HOME/.claude/projects}"   # rule 5: session transcripts <uuid>.jsonl

# Scratch directories agents write into, from $AGENT_SCRATCH_GLOBS (config.env). Rules 1 and 5
# both work off this list: rule 5 expands the globs, rule 1 matches paths against them. A glob
# rooted at /tmp is re-rooted on $TMPROOT so the fixtures can run against a fake tree.
SCRATCH_GLOBS=()   # the patterns, re-rooted; SCRATCH_RES, one regex each, "*" = one path segment
SCRATCH_RES=()
set -f   # split $AGENT_SCRATCH_GLOBS on whitespace only; the patterns expand later, under $TMPROOT
for _g in $AGENT_SCRATCH_GLOBS; do
  _g="${_g/#\/tmp/$TMPROOT}"; SCRATCH_GLOBS+=("$_g")
  _r=${_g//./\\.}; SCRATCH_RES+=("${_r//\*/[^/]+}")
done
set +f
# in_scratch <path> — true when the path is one of the scratch dirs or lives under one.
in_scratch() {
  local p=$1 r
  for r in ${SCRATCH_RES[@]+"${SCRATCH_RES[@]}"}; do
    [[ "$p" =~ $r(/|[[:space:]]|$) ]] && return 0
  done
  return 1
}
# session_of <text> — the session id of the first scratch dir named in text (its parent dir's name).
session_of() {
  local r m
  for r in ${SCRATCH_RES[@]+"${SCRATCH_RES[@]}"} '[^/[:space:]]+/scratchpad'; do
    if [[ "$1" =~ ($r)(/|[[:space:]]|$) ]]; then m=${BASH_REMATCH[1]%/*}; echo "${m##*/}"; return; fi
  done
}
# chrome_bin <name> — true for a Chrome/Chromium executable name (argv[0] basename).
chrome_bin() {
  case "$1" in
    chrome|chromium|chromium-browser|headless_shell|chrome-headless-shell) return 0 ;;
    *) return 1 ;;
  esac
}
# last_playwright — epoch of the newest Playwright tool call in $ACTIONS, 0 when there is none.
last_playwright() {
  local line
  line=$(tac "$ACTIONS" 2>/dev/null | grep -m1 -F '"tool": "mcp__playwright__')
  if [[ "$line" =~ \"ts\":\ *\"([^\"]+)\" ]]; then date -d "${BASH_REMATCH[1]}" +%s 2>/dev/null || echo 0; else echo 0; fi
}
# owner_live <pid> <session> — true when a claude process is an ancestor of pid or names the session.
owner_live() {
  local p=${PARENT[$1]:-} c
  for _ in 1 2 3 4 5; do
    [ -n "$p" ] || break
    [ -n "${CLAUDE_CMD[$p]+x}" ] && return 0
    p=${PARENT[$p]:-}
  done
  [ -n "$2" ] || return 1
  for c in "${!CLAUDE_CMD[@]}"; do
    [[ "${CLAUDE_CMD[$c]}" == *"$2"* ]] && return 0
    find "$PROC/$c/fd" -maxdepth 1 -lname "*$2*" 2>/dev/null | grep -q . && return 0
  done
  return 1
}
LOOP_RE='(^|[^[:alnum:]_-])(until|while)[[:space:]].*[^[:alnum:]_-]sleep[[:space:]]'

PCT_MIN=90        # % of one core, legacy + rule 4 CPU condition
STRIKES_MIN=2     # consecutive sentinel runs above PCT_MIN (~30 min at 15-min ticks)
ORPHAN_AGE=1800   # rule 2: hand-run test process / capture pipe, seconds
SHELL_AGE=3600    # rule 1: shell loop under a scratchpad, seconds
EYE_AGE=7200      # rule 3: hand-run eye-render/main.js outside dark-eye.service, seconds
SCRATCH_AGE=86400 # rule 5: scratchpad of a dead session, seconds
RSS_MIN_KB=307200 # rule 4: portal helper RSS, 300 MB
BROWSER_PCT_MIN=50  # rule 6: whole Chrome tree, % of one core (the 09-26 leak ran 100-165%, idle ~0-2%)
BROWSER_IDLE=1800   # rule 6: seconds since the last Playwright tool call in $ACTIONS

log() { if [ "$DRY" = 1 ]; then printf '%s\n' "$*"; else printf '%s %s\n' "$(date -Is)" "$*" >>"$st/sentinel.log"; fi; }

dry_for() {
  [ "$DRY" = 1 ] && return 0
  case ",${DRYRULES}," in *",$1,"*) return 0 ;; esac
  return 1
}

# Legacy kill-list: stateless session helpers restarted on demand by systemd/D-Bus.
legacy_allowed() {
  case "$1" in
    evolution-*-factory|tracker-*|localsearch-*|\
    gnome-software|packagekitd|snapd-desktop-integration|ibus-*) return 0 ;;
    *) return 1 ;;
  esac
}

# Rule 4: desktop helpers that get restarted (not killed) when hot or fat.
desktop_helper() {
  case "$1" in
    xdg-desktop-portal*|gsd-*|gjs) return 0 ;;
    *) return 1 ;;
  esac
}

stop_pid() {
  local rule="$1" pid="$2" why="$3" cmd="$4"
  if dry_for "$rule"; then log "runaway would kill pid $pid (rule$rule: $why): $cmd"; return; fi
  kill "$pid" 2>/dev/null || sudo -n kill "$pid" 2>/dev/null
  for _ in $(seq 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || sudo -n kill -9 "$pid" 2>/dev/null
  fi
  log "runaway killed pid $pid (rule$rule: $why): $cmd"
}

# unit_of <pid> — the user service the pid runs in (last *.service under user@N.service), or nothing.
unit_of() {
  local cg seg segs unit=""
  cg=$(grep -m1 '^0::' "$PROC/$1/cgroup" 2>/dev/null)
  [[ "$cg" == */user@*.service/* ]] || return 0
  IFS=/ read -ra segs <<<"${cg#*/user@*.service/}"
  for seg in "${segs[@]}"; do [[ "$seg" == *.service ]] && unit=$seg; done
  echo "$unit"
}

restart_helper() {
  local pid="$1" comm="$2" why="$3" unit
  unit=$(unit_of "$pid")
  if [ -z "$unit" ]; then stop_pid 4 "$pid" "$why, in no user unit, killed instead" "$comm"; return; fi
  if dry_for 4; then log "runaway would restart $unit (pid $pid, rule4: $why)"; return; fi
  if systemctl --user restart "$unit" >>"$st/sentinel.log" 2>&1; then
    log "runaway restarted $unit (pid $pid was $why)"
  else
    log "runaway could not restart $unit (pid $pid, rule4: $why), left running"
    return
  fi
  local now_e last=0
  now_e=$(date +%s)
  last=$(awk -F'\t' -v c="$comm" '$1==c{print $2}' "$restarts" 2>/dev/null | tail -1)
  [ -n "$last" ] || last=0
  if [ $((now_e - last)) -lt 86400 ] && [ "$last" -gt 0 ]; then
    notify-owner -p high -t sentinel "sentinel: $unit restarted again within 24h ($why)" 2>/dev/null || true
  fi
  { grep -v -F "$(printf '%s\t' "$comm")" "$restarts" 2>/dev/null; printf '%s\t%s\n' "$comm" "$now_e"; } >"$restarts.new" \
    && mv "$restarts.new" "$restarts"
}

declare -A REAPED   # rule 3: one body-sandbox down per sandbox name per run
# reap_sandbox <name> <age> <pid> <cmd> — `down` the sandbox once, then read each body pid back:
# `down` exits 0 on a pid it cannot see (an orphaned eye-render, a removed sandbox dir), so a
# survivor is logged as a failed takedown and killed by pid.
reap_sandbox() {
  local name="$1" age="$2" pid="$3" cmd="$4" first="" rc=0 why
  why="rule3: stale sandbox, $((age/3600))h old"
  if [ -z "${REAPED[$name]:-}" ]; then
    REAPED["$name"]=1; first=1
    if dry_for 3; then log "runaway would take down sandbox $name ($why)"; return; fi
    body-sandbox down --name "$name" >>"$st/sentinel.log" 2>&1 || rc=$?
  fi
  dry_for 3 && return
  if [ -d "$PROC/$pid" ]; then
    log "runaway failed to take down sandbox $name: pid $pid survived body-sandbox down (rc $rc, $why)"
    stop_pid 3 "$pid" "sandbox $name body left running by body-sandbox down, $((age/3600))h old" "$cmd"
  elif [ -n "$first" ]; then
    log "runaway took down sandbox $name ($why)"
  fi
}

wipe_scratch() {
  local dir="$1" age="$2"
  if dry_for 5; then log "runaway would rm -rf $dir (rule5: dead session's scratchpad, $((age/3600))h old)"; return; fi
  rm -rf -- "$dir"
  log "runaway removed $dir (rule5: dead session's scratchpad, $((age/3600))h old)"
}

now="${SENTINEL_RUNAWAY_NOW:-$(date +%s)}"   # fixtures pin the clock
read -r uptime_s _ <"$PROC/uptime" 2>/dev/null || uptime_s=0
boot_epoch=$((now - ${uptime_s%.*}))
HZ=100
PAGE_KB=4

declare -A PREV
if [ -r "$state" ]; then
  while IFS=$'\t' read -r p s c t k; do PREV["$p:$s"]="$c:$t:$k"; done <"$state"
fi

new=$(mktemp)
CMD_ALL=()
CLAUDE_PIDS=()
declare -A PARENT MANAGER CLAUDE_CMD R1_CMD R1_AGE R1_SID CH_PCT BR_CMD BR_KEY BR_PREV

for d in "$PROC"/[0-9]*; do
  pid=${d##*/}
  [ -r "$d/stat" ] || continue
  stat_line=$(<"$d/stat") || continue
  rest="${stat_line#*\(}"
  comm="${rest%\)*}"
  after="${rest##*\) }"
  # state ppid pgrp session tty tpgid flags minflt cminflt majflt cmajflt utime stime cutime cstime priority nice nthreads itrealvalue starttime vsize rss...
  # shellcheck disable=SC2206  # numeric fields, no glob characters; an array split costs a third of a here-string read (T988)
  sf=($after)
  ppid=${sf[1]:-} utime=${sf[11]:-} stime=${sf[12]:-} starttime=${sf[19]:-} rss_pages=${sf[21]:-}
  [ -n "${starttime:-}" ] || continue
  # Kernel threads (kthreadd, pid 2, and its children) match no rule: ~40 % of /proc (T988).
  [ "$ppid" = 2 ] || [ "$pid" = 2 ] && continue
  cpu=$(( (utime + stime) / HZ ))
  start=$(( boot_epoch + starttime / HZ ))
  age=$(( now - start ))
  rss_kb=$(( rss_pages * PAGE_KB ))

  cmd=""
  argv=()
  if [ -r "$d/cmdline" ]; then
    mapfile -d '' -t argv <"$d/cmdline" 2>/dev/null
    cmd="${argv[*]:-}"
  fi
  [ -n "$cmd" ] || cmd="$comm"
  CMD_ALL+=("$cmd")
  [ "$comm" = "claude" ] && { CLAUDE_PIDS+=("$pid"); CLAUDE_CMD[$pid]="$cmd"; }
  PARENT[$pid]="$ppid"
  [ "$comm" = systemd ] && MANAGER[$pid]=1   # rule 1: a loop reparented here lost its Bash parent
  # /proc/*/stat truncates comm to 15 chars ("xdg-desktop-por"), too short to match or to
  # restart by; prefer argv[0]'s basename, which carries the full executable name.
  fname="$comm"
  [ -n "${argv[0]:-}" ] && fname="${argv[0]##*/}"

  [ "$pid" = "$$" ] && continue

  # --- rule 4 + legacy: CPU-strike tracking, shared across both kill-list and restart-list ---
  key="$pid:$start"
  strikes=0
  if [ -n "${PREV[$key]:-}" ]; then
    pv=${PREV[$key]}; pcpu=${pv%%:*}; pv=${pv#*:}; pts=${pv%%:*}; pstrikes=${pv#*:}   # no here-string per process (T988)
    dt=$((now - pts))
    if [ "$dt" -gt 0 ]; then pct=$(( 100 * (cpu - pcpu) / dt )); else pct=0; fi
    [ "$pct" -ge "$PCT_MIN" ] && strikes=$((pstrikes + 1))
  else
    pct=0
  fi

  if legacy_allowed "$fname" && [ "$strikes" -ge "$STRIKES_MIN" ]; then
    stop_pid legacy "$pid" "${pct}% of a core over $strikes runs" "$cmd"
    strikes=0
  elif desktop_helper "$fname"; then
    trigger=""
    if [ "$strikes" -ge "$STRIKES_MIN" ]; then trigger="${pct}% of a core over $strikes runs"; fi
    if [ "$rss_kb" -ge "$RSS_MIN_KB" ]; then
      trigger="${trigger:+$trigger, }$((rss_kb / 1024)) MB RSS"
    fi
    if [ -n "$trigger" ]; then
      restart_helper "$pid" "$fname" "$trigger"
      strikes=0
    fi
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$start" "$cpu" "$now" "$strikes" >>"$new"

  # --- rule 6: Chrome processes; the browser root is the one without --type=, judged after the pass ---
  if chrome_bin "$fname"; then
    CH_PCT[$pid]=$pct
    if [[ "$cmd" != *" --type="* ]]; then
      udd=""; for a in "${argv[@]}"; do [[ "$a" == --user-data-dir=* ]] && udd=" $a"; done
      BR_CMD[$pid]="$fname$udd"; BR_KEY[$pid]="$key"
      [ -n "${PREV[$key]:-}" ] && BR_PREV[$pid]=1
    fi
  fi

  # --- rule 1: until/while-sleep loop under an agent scratchpad, > 60 min, not wait-for; judged after the pass ---
  if [ "$age" -ge "$SHELL_AGE" ] && [[ "$comm" =~ ^(bash|sh)$ ]] && [[ "$cmd" != *wait-for* ]] && [[ "$cmd" =~ $LOOP_RE ]]; then
    cwd=$(readlink "$d/cwd" 2>/dev/null)
    if [[ "$cmd" == *"/scratchpad"*/* ]] || in_scratch "$cmd" || in_scratch "$cwd"; then
      R1_CMD[$pid]="$cmd"; R1_AGE[$pid]="$age"; R1_SID[$pid]=$(session_of "$cmd $cwd")
    fi
  fi

  # --- rule 2: capture command whose stdout is an unread pipe or a deleted file; sockets are never judged ---
  if [ "$age" -ge "$ORPHAN_AGE" ]; then
    is_capture=0
    case "$comm" in
      journalctl) [[ "$cmd" == *" -f"* || "$cmd" == *"--follow"* ]] && is_capture=1 ;;
      tail) [[ "$cmd" == *" -f"* ]] && is_capture=1 ;;
      btmon) is_capture=1 ;;
      pw-cat) [[ "$cmd" == *" -r"* || "$cmd" == *"--record"* ]] && is_capture=1 ;;
    esac
    if [ "$is_capture" = 1 ]; then
      target=$(readlink "$d/fd/1" 2>/dev/null)
      orphan=0
      if [[ "$target" =~ ^pipe:\[([0-9]+)\]$ ]]; then
        inode="${BASH_REMATCH[1]}"
        holders=$(find "$PROC" -maxdepth 3 -path '*/fd/*' -lname "pipe:\\[${inode}\\]" 2>/dev/null | grep -vc "^$d/fd/")
        [ "${holders:-0}" -eq 0 ] && orphan=1
      elif [[ "$target" == /* ]] && [ ! -e "$target" ]; then
        orphan=1
      fi
      if [ "$orphan" = 1 ]; then
        stop_pid 2 "$pid" "capture with no reader, $((age / 60)) min old" "$cmd"
      fi
    fi
  fi

  # --- rule 3: hand-run eye-render/body outside dark-eye.service's cgroup, > 2 h ---
  if [ "$age" -ge "$EYE_AGE" ]; then
    is_body=0
    [ "$comm" = "eye-render" ] && is_body=1
    # Node >= 23 names its main thread (comm "MainThread"), so match argv[0] too.
    [[ ( "$comm" = "node"* || "$fname" = "node"* ) && "$cmd" =~ src/main\.js ]] && is_body=1
    if [ "$is_body" = 1 ]; then
      cgroup=""
      [ -r "$d/cgroup" ] && cgroup=$(<"$d/cgroup")
      if [[ "$cgroup" != *dark-eye.service* ]]; then
        sbname=""
        [ -r "$d/environ" ] && sbname=$(tr '\0' '\n' <"$d/environ" 2>/dev/null | sed -n 's/^DARK_EYE_SANDBOX=//p' | head -1)
        if [ -n "$sbname" ]; then
          reap_sandbox "$sbname" "$age" "$pid" "$cmd"
        else
          stop_pid 3 "$pid" "hand-run Dark Eye body outside dark-eye.service, $((age / 3600))h old" "$cmd"
        fi
      fi
    fi
  fi
done

if [ "$DRY" = 1 ]; then rm -f "$new"; else mv "$new" "$state"; fi

# --- rule 1 verdict: loops whose owner session is gone, or reparented to systemd (ppid = user manager) ---
for pid in "${!R1_CMD[@]}"; do
  pp=${PARENT[$pid]:-0}
  if [ -n "${MANAGER[$pp]+x}" ]; then
    why="reparented to systemd pid $pp"
  else
    owner_live "$pid" "${R1_SID[$pid]}" && continue
    why="owner gone"
  fi
  stop_pid 1 "$pid" "shell loop under a scratchpad, $why, $((R1_AGE[$pid] / 60)) min old" "${R1_CMD[$pid]}"
done

# --- rule 6 verdict: a Chrome tree hot over STRIKES_MIN runs, with no Playwright call for BROWSER_IDLE ---
declare -A BR_PCT BR_STRIKES
if [ -n "${BR_CMD[*]+x}" ]; then
  if [ -r "$browsers" ]; then
    while IFS=$'\t' read -r k s; do BR_STRIKES["$k"]=$s; done <"$browsers"
  fi
  for pid in "${!CH_PCT[@]}"; do
    p=$pid
    for _ in 1 2 3 4 5 6; do
      if [ -n "${BR_CMD[$p]+x}" ]; then BR_PCT[$p]=$(( ${BR_PCT[$p]:-0} + CH_PCT[$pid] )); break; fi
      p=${PARENT[$p]:-}; [ -n "$p" ] || break
    done
  done
  pw_last=""
  bnew=$(mktemp)
  for pid in "${!BR_CMD[@]}"; do
    k=${BR_KEY[$pid]} tpct=${BR_PCT[$pid]:-0} s=0
    if [ -n "${BR_PREV[$pid]:-}" ] && [ "$tpct" -ge "$BROWSER_PCT_MIN" ]; then s=$(( ${BR_STRIKES[$k]:-0} + 1 )); fi
    if [ "$s" -ge "$STRIKES_MIN" ]; then
      [ -n "$pw_last" ] || pw_last=$(last_playwright)
      idle=$(( now - pw_last ))
      if [ "$idle" -ge "$BROWSER_IDLE" ]; then
        [ "$pw_last" = 0 ] && idle_txt="no Playwright call in the log" || idle_txt="no Playwright call for $((idle / 60)) min"
        stop_pid 6 "$pid" "Chrome tree at ${tpct}% of a core over $s runs, $idle_txt" "${BR_CMD[$pid]}"
        s=0
      fi
    fi
    printf '%s\t%s\n' "$k" "$s" >>"$bnew"
  done
  if [ "$DRY" = 1 ]; then rm -f "$bnew"; else mv "$bnew" "$browsers"; fi
elif [ "$DRY" = 0 ]; then
  rm -f "$browsers"
fi

# --- rule 5: scratchpads of sessions whose agent process is gone, > 24 h ---
shopt -s nullglob
declare -A CWD_CLAUDES   # project slug -> claude processes whose cwd is that dir or below it
for cp in "${CLAUDE_PIDS[@]:-}"; do
  cwd=$(readlink "$PROC/$cp/cwd" 2>/dev/null) || continue
  while [ -n "$cwd" ] && [ "$cwd" != / ]; do
    s=${cwd//[^a-zA-Z0-9]/-}; CWD_CLAUDES[$s]=$(( ${CWD_CLAUDES[$s]:-0} + 1 )); cwd=${cwd%/*}
  done
done
# Unquoted on purpose: this is where the patterns expand into directories.
# shellcheck disable=SC2068
for scratch in ${SCRATCH_GLOBS[@]+${SCRATCH_GLOBS[@]}}; do
  [ -d "$scratch" ] || continue
  uuid_dir="${scratch%/*}"          # the session directory, whatever the glob's last segment is called
  uuid="${uuid_dir##*/}"
  live=0
  for t in "$PROJECTS"/*/"$uuid".jsonl; do
    tm=$(stat -c %Y "$t" 2>/dev/null) || continue
    [ $(( now - tm )) -lt "$SCRATCH_AGE" ] && { live=1; break; }
  done
  for c in "${CMD_ALL[@]:-}"; do
    [[ "$c" == *"$uuid"* ]] && { live=1; break; }
  done
  # A live session is never wiped: skip walking its tree (T988: 16k files, ~0.3 CPU s a tick).
  [ "$live" = 1 ] && continue
  mtime=$(find "$scratch" -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
  [ -n "$mtime" ] || continue
  age=$(( now - ${mtime%.*} ))
  [ "$age" -ge "$SCRATCH_AGE" ] || continue
  if [ "$live" = 0 ]; then
    for cp in "${CLAUDE_PIDS[@]:-}"; do
      if find "$PROC/$cp/fd" -maxdepth 1 -lname "*$uuid*" 2>/dev/null | grep -q .; then live=1; break; fi
    done
  fi
  if [ "$live" = 0 ]; then
    # An idle `claude --continue` names no uuid: spare the newest k transcripts of a project k claudes run in.
    proj="${uuid_dir%/*}"; proj="${proj##*/}"; k=${CWD_CLAUDES[${proj:-/}]:-0}
    if [ "$k" -gt 0 ] && ls -t "$PROJECTS/$proj"/*.jsonl 2>/dev/null | head -n "$k" | grep -qF "/$uuid.jsonl"; then live=1; fi
  fi
  [ "$live" = 0 ] && wipe_scratch "$scratch" "$age"
done
shopt -u nullglob
